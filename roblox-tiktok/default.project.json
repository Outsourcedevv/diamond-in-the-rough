{
  "name": "DiamondRushTikTok",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "DiamondRush": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "DiamondRushServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "DiamondRushHud": {
          "$path": "src/client"
        }
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true,
          "GrassLength": 0.75
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "GlobalShadows": true
      }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "$properties": {
        "Use2022Materials": true
      }
    }
  }
}
