  <Item class="ReplicatedFirst" referent="3">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="4">
      <Properties>
        <string name="Name">DiamondRushLoading</string>
        <string name="Source"><![CDATA[--!strict
-- The loading screen: runs first (ReplicatedFirst), in place of Roblox's own,
-- and covers the screen until the game is ready to play: the place has
-- loaded, the palace stands, the player's character is in it and the game's
-- display has started (it says so with the player's DiamondRushHudReady
-- attribute). A royal blue card with the title, a turning diamond, a gold
-- progress bar that fills as each of those is done, and tips. It shows for
-- at least MIN_SECONDS so it never flashes, never stays past MAX_SECONDS, and
-- fades away at the end.
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local MIN_SECONDS = 2.5
local MAX_SECONDS = 45

local ROYAL = Color3.fromRGB(34, 52, 140)
local ROYAL_DEEP = Color3.fromRGB(12, 18, 64)
local GOLD = Color3.fromRGB(246, 200, 92)
local ICE = Color3.fromRGB(176, 230, 255)
local WHITE = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(190, 200, 236)

local TIPS = {
	"Hold Shift to sprint.",
	"Walk into a room's glowing portal to join its game.",
	"Press G for the games menu, P for settings and H for how to play.",
	"Dig into the mountain, find the diamond, and hold it for 15 seconds to win.",
	"Catch the diamond bird: every gift counts double for 30 seconds.",
	"Streamers: set up your gifts in Gifts, on the sidebar.",
	"Pick the map's look in Themes, on the sidebar.",
}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then instance.Parent = parent end
	return instance
end
local function corner(parent: Instance, radius: UDim)
	make("UICorner", { CornerRadius = radius }, parent)
end

local gui = make("ScreenGui", {
	Name = "DiamondRushLoading",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 1000,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)
pcall(function() ReplicatedFirst:RemoveDefaultLoadingScreen() end)

-- One group, so the whole screen fades as one.
local screen = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, gui)
make("UIGradient", { Color = ColorSequence.new(ROYAL, ROYAL_DEEP), Rotation = 90 }, screen)

-- Sparkles drifting up the screen.
local sparkles = {}
local random = Random.new()
for k = 1, 24 do
	local size = random:NextInteger(3, 7)
	local dot = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(random:NextNumber(), random:NextNumber()),
		Size = UDim2.fromOffset(size, size),
		Rotation = 45,
		BackgroundColor3 = if k % 3 == 0 then GOLD else ICE,
		BackgroundTransparency = random:NextNumber(0.3, 0.7),
		BorderSizePixel = 0,
	}, screen)
	table.insert(sparkles, { frame = dot, speed = random:NextNumber(0.015, 0.05), x = dot.Position.X.Scale, y = dot.Position.Y.Scale })
end

local middle = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(520, 380),
	BackgroundTransparency = 1,
}, screen)
-- Shrinks to fit small screens (phones).
local fit = make("UIScale", { Scale = 1 }, middle)
local function refit()
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	fit.Scale = math.clamp(math.min(size.X / 560, size.Y / 420), 0.5, 1.2)
end
refit()
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit) end

-- The diamond: a gem on its corner with a gold edge and a lighter heart,
-- turning gently and pulsing, with a glint sweeping across it.
local gemHolder = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(260, 80), Size = UDim2.fromOffset(110, 110), BackgroundTransparency = 1 }, middle)
local glow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.45, 1.45), BackgroundColor3 = ICE, BackgroundTransparency = 0.85, BorderSizePixel = 0 }, gemHolder)
corner(glow, UDim.new(1, 0))
local gem = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.72, 0.72), Rotation = 45, BackgroundColor3 = WHITE, BorderSizePixel = 0, ClipsDescendants = true }, gemHolder)
corner(gem, UDim.new(0.12, 0))
make("UIGradient", { Color = ColorSequence.new(WHITE, ICE), Rotation = -45 }, gem)
make("UIStroke", { Color = GOLD, Thickness = 4 }, gem)
local heart = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.46, 0.46), BackgroundColor3 = Color3.fromRGB(120, 200, 255), BackgroundTransparency = 0.25, BorderSizePixel = 0 }, gem)
corner(heart, UDim.new(0.15, 0))
local glint = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(-0.5, 0.5), Size = UDim2.new(0.18, 0, 2, 0), Rotation = 0, BackgroundColor3 = WHITE, BackgroundTransparency = 0.35, BorderSizePixel = 0 }, gem)
local pulse = make("UIScale", { Scale = 1 }, gemHolder)

local title = make("TextLabel", {
	Position = UDim2.fromOffset(0, 176),
	Size = UDim2.new(1, 0, 0, 48),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextSize = 40,
	TextColor3 = WHITE,
	Text = "DIAMOND IN THE ROUGH",
}, middle)
make("UIStroke", { Color = ROYAL_DEEP, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, title)
local status = make("TextLabel", {
	Position = UDim2.fromOffset(0, 226),
	Size = UDim2.new(1, 0, 0, 22),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 16,
	TextColor3 = GOLD,
	Text = "Loading…",
}, middle)

-- The progress bar.
local track = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 258), Size = UDim2.fromOffset(380, 14), BackgroundColor3 = WHITE, BackgroundTransparency = 0.85, BorderSizePixel = 0 }, middle)
corner(track, UDim.new(1, 0))
local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, track)
corner(fill, UDim.new(1, 0))
make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), GOLD) }, fill)
local percent = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 278), Size = UDim2.fromOffset(120, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = MUTED, Text = "0%" }, middle)

local tip = make("TextLabel", {
	Position = UDim2.fromOffset(0, 326),
	Size = UDim2.new(1, 0, 0, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamMedium,
	TextSize = 15,
	TextWrapped = true,
	TextColor3 = MUTED,
	Text = TIPS[random:NextInteger(1, #TIPS)],
}, middle)

-- What's left to wait for, in order, with how full the bar is once each is done.
local target = 0.05
local stage = "Loading…"
local done = false
local started = os.clock()
task.spawn(function()
	if not game:IsLoaded() then game.Loaded:Wait() end
	target, stage = 0.35, "Building the palace…"
	workspace:WaitForChild("Lobby", MAX_SECONDS)
	target, stage = 0.6, "Getting your character ready…"
	local character = player.Character or player.CharacterAdded:Wait()
	character:WaitForChild("HumanoidRootPart", MAX_SECONDS)
	target, stage = 0.85, "Almost there…"
	while player:GetAttribute("DiamondRushHudReady") ~= true do
		player:GetAttributeChangedSignal("DiamondRushHudReady"):Wait()
	end
	target, stage = 1, "Ready!"
	done = true
end)

local shown = 0
local tipAt = os.clock()
local tipIndex = 1
local beat: RBXScriptConnection
beat = RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock() - started
	-- The bar eases towards where loading is up to.
	shown += (target - shown) * math.min(1, dt * 6)
	if target >= 1 and shown > 0.995 then shown = 1 end
	fill.Size = UDim2.fromScale(math.clamp(shown, 0, 1), 1)
	percent.Text = tostring(math.floor(shown * 100 + 0.5)) .. "%"
	status.Text = stage
	-- The diamond turns a little either way, pulses, and a glint sweeps across.
	gem.Rotation = 45 + math.sin(t * 1.6) * 10
	pulse.Scale = 1 + math.sin(t * 3) * 0.04
	glow.BackgroundTransparency = 0.82 + math.sin(t * 3) * 0.05
	glint.Position = UDim2.fromScale(-0.5 + ((t * 0.6) % 1.6), 0.5)
	for _, sparkle in sparkles do
		sparkle.y -= sparkle.speed * dt
		if sparkle.y < -0.05 then sparkle.y = 1.05 end
		sparkle.frame.Position = UDim2.fromScale(sparkle.x, sparkle.y)
	end
	-- A new tip every few seconds.
	if os.clock() - tipAt > 3.5 then
		tipAt = os.clock()
		tipIndex = tipIndex % #TIPS + 1
		tip.Text = TIPS[tipIndex]
	end
end)

-- Wait until it's all done (and the screen has shown a moment), or give up
-- waiting, then fade away.
while not (done and os.clock() - started >= MIN_SECONDS and shown >= 1) and os.clock() - started < MAX_SECONDS do
	task.wait(0.1)
end
target = 1
task.wait(0.3)
local fade = TweenService:Create(screen, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 1 })
fade:Play()
fade.Completed:Wait()
beat:Disconnect()
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="5">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">DiamondRush</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">BirdBonus</string>
          <string name="Source"><![CDATA[--!strict
-- The diamond bird: when it turns up, how it flies and how long its bonus
-- lasts. Plain maths so the server, every client and the tests agree.
local BirdBonus = {}

BirdBonus.ARRIVE_SECONDS = 4 -- swooping down from the sky into its circuit
BirdBonus.LEAVE_SECONDS = 4 -- climbing away after a click, or when the next bird arrives
local ORBIT_SPEED = 0.13 -- radians a second: about 48 seconds a lap

-- Seconds until the next bird, for `roll` in [0, 1).
function BirdBonus.nextDelay(roll: number, minSeconds: number, maxSeconds: number): number
	return minSeconds + math.clamp(roll, 0, 1) * (maxSeconds - minSeconds)
end

-- Gifts arriving before `boostUntil` (server time) count `multiplier` times.
function BirdBonus.multiplier(now: number, boostUntil: number, multiplier: number): number
	return if now < boostUntil then multiplier else 1
end

export type Path = {
	radius: number, -- circuit radius around the mountain's centre (x = z = 0)
	height: number, -- cruising height
	angle: number, -- where on the circuit it arrives
	direction: number, -- 1 anticlockwise, -1 clockwise
}

-- Where the bird is `t` seconds after it appeared. `leaveAt` is when it set
-- off (seconds after it appeared), or nil while it is still circling.
function BirdBonus.position(path: Path, t: number, leaveAt: number?): (number, number, number)
	local angle = path.angle + path.direction * ORBIT_SPEED * t
	-- It swings in and out and rises and dips as it circles, so it passes close
	-- to the camp and never looks like it is on a rail.
	local reach = path.radius * (1 + 0.18 * math.sin(t * 0.37))
	local x, y, z = math.cos(angle) * reach, path.height + 2.5 * math.sin(t * 0.8), math.sin(angle) * reach
	if t < BirdBonus.ARRIVE_SECONDS then
		local away = 1 - t / BirdBonus.ARRIVE_SECONDS
		away *= away
		x, z = x * (1 + 2.5 * away), z * (1 + 2.5 * away)
		y += 60 * away
	end
	if leaveAt ~= nil and t > leaveAt then
		local gone = (t - leaveAt) / BirdBonus.LEAVE_SECONDS
		gone *= gone
		x, z = x * (1 + 3 * gone), z * (1 + 3 * gone)
		y += 80 * gone
	end
	return x, y, z
end

-- Wing angle in radians: steady beats with a glide every so often.
function BirdBonus.flap(t: number, leaving: boolean): number
	local beat = math.sin(t * (if leaving then 14 else 8))
	local gliding = not leaving and math.sin(t * 0.5) > 0.6
	return beat * (if gliding then 0.08 else 0.6) + 0.1
end

return BirdBonus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ChalkBoard</string>
          <string name="Source"><![CDATA[--!strict
-- Chalkboard Count's classroom and board: where everything stands, how each
-- number is written in chalk strokes (no text on the board, so nothing can
-- glitch), the board's themes, and how far a gift moves the count. The server
-- builds the classroom from this; each player's game draws the chalk.
local GiftTier = require(script.Parent:WaitForChild("GiftTier"))

local ChalkBoard = {}

ChalkBoard.ORIGIN = Vector3.new(-2600, 200, 0) -- the middle of the classroom floor's top
ChalkBoard.BOARD_WIDTH, ChalkBoard.BOARD_HEIGHT = 36, 13
ChalkBoard.BOARD_BOTTOM = 2.4 -- above the floor
ChalkBoard.BOARD_Z = -20 -- the board's middle, from the classroom's middle (it faces +Z)
ChalkBoard.BOARD_THICKNESS = 0.6

-- The settings: the number to reach (up to 5 million), and how fast the hand
-- writes. The fastest writing is the old top speed (20 a second for a goal of
-- 1,000) scaled up to 5 million: 100,000 numbers a second.
ChalkBoard.GOAL = { min = 10, max = 5000000, default = 1000 }
ChalkBoard.SPEED = { min = 1, max = 100000, default = 3 } -- numbers a second
ChalkBoard.RESET_SECONDS = { min = 10, max = 300, default = 60 }
ChalkBoard.RESET_GIFT = "Galaxy" -- starts the reset countdown
ChalkBoard.SAVE_COINS = 1000 -- a gift worth this much (not the reset gift) saves the count
ChalkBoard.MAX_DIGITS = 7
-- The writer is drawn this much bigger at the board, so their hand reaches the
-- big number and they write it themselves.
ChalkBoard.WRITER_SCALE = 2

-- The board's front, where chalk goes.
function ChalkBoard.face(): number
	return ChalkBoard.ORIGIN.Z + ChalkBoard.BOARD_Z + ChalkBoard.BOARD_THICKNESS / 2
end

-- The middle of the board's front.
function ChalkBoard.centre(): Vector3
	return Vector3.new(ChalkBoard.ORIGIN.X, ChalkBoard.ORIGIN.Y + ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT / 2, ChalkBoard.face())
end

-- Where the (bigger) writer stands: at the board, a little right of the
-- middle, facing it, close enough to write on it.
function ChalkBoard.standFrame(): CFrame
	local s = ChalkBoard.WRITER_SCALE
	local at = Vector3.new(ChalkBoard.ORIGIN.X + 3, ChalkBoard.ORIGIN.Y + 3 * s, ChalkBoard.face() + 1.3 * s)
	return CFrame.lookAt(at, at - Vector3.new(0, 0, 1))
end

-- Across the board (from its middle), where the writer stands so their right
-- hand reaches a chalk point at `x`: just left of it, kept on the board.
function ChalkBoard.writerX(x: number): number
	local half = ChalkBoard.BOARD_WIDTH / 2 - 2
	return math.clamp(x - 1.3 * ChalkBoard.WRITER_SCALE, -half, half)
end

-- The writing speed slider goes up in steps that feel even from 1 a second
-- to 100,000 a second: `fraction` 0 to 1 along it, and back.
function ChalkBoard.speedAt(fraction: number): number
	local low, high = ChalkBoard.SPEED.min, ChalkBoard.SPEED.max
	local raw = low * (high / low) ^ math.clamp(fraction, 0, 1)
	if raw < 10 then return math.floor(raw * 2 + 0.5) / 2 end
	-- Two significant figures: 12, 340, 5,600, 78,000.
	local step = 10 ^ math.max(0, math.floor(math.log10(raw)) - 1)
	return math.clamp(math.floor(raw / step + 0.5) * step, low, high)
end
function ChalkBoard.speedFraction(speed: number): number
	local low, high = ChalkBoard.SPEED.min, ChalkBoard.SPEED.max
	return math.clamp(math.log(math.max(speed, low) / low) / math.log(high / low), 0, 1)
end

-- The view of the classroom: in front of the board and off to one side, looking
-- at the writer and the board.
function ChalkBoard.cameraFrame(): CFrame
	local O = ChalkBoard.ORIGIN
	local at = Vector3.new(O.X + 7, O.Y + 7.5, ChalkBoard.face() + 27)
	return CFrame.lookAt(at, ChalkBoard.centre() + Vector3.new(0, -0.8, 0))
end

-- Where the big number is written: its middle and height.
ChalkBoard.NUMBER_HEIGHT = 5.4
ChalkBoard.NUMBER_Y = 9.6 -- above the floor, the number's middle
ChalkBoard.DIGIT_WIDTH = 3.1
ChalkBoard.DIGIT_GAP = 0.9

-- Board positions: `x` across from the board's middle, `y` above the floor.
function ChalkBoard.onBoard(x: number, y: number): Vector3
	return Vector3.new(ChalkBoard.ORIGIN.X + x, ChalkBoard.ORIGIN.Y + y, ChalkBoard.face() + 0.06)
end

-- The left edge of each digit of an `n`-digit number `height` tall, centred on `middle`.
function ChalkBoard.digitLefts(n: number, height: number?, middle: number?): { number }
	local scale = (height or ChalkBoard.NUMBER_HEIGHT) / ChalkBoard.NUMBER_HEIGHT
	local width, gap = ChalkBoard.DIGIT_WIDTH * scale, ChalkBoard.DIGIT_GAP * scale
	local total = n * width + (n - 1) * gap
	local lefts = {}
	for i = 1, n do
		table.insert(lefts, (middle or 0) - total / 2 + (i - 1) * (width + gap))
	end
	return lefts
end

-- An ellipse as a polyline, from angle `a0` to `a1` (radians, 0 = right).
local function arc(cx: number, cy: number, rx: number, ry: number, a0: number, a1: number, steps: number): { Vector2 }
	local points = {}
	for i = 0, steps do
		local a = a0 + (a1 - a0) * i / steps
		table.insert(points, Vector2.new(cx + math.cos(a) * rx, cy + math.sin(a) * ry))
	end
	return points
end
local function line(...: number): { Vector2 }
	local values = { ... }
	local points = {}
	for i = 1, #values, 2 do
		table.insert(points, Vector2.new(values[i], values[i + 1]))
	end
	return points
end
local function join(a: { Vector2 }, b: { Vector2 }): { Vector2 }
	local out = table.clone(a)
	for _, p in b do table.insert(out, p) end
	return out
end

-- Each digit as hand-written chalk strokes: polylines in a box from (0, 0)
-- at the bottom left to (1, 1) at the top right, in writing order.
ChalkBoard.DIGITS = {
	[0] = { arc(0.5, 0.5, 0.42, 0.5, math.pi / 2, math.pi / 2 + 2 * math.pi, 14) },
	[1] = { line(0.22, 0.78, 0.55, 1, 0.55, 0), line(0.25, 0, 0.85, 0) },
	[2] = { join(arc(0.5, 0.7, 0.4, 0.3, math.pi * 0.95, -math.pi * 0.25, 7), line(0.1, 0, 0.92, 0)) },
	[3] = { join(arc(0.48, 0.76, 0.36, 0.24, math.pi * 0.85, -math.pi * 0.5, 7), arc(0.48, 0.27, 0.42, 0.27, math.pi * 0.5, -math.pi * 0.85, 8)) },
	[4] = { line(0.68, 0, 0.68, 1, 0.05, 0.32, 0.95, 0.32) },
	[5] = { join(line(0.86, 1, 0.22, 1, 0.16, 0.56), arc(0.5, 0.3, 0.4, 0.3, math.pi * 0.7, -math.pi * 0.85, 8)) },
	[6] = { join(arc(0.6, 0.45, 0.45, 0.55, math.pi * 0.35, math.pi, 6), arc(0.5, 0.29, 0.35, 0.29, math.pi, math.pi * 3, 12)) },
	[7] = { line(0.05, 1, 0.95, 1, 0.35, 0) },
	[8] = { arc(0.5, 0.76, 0.3, 0.24, -math.pi / 2, math.pi * 1.5, 12), arc(0.5, 0.27, 0.4, 0.27, math.pi / 2, math.pi * 2.5, 12) },
	[9] = { join(arc(0.5, 0.71, 0.38, 0.29, 0, math.pi * 2, 12), line(0.88, 0.71, 0.72, 0)) },
} :: { [number]: { { Vector2 } } }

-- The strokes of digit `d` written `height` tall with its bottom left at
-- board position (`left`, `bottom`): a list of segments { from, to }.
function ChalkBoard.segments(d: number, left: number, bottom: number, height: number): { { Vector3 } }
	local width = height * ChalkBoard.DIGIT_WIDTH / ChalkBoard.NUMBER_HEIGHT
	local out = {}
	for _, stroke in ChalkBoard.DIGITS[d] do
		for i = 1, #stroke - 1 do
			local a, b = stroke[i], stroke[i + 1]
			-- Where two strokes join at the same point there is nothing to draw.
			if math.abs(a.X - b.X) + math.abs(a.Y - b.Y) < 1e-3 then continue end
			table.insert(out, {
				ChalkBoard.onBoard(left + a.X * width, bottom + a.Y * height),
				ChalkBoard.onBoard(left + b.X * width, bottom + b.Y * height),
			})
		end
	end
	return out
end

-- The digits of a count, most significant first.
function ChalkBoard.digits(count: number): { number }
	local text = tostring(math.max(0, math.floor(count)))
	local out = {}
	for i = 1, #text do table.insert(out, tonumber(string.sub(text, i, i)) :: number) end
	return out
end

-- How far a gift moves the count: up for gifts that would break the
-- mountain, down for gifts that add stone. A Rose is 2, 100 coins 20, a
-- Galaxy 63, 10,000 coins 200 (times the strength and each gift of a combo).
function ChalkBoard.giftAmount(rocks: number, coins: number, count: number, strength: number?): number
	if rocks == 0 then return 0 end
	local amount = math.max(1, math.floor(2 * math.sqrt(math.max(coins, 1)) * (strength or 1) + 0.5)) * math.max(1, math.floor(count))
	return if rocks > 0 then amount else -amount
end

ChalkBoard.tier = GiftTier.pick

-- True if a gift called `gift` starts the reset countdown.
function ChalkBoard.isResetGift(gift: string?, resetGift: string): boolean
	return gift ~= nil and resetGift ~= "" and string.lower(gift) == string.lower(resetGift)
end

-- True if a gift saves the count while the countdown runs: worth at least
-- `saveCoins` and not the reset gift itself.
function ChalkBoard.isSaveGift(gift: string?, coins: number, resetGift: string, saveCoins: number): boolean
	return coins >= saveCoins and not ChalkBoard.isResetGift(gift, resetGift)
end

-- The themes: the board, its frame, the walls and floor, and the chalk.
export type Theme = {
	name: string,
	board: Color3, boardMaterial: Enum.Material,
	frame: Color3, frameMaterial: Enum.Material,
	wall: Color3, trim: Color3, floor: Color3, floorMaterial: Enum.Material,
	chalk: Color3, glow: boolean, -- glowing (neon) chalk
	light: Color3,
}
ChalkBoard.THEMES = {
	classic = {
		name = "Classic", board = Color3.fromRGB(38, 84, 58), boardMaterial = Enum.Material.Slate,
		frame = Color3.fromRGB(150, 104, 62), frameMaterial = Enum.Material.Wood,
		wall = Color3.fromRGB(236, 226, 200), trim = Color3.fromRGB(150, 104, 62), floor = Color3.fromRGB(176, 128, 82), floorMaterial = Enum.Material.WoodPlanks,
		chalk = Color3.fromRGB(246, 246, 238), glow = false, light = Color3.fromRGB(255, 244, 222),
	},
	blackboard = {
		name = "Blackboard", board = Color3.fromRGB(32, 34, 36), boardMaterial = Enum.Material.Slate,
		frame = Color3.fromRGB(92, 64, 44), frameMaterial = Enum.Material.Wood,
		wall = Color3.fromRGB(176, 190, 204), trim = Color3.fromRGB(70, 82, 96), floor = Color3.fromRGB(110, 112, 118), floorMaterial = Enum.Material.Concrete,
		chalk = Color3.fromRGB(250, 250, 250), glow = false, light = Color3.fromRGB(235, 242, 255),
	},
	neon = {
		name = "Neon night", board = Color3.fromRGB(14, 12, 24), boardMaterial = Enum.Material.SmoothPlastic,
		frame = Color3.fromRGB(255, 70, 200), frameMaterial = Enum.Material.Neon,
		wall = Color3.fromRGB(34, 24, 58), trim = Color3.fromRGB(70, 230, 255), floor = Color3.fromRGB(20, 18, 34), floorMaterial = Enum.Material.SmoothPlastic,
		chalk = Color3.fromRGB(110, 240, 255), glow = true, light = Color3.fromRGB(190, 120, 255),
	},
	sakura = {
		name = "Sakura", board = Color3.fromRGB(44, 88, 66), boardMaterial = Enum.Material.Slate,
		frame = Color3.fromRGB(120, 60, 52), frameMaterial = Enum.Material.Wood,
		wall = Color3.fromRGB(252, 226, 232), trim = Color3.fromRGB(196, 108, 128), floor = Color3.fromRGB(196, 150, 120), floorMaterial = Enum.Material.WoodPlanks,
		chalk = Color3.fromRGB(255, 196, 220), glow = false, light = Color3.fromRGB(255, 232, 240),
	},
	royal = {
		name = "Royal diamond", board = Color3.fromRGB(26, 40, 110), boardMaterial = Enum.Material.Slate,
		frame = Color3.fromRGB(224, 178, 72), frameMaterial = Enum.Material.Foil,
		wall = Color3.fromRGB(242, 240, 235), trim = Color3.fromRGB(224, 178, 72), floor = Color3.fromRGB(230, 226, 218), floorMaterial = Enum.Material.Marble,
		chalk = Color3.fromRGB(255, 220, 120), glow = false, light = Color3.fromRGB(255, 246, 228),
	},
} :: { [string]: Theme }
ChalkBoard.THEME_ORDER = { "classic", "blackboard", "neon", "sakura", "royal" }

function ChalkBoard.theme(name: string?): Theme
	return ChalkBoard.THEMES[name or "classic"] or ChalkBoard.THEMES.classic
end

return ChalkBoard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ClimbPath</string>
          <string name="Source"><![CDATA[--!strict
-- Diamond Climb's path: 1000 big gem platforms spiralling up round a crystal
-- pillar in the sky, far from the valley and the lobby (and hidden from them,
-- see ClimbView), with the diamond on the last one. Each platform is a little higher above the one before (from
-- 2 studs at the bottom to 3.5 at the top), always a short, easy hop away.
-- The spiral is wide (18 platforms a turn), so the turn above is over 30
-- studs overhead: clear of jumping heads and of the camera.
-- The server builds the tower from this and checks where players stand; each
-- player's game draws the climb's display and gift animations from it.
local GiftTier = require(script.Parent:WaitForChild("GiftTier"))

local ClimbPath = {}

ClimbPath.TOP = 1000 -- the platform with the diamond
ClimbPath.ORIGIN = Vector3.new(2600, 200, 0) -- the pillar's foot; platform 0 is the start island
ClimbPath.RADIUS = 48 -- studs from the pillar to the platforms' centres
ClimbPath.SPACING = 16.75 -- studs between neighbouring platforms' centres, along the spiral (18 a turn)
ClimbPath.RISE_LOW, ClimbPath.RISE_HIGH = 2, 3.5 -- studs each platform rises, at the bottom and the top
ClimbPath.THICKNESS = 1.2
ClimbPath.START_SIZE = 30 -- the start island's width
ClimbPath.MILESTONE = 100 -- every 100th platform is a bigger gold-rimmed one

-- Movement the climber can choose (the climb's sliders), and Roblox's defaults.
ClimbPath.SPEED = { min = 8, max = 40, default = 16 }
ClimbPath.JUMP = { min = 4, max = 15, default = 7.2 }

-- Gem colours, a new one every hundred platforms.
ClimbPath.GEMS = {
	Color3.fromRGB(96, 170, 255), -- sapphire
	Color3.fromRGB(70, 214, 140), -- emerald
	Color3.fromRGB(255, 92, 120), -- ruby
	Color3.fromRGB(176, 110, 255), -- amethyst
	Color3.fromRGB(255, 186, 72), -- topaz
	Color3.fromRGB(80, 226, 230), -- aquamarine
	Color3.fromRGB(255, 120, 200), -- pink sapphire
	Color3.fromRGB(150, 230, 90), -- peridot
	Color3.fromRGB(255, 140, 70), -- fire opal
	Color3.fromRGB(210, 236, 255), -- diamond
}

local function clampIndex(index: number): number
	return math.clamp(math.floor(index), 0, ClimbPath.TOP)
end

-- How far platform `index` rises above the one before it.
function ClimbPath.rise(index: number): number
	return ClimbPath.RISE_LOW + (ClimbPath.RISE_HIGH - ClimbPath.RISE_LOW) * index / ClimbPath.TOP
end

-- The height of platform `index`'s top above the start island's top.
function ClimbPath.height(index: number): number
	local n = clampIndex(index)
	-- The sum of rise(1) .. rise(n).
	return ClimbPath.RISE_LOW * n + (ClimbPath.RISE_HIGH - ClimbPath.RISE_LOW) * n * (n + 1) / (2 * ClimbPath.TOP)
end

-- The angle round the pillar of platform `index`.
function ClimbPath.angle(index: number): number
	return clampIndex(index) * ClimbPath.SPACING / ClimbPath.RADIUS
end

-- The middle of platform `index`'s top surface, in the world.
function ClimbPath.top(index: number): Vector3
	local n = clampIndex(index)
	local angle = ClimbPath.angle(n)
	local reach = if n == 0 then ClimbPath.RADIUS + 4 else ClimbPath.RADIUS
	return ClimbPath.ORIGIN + Vector3.new(math.cos(angle) * reach, ClimbPath.height(n), math.sin(angle) * reach)
end

-- How wide platform `index` is: 13.6 studs, 18.7 for every hundredth and
-- 23.8 for the top (1.7 times the first tower's 8, 11 and 14).
ClimbPath.SCALE = 1.7
function ClimbPath.size(index: number): number
	local n = clampIndex(index)
	if n == 0 then return ClimbPath.START_SIZE end
	if n == ClimbPath.TOP then return 14 * ClimbPath.SCALE end
	if n % ClimbPath.MILESTONE == 0 then return 11 * ClimbPath.SCALE end
	return 8 * ClimbPath.SCALE
end

-- Platform `index`'s gem colour.
function ClimbPath.colour(index: number): Color3
	local n = clampIndex(index)
	return ClimbPath.GEMS[math.min(#ClimbPath.GEMS, math.floor(math.max(n - 1, 0) / 100) + 1)]
end

-- Where a player stands on platform `index`, facing along the climb.
function ClimbPath.standFrame(index: number): CFrame
	local n = clampIndex(index)
	local at = ClimbPath.top(n) + Vector3.new(0, 3, 0)
	local ahead = ClimbPath.top(math.min(n + 1, ClimbPath.TOP))
	local look = Vector3.new(ahead.X - at.X, 0, ahead.Z - at.Z)
	if n == ClimbPath.TOP or look.Magnitude < 0.1 then
		look = Vector3.new(ClimbPath.ORIGIN.X - at.X, 0, ClimbPath.ORIGIN.Z - at.Z)
	end
	return CFrame.lookAt(at, at + look.Unit)
end

-- True if a point (a player's feet) is on platform `index`: over it and
-- standing on or just above its top. `slack` widens the check (the server
-- sees players a moment late).
function ClimbPath.isOn(index: number, feet: Vector3, slack: number?): boolean
	local extra = slack or 0
	local top = ClimbPath.top(index)
	local flat = Vector3.new(feet.X - top.X, 0, feet.Z - top.Z).Magnitude
	return flat <= ClimbPath.size(index) / 2 + 1.5 + extra and feet.Y >= top.Y - 1.5 - extra and feet.Y <= top.Y + 4 + extra * 2
end

-- The wall behind the start island. Gifts that push the climber back past
-- platform 0 hit it instead: every platform they would have gone below 0
-- takes 1 health off. At 0 health the wall breaks, the climber loses a win
-- and the wall is built again at full health.
ClimbPath.WALL = { min = 100, max = 1000000, default = 5000 }
ClimbPath.WALL_SIZE = Vector3.new(26, 14, 3) -- across, up, thick

-- The wall's middle, behind the start island (the way back, away from
-- platform 1), standing on the island's level.
function ClimbPath.wallFrame(): CFrame
	local start = ClimbPath.top(0)
	local ahead = ClimbPath.top(1) - start
	local back = -Vector3.new(ahead.X, 0, ahead.Z).Unit
	local at = start + back * (ClimbPath.START_SIZE / 2 + ClimbPath.WALL_SIZE.Z / 2 + 0.5) + Vector3.new(0, ClimbPath.WALL_SIZE.Y / 2, 0)
	return CFrame.lookAt(at, at - back)
end

-- How far past platform 0 a push from `from` by `move` goes (the wall's
-- damage), or 0.
function ClimbPath.wallDamage(from: number, move: number): number
	return math.max(0, -(math.floor(from) + math.floor(move)))
end

-- How many platforms a gift of `coins` (each) moves the climber, up or down.
-- It grows with the square root of the coins: a Rose is 2, 100 coins is 20,
-- a Galaxy 63 and 10,000 coins 200. `strength` is the streamer's multiplier.
function ClimbPath.giftPlatforms(coins: number, strength: number?): number
	return math.max(1, math.floor(2 * math.sqrt(math.max(coins, 1)) * (strength or 1) + 0.5))
end

-- The animation tier (1 to 6) for a gift of `coins` (each).
ClimbPath.tier = GiftTier.forCoins

-- How long each tier's send-up or send-down animation runs, in seconds.
ClimbPath.GIFT_SECONDS = { 1.6, 2.2, 3.4, 4.6, 6, 8 }
function ClimbPath.giftSeconds(coins: number): number
	return ClimbPath.GIFT_SECONDS[GiftTier.forCoins(math.max(1, coins))]
end

ClimbPath.UP_TITLES = { "BOUNCE PAD", "SPRING LAUNCH", "ROCKET BOOST", "DIAMOND CANNON", "STARLIGHT ASCENT", "GALACTIC ASCENSION" }
ClimbPath.DOWN_TITLES = { "BANANA SLIP", "SPIKE BOUNCE", "ANVIL SMASH", "METEOR STRIKE", "THUNDER HAMMER", "BLACK HOLE PLUNGE" }

return ClimbPath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Everything a streamer may want to tune. Values marked (live) can also be
-- changed in-game from the settings panel; the panel's values are saved.
local Config = {
	-- Stone -----------------------------------------------------------------
	StartingStone = 250000, -- (live) rocks in the mountain at the start of a round (one rock = one stone, max 1,500,000)
	GrowthMaxStone = 1500000, -- growth limit, or twice starting stone for larger starting mountains
	StonePerCoin = 100, -- (live) rocks removed per TikTok coin, for gifts without their own rule
	-- (live) Gift rules: gift name -> rocks removed per gift. Change them in the
	-- gift settings (press Y, then Open gift settings) while playing.
	GiftRules = {} :: { [string]: number },
	-- (live) Diamond Climb and Chalkboard Count's own gift rules: gift name ->
	-- platforms (or numbers) per gift, up if positive and down if negative.
	-- Gifts without a rule go up by their coins (a Rose 2, 100 coins 20, a
	-- Galaxy 63). Change them in the gift settings (press Y, then Open gift
	-- settings). A fresh save starts with these.
	ClimbGiftRules = {
		["ice cream cone"] = -2,
		["finger heart"] = -4,
		["perfume"] = -9,
		["confetti"] = -20,
		["money gun"] = -45,
		["tiktok universe"] = -374,
	} :: { [string]: number },
	ChalkGiftRules = {
		["ice cream cone"] = -2,
		["finger heart"] = -4,
		["perfume"] = -9,
		["confetti"] = -20,
		["money gun"] = -45,
		["tiktok universe"] = -374,
	} :: { [string]: number },
	StonePerLike = 2, -- (live)
	StonePerFollow = 500, -- (live)
	StonePerShare = 300, -- (live)

	-- The diamond -----------------------------------------------------------
	HoldSeconds = 15, -- real seconds the diamond must be held to win
	HoldCountFrom = 10, -- the number the on-screen countdown starts at
	HoldSlowdown = 0.6, -- 0 = steady countdown, 1 = slows down a lot near the end
	WinScreenSeconds = 4,

	-- The diamond bird -------------------------------------------------------
	-- It flies round the mountain every 5 to 7½ minutes. Clicking it doubles
	-- every gift (blasting or adding stone) for BirdBoostSeconds.
	BirdMinSeconds = 300,
	BirdMaxSeconds = 450,
	BirdBoostSeconds = 30,
	BirdMultiplier = 2,

	-- Win counter defaults (all live) ----------------------------------------
	WinTitle = "WINS",
	WinGoal = 0, -- 0 hides the goal ("WINS: 3" instead of "WINS: 3/10")
	WinTextColor = "#FFFFFF",
	WinBackgroundColor = "#2B2140",

	-- Rocks -----------------------------------------------------------------------
	BlockSize = 0.4, -- diggable cell size in studs; each visible rock fills one cell, sloped towards open air
	DigPerSecond = 100, -- rocks dug per second while the dig button is held
	-- The dig sound. Empty plays the built-in chip. To use any sound you like,
	-- find one in Studio's Toolbox (Audio, e.g. "rock hit" or "pickaxe") or
	-- your uploads, copy its asset id and put it here, e.g. "1234567890".
	DigSoundId = "",
	DigSoundVolume = 0.5,
	-- Holding Shift (or the left stick, or the Run button on a phone) moves
	-- this many times faster, everywhere (see the client's Sprint).
	SprintMultiplier = 1.5,

	-- Map themes and the haystack skin for Robux (the sidebar's Themes).
	-- Alpine and the stone skin are free; each of these is a game pass: make
	-- it in the Creator Dashboard (your game, then Monetization, then Passes),
	-- set its price there, and put its id here. One left at 0 is free.
	ThemePasses = {
		sakura = 0,
		farm = 0,
		desert = 0,
		haunted = 0,
		hay = 0, -- the Hay & needle skin
	} :: { [string]: number },

	-- Single player: whoever plays is the streamer, so every player gets the Y
	-- panel, test gifts and gift settings (with their keys). Set to false for a game where others
	-- join; then only the owner and Admins can.
	SinglePlayer = true,
	-- Extra Roblox user ids allowed to change settings (the owner always can).
	Admins = {} :: { number },
}

return Config

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DiamondShape</string>
          <string name="Source"><![CDATA[--!strict
-- An eight-sided brilliant-cut gem, made from native triangular facets.
-- Light crown, deeper blue pavilion and a bright table give it the familiar
-- diamond silhouette against any background, including the open sky.
--
-- The haystack skin (see Skin) swaps the gem for a needle: a slim steel shaft
-- with a sharp point, an open eye and a red thread, lying at a slant. A root
-- part's "GemKind" attribute ("diamond" or "needle") says which it shows.
local DiamondShape = {}

-- `shape` is the part shape: a triangular facet (the default, a WedgePart),
-- or "Block", "Cylinder" (along X) or "Ball".
export type Facet = { offset: CFrame, size: Vector3, colour: Color3, material: Enum.Material, shape: string? }

local THICKNESS = 0.006

local STEEL = Color3.fromRGB(206, 212, 220)
local THREAD = Color3.fromRGB(214, 40, 52)

-- A needle about 1.3 x `scale` studs long, slanting through its centre.
local function needle(scale: number): { Facet }
	local list: { Facet } = {}
	local along = Vector3.new(math.sin(math.rad(50)), math.cos(math.rad(50)), 0)
	local across = Vector3.new(0, 0, 1)
	local side = along:Cross(across).Unit
	local function rod(name: string, from: number, to: number, width: number, colour: Color3, material: Enum.Material, shift: Vector3?)
		local centre = along * ((from + to) / 2) + (shift or Vector3.zero)
		table.insert(list, {
			offset = CFrame.fromMatrix(centre * scale, along, side),
			size = Vector3.new(to - from, width, width) * scale,
			colour = colour,
			material = material,
			shape = name,
		})
	end
	-- The shaft, then a point that narrows in steps.
	rod("Cylinder", -0.34, 0.46, 0.09, STEEL, Enum.Material.Metal)
	rod("Cylinder", -0.5, -0.33, 0.06, STEEL, Enum.Material.Metal)
	rod("Cylinder", -0.62, -0.49, 0.032, STEEL, Enum.Material.Metal)
	-- A bright glint runs down the shaft, so the needle catches the eye.
	rod("Block", -0.3, 0.3, 0.022, Color3.fromRGB(240, 250, 255), Enum.Material.Neon, side * 0.04)
	-- The eye: two flat prongs either side of a slot, joined by a rounded head.
	for _, offset in { -0.032, 0.032 } do
		rod("Block", 0.45, 0.63, 0.026, STEEL, Enum.Material.Metal, side * offset)
	end
	table.insert(list, {
		offset = CFrame.new(along * 0.63 * scale),
		size = Vector3.one * 0.09 * scale,
		colour = STEEL,
		material = Enum.Material.Metal,
		shape = "Ball",
	})
	-- A red thread through the eye, trailing down in a loose loop.
	local eye = along * 0.55
	local points = { eye, eye + Vector3.new(0.16, -0.22, 0.08), eye + Vector3.new(0.3, -0.5, 0.12), eye + Vector3.new(0.42, -0.62, 0.02) }
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local direction = (b - a).Unit
		local up = if math.abs(direction.Y) > 0.99 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
		table.insert(list, {
			offset = CFrame.fromMatrix((a + b) / 2 * scale, direction, direction:Cross(up):Cross(direction).Unit),
			size = Vector3.new((b - a).Magnitude + 0.02, 0.026, 0.026) * scale,
			colour = THREAD,
			material = Enum.Material.Fabric,
			shape = "Cylinder",
		})
	end
	return list
end

-- Facet layout for a gem whose bounding size is `scale` studs, relative to its
-- centre. `kind` is "diamond" (the default) or "needle".
function DiamondShape.facets(scale: number, kind: string?): { Facet }
	if kind == "needle" then return needle(scale) end
	local list: { Facet } = {}
	local function triangle(a: Vector3, b: Vector3, c: Vector3, colour: Color3, material: Enum.Material)
		local ab, ac, bc = b - a, c - a, c - b
		if ab.Magnitude > ac.Magnitude and ab.Magnitude > bc.Magnitude then c, a = a, c
		elseif ac.Magnitude > bc.Magnitude then a, b = b, a end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		for _, spec in { { (a + b) / 2, right, back, math.abs(ab:Dot(back)) }, { (a + c) / 2, -right, -back, math.abs(ac:Dot(back)) } } do
			if spec[4] < 0.0001 then continue end
			table.insert(list, {
				offset = CFrame.fromMatrix(spec[1] * scale, spec[2], up, spec[3]),
				size = Vector3.new(THICKNESS, height, spec[4]) * scale,
				colour = colour,
				material = material,
			})
		end
	end
	for i = 0, 7 do
		local a, b = i * math.pi / 4, (i + 1) * math.pi / 4
		local rimA = Vector3.new(math.cos(a) * 0.5, 0.08, math.sin(a) * 0.5)
		local rimB = Vector3.new(math.cos(b) * 0.5, 0.08, math.sin(b) * 0.5)
		local topA = Vector3.new(math.cos(a) * 0.26, 0.34, math.sin(a) * 0.26)
		local topB = Vector3.new(math.cos(b) * 0.26, 0.34, math.sin(b) * 0.26)
		local alternate = i % 2
		-- Pavilion: the long point underneath, in deeper blues.
		triangle(Vector3.new(0, -0.55, 0), rimA, rimB, Color3.fromRGB(62 + alternate * 34, 150 + alternate * 30, 232 + alternate * 12), Enum.Material.SmoothPlastic)
		-- Crown: pale, alternating facets catch the light.
		triangle(rimA, topA, topB, Color3.fromRGB(175 + alternate * 45, 232 + alternate * 16, 255), Enum.Material.SmoothPlastic)
		triangle(rimA, topB, rimB, Color3.fromRGB(140 + alternate * 40, 214 + alternate * 20, 252), Enum.Material.SmoothPlastic)
		-- Table: the flat top glints.
		triangle(Vector3.new(0, 0.34, 0), topB, topA, Color3.fromRGB(215, 248, 255), Enum.Material.Neon)
	end
	return list
end

local function facetPart(facet: Facet): Part
	local face = Instance.new(if facet.shape == nil then "WedgePart" else "Part") :: any
	if facet.shape == "Cylinder" then face.Shape = Enum.PartType.Cylinder
	elseif facet.shape == "Ball" then face.Shape = Enum.PartType.Ball end
	face.Name = "Facet"
	face.Size = facet.size
	face.Color = facet.colour
	face.Material = facet.material
	face.Reflectance = if facet.material == Enum.Material.Neon or facet.material == Enum.Material.Fabric then 0 else 0.3
	face.CanCollide = false
	face.CanQuery = false
	face.CanTouch = false
	face.Massless = true
	face.CastShadow = false
	return face
end

-- Welds visible facets to an invisible root part (the server's world gem).
-- The root must already be in the workspace so the welds keep these offsets.
function DiamondShape.attach(root: BasePart)
	root.Transparency = 1
	root.Reflectance = 0
	root.Material = Enum.Material.SmoothPlastic
	local facets = Instance.new("Folder")
	facets.Name = "Facets"
	facets.Parent = root
	local kind = root:GetAttribute("GemKind")
	for _, facet in DiamondShape.facets(root.Size.X, if type(kind) == "string" then kind else nil) do
		local face = facetPart(facet)
		face.CFrame = root.CFrame * facet.offset
		face.Parent = facets
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = face
		weld.Parent = face
	end
end

-- An unwelded, anchored gem for local effects. Move it with DiamondShape.place:
-- welds made while a part is outside the workspace keep stale offsets, which
-- left the old held gem's facets behind at the world origin.
export type Gem = { model: Model, parts: { BasePart }, offsets: { CFrame }, frames: { CFrame } }

function DiamondShape.build(size: number, name: string, kind: string?): Gem
	local model = Instance.new("Model")
	model.Name = name
	local parts: { BasePart }, offsets: { CFrame }, frames: { CFrame } = {}, {}, {}
	for _, facet in DiamondShape.facets(size, kind) do
		local face = facetPart(facet)
		face.Anchored = true
		face.Parent = model
		table.insert(parts, face)
		table.insert(offsets, facet.offset)
		table.insert(frames, facet.offset)
	end
	return { model = model, parts = parts, offsets = offsets, frames = frames }
end

-- Moves every facet of a built gem in one engine call.
function DiamondShape.place(gem: Gem, frame: CFrame)
	local frames = gem.frames
	for index, offset in gem.offsets do
		frames[index] = frame * offset
	end
	workspace:BulkMoveTo(gem.parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Facets are independent welded parts; resizing only the invisible root does
-- not resize the visible gem. Rebuild them only when its size actually changes.
function DiamondShape.resize(root: BasePart, size: Vector3)
	if root.Size == size then return end
	local visible = root:GetAttribute("GemVisible") == true
	local facets = root:FindFirstChild("Facets")
	if facets then facets:Destroy() end
	root.Size = size
	DiamondShape.attach(root)
	root:SetAttribute("GemVisible", nil)
	DiamondShape.visible(root, visible)
end

-- Switches a world gem between the diamond and the needle, keeping its size
-- and whether it shows.
function DiamondShape.setKind(root: BasePart, kind: string)
	if (root:GetAttribute("GemKind") or "diamond") == kind then return end
	root:SetAttribute("GemKind", kind)
	local visible = root:GetAttribute("GemVisible") == true
	local facets = root:FindFirstChild("Facets")
	if facets then facets:Destroy() end
	DiamondShape.attach(root)
	root:SetAttribute("GemVisible", nil)
	DiamondShape.visible(root, visible)
end

function DiamondShape.visible(root: BasePart, visible: boolean)
	if root:GetAttribute("GemVisible") == visible then return end
	root:SetAttribute("GemVisible", visible)
	root.Transparency = 1
	local facets = root:FindFirstChild("Facets")
	if facets == nil then return end
	for _, face in facets:GetChildren() do
		(face :: BasePart).Transparency = if visible then 0 else 1
	end
end

return DiamondShape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
local Format = {}

-- 250000 -> "250,000"
function Format.commas(n: number): string
	local whole = math.floor(math.abs(n) + 0.5)
	local digits = tostring(whole)
	local out = ""
	while #digits > 3 do
		out = "," .. string.sub(digits, -3) .. out
		digits = string.sub(digits, 1, -4)
	end
	return (if n < 0 and whole > 0 then "-" else "") .. digits .. out
end

-- 83.46 -> "1:23.5"; an hour or more -> "1:02:03.0"
function Format.duration(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	local hours = tenths // 36000
	local minutes = (tenths // 600) % 60
	local secs = (tenths % 600) / 10
	if hours > 0 then
		return string.format("%d:%02d:%04.1f", hours, minutes, secs)
	end
	return string.format("%d:%04.1f", minutes, secs)
end

-- "#FF8800" or "FF8800" -> 255, 136, 0 (nil if it is not a colour)
function Format.parseHex(text: string): (number?, number?, number?)
	local hex = string.match(string.upper(text), "^%s*#?(%x%x%x%x%x%x)%s*$")
	if hex == nil then
		return nil, nil, nil
	end
	return tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16)
end

-- The win counter text: "WINS: 3" or "WINS: 3/10" when a goal is set.
function Format.wins(title: string, wins: number, goal: number): string
	local label = if title == "" then "" else title .. ": "
	if goal > 0 then
		return label .. tostring(wins) .. "/" .. tostring(goal)
	end
	return label .. tostring(wins)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">GiftCatalogue</string>
          <string name="Source"><![CDATA[--!strict
-- TikTok LIVE gifts, their coin prices and an emoji for each, for the
-- full-screen gift settings (GiftMenu). TikTok's own gift pictures are its
-- artwork and can't be put in a Roblox game, so each gift has an emoji
-- instead. TikTok changes its gifts and prices now and then, and some differ
-- by country, so the streamer can change any gift's coins or add a gift that
-- is missing from the menu; those are kept as the "CustomGifts" of their save.
-- GiftCatalogue.ICON is the emoji for a gift that has none.
local GiftCatalogue = {}

GiftCatalogue.ICON = "🎁"

export type Gift = { name: string, coins: number, icon: string? }

GiftCatalogue.GIFTS = {
	{ name = "Rose", coins = 1, icon = "🌹" },
