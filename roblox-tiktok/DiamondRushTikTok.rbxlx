      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Everything a streamer may want to tune. Values marked (live) can also be
-- changed in-game from the settings panel; the panel's values are saved.
local Config = {
	-- Stone -----------------------------------------------------------------
	StartingStone = 250000, -- (live) rocks in the mountain at the start of a round (one rock = one stone, max 1,500,000)
	GrowthMaxStone = 1500000, -- growth limit, or twice starting stone for larger starting mountains
	StonePerCoin = 100, -- (live) rocks removed per TikTok coin, for gifts without their own rule
	-- (live) Gift rules: gift name -> rocks removed per gift. Change them in the
	-- settings panel (press Y) while playing.
	GiftRules = {} :: { [string]: number },
	StonePerLike = 2, -- (live)
	StonePerFollow = 500, -- (live)
	StonePerShare = 300, -- (live)

	-- The diamond -----------------------------------------------------------
	HoldSeconds = 15, -- real seconds the diamond must be held to win
	HoldCountFrom = 10, -- the number the on-screen countdown starts at
	HoldSlowdown = 0.6, -- 0 = steady countdown, 1 = slows down a lot near the end
	WinScreenSeconds = 4,

	-- Win counter defaults (all live) ----------------------------------------
	WinTitle = "WINS",
	WinGoal = 0, -- 0 hides the goal ("WINS: 3" instead of "WINS: 3/10")
	WinTextColor = "#FFFFFF",
	WinBackgroundColor = "#2B2140",

	-- Rocks -----------------------------------------------------------------------
	BlockSize = 0.4, -- diggable cell size in studs; irregular rock chips overlap its edges
	DigPerSecond = 100, -- rocks dug per second while the dig button is held

	-- TikTok ------------------------------------------------------------------
	BridgeUrls = { "http://localhost:8787", "http://127.0.0.1:8787" }, -- the bridge app (Roblox Studio)
	MessagingTopic = "DiamondRushTikTok", -- Open Cloud topic (published games)

	-- Extra Roblox user ids allowed to change settings (the owner always can).
	Admins = {} :: { number },
}

return Config

]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">DiamondShape</string>
          <string name="Source"><![CDATA[--!strict
-- An eight-sided brilliant-cut gem, made from native triangular facets.
local DiamondShape = {}
function DiamondShape.attach(root: BasePart)
	root.Transparency = 1
	root.Reflectance = 0
	root.Material = Enum.Material.SmoothPlastic
	local scale = root.Size.X
	local facets = Instance.new("Folder")
	facets.Name = "Facets"
	facets.Parent = root
	local function triangle(a: Vector3, b: Vector3, c: Vector3, shade: number)
		local ab, ac, bc = b - a, c - a, c - b
		if ab.Magnitude > ac.Magnitude and ab.Magnitude > bc.Magnitude then c, a = a, c
		elseif ac.Magnitude > bc.Magnitude then a, b = b, a end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		for _, spec in { { (a + b) / 2, right, back, math.abs(ab:Dot(back)) }, { (a + c) / 2, -right, -back, math.abs(ac:Dot(back)) } } do
			if spec[4] < 0.0001 then continue end
			local face = Instance.new("WedgePart")
			face.Name = "Facet"
			face.Size = Vector3.new(0.005, height, spec[4]) * scale
			face.CFrame = root.CFrame * CFrame.fromMatrix(spec[1] * scale, spec[2], up, spec[3])
			face.Color = Color3.fromRGB(100 + shade * 100, 195 + shade * 50, 245)
			face.Material = Enum.Material.Glass
			face.Reflectance = 0.18
			face.Transparency = 0.08
			face.CanCollide = false
			face.CanQuery = false
			face.CanTouch = false
			face.Massless = true
			face.CastShadow = false
			face.Parent = facets
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = face
			weld.Parent = face
		end
	end
	for i = 0, 7 do
		local a, b = i * math.pi / 4, (i + 1) * math.pi / 4
		local rimA = Vector3.new(math.cos(a) * 0.5, 0.08, math.sin(a) * 0.5)
		local rimB = Vector3.new(math.cos(b) * 0.5, 0.08, math.sin(b) * 0.5)
		local topA = Vector3.new(math.cos(a) * 0.26, 0.34, math.sin(a) * 0.26)
		local topB = Vector3.new(math.cos(b) * 0.26, 0.34, math.sin(b) * 0.26)
		triangle(Vector3.new(0, -0.55, 0), rimA, rimB, 0.25 + i % 3 * 0.2)
		triangle(rimA, topA, topB, 0.55 + i % 2 * 0.3)
		triangle(rimA, topB, rimB, 0.4 + i % 3 * 0.2)
		triangle(Vector3.new(0, 0.34, 0), topB, topA, 0.9)
	end
end
-- Facets are independent welded parts; resizing only the invisible root does
-- not resize the visible gem. Rebuild them only when its size actually changes.
function DiamondShape.resize(root: BasePart, size: Vector3)
	if root.Size == size then return end
	local visible = root:GetAttribute("GemVisible") == true
	local facets = root:FindFirstChild("Facets")
	if facets then facets:Destroy() end
	root.Size = size
	DiamondShape.attach(root)
	root:SetAttribute("GemVisible", nil)
	DiamondShape.visible(root, visible)
end
function DiamondShape.visible(root: BasePart, visible: boolean)
	if root:GetAttribute("GemVisible") == visible then return end
	root:SetAttribute("GemVisible", visible)
	root.Transparency = 1
	for _, face in root.Facets:GetChildren() do
		(face :: BasePart).Transparency = if visible then 0.08 else 1
	end
end
return DiamondShape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
local Format = {}

-- 250000 -> "250,000"
function Format.commas(n: number): string
	local whole = math.floor(math.abs(n) + 0.5)
	local digits = tostring(whole)
	local out = ""
	while #digits > 3 do
		out = "," .. string.sub(digits, -3) .. out
		digits = string.sub(digits, 1, -4)
	end
	return (if n < 0 and whole > 0 then "-" else "") .. digits .. out
end

-- 83.46 -> "1:23.5"; an hour or more -> "1:02:03.0"
function Format.duration(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	local hours = tenths // 36000
	local minutes = (tenths // 600) % 60
	local secs = (tenths % 600) / 10
	if hours > 0 then
		return string.format("%d:%02d:%04.1f", hours, minutes, secs)
	end
	return string.format("%d:%04.1f", minutes, secs)
end

-- "#FF8800" or "FF8800" -> 255, 136, 0 (nil if it is not a colour)
function Format.parseHex(text: string): (number?, number?, number?)
	local hex = string.match(string.upper(text), "^%s*#?(%x%x%x%x%x%x)%s*$")
	if hex == nil then
		return nil, nil, nil
	end
	return tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16)
end

-- The win counter text: "WINS: 3" or "WINS: 3/10" when a goal is set.
function Format.wins(title: string, wins: number, goal: number): string
	local label = if title == "" then "" else title .. ": "
	if goal > 0 then
		return label .. tostring(wins) .. "/" .. tostring(goal)
	end
	return label .. tostring(wins)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GiftTier</string>
          <string name="Source"><![CDATA[--!strict
local GiftTier = {}
function GiftTier.forCoins(coins: number): number
	if coins >= 10000 then return 6 end
	if coins >= 1000 then return 5 end
	if coins >= 500 then return 4 end
	if coins >= 100 then return 3 end
	if coins >= 10 then return 2 end
	return 1
end
return GiftTier
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">HoldTimer</string>
          <string name="Source"><![CDATA[--!strict
-- The diamond must be held for HoldSeconds of real time, but the screen counts
-- down from HoldCountFrom (10). The count runs quickly at first and slows near
-- the end, so the last numbers hang on screen for longer.
local HoldTimer = {}

-- How much of the on-screen countdown has passed after a fraction p of the real
-- hold time. slowdown 0 is linear; 1 is a full ease-out (4x slower at the end).
function HoldTimer.progress(p: number, slowdown: number): number
	p = math.clamp(p, 0, 1)
	slowdown = math.clamp(slowdown, 0, 1)
	return (1 - slowdown) * p + slowdown * (1 - (1 - p) * (1 - p))
end

-- The whole number to show after `elapsed` real seconds: countFrom at the start,
-- never below 1 until the hold is complete, then 0.
function HoldTimer.display(elapsed: number, holdSeconds: number, countFrom: number, slowdown: number): number
	if elapsed >= holdSeconds then
		return 0
	end
	local shown = countFrom * (1 - HoldTimer.progress(elapsed / holdSeconds, slowdown))
	return math.max(1, math.ceil(shown - 1e-9))
end

return HoldTimer
]]></string>
        </Properties>
      </Item>
