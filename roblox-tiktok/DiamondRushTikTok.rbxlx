-- The settings panel is hidden: the owner presses Y to open or close it.
local isAdmin = false
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= Enum.KeyCode.Y or not isAdmin then
		return
	end
	panel.Visible = not panel.Visible
	if panel.Visible then
		refreshPanelFields()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)
RunService.RenderStepped:Connect(function()
	-- First person locks the mouse; free it while the panel is open.
	if panel.Visible then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end)

local function refreshAdmin()
	isAdmin = player:GetAttribute("DiamondRushAdmin") == true
	if not isAdmin then
		panel.Visible = false
	end
end
player:GetAttributeChangedSignal("DiamondRushAdmin"):Connect(refreshAdmin)
refreshAdmin()

-- Live updates ---------------------------------------------------------------------------
local function refreshWins()
	winsBox.Visible = attr("ShowWins", true)
	winsBox.Text = Format.wins(attr("WinTitle", "WINS"), attr("Wins", 0), attr("WinGoal", 0))
	winsBox.TextColor3 = hexColor(attr("WinTextColor", "#FFFFFF"), WHITE)
	winsBox.BackgroundColor3 = hexColor(attr("WinBackgroundColor", "#2B2140"), PANEL)
	winsStroke.Color = winsBox.TextColor3:Lerp(GOLD, 0.6)
	if panel.Visible then
		refreshPanelFields()
	end
end
for _, name in { "Wins", "WinTitle", "WinGoal", "WinTextColor", "WinBackgroundColor", "ShowWins", "NextStartingStone" } do
	State:GetAttributeChangedSignal(name):Connect(refreshWins)
end
refreshWins()

local shownStone = attr("Stone", Config.StartingStone)
local lastCount = -1

RunService.RenderStepped:Connect(function(dt: number)
	-- The stone number rolls towards its new value instead of jumping.
	local stone = attr("Stone", 0)
	local starting = math.max(1, attr("MountainTotal", attr("StartingStone", Config.StartingStone)))
	shownStone += (stone - shownStone) * math.min(1, dt * 10)
	if math.abs(stone - shownStone) < 1 then
		shownStone = stone
	end
	setText(stoneValue, Format.commas(shownStone))
	barFill.Size = UDim2.fromScale(math.clamp(shownStone / starting, 0, 1), 1)

	local phase = attr("Phase", "Digging")
	-- The hold counter takes the top-centre slot; the hand and gem stay unobscured.
	stoneBox.Visible = phase ~= "Holding"
	timerLabel.Visible = phase ~= "Holding"
	local now = workspace:GetServerTimeNow()
	local roundStart = attr("RoundStart", now)
	setText(timerLabel, "⏱ " .. Format.duration(if phase == "Won" then attr("LastTime", 0) else now - roundStart))
	setText(status, "TikTok: " .. tostring(attr("TikTok", "")) .. (if attr("GiftProcessing", false) then " · Updating mountain (" .. tostring(attr("GiftQueueLength", 0)) .. " queued)" else ""))

	if phase == "Holding" then
		local elapsed = now - attr("HoldStart", now)
		local shown = HoldTimer.display(elapsed, Config.HoldSeconds, Config.HoldCountFrom, Config.HoldSlowdown)
		countdown.Visible = true
		setText(countHolder, "💎 " .. tostring(attr("Holder", "")) .. " — HOLD IT!")
		setText(countNumber, tostring(shown))
		if shown ~= lastCount then
			lastCount = shown
			countNumber.TextColor3 = WHITE:Lerp(GOLD, 1 - shown / Config.HoldCountFrom)
			countScale.Scale = 1.35
			TweenService:Create(countScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
		banner.Visible = false
	else
		countdown.Visible = false
		lastCount = -1
		banner.Visible = phase == "Revealed" or phase == "Rebuilding"
		if phase == "Rebuilding" then
			banner.Text = "REBUILDING THE MOUNTAIN"
			banner.TextTransparency = 0
		end
		if phase == "Revealed" then
			banner.Text = "DIAMOND UNCOVERED — FIND IT AND CLICK IT"
			banner.TextTransparency = 0.25 + 0.25 * math.sin(now * 6)
		end
	end
end)

Notify.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "giftEffect" and type(data) == "table" then
		GiftEffects.play(data)
	elseif kind == "feed" and type(data) == "table" then
		addFeed(tostring(data.text), tonumber(data.stone) or 0, tostring(data.kind))
	elseif kind == "win" and type(data) == "table" then
		showWin(data)
	elseif kind == "dropped" and type(data) == "table" and data.name ~= "" then
		addFeed(tostring(data.name) .. (if data.reason == "rebuild" then " — rebuild cancelled the countdown! Pick up the diamond again." else " dropped the diamond!"), 0, "drop")
	end
end)

-- Digging: hold the dig button (left mouse / touch) and your hands tear
-- through the rock you aim at, about DigPerSecond rocks a second.
-- A separate full-viewport layer keeps the dot aligned with the camera ray,
-- regardless of the HUD inset or the screen's aspect ratio.
local aimGui = make("ScreenGui", {
	Name = "DiamondRushAim",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 5,
}, player:WaitForChild("PlayerGui"))
local aimDot = make("Frame", {
	Name = "Dot",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(5, 5),
	BackgroundColor3 = WHITE,
	BorderSizePixel = 0,
	Active = false,
}, aimGui)
rounded(aimDot, 5)
outline(aimDot, 1)
local rockOutline = make("Highlight", {
	Name = "AimedRock",
	FillTransparency = 1,
	OutlineColor = WHITE,
	OutlineTransparency = 0.15,
	DepthMode = Enum.HighlightDepthMode.Occluded,
	Enabled = false,
}, workspace)
local aimTarget: BasePart? = nil
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
RunService:BindToRenderStep("DiamondRushAim", Enum.RenderPriority.Camera.Value + 3, function()
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local phase = attr("Phase", "Digging")
	local active = camera ~= nil and humanoid ~= nil and humanoid.Health > 0
		and not panel.Visible and phase ~= "Won" and phase ~= "Rebuilding"
		and not (phase == "Holding" and attr("HolderUserId", 0) == player.UserId)
	aimDot.Visible = active
	UserInputService.MouseIconEnabled = not active
	aimTarget = nil
	if active and camera then
		aimParams.FilterDescendantsInstances = if character then { character } else {}
		local viewport = camera.ViewportSize
		local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
		local result = workspace:Raycast(ray.Origin, ray.Direction * 500, aimParams)
		if result then aimTarget = result.Instance end
	end
	local target = aimTarget
	local stone = target ~= nil and view:keyForPart(target) ~= nil
	local adornee = if stone then target else nil
	if rockOutline.Adornee ~= adornee then rockOutline.Adornee = adornee end
	rockOutline.Enabled = stone
end)
local digging = false
local digClock = 0
local function isDigInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if not processed and isDigInput(input) then
		-- A fresh click on the diamond goes to its ClickDetector, never to digging.
		if aimTarget == workspace:FindFirstChild("Diamond") then
			digging = false
			return
		end
		digging = true
		digClock = 1
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if isDigInput(input) then
		digging = false
	end
end)
UserInputService.WindowFocusReleased:Connect(function()
	digging = false
end)
RunService.Heartbeat:Connect(function(dt: number)
	local phase = attr("Phase", "Digging")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local target = aimTarget
	local allowed = digging and not panel.Visible and phase ~= "Won" and phase ~= "Rebuilding"
		and not (phase == "Holding" and attr("HolderUserId", 0) == player.UserId)
	local key = if target then view:keyForPart(target) else nil
	local onRock = allowed and root ~= nil and root:IsA("BasePart")
		and key ~= nil and (root.Position - (target :: BasePart).Position).Magnitude <= 16
	player:SetAttribute("DiggingRock", onRock == true)
	if not allowed then
		return
	end
	digClock += dt
	if digClock < 0.1 then
		return
	end
	digClock = 0
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool == nil and onRock then
		Request:FireServer("mine", key)
	end
end)

-- Catalogue keybinds work in-game for the streamer, outside text entry and menus.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isAdmin or panel.Visible or UserInputService:GetFocusedTextBox() then return end
	local ok, bindings = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), attr("GiftBindings", "{}"))
	if not ok or type(bindings) ~= "table" then return end
	local binding = bindings[input.KeyCode.Name]
	if binding then send("testGift", { coins = binding.coins, count = 1, name = binding.gift }) end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">FirstPerson</string>
            <string name="Source"><![CDATA[--!strict
-- First-person view with two hands in front of the camera (like the PC game).
-- The hands follow the camera, bob while walking and alternate reaching,
-- curling around stone and raking rubble back while digging.
--
-- Picking up the diamond: the gem flies from where it lay into your right hand,
-- the hand lifts it up and the camera eases upward so the gem is framed
-- against the sky and the mountain. The server freezes the holder in place
-- until a rebuild cancels the hold or the countdown is won.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FirstPerson = {}

local SKIN_FALLBACK = Color3.fromRGB(234, 184, 146)
local SLEEVE = Color3.fromRGB(70, 82, 70)
local GEM_SIZE = 1.05 -- studs across: about a third of the screen in the raised hand
local FLY_SECONDS = 0.45 -- world position to hand
local CAMERA_EASE = 0.7
local HOLD_PITCH = math.rad(28) -- looking up, but still showing the peak below the gem

local function part(name: string, size: Vector3, colour: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = colour
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local function smooth(value: number): number
	value = math.clamp(value, 0, 1)
	return value * value * (3 - 2 * value)
end

function FirstPerson.start()
	local player = Players.LocalPlayer
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5

	local rig = Instance.new("Model")
	rig.Name = "FirstPersonHands"
	local hands = {}
	local rigParts: { BasePart } = {}
	local skinParts: { BasePart } = {}
	local function add(p: BasePart, skin: boolean)
		p.Parent = rig
		table.insert(rigParts, p)
		if skin then table.insert(skinParts, p) end
	end
	for _, side in { -1, 1 } do
		local sleeve = part("Sleeve", Vector3.new(0.42, 0.42, 1.5), SLEEVE, Enum.Material.Fabric)
		local hand = part("Hand", Vector3.new(0.4, 0.34, 0.45), SKIN_FALLBACK)
		add(sleeve, false)
		add(hand, true)
		local fingers = {}
		for _ = 1, 4 do
			local finger = part("FingerBase", Vector3.new(0.075, 0.11, 0.14), SKIN_FALLBACK)
			local tip = part("FingerTip", Vector3.new(0.072, 0.10, 0.13), SKIN_FALLBACK)
			add(finger, true)
			add(tip, true)
			table.insert(fingers, { base = finger, tip = tip })
		end
		local thumb = part("Thumb", Vector3.new(0.12, 0.16, 0.21), SKIN_FALLBACK)
		add(thumb, true)
		table.insert(hands, { side = side, sleeve = sleeve, hand = hand, fingers = fingers, thumb = thumb })
	end
	local rigFrames: { CFrame } = table.create(#rigParts, CFrame.identity)
	local skinColour = SKIN_FALLBACK

	local State = ReplicatedStorage:WaitForChild("DiamondRushState")
	local DiamondShape = require(ReplicatedStorage:WaitForChild("DiamondRush"):WaitForChild("DiamondShape"))
	local worldDiamond = workspace:WaitForChild("Diamond") :: BasePart

	-- The server rebuilds the world gem's facets whenever it changes size, so
	-- the facet folder is looked up again rather than cached.
	local hiddenFacets: Instance? = nil
	local function hideWorld(hidden: boolean)
		local facets = worldDiamond:FindFirstChild("Facets")
		local target = if hidden then facets else nil
		if target == hiddenFacets then return end
		if hiddenFacets and hiddenFacets.Parent then
			for _, face in hiddenFacets:GetChildren() do
				if face:IsA("BasePart") then face.LocalTransparencyModifier = 0 end
			end
		end
		hiddenFacets = target
		if target then
			for _, face in target:GetChildren() do
				if face:IsA("BasePart") then face.LocalTransparencyModifier = 1 end
			end
		end
	end

	-- The held gem: anchored facets moved in one call each frame (no welds).
	local gem = DiamondShape.build(GEM_SIZE, "HeldDiamond")
	local core = part("Core", Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 1, 1))
	core.Transparency = 1
	core.Parent = gem.model
	local shine = Instance.new("PointLight")
	shine.Color = Color3.fromRGB(160, 235, 255)
	shine.Range = 6
	shine.Brightness = 1.2
	shine.Shadows = false
	shine.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(160, 235, 255))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new(0, 1)
	sparkles.Lifetime = NumberRange.new(0.3, 0.7)
	sparkles.Rate = 10
	sparkles.Speed = NumberRange.new(0.3, 0.9)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LockedToPart = true
	sparkles.Enabled = false
	sparkles.Parent = core
	local outline = Instance.new("Highlight")
	outline.FillTransparency = 1
	outline.OutlineColor = Color3.new(1, 1, 1)
	outline.OutlineTransparency = 0.35
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = gem.model

	local hiddenArms: { [BasePart]: number } = {}
	local armNames = { RightHand = true, RightLowerArm = true, RightUpperArm = true, LeftHand = true, LeftLowerArm = true, LeftUpperArm = true, ["Right Arm"] = true, ["Left Arm"] = true }
	local function restoreArms()
		for limb, transparency in hiddenArms do
			if limb.Parent then limb.LocalTransparencyModifier = transparency end
		end
		table.clear(hiddenArms)
	end
	player.CharacterRemoving:Connect(restoreArms)

	local function isHolding(): boolean
		-- Display names are not unique: only the actual holder gets this view.
		return State:GetAttribute("Phase") == "Holding" and State:GetAttribute("HolderUserId") == player.UserId
	end

	-- Hold state, set when the hold begins.
	local holdClock = 0
	local holdYaw = 0
	local startPitch = 0
	local gemFrom: CFrame? = nil
	local lastWorldGem: CFrame? = nil
	local wasHolding = false

	-- While you hold the diamond the camera is locked, easing up towards it.
	RunService:BindToRenderStep("DiamondRushHoldCamera", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local holding = isHolding() and humanoid ~= nil and humanoid.Health > 0
		if not holding and State:GetAttribute("Phase") == "Revealed" then
			lastWorldGem = worldDiamond.CFrame
		end
		if holding and camera and head and head:IsA("BasePart") then
			if not wasHolding then
				wasHolding = true
				holdClock = os.clock()
				local look = camera.CFrame.LookVector
				holdYaw = math.atan2(-look.X, -look.Z)
				startPitch = math.asin(math.clamp(look.Y, -1, 1))
				gemFrom = lastWorldGem
				camera.CameraType = Enum.CameraType.Scriptable
			end
			local t = os.clock() - holdClock
			local pitch = startPitch + (HOLD_PITCH - startPitch) * smooth(t / CAMERA_EASE)
			local breathe = math.sin(t * 1.6) * math.rad(0.6)
			camera.CFrame = CFrame.new(head.Position + Vector3.new(0, 0.6, 0))
				* CFrame.Angles(0, holdYaw + breathe * 0.5, 0) * CFrame.Angles(pitch + breathe, 0, 0)
		elseif wasHolding then
			wasHolding = false
			gemFrom = nil
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
		end
	end)

	local cycle = 1
	local punchSide = 1
	local bob = 0
	local digBlend = 0
	local lift = 0 -- 0 = digging pose, 1 = diamond raised high

	-- Position the hands after both Roblox's camera and our hold-camera update.
	RunService:BindToRenderStep("DiamondRushHands", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if camera == nil or character == nil or humanoid == nil or humanoid.Health <= 0 then
			rig.Parent = nil
			gem.model.Parent = nil
			sparkles.Enabled = false
			restoreArms()
			hideWorld(false)
			return
		end
		rig.Parent = camera
		-- Scriptable cameras bypass the normal first-person transparency controller.
		-- Hide the real limbs so they cannot float above the custom hands.
		for _, limb in character:GetChildren() do
			if limb:IsA("BasePart") and armNames[limb.Name] and hiddenArms[limb] == nil then
				hiddenArms[limb] = limb.LocalTransparencyModifier
				limb.LocalTransparencyModifier = 1
			end
		end
		-- Skin tone from the avatar, applied only when it changes.
		local colours = character:FindFirstChildOfClass("BodyColors")
		local skin = if colours then colours.RightArmColor3 else SKIN_FALLBACK
		if skin ~= skinColour then
			skinColour = skin
			for _, p in skinParts do p.Color = skin end
		end
		local tool = character:FindFirstChildOfClass("Tool")
		-- Keep any third-person tool from obscuring the local hand and diamond.
		if tool then
			for _, d in tool:GetDescendants() do
				if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 end
			end
		end
		local moving = humanoid.MoveDirection.Magnitude > 0.1 and humanoid.FloorMaterial ~= Enum.Material.Air
		bob += dt * (if moving then 9 else 2)
		local sway = if moving then 0.05 else 0.015
		local holding = isHolding()
		local digging = player:GetAttribute("DiggingRock") == true and not holding
		digBlend += ((if digging then 1 else 0) - digBlend) * (1 - math.exp(-dt * 14))
		if holding then
			cycle = 1
		elseif cycle < 1 then
			cycle = math.min(1, cycle + dt / 0.46)
		elseif digging then
			cycle = 0
			punchSide = -punchSide
		end
		-- Wind up, reach quickly into the stone, rake down, then pull the rubble back.
		local wind = smooth(cycle / 0.18) * (1 - smooth((cycle - 0.18) / 0.16))
		local reach = smooth((cycle - 0.18) / 0.20)
		local pull = smooth((cycle - 0.48) / 0.52)
		local extension = reach * (1 - pull) * digBlend
		local scoop = math.sin(math.clamp((cycle - 0.38) / 0.62, 0, 1) * math.pi) * digBlend
		lift += ((if holding then 1 else 0) - lift) * (1 - math.exp(-dt * 8))
		hideWorld(holding)
		local worldLight = worldDiamond:FindFirstChildOfClass("PointLight")
		if worldLight then worldLight.Enabled = State:GetAttribute("Phase") == "Holding" and not holding end
		if holding then
			-- The world gem's sparkles are for everyone else watching.
			local worldSparkles = worldDiamond:FindFirstChild("HeldSparkles", true)
			if worldSparkles and worldSparkles:IsA("ParticleEmitter") then worldSparkles.Enabled = false end
		end

		local index = 0
		local function put(frame: CFrame)
			index += 1
			rigFrames[index] = frame
		end
		local base = camera.CFrame * CFrame.new(math.sin(bob * 0.5) * sway * 0.4, -0.92 + math.sin(bob) * sway * 0.45, -1.6)
		local palm = CFrame.identity
		for _, h in hands do
			local active = if h.side == punchSide then 1 - lift else 0
			local hit = extension * active
			local rake = scoop * active
			local prep = wind * digBlend * active
			local support = if h.side ~= punchSide then extension * (1 - lift) else 0
			local normal = base * CFrame.new(h.side * (0.58 - hit * 0.24), hit * 0.27 - rake * 0.19 + support * 0.05, -hit * 0.62 + prep * 0.12 + rake * 0.16 - support * 0.08)
				* CFrame.Angles(math.rad(10 - hit * 22 + rake * 34 + prep * 12), math.rad(-h.side * (8 + hit * 12)), math.rad(h.side * (rake * 16 - hit * 8)))
			-- The right hand rises to the right of centre, under the countdown;
			-- the left hand drops out of view.
			local raised = if h.side == 1
				then camera.CFrame * CFrame.new(0.5, -0.62, -1.7) * CFrame.Angles(math.rad(34), math.rad(-12), math.rad(-6))
				else normal * CFrame.new(0, -1.6, 0.3)
			local arm = normal:Lerp(raised, smooth(lift))
			put(arm * CFrame.new(0, 0, 0.46))
			local handFrame = arm * CFrame.new(0, 0, -0.35)
			put(handFrame)
			if h.side == 1 then palm = handFrame end
			local grip = math.max(if h.side == 1 then lift else 0, rake * 0.85)
			for fingerIndex, _ in h.fingers do
				local curl = grip * (0.85 + fingerIndex * 0.035)
				local joint = handFrame * CFrame.new((fingerIndex - 2.5) * 0.09, 0, -0.20) * CFrame.Angles(math.rad(-46 * curl), 0, 0)
				put(joint * CFrame.new(0, 0, -0.07))
				put(joint * CFrame.new(0, 0, -0.14) * CFrame.Angles(math.rad(-54 * curl), 0, 0) * CFrame.new(0, 0, -0.065))
			end
			put(handFrame * CFrame.new(-h.side * 0.17, 0.015, -0.08)
				* CFrame.Angles(math.rad(-35 * grip), math.rad(h.side * 20 * grip), math.rad(h.side * (15 + 35 * grip))))
		end
		workspace:BulkMoveTo(rigParts, rigFrames, Enum.BulkMoveMode.FireCFrameChanged)

		if holding then
			local t = os.clock() - holdClock
			-- Upright in the world, crown tipped towards you, slowly turning.
			local spin = t * 0.9
			local seat = palm * CFrame.new(0, 0.17 + GEM_SIZE * 0.6, -0.05)
			local target = CFrame.new(seat.Position) * CFrame.Angles(0, holdYaw, 0) * CFrame.Angles(math.rad(20), 0, 0) * CFrame.Angles(0, spin, 0)
			local frame = target
			local from = gemFrom
			if from and t < FLY_SECONDS then
				-- Arc from where the gem lay into the hand.
				local u = smooth(t / FLY_SECONDS)
				frame = from:Lerp(target, u) + Vector3.new(0, math.sin(u * math.pi) * 0.9, 0)
			end
			gem.model.Parent = camera
			DiamondShape.place(gem, frame)
			core.CFrame = frame
			-- A bright flash as it lands, settling to a steady glow.
			shine.Brightness = 1.2 + 3 * math.max(0, 1 - math.abs(t - FLY_SECONDS) / 0.35)
			sparkles.Enabled = t >= FLY_SECONDS * 0.5
		else
			sparkles.Enabled = false
			gem.model.Parent = nil
		end
	end)
end

return FirstPerson
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">GiftEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Local, non-physical spectacle. At most two sequences / 80 parts at once.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("DiamondRush")
local GiftTier = require(Shared:WaitForChild("GiftTier"))
local Format = require(Shared:WaitForChild("Format"))
local GiftEffects = {}
local colours = { Color3.fromRGB(255, 208, 112), Color3.fromRGB(255, 137, 55), Color3.fromRGB(110, 245, 255), Color3.fromRGB(70, 230, 255), Color3.fromRGB(156, 90, 255), Color3.fromRGB(255, 225, 120) }
local titles = { "SPARK BURST", "SHOCKWAVE", "DIAMOND FRACTURE", "ORBITAL STRIKE", "GALAXY COLLAPSE", "COSMIC BURST" }
local active: { { folder: Folder, tier: number } } = {}
local label: TextLabel? = nil
local bannerSerial = 0
local bannerTier = 0
local bannerTween: Tween? = nil
local random = Random.new()

function GiftEffects.start(parent: Instance)
	local gui = Instance.new("ScreenGui")
	gui.Name = "GiftEffects"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 4
	gui.Parent = parent
	local text = Instance.new("TextLabel")
	text.AnchorPoint = Vector2.new(0.5, 0.5)
	text.Position = UDim2.fromScale(0.5, 0.30)
	text.Size = UDim2.new(0.82, 0, 0, 64)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextStrokeTransparency = 0.35
	text.TextTransparency = 1
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 12
	limit.MaxTextSize = 23
	limit.Parent = text
	text.Parent = gui
	label = text
end

function GiftEffects.play(data: any)
	if typeof(data.position) ~= "Vector3" or type(data.coins) ~= "number" then return end
	local tier = GiftTier.forCoins(data.coins)
	for i = #active, 1, -1 do
		if active[i].folder.Parent == nil then table.remove(active, i) end
	end
	if #active >= 2 then
		local weakest = 1
		for i, entry in active do
			if entry.tier < active[weakest].tier then weakest = i end
		end
		if active[weakest].tier > tier then return end
		table.remove(active, weakest).folder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GiftBurst"
	folder.Parent = workspace
	table.insert(active, { folder = folder, tier = tier })
	Debris:AddItem(folder, 8)
	local colour = if data.adding then Color3.fromRGB(90, 235, 170) else colours[tier]
	local centre: Vector3 = data.position
	local allocated = 0
	local function piece(shape: Enum.PartType, size: Vector3, frame: CFrame): Part?
		if folder.Parent == nil or allocated >= 40 then return nil end
		allocated += 1
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = frame
		p.Color = colour
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Parent = folder
		p.Destroying:Connect(function() allocated -= 1 end)
		return p
	end
	local function animate(p: Part, seconds: number, goal: any)
		TweenService:Create(p, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
		Debris:AddItem(p, seconds + 0.05)
	end
	-- Each moving element owns one connection, released immediately on cleanup.
	local function motion(p: Part, duration: number, update: (number) -> ())
		local elapsed = 0
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function(dt)
			elapsed += dt
			local t = math.clamp(elapsed / duration, 0, 1)
			update(t)
			if t >= 1 then p:Destroy() end
		end)
		p.Destroying:Connect(function()
			if connection then connection:Disconnect(); connection = nil end
		end)
	end
	local function ring(at: Vector3, radius: number, delay: number)
		task.delay(delay, function()
			local root = piece(Enum.PartType.Block, Vector3.one * 0.1, CFrame.new(at + Vector3.new(0, 0.15, 0)))
			if root == nil then return end
			root.Transparency = 1
			local points = {}
			local beams = {}
			for i = 1, 16 do
				local point = Instance.new("Attachment")
				point.Parent = root
				table.insert(points, point)
			end
			for i, point in points do
				local beam = Instance.new("Beam")
				beam.Attachment0 = point
				beam.Attachment1 = points[i % #points + 1]
				beam.FaceCamera = true
				beam.Color = ColorSequence.new(colour:Lerp(Color3.new(1, 1, 1), 0.4))
				beam.LightEmission = 1
				beam.Parent = root
				table.insert(beams, beam)
			end
			for i, point in points do
				local angle = i * math.pi * 2 / #points
				local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
				point.Position = direction * 0.5
				TweenService:Create(point, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = direction * radius }):Play()
			end
			for _, beam in beams do
				beam.Width0 = 0.3 + tier * 0.08
				beam.Width1 = beam.Width0
				TweenService:Create(beam, TweenInfo.new(0.8), { Width0 = 0, Width1 = 0 }):Play()
			end
			Debris:AddItem(root, 0.85)
		end)
	end
	local function pulse(at: Vector3, radius: number)
		ring(at, radius, 0)
		if tier >= 2 then ring(at, radius * 0.8, 0.13) end
		local orb = piece(Enum.PartType.Ball, Vector3.one, CFrame.new(at))
		if orb then
			orb.Color = Color3.new(1, 0.94, 0.8)
			orb.Transparency = 0.35
			animate(orb, 0.3, { Size = Vector3.one * math.min(radius, 10), Transparency = 1 })
		end
		for i = 1, 4 + tier do
			local angle = i * math.pi * 2 / (4 + tier)
			local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local shard = piece(Enum.PartType.Block, Vector3.new(0.16, 0.16, 0.55), CFrame.new(at))
			if shard then
				local height = random:NextNumber(2, 6 + tier)
				local spin = random:NextNumber(-8, 8)
				motion(shard, random:NextNumber(0.6, 1.1), function(t)
					local position = at + direction * radius * t + Vector3.new(0, height * 4 * t * (1 - t), 0)
					shard.CFrame = CFrame.new(position) * CFrame.Angles(t * spin, angle, t * spin * 0.7)
					shard.Transparency = t * t
				end)
			end
		end
	end
	local function meteor(at: Vector3, delay: number)
		task.delay(delay, function()
			if folder.Parent == nil then return end
			local approach = random:NextNumber(0, math.pi * 2)
			local start = at + Vector3.new(math.cos(approach) * 28, 40 + tier * 5, math.sin(approach) * 28)
			local control = start:Lerp(at, 0.45) + Vector3.new(0, 14, 0)
			local rock = piece(Enum.PartType.Ball, Vector3.one * (1 + tier * 0.35), CFrame.new(start))
			if rock == nil then return end
			rock.Color = colour:Lerp(Color3.new(1, 1, 1), 0.6)
			local light = Instance.new("PointLight")
			light.Color = colour
			light.Range = 16
			light.Brightness = 2
			light.Parent = rock
			local a = Instance.new("Attachment")
			a.Position = Vector3.new(-0.6, 0, 0)
			a.Parent = rock
			local b = Instance.new("Attachment")
			b.Position = Vector3.new(0.6, 0, 0)
			b.Parent = rock
			local trail = Instance.new("Trail")
			trail.Attachment0 = a
			trail.Attachment1 = b
			trail.Color = ColorSequence.new(Color3.new(1, 0.97, 0.8), colour)
			trail.Lifetime = 0.45
			trail.LightEmission = 1
			trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
			trail.Transparency = NumberSequence.new(0.05, 1)
			trail.Parent = rock
			ring(at, 2.5, 0) -- Brief impact warning, followed by the main shockwave.
			motion(rock, 0.9, function(t)
				local u = t * t
				local position = start * (1 - u) ^ 2 + control * (2 * (1 - u) * u) + at * u ^ 2
				rock.CFrame = CFrame.lookAt(position, at + Vector3.new(0, -0.01, 0))
				if t >= 1 then pulse(at, 5 + tier * 2) end
			end)
		end)
	end
	local function diamondFracture()
		-- Project each jagged crack onto actual remaining stone, never the gem
		-- or characters. The server has already applied the gift's damage.
		local mountain = workspace:FindFirstChild("Mountain", true)
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Include
		rayParams.FilterDescendantsInstances = if mountain then { mountain } else {}
		local function surface(at: Vector3): Vector3?
			if mountain == nil then return nil end
			local hit = workspace:Raycast(at + Vector3.new(0, 100, 0), Vector3.new(0, -220, 0), rayParams)
			return if hit then hit.Position + hit.Normal * 0.09 else nil
		end
		local origin = surface(centre) or centre
		local cracks: { Part } = {}
		local fragmentOrigins: { Vector3 } = {}
		local radius = 7 + math.clamp((data.coins - 100) / 399, 0, 1) * 5
		local rotation = random:NextNumber(0, math.pi * 2)
		for branch = 1, 6 do
			local angle = rotation + branch * math.pi / 3
			local previous: Vector3? = surface(centre)
			for step = 1, 4 do
				local bend = angle + random:NextNumber(-0.28, 0.28)
				local target = surface(centre + Vector3.new(math.cos(bend), 0, math.sin(bend)) * radius * step / 4)
				local start = previous
				previous = target
				if target then table.insert(fragmentOrigins, target) end
				if start == nil or target == nil then continue end
				local delta = target - start
				-- Do not draw glowing bridges across an excavated cliff or gap.
				if delta.Magnitude < 0.05 or delta.Magnitude > 7 then continue end
				local finish = target
				task.delay((step - 1) * 0.14 + branch * 0.018, function()
					local frame = CFrame.lookAt(start, finish)
					local crack = piece(Enum.PartType.Block, Vector3.new(0.09, 0.09, 0.05), frame)
					if crack == nil then return end
					table.insert(cracks, crack)
					TweenService:Create(crack, TweenInfo.new(0.16, Enum.EasingStyle.Linear), {
						Size = Vector3.new(0.10, 0.10, delta.Magnitude),
						CFrame = frame * CFrame.new(0, 0, -delta.Magnitude / 2),
					}):Play()
				end)
			end
		end
		task.delay(0.9, function()
			if folder.Parent == nil then return end
			for _, crack in cracks do
				if crack.Parent then
					crack.Color = Color3.new(1, 1, 1)
					animate(crack, 0.18, { Transparency = 1, Size = crack.Size + Vector3.new(0.12, 0.12, 0) })
				end
			end
			ring(origin, radius * 1.6, 0)
			local flash = piece(Enum.PartType.Ball, Vector3.one, CFrame.new(origin))
			if flash then
				flash.Transparency = 0.5
				animate(flash, 0.35, { Size = Vector3.one * radius, Transparency = 1 })
			end
			-- 24 cracks + 12 fragments + flash + ring remain below 40 parts.
			for i = 1, 12 do
				local at = if #fragmentOrigins > 0 then fragmentOrigins[(i - 1) % #fragmentOrigins + 1] else origin
				local angle = rotation + i * math.pi / 6
				local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
				local shard = piece(Enum.PartType.Block, Vector3.new(0.15, 0.35, 0.15), CFrame.new(at))
				if shard == nil then continue end
				local height = random:NextNumber(2, 5)
				local spin = random:NextNumber(4, 10)
				motion(shard, random:NextNumber(0.7, 1.2), function(t)
					shard.CFrame = CFrame.new(at + direction * radius * 0.6 * t + Vector3.new(0, height * 4 * t * (1 - t), 0)) * CFrame.Angles(t * spin, angle, t * spin)
					shard.Color = colour:Lerp(Color3.new(1, 1, 1), (math.sin(t * 35 + i) + 1) * 0.5)
					shard.Transparency = math.clamp(t * t + 0.15 * math.sin(t * 45 + i), 0, 1)
				end)
			end
		end)
	end
	if data.adding then
		ring(centre, 8 + tier * 2, 0)
	elseif tier == 3 then
		diamondFracture()
	elseif tier == 4 then
		-- 500 coins: six descending energy lances close in on one impact point.
		for i = 1, 6 do
			task.delay((i - 1) * 0.12, function()
				if folder.Parent == nil then return end
				local angle = i * math.pi / 3
				local at = centre + Vector3.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
				local lance = piece(Enum.PartType.Cylinder, Vector3.new(45, 0.35, 0.35), CFrame.new(at + Vector3.new(0, 23, 0)) * CFrame.Angles(0, 0, math.pi / 2))
				if lance then animate(lance, 0.45, { Size = Vector3.new(45, 2.5, 2.5), Transparency = 1 }) end
				ring(at, 9, 0.08)
			end)
		end
		task.delay(0.85, function() if folder.Parent then pulse(centre, 26) end end)
	elseif tier <= 2 then
		pulse(centre, 3 + tier * 3)
		for _ = 1, tier * 3 do
			local spark = piece(Enum.PartType.Ball, Vector3.one * 0.22, CFrame.new(centre))
			if spark then animate(spark, random:NextNumber(0.5, 1.2), { Position = centre + Vector3.new(random:NextNumber(-7, 7), random:NextNumber(3, 12), random:NextNumber(-7, 7)), Transparency = 1 }) end
		end
	else
		local count = if tier >= 5 then 4 else 5
		for i = 1, count do
			local offset = if i == 1 then Vector3.zero else Vector3.new(random:NextNumber(-10, 10), 0, random:NextNumber(-10, 10))
			meteor(centre + offset, (i - 1) * 0.3)
		end
		if tier >= 5 then
			task.delay(2.3, function()
				if folder.Parent == nil then return end
				pulse(centre, 32)
				local pillar = piece(Enum.PartType.Cylinder, Vector3.new(65, 0.5, 0.5), CFrame.new(centre + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.pi / 2))
				if pillar then
					pillar.Transparency = 0.35
					animate(pillar, 1.5, { Size = Vector3.new(80, 5, 5), Transparency = 1 })
				end
				ring(centre + Vector3.new(0, 3, 0), 24, 0.18)
				ring(centre + Vector3.new(0, 6, 0), 18, 0.32)
			end)
		end
	end
	local text = label
	if text and tier >= bannerTier then
		bannerTier = tier
		bannerSerial += 1
		local serial = bannerSerial
		text.Text = (if data.adding then (if data.blocks == 0 then "MOUNTAIN FULL" elseif data.blocks == nil then "REBUILDING" else "ROCKS RESTORED") else titles[tier]) .. "  •  " .. Format.commas(data.coins) .. " COINS\n" .. tostring(data.name or "Someone") .. " sent " .. tostring(data.gift or "a gift")
		text.TextColor3 = colour
		if bannerTween then bannerTween:Cancel() end
		text.TextTransparency = 0
		text.TextStrokeTransparency = 0.35
		text.Position = UDim2.fromScale(0.5, 0.32)
		TweenService:Create(text, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.30) }):Play()
		task.delay(1.5 + tier * 0.35, function()
			if serial ~= bannerSerial then return end
			bannerTween = TweenService:Create(text, TweenInfo.new(0.45), { TextTransparency = 1, TextStrokeTransparency = 1 })
			bannerTween:Play()
			bannerTier = 0
		end)
	end
end
return GiftEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">MountainView</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- Draws the mountain on this client. The server only keeps the rock grid and
-- sends a snapshot plus compact change lists (MountainCodec). Every exposed cell
-- gets exactly one local part; shapes slope towards open air (RockStyle).
--
-- Local parts cost no replication, collide with the local character and block
-- clicks, exactly like server parts did. All work runs in one worker with a
-- per-frame time budget, so a 100,000-rock gift opens over a few frames
-- instead of freezing the game.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Grid = require(Shared:WaitForChild("Grid"))
local RockStyle = require(Shared:WaitForChild("RockStyle"))
local Codec = require(Shared:WaitForChild("MountainCodec"))
local PartShapes = require(Shared:WaitForChild("PartShapes"))

local MountainView = {}
MountainView.__index = MountainView

local SPAN, LAYER = Grid.SPAN, Grid.LAYER
local STEPS = Grid.STEPS
local SIDES = { 1, -1, SPAN, -SPAN }
local hasBit = Grid.hasBit
local POOL_LIMIT = 3000
local DEBRIS_PER_CHANGE = 4
local DEBRIS_LIMIT = 24
local REBUILD_LAYERS = 16
local REBUILD_STEP = 0.15 -- seconds between rebuild layers, matching the server

local MATERIALS: { Enum.Material } = {}
for index, layer in RockStyle.LAYERS do
	MATERIALS[index] = (Enum.Material :: any)[layer.material]
end

-- Rotation for every shape code, so a wedge slopes down towards open air and a
-- corner wedge turns its tall corner away from both open sides.
local function shapeRotations(): { [number]: CFrame }
	local rotations: { [number]: CFrame } = { [RockStyle.BLOCK] = CFrame.identity }
	for code, direction in RockStyle.DIRECTIONS do
		rotations[code] = if code <= 5
			then PartShapes.wedgeToward(Vector3.new(direction[1], 0, direction[2]))
			else PartShapes.cornerToward(-direction[1], -direction[2])
	end
	return rotations
end

export type View = typeof(setmetatable({} :: {
	folder: Folder?,
	grid: Grid.Grid?,
	parts: { [number]: BasePart },
	codes: { [number]: number },
	keys: { [BasePart]: number },
	tops: { [number]: number },
	pool: { { BasePart } },
	templates: { BasePart },
	rotations: { [number]: CFrame },
	queue: { any },
	head: number,
	tail: number,
	round: number,
	height: number,
	blockSize: number,
	ready: boolean,
	meta: any,
	sliceStart: number,
	debris: { any },
	debrisConnection: RBXScriptConnection?,
	onRebuild: ((any) -> ())?,
	onRestore: ((any) -> ())?,
}, MountainView))

function MountainView.new(): View
	local self = setmetatable({
		folder = nil,
		grid = nil,
		parts = {},
		codes = {},
		keys = {},
		tops = {},
		pool = { {}, {}, {} },
		templates = {},
		rotations = shapeRotations(),
		queue = {},
		head = 1,
		tail = 0,
		round = 0,
		height = 1,
		blockSize = 0.4,
		ready = false,
		meta = nil,
		sliceStart = os.clock(),
		debris = {},
		debrisConnection = nil,
		onRebuild = nil,
		onRestore = nil,
	}, MountainView)
	return self
end

function MountainView._makeTemplates(self: View)
	local size = self.blockSize * 1.02 -- a hair of overlap hides seams between cells
	for kind, className in { "Part", "WedgePart", "CornerWedgePart" } do
		local part = Instance.new(className) :: BasePart
		part.Name = "Stone"
		part.Size = Vector3.new(size, size, size)
		part.Anchored = true
		part.CanCollide = true
		part.CanQuery = true
		part.CanTouch = false
		part.CastShadow = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		self.templates[kind] = part
		self.pool[kind] = {}
	end
end

-- Messages from the server, processed strictly in order.
function MountainView.push(self: View, kind: string, payload: any)
	self.tail += 1
	self.queue[self.tail] = { kind = kind, payload = payload }
end

function MountainView.pending(self: View): number
	return self.tail - self.head + 1
end

-- Yields once this frame's share of work is used up. A backlog earns a
-- slightly larger share so the mountain catches up quickly.
function MountainView._pace(self: View)
	local budget = if self:pending() > 2 or not self.ready then 0.006 else 0.004
	if os.clock() - self.sliceStart >= budget then
		task.wait()
		self.sliceStart = os.clock()
	end
end

function MountainView.start(self: View)
	task.spawn(function()
		while true do
			local message = self.queue[self.head]
			if message == nil then
				self.head, self.tail = 1, 0
				task.wait()
				self.sliceStart = os.clock()
			else
				self.queue[self.head] = nil
				self.head += 1
				local ok, problem = pcall(self._handle, self, message.kind, message.payload)
				if not ok then warn("[DiamondRush] mountain update failed: " .. tostring(problem)) end
			end
		end
	end)
end

function MountainView.keyForPart(self: View, part: Instance): number?
	return if part:IsA("BasePart") then self.keys[part] else nil
end

function MountainView.keyPosition(self: View, key: number): Vector3
	local column = key % LAYER
	local size = self.blockSize
	return Vector3.new((column % SPAN - 128) * size, (key // LAYER) * size + size / 2, (column // SPAN - 128) * size)
end

function MountainView._handle(self: View, kind: string, payload: any)
	if kind == "begin" then
		self:_begin(payload)
	elseif kind == "cells" and self.grid then
		local grid = self.grid :: Grid.Grid
		local count = 0
		Codec.decode(payload, function(key)
			grid.solid[key] = true
			count += 1
			if count % 2048 == 0 then self:_pace() end
		end)
	elseif kind == "tops" then
		Codec.decodePairs(payload, function(column, top) self.tops[column] = top end)
	elseif kind == "end" and self.grid then
		self:_finishSnapshot()
	elseif kind == "diff" and self.grid and self.ready and payload.round == self.round then
		self:_applyDiff(payload)
	end
end

function MountainView._begin(self: View, meta: any)
	-- Drop the previous mountain in one step; it is out of view immediately.
	local old = self.folder
	if old then
		old.Parent = nil
		task.defer(function() old:Destroy() end)
	end
	for _, entry in self.debris do entry.part:Destroy() end
	table.clear(self.debris)
	self.meta = meta
	self.round = meta.round
	self.height = math.max(1, meta.height)
	if meta.blockSize ~= self.blockSize or #self.templates == 0 then
		self.blockSize = meta.blockSize
		self:_makeTemplates()
	end
	self.ready = false
	self.parts, self.codes, self.keys, self.tops = {}, {}, {}, {}
	for kind in self.pool do self.pool[kind] = {} end
	local grid = Grid.blank()
	grid.sealed[meta.diamondKey] = true
	self.grid = grid
	local folder = Instance.new("Folder")
	folder.Name = "Mountain"
	folder.Parent = workspace
	self.folder = folder
end

function MountainView._finishSnapshot(self: View)
	local grid = self.grid :: Grid.Grid
	local exposed: { number } = {}
	local visited = 0
	grid:eachSolid(function(key)
		if grid:isExposed(key) then table.insert(exposed, key) end
		visited += 1
		if visited % 4096 == 0 then self:_pace() end
	end)
	local meta = self.meta
	if meta.animated then
		-- Rise from the base to the summit in waves, with flying stones.
		local layers: { { number } } = {}
		for wave = 1, REBUILD_LAYERS do layers[wave] = {} end
		for _, key in exposed do
			local wave = math.clamp(math.floor((key // LAYER) / self.height * REBUILD_LAYERS) + 1, 1, REBUILD_LAYERS)
			table.insert(layers[wave], key)
		end
		local samples = {}
		for wave, keys in layers do
			for i = 1, math.min(5, #keys) do
				local key = keys[math.max(1, math.floor(i * #keys / 5))]
				local shape = RockStyle.shape(grid, key)
				local _, r, g, b = RockStyle.look(key, self.tops[key % LAYER], self.height)
				table.insert(samples, {
					frame = CFrame.new(self:keyPosition(key)) * (self.rotations[shape] or CFrame.identity),
					size = self.templates[1].Size,
					colour = Color3.fromRGB(r, g, b),
					layer = wave,
				})
			end
		end
		if self.onRebuild then self.onRebuild({ stones = samples, start = meta.start }) end
		for wave, keys in layers do
			while workspace:GetServerTimeNow() < meta.start + wave * REBUILD_STEP do task.wait() end
			self.sliceStart = os.clock()
			for index, key in keys do
				self:_refresh(key)
				if index % 64 == 0 then self:_pace() end
			end
		end
	else
		for index, key in exposed do
			self:_refresh(key)
			if index % 64 == 0 then self:_pace() end
		end
	end
	self.ready = true
end

function MountainView._acquire(self: View, kind: number): BasePart
	local pool = self.pool[kind]
	local part = pool[#pool]
	if part then
		pool[#pool] = nil
		return part
	end
	return self.templates[kind]:Clone()
end

function MountainView._release(self: View, part: BasePart, kind: number)
	self.keys[part] = nil
	local pool = self.pool[kind]
	if #pool < POOL_LIMIT then
		part.Parent = nil
		table.insert(pool, part)
	else
		part:Destroy()
	end
end

-- Brings one cell's part in line with the grid: created, reshaped or removed.
function MountainView._refresh(self: View, key: number): BasePart?
	local grid = self.grid :: Grid.Grid
	local old = self.codes[key]
	if not (hasBit(grid.solidPages, key) and grid:isExposed(key)) then
		if old ~= nil then
			self.codes[key] = nil
			local part = self.parts[key]
			if part then
				self.parts[key] = nil
				self:_release(part, RockStyle.kind(old % 16))
			end
		end
		return nil
	end
	local shape = RockStyle.shape(grid, key)
	local layer, r, g, b = RockStyle.look(key, self.tops[key % LAYER], self.height)
	local code = shape + layer * 16
	if code == old then return nil end
	local kind = RockStyle.kind(shape)
	local part: BasePart? = self.parts[key]
	if part and (old == nil or RockStyle.kind(old % 16) ~= kind) then
		self:_release(part, RockStyle.kind((old or 0) % 16))
		part = nil
	end
	local fresh = part == nil
	if part == nil then
		local acquired = self:_acquire(kind)
		self.parts[key] = acquired
		self.keys[acquired] = key
		part = acquired
	end
	local stone = part :: BasePart
	stone.CFrame = CFrame.new(self:keyPosition(key)) * self.rotations[shape]
	stone.Material = MATERIALS[layer]
	stone.Color = Color3.fromRGB(r, g, b)
	if fresh then stone.Parent = self.folder end
	self.codes[key] = code
	return if fresh then stone else nil
end

function MountainView._applyDiff(self: View, diff: any)
	local grid = self.grid :: Grid.Grid
	local changed: { number } = {}
	local added: { number } = {}
	local flying: { BasePart } = {}
	local count = 0
	for _, chunk in diff.removed or {} do
		Codec.decode(chunk, function(key)
			if hasBit(grid.solidPages, key) then
				grid.solid[key] = nil
				table.insert(changed, key)
				local part = self.parts[key]
				if part and #flying < DEBRIS_PER_CHANGE and #self.debris + #flying < DEBRIS_LIMIT and diff.effect ~= nil then
					-- This rock flies off as rubble instead of vanishing.
					self.parts[key] = nil
					self.keys[part] = nil
					self.codes[key] = nil
					table.insert(flying, part)
				end
			end
			count += 1
			if count % 1024 == 0 then self:_pace() end
		end)
	end
	for _, chunk in diff.added or {} do
		Codec.decode(chunk, function(key)
			if not hasBit(grid.solidPages, key) then
				grid.solid[key] = true
				table.insert(changed, key)
				table.insert(added, key)
				local column = key % LAYER
				local y = key // LAYER
				if (self.tops[column] or -1) < y then self.tops[column] = y end
			end
			count += 1
			if count % 1024 == 0 then self:_pace() end
		end)
	end
	if #flying > 0 then self:_throwDebris(flying, diff.at) end
	self:_reconcile(changed)
	if diff.effect == "restore" and self.onRestore and #added > 0 then
		local stones = {}
		for _, key in added do
			local part = self.parts[key]
			if part and part.Parent then
				table.insert(stones, { frame = part.CFrame, size = part.Size, colour = part.Color, part = part })
				if #stones >= 24 then break end
			end
		end
		self.onRestore({ stones = stones })
	end
end

-- Re-checks every cell whose shape can depend on the changed cells: the cells
-- themselves, their neighbours (air or exposure changed) and the side
-- neighbours of those (whose shapes test neighbour exposure).
function MountainView._reconcile(self: View, changed: { number })
	local grid = self.grid :: Grid.Grid
	local pages = grid.solidPages
	local marks, markPages = Grid.cellMap()
	local list: { number } = {}
	local function touch(key: number)
		if not hasBit(markPages, key) then
			marks[key] = true
			table.insert(list, key)
		end
	end
	for index, key in changed do
		touch(key)
		for _, step in STEPS do
			local neighbour = key + step
			if neighbour >= 0 and hasBit(pages, neighbour) then
				touch(neighbour)
				for _, side in SIDES do
					local beside = neighbour + side
					if hasBit(pages, beside) then touch(beside) end
				end
			end
		end
		if index % 256 == 0 then self:_pace() end
	end
	for index, key in list do
		self:_refresh(key)
		if index % 64 == 0 then self:_pace() end
	end
end

-- A few removed rocks tumble away from the blast or dig, then return to the pool.
function MountainView._throwDebris(self: View, parts: { BasePart }, at: Vector3?)
	local random = Random.new()
	for _, part in parts do
		part.CanCollide = false
		part.CanQuery = false
		part.CastShadow = false
		local away = if at then part.Position - at else Vector3.new(random:NextNumber(-1, 1), 0, random:NextNumber(-1, 1))
		if away.Magnitude < 0.05 then away = Vector3.new(random:NextNumber(-1, 1), 0.5, random:NextNumber(-1, 1)) end
		table.insert(self.debris, {
			part = part,
			kind = if part:IsA("CornerWedgePart") then 3 elseif part:IsA("WedgePart") then 2 else 1,
			velocity = away.Unit * random:NextNumber(8, 16) + Vector3.new(0, random:NextNumber(9, 16), 0),
			spin = Vector3.new(random:NextNumber(-9, 9), random:NextNumber(-9, 9), random:NextNumber(-9, 9)),
			age = 0,
		})
	end
	if self.debrisConnection then return end
	self.debrisConnection = RunService.RenderStepped:Connect(function(dt)
		for index = #self.debris, 1, -1 do
			local entry = self.debris[index]
			entry.age += dt
			entry.velocity += Vector3.new(0, -50 * dt, 0)
			local part = entry.part
			part.CFrame = (part.CFrame + entry.velocity * dt) * CFrame.Angles(entry.spin.X * dt, entry.spin.Y * dt, entry.spin.Z * dt)
			part.Transparency = math.clamp((entry.age - 0.55) / 0.35, 0, 1)
			if entry.age >= 0.9 then
				table.remove(self.debris, index)
				part.Transparency = 0
				part.CanCollide = true
				part.CanQuery = true
				part.CastShadow = true
				if part.Parent == self.folder then
					self:_release(part, entry.kind)
				else
					part:Destroy()
				end
			end
		end
		if #self.debris == 0 and self.debrisConnection then
			self.debrisConnection:Disconnect()
			self.debrisConnection = nil
		end
	end)
end

return MountainView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RebuildEffects</string>
            <string name="Source"><![CDATA[--!strict
-- A bounded stream of flying stones accompanies the server's layer reveal.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RebuildEffects = {}
local current: Folder? = nil
local connection: RBXScriptConnection? = nil
function RebuildEffects.play(data: any)
	if connection then connection:Disconnect(); connection = nil end
	if current then current:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "RebuildingStones"
	folder.Parent = workspace
	current = folder
	local tracks = {}
	for index, stone in data.stones do
		if index > 80 then break end
		local angle = index * 2.39996
		local destination = stone.frame.Position
		local start = destination + Vector3.new(math.cos(angle) * 10, -6, math.sin(angle) * 10)
		table.insert(tracks, { stone = stone, start = CFrame.new(start) * CFrame.Angles(angle, angle, 0), arrive = data.start + stone.layer * 0.15, part = nil, done = false })
	end
	connection = RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local done = 0
		for _, track in tracks do
			local t = (now - (track.arrive - 0.55)) / 0.55
			if t >= 1 then
				if track.part then track.part:Destroy(); track.part = nil end
				track.done = true
				done += 1
			elseif t >= 0 and not track.done then
				if track.part == nil then
					local p = Instance.new("WedgePart")
					p.Size = track.stone.size * 1.8
					p.Color = track.stone.colour
					p.Material = Enum.Material.Slate
					p.Anchored = true
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.CastShadow = false
					p.Parent = folder
					track.part = p
				end
				local eased = 1 - (1 - t) ^ 3
				track.part.CFrame = track.start:Lerp(track.stone.frame, eased) + Vector3.new(0, math.sin(t * math.pi) * 2, 0)
				track.part.Size = track.stone.size * (1 + 0.8 * (1 - eased))
				track.part.Transparency = math.max(0, 1 - t * 8)
			end
		end
		if done == #tracks then
			if connection then connection:Disconnect(); connection = nil end
			-- A short finishing glint travels upward from the completed peak.
			local peak = Vector3.zero
			for _, track in tracks do
				if track.stone.frame.Position.Y > peak.Y then peak = track.stone.frame.Position end
			end
			for i = 1, 12 do
				local p = Instance.new("Part")
				p.Size = Vector3.new(0.08, 0.08, 0.45)
				p.Anchored = true
				p.CanQuery = false
				p.CanCollide = false
				p.CanTouch = false
				p.Material = Enum.Material.Neon
				p.Color = Color3.fromRGB(170, 240, 255)
				p.Position = peak
				p.Parent = folder
				local angle = i * math.pi / 6
				TweenService:Create(p, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = peak + Vector3.new(math.cos(angle) * 5, 3, math.sin(angle) * 5), Transparency = 1 }):Play()
			end
			Debris:AddItem(folder, 0.7)
		end
	end)
end
local restorations: { () -> () } = {}
function RebuildEffects.restore(data: any)
	if #data.stones == 0 then return end
	if #restorations >= 2 then table.remove(restorations, 1)() end
	local folder = Instance.new("Folder")
	folder.Name = "RestoringRocks"
	folder.Parent = workspace
	local hidden = {}
	local function cleanup()
		for _, part in hidden do if part.Parent then part.LocalTransparencyModifier = 0 end end
		table.clear(hidden)
		folder:Destroy()
	end
	table.insert(restorations, cleanup)
	for i, stone in data.stones do
		if i > 24 then break end
		local p = Instance.new("WedgePart")
		p.Size = stone.size * 1.6
		p.Color = stone.colour
		p.Material = Enum.Material.Slate
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		local angle = i * 2.39996
		p.CFrame = stone.frame + Vector3.new(math.cos(angle) * 5, 6 + i % 3, math.sin(angle) * 5)
		p.Parent = folder
		if typeof(stone.part) == "Instance" and stone.part:IsA("BasePart") then
			stone.part.LocalTransparencyModifier = 1
			table.insert(hidden, stone.part)
		end
		TweenService:Create(p, TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, i * 0.012), { CFrame = stone.frame, Size = stone.size }):Play()
	end
	task.delay(1.05, function()
		local index = table.find(restorations, cleanup)
		if index then table.remove(restorations, index) end
		cleanup()
	end)
end

return RebuildEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="27">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
