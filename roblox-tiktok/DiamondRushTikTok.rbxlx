hideSwitch.Activated:Connect(function()
	local hidden = player:GetAttribute("HideButtons") ~= true
	-- Shown at once; the server keeps it for next time.
	player:SetAttribute("HideButtons", hidden)
	Request:FireServer("setHideButtons", hidden)
end)
-- Switches that hide a game's own card: Diamond Climb's speed and jump
-- sliders, Chalkboard Count's writing speed and themes. Remembered by the server.
local function cardSwitch(y: number, title: string, card: string, attribute: string)
	settingsText({ Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, -60, 0, 20), Font = FONT_MEDIUM, TextSize = 15, TextColor3 = WHITE, Text = title })
	local switch = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, y + 2),
		Size = UDim2.fromOffset(46, 26),
		BackgroundColor3 = BUTTON,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 16,
	}, settingsCard)
	rounded(switch, 13)
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 17,
	}, switch)
	rounded(knob, 10)
	local function refresh()
		local hidden = player:GetAttribute(attribute) == true
		switch.BackgroundColor3 = if hidden then SELECTED else BUTTON
		knob.Position = if hidden then UDim2.new(1, -23, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
	end
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
	refresh()
	switch.Activated:Connect(function()
		local hidden = player:GetAttribute(attribute) ~= true
		player:SetAttribute(attribute, hidden)
		Request:FireServer("setHideCard", { card = card, hidden = hidden })
	end)
end
cardSwitch(156, "Hide speed and jump", "climb", "HideClimbCard")
settingsText({ Position = UDim2.fromOffset(0, 178), Size = UDim2.new(1, -60, 0, 16), Font = FONT_MEDIUM, TextSize = 12, TextColor3 = MUTED, Text = "Diamond Climb's sliders" })
cardSwitch(206, "Hide writing speed", "chalk", "HideChalkCard")
settingsText({ Position = UDim2.fromOffset(0, 228), Size = UDim2.new(1, -60, 0, 16), Font = FONT_MEDIUM, TextSize = 12, TextColor3 = MUTED, Text = "Chalkboard Count's card" })
-- The win counter (the streamer's: it's the same for everyone watching).
local winsRowTitle = settingsText({ Position = UDim2.fromOffset(0, 258), Size = UDim2.new(1, -60, 0, 20), Font = FONT_MEDIUM, TextSize = 15, TextColor3 = WHITE, Text = "Hide the win counter" })
local winsRowHint = settingsText({ Position = UDim2.fromOffset(0, 280), Size = UDim2.new(1, -60, 0, 16), Font = FONT_MEDIUM, TextSize = 12, TextColor3 = MUTED, Text = "In every game" })
local winsSwitch = make("TextButton", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, 0, 0, 260),
	Size = UDim2.fromOffset(46, 26),
	BackgroundColor3 = BUTTON,
	AutoButtonColor = false,
	Text = "",
	ZIndex = 16,
}, settingsCard)
rounded(winsSwitch, 13)
local winsKnob = make("Frame", {
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 3, 0.5, 0),
	Size = UDim2.fromOffset(20, 20),
	BackgroundColor3 = WHITE,
	BorderSizePixel = 0,
	ZIndex = 17,
}, winsSwitch)
rounded(winsKnob, 10)
local function refreshWinsSwitch()
	local hidden = State:GetAttribute("ShowWins") == false
	winsSwitch.BackgroundColor3 = if hidden then SELECTED else BUTTON
	winsKnob.Position = if hidden then UDim2.new(1, -23, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
end
State:GetAttributeChangedSignal("ShowWins"):Connect(refreshWinsSwitch)
refreshWinsSwitch()
winsSwitch.Activated:Connect(function()
	Request:FireServer("setShowWins", State:GetAttribute("ShowWins") == false)
end)
local function showWinsRow(isAdmin: boolean)
	winsRowTitle.Visible, winsRowHint.Visible, winsSwitch.Visible = isAdmin, isAdmin, isAdmin
end
local fovReset = settingsAction("Reset", 0, BUTTON)
local settingsDone = settingsAction("Done", 0.5, SELECTED)

local function refreshFov()
	local fov = FirstPerson.fieldOfView()
	local fraction = (fov - FirstPerson.FOV_MIN) / (FirstPerson.FOV_MAX - FirstPerson.FOV_MIN)
	fovFill.Size = UDim2.fromScale(fraction, 1)
	fovKnob.Position = UDim2.fromScale(fraction, 0.5)
	fovValue.Text = tostring(fov)
end
refreshFov()
local function fovFromScreen(x: number)
	local left, width = fovTrack.AbsolutePosition.X, math.max(1, fovTrack.AbsoluteSize.X)
	local fraction = math.clamp((x - left) / width, 0, 1)
	FirstPerson.setFieldOfView(FirstPerson.FOV_MIN + fraction * (FirstPerson.FOV_MAX - FirstPerson.FOV_MIN))
	refreshFov()
end
local draggingFov = false
fovSlider.InputBegan:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingFov = true
		fovFromScreen(input.Position.X)
	end
end)
UserInputService.InputChanged:Connect(function(input: InputObject)
	if draggingFov and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		fovFromScreen(input.Position.X)
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingFov = false
	end
end)
fovReset.Activated:Connect(function()
	FirstPerson.setFieldOfView(FirstPerson.FOV_DEFAULT)
	refreshFov()
end)

local function settingsOpen(): boolean
	return settingsCard.Visible
end
local function setSettingsOpen(show: boolean)
	settingsCard.Visible = show
	-- One card at a time beside the sidebar.
	if show then
		LobbyView.close()
		Sidebar.setThemesOpen(false)
	end
	draggingFov = false
	if show then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
end
settingsDone.Activated:Connect(function() setSettingsOpen(false) end)
-- P toggles the settings, anywhere (no gift can be given P, see Keybinds).
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= SETTINGS_KEY or UserInputService:GetFocusedTextBox() then return end
	setSettingsOpen(not settingsCard.Visible)
end)
-- The games menu opening (GAMES, G, or arriving in the lobby) closes the others.
LobbyView.opened = function()
	settingsCard.Visible = false
	Sidebar.setThemesOpen(false)
end

-- The sidebar: GIFTS opens the gift settings (the streamer's), THEMES the
-- themes card, SETTINGS this settings card and GAMES the games menu; pressing
-- one that's open closes it.
Sidebar.start({
	request = Request,
	state = State,
	onPick = function(name: string)
		if name == "gifts" then
			LobbyView.close()
			setSettingsOpen(false)
			Sidebar.setThemesOpen(false)
			panel.Visible = false
			GiftMenu.setOpen(true)
		elseif name == "themes" then
			local show = not Sidebar.themesOpen()
			LobbyView.close()
			setSettingsOpen(false)
			Sidebar.setThemesOpen(show)
		elseif name == "settings" then
			setSettingsOpen(not settingsCard.Visible)
		else
			LobbyView.setOpen(not LobbyView.isOpen())
		end
	end,
	active = function(): string?
		if GiftMenu.isOpen() then return "gifts" end
		if Sidebar.themesOpen() then return "themes" end
		if settingsCard.Visible then return "settings" end
		if LobbyView.isOpen() then return "games" end
		return nil
	end,
})
-- The saved "hide the sidebar" was looked at before the sidebar existed.
refreshHidden()

-- The settings panel is hidden: the owner presses Y to open or close it.
local isAdmin = false
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	-- The panel lives in the game's display, which is off in the lobby.
	if processed or input.KeyCode ~= Enum.KeyCode.Y or not isAdmin or not gui.Enabled then
		return
	end
	-- Y also closes the gift settings.
	if GiftMenu.isOpen() then
		GiftMenu.setOpen(false)
		return
	end
	panel.Visible = not panel.Visible
	if panel.Visible then
		refreshPanelFields()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)
RunService.RenderStepped:Connect(function()
	-- Back in the lobby the game's display is off, and the streamer panel with
	-- it (the sidebar's cards still work there); the lobby keeps the mouse free.
	if not gui.Enabled then
		panel.Visible = false
		return
	end
	-- First person locks the mouse; free it while a panel or card is open.
	if panel.Visible or settingsOpen() or GiftMenu.isOpen() or Sidebar.themesOpen() then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end)

local function refreshAdmin()
	isAdmin = player:GetAttribute("DiamondRushAdmin") == true
	if not isAdmin then
		panel.Visible = false
	end
	Sidebar.setAdmin(isAdmin)
	showWinsRow(isAdmin)
end
player:GetAttributeChangedSignal("DiamondRushAdmin"):Connect(refreshAdmin)
refreshAdmin()

-- Live updates ---------------------------------------------------------------------------
local function refreshWins()
	winsBox.Visible = attr("ShowWins", true)
	winsBox.Text = Format.wins(attr("WinTitle", "WINS"), currentWins(), attr("WinGoal", 0))
	winsBox.TextColor3 = hexColor(attr("WinTextColor", "#FFFFFF"), WHITE)
	winsBox.BackgroundColor3 = hexColor(attr("WinBackgroundColor", "#2B2140"), PANEL)
	winsStroke.Color = winsBox.TextColor3:Lerp(GOLD, 0.6)
	if panel.Visible then
		refreshPanelFields()
	end
end
for _, name in { "Wins", "ClimbWins", "ChalkWins", "WinTitle", "WinGoal", "WinTextColor", "WinBackgroundColor", "ShowWins", "NextStartingStone" } do
	State:GetAttributeChangedSignal(name):Connect(refreshWins)
end
for _, name in { "InGame", "InClimb", "InChalk" } do
	player:GetAttributeChangedSignal(name):Connect(refreshWins)
end
refreshWins()

local shownStone = attr("Stone", Config.StartingStone)
local lastCount = -1

RunService.RenderStepped:Connect(function(dt: number)
	-- The stone number rolls towards its new value instead of jumping.
	local stone = attr("Stone", 0)
	local starting = math.max(1, attr("MountainTotal", attr("StartingStone", Config.StartingStone)))
	shownStone += (stone - shownStone) * math.min(1, dt * 10)
	if math.abs(stone - shownStone) < 1 then
		shownStone = stone
	end
	setText(stoneValue, Format.commas(shownStone))
	barFill.Size = UDim2.fromScale(math.clamp(shownStone / starting, 0, 1), 1)

	local phase = attr("Phase", "Digging")
	-- The hold counter takes the top-centre slot; the hand and gem stay unobscured.
	stoneBox.Visible = phase ~= "Holding"
	timerLabel.Visible = phase ~= "Holding"
	-- In Diamond in the Rough it moves below the hold countdown; the climb and
	-- chalkboard have their own displays above it, the same height.
	winsBox.Position = UDim2.new(0.5, 0, 0, if phase == "Holding" and roughHud.Visible then WINS_Y_HOLDING else WINS_Y)
	-- The time takes the wins' place when the counter is hidden.
	timerLabel.Position = UDim2.new(0.5, 0, 0, if winsBox.Visible then 154 else WINS_Y)
	local now = workspace:GetServerTimeNow()
	-- The 2X card shows while a caught diamond bird's bonus runs, and pops in.
	local boostLeft = attr("BirdBoostUntil", 0) - now
	local boosted = boostLeft > 0 and phase ~= "Holding"
	if boosted and not boostTag.Visible then
		boostScale.Scale = 1.4
		TweenService:Create(boostScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	boostTag.Visible = boosted
	if boosted then setText(boostTime, Format.duration(boostLeft)) end
	local roundStart = attr("RoundStart", now)
	setText(timerLabel, '<font color="#A8AEBE">TIME</font>   ' .. Format.duration(if phase == "Won" then attr("LastTime", 0) else now - roundStart))
	-- Shown only while gifts are being played on the mountain.
	setText(status, if attr("GiftProcessing", false) then "Updating mountain (" .. tostring(attr("GiftQueueLength", 0)) .. " queued)" else "")

	if phase == "Holding" then
		local elapsed = now - attr("HoldStart", now)
		local shown = HoldTimer.display(elapsed, Config.HoldSeconds, Config.HoldCountFrom, Config.HoldSlowdown)
		countdown.Visible = true
		setText(countHolder, string.upper(tostring(attr("Holder", ""))) .. " IS HOLDING IT")
		setText(countNumber, tostring(shown))
		if shown ~= lastCount then
			if lastCount ~= -1 and roughHud.Visible then Sounds.play("tick") end
			lastCount = shown
			countNumber.TextColor3 = WHITE:Lerp(GOLD, 1 - shown / Config.HoldCountFrom)
			countScale.Scale = 1.35
			TweenService:Create(countScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
		banner.Visible = false
	else
		countdown.Visible = false
		lastCount = -1
		banner.Visible = phase == "Revealed" or phase == "Rebuilding"
		if phase == "Rebuilding" then
			banner.Text = "REBUILDING THE " .. string.upper(Skin.words(attr("Skin", "stone")).heap)
			banner.TextTransparency = 0
		end
		if phase == "Revealed" then
			banner.Text = string.upper(Skin.words(attr("Skin", "stone")).gem) .. " UNCOVERED  ·  FIND IT AND CLICK IT"
			banner.TextTransparency = 0.15 + 0.15 * math.sin(now * 5)
		end
	end
end)

-- A chime when the diamond (or needle) is uncovered.
State:GetAttributeChangedSignal("Phase"):Connect(function()
	if attr("Phase", "Digging") == "Revealed" and player:GetAttribute("InGame") == true then Sounds.play("chime") end
end)

Notify.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "giftEffect" and type(data) == "table" then
		-- The mountain's gift shows play at the mountain only.
		if player:GetAttribute("InGame") == true then GiftEffects.play(data) end
	elseif kind == "feed" and type(data) == "table" then
		addFeed(tostring(data.text), tonumber(data.stone) or 0, tostring(data.kind))
	elseif kind == "win" and type(data) == "table" then
		showWin(data)
	elseif kind == "climbGift" then
		climb.onGift(data)
	elseif kind == "climbWin" then
		climb.onWin(data)
	elseif kind == "climbRestart" then
		climb.onRestart()
	elseif kind == "climbWall" then
		climb.onWall(data)
	elseif kind == "chalkGift" then
		chalk.onGift(data)
	elseif kind == "chalkReset" then
		chalk.onReset(data)
	elseif kind == "chalkWipe" then
		chalk.onWipe(data)
	elseif kind == "chalkWin" then
		chalk.onWin(data)
	elseif kind == "notice" and type(data) == "string" then
		addFeed(data, 0, "notice")
	elseif kind == "dropped" and type(data) == "table" and data.name ~= "" then
		local gem = Skin.words(attr("Skin", "stone")).gem
		addFeed(tostring(data.name) .. (if data.reason == "rebuild" then " — rebuild cancelled the countdown! Pick up the " .. gem .. " again." else " dropped the " .. gem .. "!"), 0, "drop")
	end
end)

-- Digging: hold the dig button (left mouse / touch) and your hands tear
-- through the rock you aim at, about DigPerSecond rocks a second: a hand lands
-- four times a second and breaks a quarter of that each time (see FirstPerson).
-- A separate full-viewport layer keeps the dot aligned with the camera ray,
-- regardless of the HUD inset or the screen's aspect ratio.
local aimGui = make("ScreenGui", {
	Name = "DiamondRushAim",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 5,
}, player:WaitForChild("PlayerGui"))
local aimDot = make("Frame", {
	Name = "Dot",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(5, 5),
	BackgroundColor3 = WHITE,
	BorderSizePixel = 0,
	Active = false,
}, aimGui)
rounded(aimDot, 5)
outline(aimDot, 1)
local rockOutline = make("Highlight", {
	Name = "AimedRock",
	FillTransparency = 1,
	OutlineColor = WHITE,
	OutlineTransparency = 0.15,
	DepthMode = Enum.HighlightDepthMode.Occluded,
	Enabled = false,
}, workspace)
local aimTarget: BasePart? = nil
-- True while the aim is on (or close to) a diamond bird that is still circling.
-- The bird is small and moving, so a click within a few degrees counts.
local aimBird = false
local function birdNear(ray: Ray): boolean
	for _, child in workspace:GetChildren() do
		local root = if child.Name == "DiamondBird" and child:IsA("Model") then child.PrimaryPart else nil
		if root and child:GetAttribute("LeaveAt") == 0 then
			local offset = root.Position - ray.Origin
			local distance = offset.Magnitude
			if distance > 1e-3 and distance < 400 then
				local tolerance = math.max(math.rad(4), math.atan(7 / distance))
				if math.acos(math.clamp(offset.Unit:Dot(ray.Direction.Unit), -1, 1)) <= tolerance then
					return true
				end
			end
		end
	end
	return false
end
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
RunService:BindToRenderStep("DiamondRushAim", Enum.RenderPriority.Camera.Value + 3, function()
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local phase = attr("Phase", "Digging")
	local active = camera ~= nil and humanoid ~= nil and humanoid.Health > 0
		and player:GetAttribute("InGame") == true and not LobbyView.isOpen() and not HowToPlay.isOpen()
		and not panel.Visible and not settingsOpen() and not GiftMenu.isOpen() and phase ~= "Won" and phase ~= "Rebuilding"
		and not (phase == "Holding" and attr("HolderUserId", 0) == player.UserId)
	aimDot.Visible = active
	UserInputService.MouseIconEnabled = not active
	aimTarget = nil
	aimBird = false
	if active and camera then
		aimParams.FilterDescendantsInstances = if character then { character } else {}
		local viewport = camera.ViewportSize
		local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
		local result = workspace:Raycast(ray.Origin, ray.Direction * 500, aimParams)
		if result then aimTarget = result.Instance end
		aimBird = birdNear(ray)
	end
	-- The dot turns gold over the bird, so players know a click will catch it.
	local dotColour = if aimBird then GOLD else WHITE
	if aimDot.BackgroundColor3 ~= dotColour then
		aimDot.BackgroundColor3 = dotColour
		aimDot.Size = if aimBird then UDim2.fromOffset(9, 9) else UDim2.fromOffset(5, 5)
	end
	local target = aimTarget
	local stone = target ~= nil and view:keyForPart(target) ~= nil
	local adornee = if stone then target else nil
	if rockOutline.Adornee ~= adornee then rockOutline.Adornee = adornee end
	rockOutline.Enabled = stone
end)
local digging = false
local function isDigInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if not processed and isDigInput(input) then
		-- A click on (or close to) the diamond bird catches it. A tap aims
		-- where the finger is; a click aims at the screen centre.
		local camera = workspace.CurrentCamera
		local catching = aimBird
		if not catching and input.UserInputType == Enum.UserInputType.Touch and camera
			and player:GetAttribute("InGame") == true then
			catching = birdNear(camera:ScreenPointToRay(input.Position.X, input.Position.Y))
		end
		local target = aimTarget
		if catching or (target and target.Parent and target.Parent.Name == "DiamondBird") then
			Request:FireServer("catchBird")
			digging = false
			return
		end
		-- A fresh click on the diamond goes to its ClickDetector, never to digging.
		if target == workspace:FindFirstChild("Diamond") then
			digging = false
			return
		end
		digging = true
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if isDigInput(input) then
		digging = false
	end
end)
UserInputService.WindowFocusReleased:Connect(function()
	digging = false
end)
-- The rock this player is digging now, while the dig button is held: its key,
-- or nil when there is nothing to dig.
local function digTarget(): number?
	local phase = attr("Phase", "Digging")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local target = aimTarget
	local allowed = digging and not panel.Visible and not settingsOpen() and not GiftMenu.isOpen() and not Sidebar.themesOpen() and not HowToPlay.isOpen() and phase ~= "Won" and phase ~= "Rebuilding"
		and not (phase == "Holding" and attr("HolderUserId", 0) == player.UserId)
	local key = if allowed and target then view:keyForPart(target) else nil
	if key == nil or root == nil or not root:IsA("BasePart") or (root.Position - (target :: BasePart).Position).Magnitude > 16 then
		return nil
	end
	return key
end
-- The hands swing while this is set; the rock breaks as each one lands.
RunService.Heartbeat:Connect(function()
	player:SetAttribute("DiggingRock", digTarget() ~= nil)
end)
-- Each landed strike cracks the rock with a crunch; every fourth a bigger
-- chunk breaks away. Hits in a row climb a little in pitch (eight steps, then
-- round again), and a pause starts the climb over.
Sounds.useDigSound(Config.DigSoundId, Config.DigSoundVolume)
local strikes = 0
local lastStrikeAt = -math.huge
FirstPerson.onStrike(function()
	local key = digTarget()
	local character = player.Character
	if key ~= nil and (character == nil or character:FindFirstChildOfClass("Tool") == nil) then
		Request:FireServer("mine", key)
		local rock = aimTarget
		local at = if rock then rock.Position else nil
		local now = os.clock()
		if now - lastStrikeAt > 0.6 then strikes = 0 end
		lastStrikeAt = now
		strikes += 1
		Sounds.play("dig", at, 1, Sounds.digPitch(strikes))
		if strikes % 4 == 0 then Sounds.play("crumble", at) end
	end
end)

-- The key held with Shift and/or Ctrl, as a binding name ("Shift+K").
local function pressedCombo(input: InputObject): string
	return Keybinds.combo(input.KeyCode.Name,
		UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
		UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
end

-- Gift keybinds work in-game for the streamer, outside text entry and the
-- gift settings (where keys are being chosen): TikFinity presses the key when
-- the gift arrives on the LIVE. They work with the Y panel open too, so no
-- gift is lost while the streamer changes something there.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isAdmin or GiftMenu.isOpen() or UserInputService:GetFocusedTextBox() then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local ok, bindings = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), attr("GiftBindings", "{}"))
	if not ok or type(bindings) ~= "table" then return end
	local binding = bindings[pressedCombo(input)]
	if binding then send("testGift", { coins = binding.coins, count = 1, name = binding.gift, keybind = true }) end
end)

-- Everything is set up: the loading screen (src/first) can go.
player:SetAttribute("DiamondRushHudReady", true)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">BirdView</string>
            <string name="Source"><![CDATA[--!strict
-- Flies the diamond bird (see the server's DiamondBird) smoothly on this
-- client from the times the server gives, beats its wings, and shows the
-- "click the bird" call on the display. The 2X card beside the stone count
-- (in the client's display) shows while the bonus runs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local BirdBonus = require(Shared:WaitForChild("BirdBonus"))

local BirdView = {}

type Flyer = {
	model: Model,
	parts: { BasePart },
	offsets: { CFrame },
	wings: { number }, -- 0 for the body, -1 / 1 for each wing
	frames: { CFrame },
}

local flyers: { [Model]: Flyer } = {}

local function track(model: Model)
	if flyers[model] or model.Name ~= "DiamondBird" or not model:IsA("Model") then return end
	local root = model.PrimaryPart or model:FindFirstChild("Hitbox")
	if root == nil or not root:IsA("BasePart") then return end
	-- Offsets come from the pose the server built it in, around its hitbox.
	local flyer: Flyer = { model = model, parts = {}, offsets = {}, wings = {}, frames = {} }
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			table.insert(flyer.parts, part)
			table.insert(flyer.offsets, root.CFrame:ToObjectSpace(part.CFrame))
			local wing = part:GetAttribute("Wing")
			table.insert(flyer.wings, if type(wing) == "number" then wing else 0)
			table.insert(flyer.frames, part.CFrame)
		end
	end
	flyers[model] = flyer
	model.AncestryChanged:Connect(function()
		if model.Parent == nil then flyers[model] = nil end
	end)
end

local function pathOf(model: Model): BirdBonus.Path
	return {
		radius = tonumber(model:GetAttribute("Radius")) or 40,
		height = tonumber(model:GetAttribute("Height")) or 40,
		angle = tonumber(model:GetAttribute("Angle")) or 0,
		direction = tonumber(model:GetAttribute("Direction")) or 1,
	}
end

local function fly(flyer: Flyer, now: number)
	local model = flyer.model
	local start = tonumber(model:GetAttribute("Start")) or now
	local leaveAt = tonumber(model:GetAttribute("LeaveAt")) or 0
	local leaving = if leaveAt > 0 then leaveAt - start else nil
	local path = pathOf(model)
	local t = now - start
	local x, y, z = BirdBonus.position(path, t, leaving)
	local ax, ay, az = BirdBonus.position(path, t + 0.1, leaving)
	local here, ahead = Vector3.new(x, y, z), Vector3.new(ax, ay, az)
	-- Banks into its turn as it circles the mountain.
	local frame = if (ahead - here).Magnitude > 1e-3 then CFrame.lookAt(here, ahead) else CFrame.new(here)
	frame *= CFrame.Angles(0, 0, path.direction * math.rad(14))
	local flap = BirdBonus.flap(t, leaving ~= nil)
	for index, part in flyer.parts do
		local side = flyer.wings[index]
		if side == 0 then
			flyer.frames[index] = frame * flyer.offsets[index]
		else
			local shoulder = CFrame.new(side * 1.0, 0.45, 0)
			flyer.frames[index] = frame * shoulder * CFrame.Angles(0, 0, side * flap) * shoulder:Inverse() * flyer.offsets[index]
		end
	end
	workspace:BulkMoveTo(flyer.parts, flyer.frames, Enum.BulkMoveMode.FireCFrameChanged)
end

function BirdView.start(gui: Instance, State: Instance)
	local call = Instance.new("TextLabel")
	call.Name = "DiamondBird"
	call.AnchorPoint = Vector2.new(0.5, 0)
	call.Position = UDim2.new(0.5, 0, 0, 244)
	call.Size = UDim2.fromOffset(0, 40)
	call.AutomaticSize = Enum.AutomaticSize.X
	call.BackgroundColor3 = Color3.fromRGB(16, 18, 26)
	call.BackgroundTransparency = 0.2
	call.Font = Enum.Font.GothamBold
	call.TextSize = 20
	call.TextColor3 = Color3.fromRGB(132, 212, 255)
	call.Text = ""
	call.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 20)
	corner.Parent = call
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 18)
	padding.PaddingRight = UDim.new(0, 18)
	padding.Parent = call
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(132, 212, 255)
	stroke.Parent = call
	call.Parent = gui

	for _, child in workspace:GetChildren() do
		if child:IsA("Model") then track(child) end
	end
	workspace.ChildAdded:Connect(function(child)
		-- Parts can stream in just after the model itself.
		if child:IsA("Model") and child.Name == "DiamondBird" then
			task.defer(track, child)
		end
	end)

	local shown = ""
	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local waiting = false
		for _, flyer in flyers do
			fly(flyer, now)
			if flyer.model:GetAttribute("LeaveAt") == 0 then waiting = true end
		end
		local boostUntil = tonumber(State:GetAttribute("BirdBoostUntil")) or 0
		local text = ""
		-- No call while a bonus runs: the 2X card beside the stone count shows it.
		if waiting and now >= boostUntil then
			text = "DIAMOND BIRD  ·  CLICK IT FOR 2X GIFTS"
			call.TextTransparency = 0.2 + 0.2 * math.sin(now * 6)
		end
		if text ~= shown then
			shown = text
			call.Text = text
			call.Visible = text ~= ""
		end
	end)
end

return BirdView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">CameraShake</string>
            <string name="Source"><![CDATA[--!strict
-- Camera shake that never builds up. Roblox's camera works out each frame's
-- view from the last frame's camera.CFrame, so a shake added on top would
-- leak into where the player looks. `apply` shakes this frame's view, and
-- just before the camera's next update the view is put back as it was.
local RunService = game:GetService("RunService")

local CameraShake = {}

local before: CFrame? = nil
local shaken: CFrame? = nil
local bound = false

-- Turns this frame's view by `offset` (call it after the camera has moved).
function CameraShake.apply(camera: Camera, offset: CFrame)
	if not bound then
		bound = true
		RunService:BindToRenderStep("CameraShakeUndo", Enum.RenderPriority.Camera.Value - 1, function()
			local current = workspace.CurrentCamera
			if shaken == nil then
				-- Nothing shook last frame: done until the next shake.
				bound = false
				RunService:UnbindFromRenderStep("CameraShakeUndo")
				return
			end
			if current and before and current.CFrame == shaken then current.CFrame = before end
			before, shaken = nil, nil
		end)
	end
	-- Two shakes in one frame stack on the same unshaken view.
	if shaken == nil or camera.CFrame ~= shaken then before = camera.CFrame end
	camera.CFrame = camera.CFrame * offset
	shaken = camera.CFrame
end

return CameraShake
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ChalkEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Chalkboard Count's gift animations, played on the board and in the
-- classroom: six for gifts that count up and six for gifts that count down,
-- one per gift tier, each wilder than the last, with its own sounds.
--
-- Counting up:
--   1  CHALK STAR      (1+ coins)       a gold star is chalked beside the number and bursts
--   2  GOLD STARS      (10+ coins)      three gold star stickers fly in and stamp the board
--   3  PAPER PLANES    (100+ coins)     paper planes loop round the room and dive at the number
--   4  CHALK STORM     (500+ coins)     sticks of chalk whirl round the number, then slam in
--   5  FIREWORKS       (1,000+ coins)   rockets shoot up from the floor and burst over the board
--   6  SUPERNOVA       (10,000+ coins)  the room goes dark, a star swells on the board, light
--                                       rays sweep the room and it goes nova in confetti
-- Counting down:
--   1  SPITBALL        a paper ball arcs in and splats on the number
--   2  ERASER TOSS     an eraser tumbles in, bounces off the board in a cloud of dust
--   3  SPONGE SPLASH   a wet sponge splats, water sprays and drips run down the board
--   4  BOARD QUAKE     the board shakes, cracks race over it and the number crumbles
--   5  DUSTER TORNADO  a whirlwind of erasers spins over the board and scrubs it
--   6  BLACK HOLE      a black hole opens in the board and swallows the number
--
-- play() returns when the number should change (the impact), so the board
-- keeps the old number until then. Nothing is physical; every piece is gone
-- a few seconds after its show, and each tier has a part budget.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("DiamondRush")
local ChalkBoard = require(Shared:WaitForChild("ChalkBoard"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local ChalkEffects = {}

ChalkEffects.UP_TITLES = { "CHALK STAR", "GOLD STARS", "PAPER PLANES", "CHALK STORM", "FIREWORKS", "SUPERNOVA" }
ChalkEffects.DOWN_TITLES = { "SPITBALL", "ERASER TOSS", "SPONGE SPLASH", "BOARD QUAKE", "DUSTER TORNADO", "BLACK HOLE" }
-- When the number changes, seconds into each show.
ChalkEffects.UP_IMPACT = { 0.5, 0.75, 1.3, 2.1, 2.5, 3.4 }
ChalkEffects.DOWN_IMPACT = { 0.55, 0.85, 1, 1.6, 2.2, 3 }
ChalkEffects.PART_LIMITS = { 30, 40, 60, 80, 100, 120 }
ChalkEffects.LIFETIMES = { 3, 3.5, 4.5, 5.5, 6.5, 8 }

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GOLD = Color3.fromRGB(255, 206, 92)
local PINK = Color3.fromRGB(255, 120, 200)
local CYAN = Color3.fromRGB(110, 225, 255)
local VIOLET = Color3.fromRGB(168, 96, 255)
local RED = Color3.fromRGB(255, 84, 84)
local WATER = Color3.fromRGB(120, 190, 255)
local WOOD = Color3.fromRGB(110, 76, 48)
local FELT = Color3.fromRGB(70, 74, 86)
local SPONGE = Color3.fromRGB(240, 210, 80)
local PAPER = Color3.fromRGB(246, 244, 236)
local CONFETTI = { GOLD, PINK, CYAN, Color3.fromRGB(120, 230, 150), VIOLET, Color3.fromRGB(255, 150, 80) }
local TEXTURES = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
}
ChalkEffects.TEXTURES = TEXTURES

local random = Random.new()

-- What a show may use from Chalkboard Count's view.
export type Context = {
	chalk: Color3, -- the theme's chalk colour
	glow: boolean, -- the theme's chalk glows
	digits: () -> { BasePart }, -- the number's chalk strokes on the board now
	drawStroke: (a: Vector3, b: Vector3, width: number, colour: Color3, glow: boolean, start: number, finish: number) -> Part,
	shake: (degrees: number, seconds: number) -> (),
}

local function sequence(...: Color3): ColorSequence
	local colours = { ... }
	if #colours == 1 then return ColorSequence.new(colours[1]) end
	local points = {}
	for i, colour in colours do
		table.insert(points, ColorSequenceKeypoint.new((i - 1) / (#colours - 1), colour))
	end
	return ColorSequence.new(points)
end

local function curve(...: number): NumberSequence
	local values = { ... }
	if #values == 1 then return NumberSequence.new(values[1]) end
	local points = {}
	for i, value in values do
		table.insert(points, NumberSequenceKeypoint.new((i - 1) / (#values - 1), value))
	end
	return NumberSequence.new(points)
end

-- Plays the show for a gift of `coins` going up (`up`) or down; `tier` is
-- 1 to 6. Returns the seconds until the number should change.
function ChalkEffects.play(tier: number, up: boolean, context: Context): number
	tier = math.clamp(math.floor(tier), 1, 6)
	local folder = Instance.new("Folder")
	folder.Name = "ChalkGiftShow"
	folder.Parent = workspace
	Debris:AddItem(folder, ChalkEffects.LIFETIMES[tier])
	local made = 0
	local function alive(): boolean
		return folder.Parent ~= nil
	end
	local function after(delay: number, callback: () -> ())
		task.delay(delay, function()
			if alive() then callback() end
		end)
	end
	local loudness = 1 + (tier - 1) * 0.12
	local function noise(name: string, at: Vector3?)
		if alive() then Sounds.play(name, at, loudness) end
	end
	-- Board positions: `x` across, `y` up from the floor, `out` towards the room.
	local function board(x: number, y: number, out: number?): Vector3
		return ChalkBoard.onBoard(x, y) + Vector3.new(0, 0, out or 0.3)
	end
	local middle = board(0, ChalkBoard.NUMBER_Y, 0.5)
	local function part(shape: Enum.PartType, size: Vector3, frame: CFrame, colour: Color3, material: Enum.Material?): Part?
		if not alive() or made >= ChalkEffects.PART_LIMITS[tier] then return nil end
		made += 1
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = frame
		p.Color = colour
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = folder
		return p
	end
	-- A chalk line drawn by the view, counted towards the show's parts.
	local function stroke(a: Vector3, b: Vector3, width: number, colour: Color3, glow: boolean, start: number, finish: number): Part?
		if not alive() or made >= ChalkEffects.PART_LIMITS[tier] then return nil end
		made += 1
		local line = context.drawStroke(a, b, width, colour, glow, start, finish)
		line.Parent = folder
		return line
	end
	local function tween(p: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
		TweenService:Create(p, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal):Play()
	end
	local function fade(p: Instance, seconds: number, goal: { [string]: any })
		tween(p, seconds, goal)
		Debris:AddItem(p, seconds + 0.05)
	end
	local function motion(seconds: number, update: (number) -> (), finish: (() -> ())?)
		local start = os.clock()
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function()
			local t = math.clamp((os.clock() - start) / seconds, 0, 1)
			if alive() then update(t) end
			if t >= 1 or not alive() then
				if connection then
					connection:Disconnect()
					connection = nil
				end
				if alive() and finish then finish() end
			end
		end)
	end
	local function emit(at: Vector3, spec: { [string]: any })
		if not alive() then return end
		local spot = Instance.new("Attachment")
		spot.Position = at
		spot.Parent = workspace.Terrain
		Debris:AddItem(spot, (spec.lifetime[2] or 1) + 0.3)
		local particles = Instance.new("ParticleEmitter")
		particles.Texture = spec.texture
		particles.Color = spec.colour
		particles.Size = spec.size
		particles.Transparency = spec.transparency or curve(0, 1)
		particles.Lifetime = NumberRange.new(spec.lifetime[1], spec.lifetime[2])
		particles.Speed = NumberRange.new(spec.speed[1], spec.speed[2])
		local spread = spec.spread or 180
		particles.SpreadAngle = Vector2.new(spread, spread)
		particles.Drag = spec.drag or 0
		particles.Acceleration = spec.acceleration or Vector3.zero
		particles.LightEmission = spec.glow or 1
		particles.Rotation = NumberRange.new(0, 360)
		particles.RotSpeed = NumberRange.new(-(spec.spin or 0), spec.spin or 0)
		particles.EmissionDirection = spec.direction or Enum.NormalId.Top
		if spec.flat then particles.Orientation = Enum.ParticleOrientation.VelocityPerpendicular end
		particles.Enabled = false
		particles.Parent = spot
		particles:Emit(spec.count)
	end
	local function sparks(at: Vector3, colour: Color3, count: number, power: number?)
		local p = power or 1
		emit(at, { texture = TEXTURES.spark, count = count, colour = sequence(WHITE, colour), size = curve(1, 0.5, 0),
			lifetime = { 0.5, 1.2 }, speed = { 8 * p, 20 * p }, drag = 2.5, acceleration = Vector3.new(0, -10, 0), spin = 200 })
	end
	local function dust(at: Vector3, colour: Color3, count: number, size: number?)
		local s = size or 1
		emit(at, { texture = TEXTURES.smoke, count = count, colour = sequence(colour), size = curve(0.6 * s, 2.2 * s),
			transparency = curve(0.3, 1), lifetime = { 0.8, 1.6 }, speed = { 2, 7 }, spread = 80, drag = 2.5, glow = 0.2, spin = 40,
			acceleration = Vector3.new(0, -1.5, 0) })
	end
	local function confetti(at: Vector3, count: number, power: number?)
		local p = power or 1
		for k = 1, 3 do
			emit(at, { texture = TEXTURES.spark, count = math.ceil(count / 3), colour = sequence(CONFETTI[(k * 2 + tier) % #CONFETTI + 1], CONFETTI[(k + tier) % #CONFETTI + 1]),
				size = curve(0.9, 0.6), lifetime = { 1.2, 2.2 }, speed = { 10 * p, 26 * p }, drag = 2, acceleration = Vector3.new(0, -9, 0), spin = 300 })
		end
	end
	-- A ring of light racing out flat over the board.
	local function ring(at: Vector3, radius: number, colour: Color3, seconds: number)
		emit(at, { texture = TEXTURES.ring, count = 1, colour = sequence(WHITE, colour), size = curve(1, radius * 2), transparency = curve(0, 1),
			lifetime = { seconds, seconds }, speed = { 0.01, 0.01 }, spread = 0, flat = true, direction = Enum.NormalId.Back })
	end
	local function flash(at: Vector3, colour: Color3, size: number, seconds: number?)
		local ball = part(Enum.PartType.Ball, Vector3.one * size * 0.25, CFrame.new(at), WHITE, Enum.Material.Neon)
		if ball == nil then return end
		ball.Transparency = 0.1
		fade(ball, seconds or 0.35, { Size = Vector3.one * size, Transparency = 1, Color = colour })
	end
	local function grade(tint: Color3, brightness: number, rise: number, hold: number, fall: number)
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "ChalkGrade"
		effect.Parent = Lighting
		tween(effect, rise, { TintColor = tint, Brightness = brightness })
		task.delay(rise + hold, function()
			if effect.Parent then tween(effect, fall, { TintColor = WHITE, Brightness = 0 }) end
		end)
		Debris:AddItem(effect, rise + hold + fall + 0.1)
	end
	-- A flat star of `size` facing the room, as five chalk-like spokes.
	local function star(at: Vector3, size: number, colour: Color3, material: Enum.Material): { Part }
		local spokes = {}
		for k = 0, 4 do
			local angle = k * math.pi * 2 / 5 + math.pi / 2
			local tip = at + Vector3.new(math.cos(angle) * size / 2, math.sin(angle) * size / 2, 0)
			local spoke = part(Enum.PartType.Block, Vector3.new(size * 0.18, size * 0.18, size / 2), CFrame.lookAt((at + tip) / 2, tip), colour, material)
			if spoke then table.insert(spokes, spoke) end
		end
		return spokes
	end
	local function arc(a: Vector3, b: Vector3, height: number, t: number): Vector3
		return a + (b - a) * t + Vector3.new(0, math.sin(math.pi * t) * height, 0)
	end
	-- Where things fly in from: the room in front of the board, off to a side.
	local function roomPoint(side: number, height: number, out: number): Vector3
		return ChalkBoard.onBoard(side, height) + Vector3.new(0, 0, out)
	end

	local impact = (if up then ChalkEffects.UP_IMPACT else ChalkEffects.DOWN_IMPACT)[tier]
	local chalk = context.chalk

	if up and tier == 1 then
		-- CHALK STAR: a gold star is chalked beside the number, then bursts.
		local centre = Vector2.new(random:NextNumber(-12, -8) * (if random:NextNumber() < 0.5 then -1 else 1), ChalkBoard.NUMBER_Y + 2.4)
		local points = {}
		for k = 0, 5 do
			local angle = math.pi / 2 + k * math.pi * 4 / 5
			table.insert(points, ChalkBoard.onBoard(centre.X + math.cos(angle) * 1.6, centre.Y + math.sin(angle) * 1.6))
		end
		local strokes: { Part } = {}
		for k = 1, 5 do
			local line = stroke(points[k], points[k + 1], 0.2, GOLD, true, (k - 1) * 0.08, k * 0.08)
			if line then table.insert(strokes, line) end
		end
		noise("chalk", points[1])
		after(0.45, function()
			local at = ChalkBoard.onBoard(centre.X, centre.Y) + Vector3.new(0, 0, 0.4)
			sparks(at, GOLD, 30)
			flash(at, GOLD, 4)
			noise("pop", at)
			for _, p in strokes do fade(p, 0.4, { Transparency = 1 }) end
		end)
		after(impact, function() sparks(middle, chalk, 16, 0.7) end)
	elseif up and tier == 2 then
		-- GOLD STARS: three star stickers fly in from the room and stamp the board.
		noise("whoosh", middle)
		for k = 1, 3 do
			local target = board((k - 2) * 8, ChalkBoard.NUMBER_Y + (if k == 2 then 3.6 else 2.4), 0.25)
			local from = roomPoint((k - 2) * 20, 4, 24)
			local spokes = star(from, 2.2, GOLD, Enum.Material.Neon)
			local offsets = {}
			for _, spoke in spokes do table.insert(offsets, CFrame.new(from):ToObjectSpace(spoke.CFrame)) end
			after((k - 1) * 0.12, function()
				motion(0.45, function(t)
					local at = arc(from, target, 4, t)
					local turn = CFrame.new(at) * CFrame.Angles(0, 0, (1 - t) * 8)
					for i, spoke in spokes do spoke.CFrame = turn * offsets[i] end
				end, function()
					noise("pop", target)
					sparks(target, GOLD, 18)
					ring(target, 3, GOLD, 0.5)
					for _, spoke in spokes do
						tween(spoke, 0.12, { Size = spoke.Size * 1.4 }, Enum.EasingStyle.Back)
						after(0.9, function() fade(spoke, 0.5, { Transparency = 1 }) end)
					end
				end)
			end)
		end
		after(impact, function() sparks(middle, chalk, 20) end)
	elseif up and tier == 3 then
		-- PAPER PLANES: planes loop round the room and dive at the number.
		noise("whoosh", middle)
		for k = 1, 5 do
			local plane: { Part } = {}
			local wing = part(Enum.PartType.Block, Vector3.new(1.6, 0.06, 1.2), CFrame.identity, PAPER)
			local body = part(Enum.PartType.Block, Vector3.new(0.18, 0.4, 1.4), CFrame.identity, PAPER)
			if wing then table.insert(plane, wing) end
			if body then table.insert(plane, body) end
			local side = if k % 2 == 0 then 1 else -1
			local loop = roomPoint(side * random:NextNumber(10, 18), random:NextNumber(10, 15), random:NextNumber(10, 18))
			local start = roomPoint(-side * 22, 6, 26)
			local target = board(random:NextNumber(-6, 6), ChalkBoard.NUMBER_Y + random:NextNumber(-1.5, 1.5), 0.3)
			local previous = start
			after((k - 1) * 0.12, function()
				motion(1.05, function(t)
					local a = start:Lerp(loop, t)
					local b = loop:Lerp(target, t)
					local at = a:Lerp(b, t) + Vector3.new(0, math.sin(t * math.pi * 2) * 1.5, 0)
					local heading = if (at - previous).Magnitude > 1e-3 then at - previous else Vector3.new(0, 0, -1)
					previous = at
					local frame = CFrame.lookAt(at, at + heading) * CFrame.Angles(0, 0, math.sin(t * 9) * 0.6)
					if wing then wing.CFrame = frame end
					if body then body.CFrame = frame * CFrame.new(0, -0.2, 0) end
				end, function()
					noise("pop", target)
					sparks(target, if k % 2 == 0 then GOLD else chalk, 14)
					dust(target, chalk, 4)
					for _, p in plane do fade(p, 0.3, { Transparency = 1, Size = p.Size * 0.4 }) end
				end)
			end)
		end
		after(impact, function()
			flash(middle, GOLD, 8)
			ring(middle, 7, GOLD, 0.6)
			noise("boom", middle)
		end)
	elseif up and tier == 4 then
		-- CHALK STORM: sticks of chalk whirl round the number, then slam in.
		noise("deepWhoosh", middle)
		local sticks: { Part } = {}
		for k = 1, 24 do
			local stick = part(Enum.PartType.Cylinder, Vector3.new(1, 0.24, 0.24), CFrame.new(middle), CONFETTI[k % #CONFETTI + 1]:Lerp(chalk, 0.4))
			if stick then table.insert(sticks, stick) end
		end
		local positions: { Vector3 } = {}
		motion(1.7, function(t)
			local spin = t * t * 18
			local reach = 4 + math.sin(t * math.pi) * 9
			for k, stick in sticks do
				local angle = spin + k * math.pi * 2 / #sticks
				local at = middle + Vector3.new(math.cos(angle) * reach * 1.6, math.sin(angle) * reach * 0.6, 1.5 + math.sin(angle * 2) * 1.2)
				positions[k] = at
				stick.CFrame = CFrame.new(at) * CFrame.Angles(angle, angle * 2, 0)
			end
			if math.random() < 0.3 then dust(middle + Vector3.new(random:NextNumber(-8, 8), random:NextNumber(-3, 3), 1), chalk, 2) end
		end, function()
			for k, stick in sticks do
				local from = positions[k] or middle
				motion(0.25, function(t)
					stick.CFrame = CFrame.new(from:Lerp(middle, t * t)) * CFrame.Angles(t * 4, 0, 0)
				end, function() stick:Destroy() end)
			end
		end)
		after(impact - 0.15, function()
			flash(middle, chalk, 12)
			ring(middle, 10, GOLD, 0.7)
			sparks(middle, GOLD, 50, 1.4)
			dust(middle, chalk, 16, 1.5)
			context.shake(1.2, 0.6)
			noise("boom", middle)
		end)
	elseif up and tier == 5 then
		-- FIREWORKS: rockets shoot up from the floor and burst over the board.
		noise("launch", middle)
		for k = 1, 6 do
			local floor = ChalkBoard.ORIGIN + Vector3.new((k - 3.5) * 6, 0.5, ChalkBoard.BOARD_Z + 6)
			local burstAt = board((k - 3.5) * 5.5, ChalkBoard.NUMBER_Y + random:NextNumber(-2, 4), 1.5)
			local colour = CONFETTI[k]
			local rocket = part(Enum.PartType.Ball, Vector3.one * 0.6, CFrame.new(floor), colour, Enum.Material.Neon)
			if rocket == nil then continue end
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 0.3, 0)
			a0.Parent = rocket
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -0.3, 0)
			a1.Parent = rocket
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Color = sequence(WHITE, colour)
			trail.Lifetime = 0.4
			trail.LightEmission = 1
			trail.FaceCamera = true
			trail.Parent = rocket
			after((k - 1) * 0.22, function()
				noise("whoosh", floor)
				motion(0.7, function(t)
					rocket.CFrame = CFrame.new(arc(floor, burstAt, 2, 1 - (1 - t) ^ 2))
				end, function()
					rocket:Destroy()
					noise("pop", burstAt)
					emit(burstAt, { texture = TEXTURES.spark, count = 45, colour = sequence(WHITE, colour, colour), size = curve(1.2, 0.8, 0),
						lifetime = { 0.8, 1.5 }, speed = { 14, 24 }, drag = 2.5, acceleration = Vector3.new(0, -8, 0), spin = 300 })
					flash(burstAt, colour, 5)
				end)
			end)
		end
		after(impact, function()
			flash(middle, GOLD, 16, 0.5)
			ring(middle, 14, GOLD, 0.8)
			confetti(middle + Vector3.new(0, 4, 2), 90, 1.2)
			context.shake(1.4, 0.7)
			noise("bigBoom", middle)
		end)
	elseif up then
		-- SUPERNOVA: the room goes dark, a star swells on the board, light rays
		-- sweep the room and it goes nova in confetti.
		grade(Color3.fromRGB(170, 160, 220), -0.25, 0.6, impact - 0.6, 1.2)
		noise("rumble", middle)
		after(0.8, function() noise("deepWhoosh", middle) end)
		local core = part(Enum.PartType.Ball, Vector3.one * 0.5, CFrame.new(middle + Vector3.new(0, 0, 0.6)), WHITE, Enum.Material.Neon)
		local halo = part(Enum.PartType.Ball, Vector3.one * 1, CFrame.new(middle + Vector3.new(0, 0, 0.5)), GOLD, Enum.Material.Neon)
		if halo then halo.Transparency = 0.55 end
		local light = Instance.new("PointLight")
		light.Color = GOLD
		light.Range = 40
		light.Brightness = 0
		light.Shadows = false
		if core then light.Parent = core end
		local rays: { Part } = {}
		for k = 1, 8 do
			local ray = part(Enum.PartType.Block, Vector3.new(0.4, 0.4, 0.1), CFrame.new(middle), if k % 2 == 0 then GOLD else WHITE, Enum.Material.Neon)
			if ray then
				ray.Transparency = 0.35
				table.insert(rays, ray)
			end
		end
		motion(impact, function(t)
			local grow = t * t
			if core then core.Size = Vector3.one * (0.5 + grow * 5) end
			if halo then halo.Size = Vector3.one * (1 + grow * 10 + math.sin(t * 40) * 0.4) end
			light.Brightness = grow * 6
			local length = 4 + grow * 40
			for k, ray in rays do
				local angle = k * math.pi / 4 + t * 3
				local tip = middle + Vector3.new(math.cos(angle) * length, math.sin(angle) * length * 0.5, 6 + length * 0.4)
				ray.Size = Vector3.new(0.3 + grow, 0.3 + grow, (tip - middle).Magnitude)
				ray.CFrame = CFrame.lookAt((middle + tip) / 2, tip)
			end
			if math.random() < 0.25 then sparks(middle + Vector3.new(random:NextNumber(-14, 14), random:NextNumber(-5, 5), 1), GOLD, 6, 0.6) end
		end, function()
			for _, ray in rays do fade(ray, 0.3, { Transparency = 1 }) end
			if core then fade(core, 0.6, { Size = Vector3.one * 40, Transparency = 1 }) end
			if halo then fade(halo, 0.5, { Size = Vector3.one * 30, Transparency = 1 }) end
		end)
		after(impact, function()
			noise("bigBoom", middle)
			flash(middle, GOLD, 30, 0.7)
			ring(middle, 22, GOLD, 1)
			after(0.12, function() ring(middle, 14, WHITE, 0.8) end)
			confetti(middle + Vector3.new(0, 2, 3), 150, 1.5)
			sparks(middle, GOLD, 80, 1.6)
			context.shake(2.2, 1)
		end)
		after(impact + 0.8, function()
			confetti(board(-10, ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT, 3), 60)
			confetti(board(10, ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT, 3), 60)
			noise("pop", middle)
		end)
	elseif tier == 1 then
		-- SPITBALL: a paper ball arcs in and splats on the number.
		local from = roomPoint(18, 5, 20)
		local target = middle + Vector3.new(random:NextNumber(-3, 3), random:NextNumber(-1, 1), -0.2)
		local ball = part(Enum.PartType.Ball, Vector3.one * 0.7, CFrame.new(from), PAPER)
		noise("whoosh", target)
		motion(impact, function(t)
			if ball then ball.CFrame = CFrame.new(arc(from, target, 3, t)) * CFrame.Angles(t * 9, t * 6, 0) end
		end, function()
			if ball then ball:Destroy() end
			noise("splat", target)
			local splat = part(Enum.PartType.Cylinder, Vector3.new(0.05, 0.4, 0.4), CFrame.new(target + Vector3.new(0, 0, 0.1)) * CFrame.Angles(0, math.pi / 2, 0), PAPER)
			if splat then
				tween(splat, 0.12, { Size = Vector3.new(0.05, 2.4, 2.4) }, Enum.EasingStyle.Back)
				after(0.8, function() fade(splat, 0.6, { Transparency = 1 }) end)
			end
			dust(target, chalk, 6)
		end)
	elseif tier == 2 then
		-- ERASER TOSS: an eraser tumbles in and bounces off the board in a cloud of dust.
		local from = roomPoint(-20, 6, 22)
		local target = middle + Vector3.new(random:NextNumber(-2, 2), 0, 0.4)
		local back = target + Vector3.new(6, -6, 8)
		local wood = part(Enum.PartType.Block, Vector3.new(2.6, 1, 1), CFrame.new(from), WOOD, Enum.Material.Wood)
		local felt = part(Enum.PartType.Block, Vector3.new(2.6, 0.4, 1), CFrame.new(from), FELT, Enum.Material.Fabric)
		local function place(at: Vector3, spin: number)
			local frame = CFrame.new(at) * CFrame.Angles(spin, spin * 0.7, spin * 0.3)
			if wood then wood.CFrame = frame end
			if felt then felt.CFrame = frame * CFrame.new(0, -0.7, 0) end
		end
		noise("whoosh", target)
		motion(impact, function(t) place(arc(from, target, 4, t), t * 10) end, function()
			noise("thud", target)
			noise("erase", target)
			dust(target, chalk, 18, 1.4)
			context.shake(0.6, 0.3)
			motion(0.6, function(t) place(arc(target, back, 3, t), 10 + t * 8) end, function()
				if wood then fade(wood, 0.3, { Transparency = 1 }) end
				if felt then fade(felt, 0.3, { Transparency = 1 }) end
			end)
		end)
	elseif tier == 3 then
		-- SPONGE SPLASH: a wet sponge splats, water sprays and drips run down the board.
		local from = roomPoint(16, 9, 24)
		local target = middle + Vector3.new(0, 0, 0.6)
		local sponge = part(Enum.PartType.Block, Vector3.new(2.4, 1.4, 1.2), CFrame.new(from), SPONGE, Enum.Material.Sand)
		noise("whoosh", target)
		motion(impact, function(t)
			if sponge then sponge.CFrame = CFrame.new(arc(from, target, 3, t)) * CFrame.Angles(t * 6, t * 4, 0) end
		end, function()
			noise("splash", target)
			if sponge then
				tween(sponge, 0.1, { Size = Vector3.new(3.4, 1.8, 0.5) })
				after(0.5, function()
					fade(sponge, 0.8, { CFrame = sponge.CFrame - Vector3.new(0, 8, -2), Transparency = 1 })
				end)
			end
			emit(target, { texture = TEXTURES.spark, count = 60, colour = sequence(WHITE, WATER), size = curve(0.5, 0.2),
				lifetime = { 0.5, 1 }, speed = { 10, 22 }, drag = 1.5, acceleration = Vector3.new(0, -30, 0), spread = 70, direction = Enum.NormalId.Back })
			emit(target, { texture = TEXTURES.smoke, count = 10, colour = sequence(WHITE), size = curve(1, 3), transparency = curve(0.6, 1),
				lifetime = { 1, 2 }, speed = { 1, 3 }, glow = 0, acceleration = Vector3.new(0, 3, 0) })
			for k = 1, 10 do
				local top = board(random:NextNumber(-7, 7), ChalkBoard.NUMBER_Y + random:NextNumber(-1.5, 2), 0.12)
				local drip = part(Enum.PartType.Block, Vector3.new(0.22, 0.4, 0.06), CFrame.new(top), WATER, Enum.Material.Glass)
				if drip == nil then break end
				drip.Transparency = 0.25
				local fall = random:NextNumber(3, 6)
				after(k * 0.04, function()
					motion(1.6, function(t)
						local length = 0.4 + t * fall
						drip.Size = Vector3.new(0.22, length, 0.06)
						drip.CFrame = CFrame.new(top - Vector3.new(0, length / 2, 0))
					end, function() fade(drip, 0.5, { Transparency = 1 }) end)
				end)
			end
		end)
	elseif tier == 4 then
		-- BOARD QUAKE: the board shakes, cracks race over it and the number crumbles.
		noise("rumble", middle)
		context.shake(1, impact + 0.3)
		for k = 1, 7 do
			local from = Vector2.new(random:NextNumber(-3, 3), ChalkBoard.NUMBER_Y + random:NextNumber(-1, 1))
			local angle = k * math.pi * 2 / 7 + random:NextNumber(-0.3, 0.3)
			local previous = from
			for step = 1, 3 do
				local nextPoint = previous + Vector2.new(math.cos(angle + random:NextNumber(-0.5, 0.5)), math.sin(angle + random:NextNumber(-0.5, 0.5)) * 0.6) * random:NextNumber(2, 4)
				local a, b = ChalkBoard.onBoard(previous.X, previous.Y), ChalkBoard.onBoard(nextPoint.X, nextPoint.Y)
				previous = nextPoint
				after(0.2 + (step - 1) * 0.25 + k * 0.03, function()
					local crack = stroke(a + Vector3.new(0, 0, 0.02), b + Vector3.new(0, 0, 0.02), 0.12, BLACK, false, 0, 0.2)
					if crack then after(1.6, function() fade(crack, 0.6, { Transparency = 1 }) end) end
				end)
			end
		end
		-- Chalk falls off the tray and dust rains from the ceiling.
		for k = 1, 6 do
			local at = ChalkBoard.ORIGIN + Vector3.new((k - 3.5) * 5, ChalkBoard.BOARD_BOTTOM - 0.2, ChalkBoard.BOARD_Z + 1)
			local stick = part(Enum.PartType.Cylinder, Vector3.new(1, 0.22, 0.22), CFrame.new(at), chalk)
			if stick then
				after(0.3 + k * 0.08, function()
					fade(stick, 0.6, { CFrame = CFrame.new(at + Vector3.new(random:NextNumber(-1, 1), -2.2, 1.5)) * CFrame.Angles(1, 2, 3), Transparency = 1 })
				end)
			end
		end
		after(0.4, function() dust(board(0, ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT + 1, 2), Color3.fromRGB(200, 196, 188), 16, 1.6) end)
		after(impact, function()
			noise("boom", middle)
			-- The number crumbles: copies of its strokes fall to the floor.
			for _, piece in context.digits() do
				local copy = part(Enum.PartType.Block, piece.Size, piece.CFrame, piece.Color, piece.Material)
				if copy == nil then break end
				local drop = random:NextNumber(6, 9)
				fade(copy, 0.9, { CFrame = piece.CFrame * CFrame.Angles(random:NextNumber(-1, 1), random:NextNumber(-1, 1), random:NextNumber(-1, 1)) - Vector3.new(0, drop, -random:NextNumber(0.5, 2)), Transparency = 1 })
			end
			dust(middle, chalk, 20, 1.6)
			context.shake(1.6, 0.5)
		end)
	elseif tier == 5 then
		-- DUSTER TORNADO: a whirlwind of erasers spins over the board and scrubs it.
		noise("deepWhoosh", middle)
		local erasers: { { Part } } = {}
		for k = 1, 8 do
			local wood = part(Enum.PartType.Block, Vector3.new(2.2, 0.8, 0.8), CFrame.new(middle), WOOD, Enum.Material.Wood)
			local felt = part(Enum.PartType.Block, Vector3.new(2.2, 0.3, 0.8), CFrame.new(middle), FELT, Enum.Material.Fabric)
			if wood and felt then table.insert(erasers, { wood, felt }) end
		end
		motion(impact + 0.5, function(t)
			local sweep = math.sin(t * math.pi * 2) * 9
			local centre = middle + Vector3.new(sweep, 0, 1.2)
			for k, pair in erasers do
				local angle = t * 22 + k * math.pi / 4
				local reach = 3 + k * 0.35
				local at = centre + Vector3.new(math.cos(angle) * reach, (k - 4.5) * 0.7 + math.sin(angle) * 0.5, math.sin(angle) * reach * 0.4)
				local frame = CFrame.new(at) * CFrame.Angles(0, -angle, math.sin(angle) * 0.5)
				pair[1].CFrame = frame
				pair[2].CFrame = frame * CFrame.new(0, -0.55, 0)
			end
			if math.random() < 0.5 then dust(centre + Vector3.new(random:NextNumber(-3, 3), random:NextNumber(-3, 3), 0), Color3.fromRGB(200, 196, 188), 2, 1.3) end
			if math.random() < 0.08 then noise("erase", centre) end
		end, function()
			for _, pair in erasers do
				local out = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(-0.3, 1), random:NextNumber(0.5, 1)).Unit * 20
				for _, p in pair do fade(p, 0.6, { CFrame = p.CFrame + out, Transparency = 1 }) end
			end
		end)
		after(impact, function()
			dust(middle, chalk, 24, 1.8)
			context.shake(1.2, 0.5)
			noise("thud", middle)
		end)
	else
		-- BLACK HOLE: a black hole opens in the board and swallows the number.
		grade(Color3.fromRGB(190, 160, 255), -0.2, 0.5, impact - 0.3, 1)
		noise("deepWhoosh", middle)
		after(1.2, function() noise("deepWhoosh", middle) end)
		local hole = part(Enum.PartType.Cylinder, Vector3.new(0.1, 0.4, 0.4), CFrame.new(middle + Vector3.new(0, 0, -0.1)) * CFrame.Angles(0, math.pi / 2, 0), BLACK)
		local rim = part(Enum.PartType.Cylinder, Vector3.new(0.08, 0.6, 0.6), CFrame.new(middle + Vector3.new(0, 0, -0.15)) * CFrame.Angles(0, math.pi / 2, 0), VIOLET, Enum.Material.Neon)
		if hole then tween(hole, 0.8, { Size = Vector3.new(0.1, 9, 9) }, Enum.EasingStyle.Back) end
		if rim then tween(rim, 0.8, { Size = Vector3.new(0.08, 10.5, 10.5) }, Enum.EasingStyle.Back) end
		-- The number's strokes (copies) spiral in.
		local pieces: { { part: Part, from: CFrame } } = {}
		after(0.6, function()
			for _, piece in context.digits() do
				local copy = part(Enum.PartType.Block, piece.Size, piece.CFrame, piece.Color, piece.Material)
				if copy == nil then break end
				table.insert(pieces, { part = copy, from = piece.CFrame })
			end
			motion(impact - 0.7, function(t)
				local pull = t * t
				for k, entry in pieces do
					local offset = entry.from.Position - middle
					local angle = pull * 8 + k * 0.1
					local spun = Vector3.new(offset.X * math.cos(angle) - offset.Y * math.sin(angle), offset.X * math.sin(angle) + offset.Y * math.cos(angle), 0)
					entry.part.CFrame = CFrame.new(middle + spun * (1 - pull) + Vector3.new(0, 0, 0.3)) * entry.from.Rotation * CFrame.Angles(0, 0, angle)
					entry.part.Size = entry.part.Size:Lerp(Vector3.new(0.05, 0.05, 0.05), pull * 0.06)
				end
				if math.random() < 0.4 then
					local edge = middle + Vector3.new(random:NextNumber(-14, 14), random:NextNumber(-5, 5), 0.5)
					emit(edge, { texture = TEXTURES.spark, count = 3, colour = sequence(WHITE, VIOLET), size = curve(0.6, 0),
						lifetime = { 0.5, 0.7 }, speed = { 0.5, 1 }, glow = 1 })
				end
			end, function()
				for _, entry in pieces do entry.part:Destroy() end
			end)
		end)
		after(impact, function()
			noise("bigBoom", middle)
			if hole then fade(hole, 0.25, { Size = Vector3.new(0.1, 0.2, 0.2) }) end
			if rim then fade(rim, 0.35, { Size = Vector3.new(0.08, 14, 14), Transparency = 1 }) end
			flash(middle, VIOLET, 20, 0.5)
			ring(middle, 18, VIOLET, 0.8)
			sparks(middle, VIOLET, 60, 1.4)
			context.shake(2, 0.8)
		end)
	end
	return impact
end

return ChalkEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ChalkView</string>
            <string name="Source"><![CDATA[--!strict
-- Chalkboard Count on this computer: the fixed view of the board, holding to
-- write, the chalk on the board (the count, drawn line by line as it goes up
-- with a stick of chalk at the tip, the goal in the corner, a progress line
-- and the reset countdown, all chalk strokes rather than text), the writer's
-- arm and chalk, the display (count, best and wins, the reset banner and the
-- hold countdown at the goal), the writing speed and theme card (Settings can
-- hide it), and the gift (see ChalkEffects), reset, save and win shows. The
-- classroom is kept out of sight from the other games.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local ChalkBoard = require(Shared:WaitForChild("ChalkBoard"))
local Format = require(Shared:WaitForChild("Format"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local HoldCountdown = require(script.Parent:WaitForChild("HoldCountdown"))
local ChalkEffects = require(script.Parent:WaitForChild("ChalkEffects"))

local ChalkView = {}

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(246, 200, 92)
local GREEN = Color3.fromRGB(118, 230, 160)
local RED = Color3.fromRGB(255, 84, 84)
local MUTED = Color3.fromRGB(168, 174, 190)
local PANEL = Color3.fromRGB(16, 18, 26)
local SELECTED = Color3.fromRGB(64, 128, 236)
local BUTTON = Color3.fromRGB(46, 50, 68)
local FONT = Enum.Font.GothamBold
local FONT_MEDIUM = Enum.Font.GothamMedium
local FONT_HEAVY = Enum.Font.GothamBlack
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
ChalkView.TEXTURES = { smoke = SMOKE, spark = SPARK }
ChalkView.STROKE = 0.34 -- the big number's chalk line width
ChalkView.SMALL_STROKE = 0.16

-- What the display says.
function ChalkView.countText(count: number, goal: number): string
	return string.format("%s / %s", Format.commas(count), Format.commas(goal))
end

function ChalkView.resetText(secondsLeft: number): string
	local s = math.max(0, math.ceil(secondsLeft))
	return string.format("RESET IN %d:%02d", s // 60, s % 60)
end

function ChalkView.saveText(saveCoins: number): string
	return string.format("Send a gift of %s+ coins to save the board", Format.commas(saveCoins))
end

-- The writing speed as the card shows it: "3 a second", "1.5 a second",
-- "12,000 a second".
function ChalkView.speedText(speed: number): string
	return (if speed % 1 == 0 then Format.commas(speed) else string.format("%.1f", speed)) .. " a second"
end

-- Above this speed the board shows the count about FAST_DRAWS times a second
-- (quick scribbles) instead of writing every number.
ChalkView.FAST_SPEED = 12
ChalkView.FAST_DRAWS = 12

-- Seconds to write one number's strokes at `speed` numbers a second.
function ChalkView.writeSeconds(speed: number): number
	return math.clamp(0.8 / math.max(speed, 0.1), 0.04, 0.35)
end

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent ~= nil then instance.Parent = parent end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function glass(instance: GuiObject, radius: number)
	instance.BackgroundColor3 = PANEL
	instance.BackgroundTransparency = 0.28
	rounded(instance, radius)
	make("UIStroke", { Thickness = 1, Color = WHITE, Transparency = 0.88, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, instance)
end

-- A chalk line on the board from `a` to `b`.
local function stroke(parent: Instance, a: Vector3, b: Vector3, width: number, colour: Color3, glow: boolean): Part
	local length = math.max(0.05, (b - a).Magnitude)
	local p = Instance.new("Part")
	p.Name = "Chalk"
	p.Size = Vector3.new(width, width, length + width * 0.8)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	p.Color = colour
	p.Material = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Transparency = 0.04
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

function ChalkView.start(request: RemoteEvent, state: Instance)
	local player = Players.LocalPlayer
	local active = false
	local function attr(name: string, fallback: any): any
		local value = state:GetAttribute(name)
		return if value == nil then fallback else value
	end
	local function theme(): ChalkBoard.Theme
		return ChalkBoard.theme(attr("ChalkTheme", "classic"))
	end

	-- The display -------------------------------------------------------------------------
	local gui = make("ScreenGui", { Name = "ChalkboardHud", ResetOnSpawn = false, Enabled = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling },
		player:WaitForChild("PlayerGui"))
	local card = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(320, 92) }, gui)
	glass(card, 14)
	local cardScale = make("UIScale", { Scale = 1 }, card)
	make("TextLabel", { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
		TextColor3 = MUTED, Text = "CHALKBOARD COUNT" }, card)
	local countLabel = make("TextLabel", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Font = FONT_HEAVY,
		TextSize = 26, TextColor3 = WHITE, Text = "" }, card)
	local bar = make("Frame", { Position = UDim2.new(0, 16, 0, 58), Size = UDim2.new(1, -32, 0, 6), BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, BorderSizePixel = 0 }, card)
	rounded(bar, 3)
	local barFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = GREEN, BorderSizePixel = 0 }, bar)
	rounded(barFill, 3)
	local statsLabel = make("TextLabel", { Position = UDim2.fromOffset(0, 68), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT_MEDIUM,
		TextSize = 13, TextColor3 = MUTED, RichText = true, Text = "" }, card)

	-- The reset countdown banner.
	-- Under the win counter (102 to 146).
	local resetBox = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 156), Size = UDim2.fromOffset(440, 70), Visible = false }, gui)
	glass(resetBox, 14)
	resetBox.BackgroundColor3 = Color3.fromRGB(90, 16, 24)
	local resetScale = make("UIScale", { Scale = 1 }, resetBox)
	local resetLabel = make("TextLabel", { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Font = FONT_HEAVY,
		TextSize = 32, TextColor3 = RED, Text = "" }, resetBox)
	local saveLabel = make("TextLabel", { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = FONT,
		TextSize = 14, TextColor3 = WHITE, Text = "" }, resetBox)

	-- A big line for gifts, saves and wins.
	local shout = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 236), Size = UDim2.fromOffset(700, 46),
		BackgroundTransparency = 1, Font = FONT_HEAVY, TextSize = 38, TextColor3 = GOLD, TextStrokeTransparency = 0.3, TextTransparency = 1, Text = "" }, gui)
	local shoutScale = make("UIScale", { Scale = 1 }, shout)
	-- Who sent what, under a gift show's name.
	local subLine = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 240), Size = UDim2.fromOffset(700, 24),
		BackgroundTransparency = 1, Font = FONT, TextSize = 18, TextColor3 = WHITE, TextStrokeTransparency = 0.3, TextTransparency = 1, Text = "" }, gui)
	local shoutSerial = 0
	local function showShout(text: string, colour: Color3, seconds: number, size: number?, sub: string?)
		shoutSerial += 1
		local serial = shoutSerial
		shout.Text = text
		shout.TextColor3 = colour
		shout.TextTransparency = 0
		subLine.Text = sub or ""
		subLine.TextTransparency = if sub then 0 else 1
		shoutScale.Scale = size or 1.8
		TweenService:Create(shoutScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		task.delay(seconds, function()
			if serial == shoutSerial then
				TweenService:Create(shout, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
				TweenService:Create(subLine, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
			end
		end)
	end
	local function pop(scale: number)
		cardScale.Scale = scale
		TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	-- The hold at the goal, under the reset banner's place.
	local hold = HoldCountdown.new(gui, 300, "HOLD THE GOAL")
	local hint = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40), Size = UDim2.fromOffset(520, 22), BackgroundTransparency = 1,
		Font = FONT, TextSize = 16, TextColor3 = WHITE, TextStrokeTransparency = 0.4, Text = "Hold the left mouse button, Space or the screen to write" }, gui)

	-- The writing card: speed and theme (Settings can hide it).
	-- Higher on touch screens, clear of Roblox's jump button.
	local settingsCard = make("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, if UserInputService.TouchEnabled then -190 else -36),
		Size = UDim2.fromOffset(290, 178) }, gui)
	glass(settingsCard, 14)
	make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 10) }, settingsCard)
	make("TextLabel", { Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = MUTED, Text = "WRITING" }, settingsCard)
	make("TextLabel", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -80, 0, 18), BackgroundTransparency = 1, Font = FONT_MEDIUM, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = WHITE, Text = "Writing speed" }, settingsCard)
	local speedValue = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 22), Size = UDim2.fromOffset(80, 18), BackgroundTransparency = 1,
		Font = FONT, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = WHITE, Text = "" }, settingsCard)
	local speedHit = make("TextButton", { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, settingsCard)
	local track = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82, BorderSizePixel = 0 }, speedHit)
	rounded(track, 3)
	local fill = make("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = SELECTED, BorderSizePixel = 0 }, track)
	rounded(fill, 3)
	local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, track)
	rounded(knob, 9)
	make("TextLabel", { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = MUTED, Text = "THEME" }, settingsCard)
	local themeButtons: { [string]: TextButton } = {}
	for i, key in ChalkBoard.THEME_ORDER do
		local row, col = (i - 1) // 3, (i - 1) % 3
		local button = make("TextButton", { Position = UDim2.new(col / 3, 2, 0, 94 + row * 36), Size = UDim2.new(1 / 3, -4, 0, 30), BackgroundColor3 = BUTTON,
			Font = FONT, TextSize = 12, TextColor3 = WHITE, TextWrapped = true, Text = ChalkBoard.THEMES[key].name }, settingsCard)
		rounded(button, 8)
		button.Activated:Connect(function() request:FireServer("setChalkTheme", key) end)
		themeButtons[key] = button
	end

	local speed = attr("ChalkSpeed", ChalkBoard.SPEED.default)
	local draggingSpeed = false
	local lastSent = 0
	local function showSpeed()
		local fraction = ChalkBoard.speedFraction(speed)
		fill.Size = UDim2.fromScale(fraction, 1)
		knob.Position = UDim2.fromScale(fraction, 0.5)
		speedValue.Text = ChalkView.speedText(speed)
	end
	local function speedFromScreen(x: number, done: boolean)
		local fraction = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		speed = ChalkBoard.speedAt(fraction)
		showSpeed()
		local now = os.clock()
		if done or now - lastSent > 0.25 then
			lastSent = now
			request:FireServer("setChalkSpeed", speed)
		end
	end
	speedHit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSpeed = true
			speedFromScreen(input.Position.X, false)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if draggingSpeed and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			speedFromScreen(input.Position.X, false)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if draggingSpeed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			draggingSpeed = false
			speedFromScreen(input.Position.X, true)
		end
	end)
	local function refreshSettings()
		if not draggingSpeed then speed = attr("ChalkSpeed", ChalkBoard.SPEED.default) end
		showSpeed()
		local current = attr("ChalkTheme", "classic")
		for key, button in themeButtons do
			button.BackgroundColor3 = if key == current then SELECTED else BUTTON
		end
	end
	state:GetAttributeChangedSignal("ChalkSpeed"):Connect(refreshSettings)
	refreshSettings()
	local function refreshCard()
		settingsCard.Visible = player:GetAttribute("HideChalkCard") ~= true
	end
	player:GetAttributeChangedSignal("HideChalkCard"):Connect(refreshCard)
	refreshCard()

	-- The chalk on the board -----------------------------------------------------------------
	local drawing = make("Folder", { Name = "ChalkDrawing" }, workspace)
	local effects = make("Folder", { Name = "ChalkEffects" }, workspace)
	type Slot = { digit: number, parts: { Part } }
	local slots: { Slot } = {}
	local shownCount = -1
	local revealSerial = 0
	local function clearSlots()
		for _, slot in slots do
			for _, p in slot.parts do p:Destroy() end
		end
		table.clear(slots)
	end
	local function dust(at: Vector3, colour: Color3, count: number, speedRange: { number })
		local spot = make("Attachment", { Position = at }, workspace.Terrain)
		Debris:AddItem(spot, 2.5)
		local puff = make("ParticleEmitter", {
			Texture = SMOKE, Color = ColorSequence.new(colour), LightEmission = 0.3,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1.6) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.6, 1.4), Speed = NumberRange.new(speedRange[1], speedRange[2]), SpreadAngle = Vector2.new(70, 70),
			Acceleration = Vector3.new(0, -2, 0), Drag = 3, Enabled = false,
		}, spot)
		puff:Emit(count)
	end
	-- Drawing: each chalk line grows from its start to its end, one after
	-- another, with a stick of chalk at the tip and a scratch as it goes.
	type Growing = { part: Part, a: Vector3, b: Vector3, width: number, start: number, finish: number, begun: boolean }
	local growing: { Growing } = {}
	local tip = make("Part", { Name = "ChalkTip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.1, 0.26, 0.26), Material = Enum.Material.SmoothPlastic,
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, effects)
	-- A line from `a` to `b` drawn between `start` and `finish` seconds from now.
	local function drawStroke(a: Vector3, b: Vector3, width: number, colour: Color3, glow: boolean, start: number, finish: number): Part
		local p = stroke(drawing, a, b, width, colour, glow)
		if finish > 0 then
			p.Transparency = 1
			local now = os.clock()
			table.insert(growing, { part = p, a = a, b = b, width = width, start = now + start, finish = now + math.max(finish, start + 0.01), begun = false })
		end
		return p
	end
	-- Where the chalk last touched the board, and when: the writer's hand follows it.
	local chalkPoint: Vector3? = nil
	local chalkPointAt = 0
	local function growStrokes()
		local now = os.clock()
		local at: Vector3? = nil
		for k = #growing, 1, -1 do
			local g = growing[k]
			if g.part.Parent == nil then
				table.remove(growing, k)
				continue
			end
			local u = math.clamp((now - g.start) / (g.finish - g.start), 0, 1)
			if u <= 0 then continue end
			if not g.begun then
				g.begun = true
				Sounds.play("chalk", g.a)
			end
			local reach = g.a + (g.b - g.a) * u
			local length = (reach - g.a).Magnitude
			g.part.Size = Vector3.new(g.width, g.width, math.max(0.05, length) + g.width * 0.8)
			g.part.CFrame = CFrame.lookAt((g.a + reach) / 2, g.b)
			g.part.Transparency = 0.04
			if u >= 1 then
				table.remove(growing, k)
			else
				at = reach
			end
		end
		if at then
			chalkPoint = at
			chalkPointAt = now
			tip.Color = theme().chalk
			tip.Transparency = 0
			-- Held at an angle, its end on the board.
			tip.CFrame = CFrame.new(at + Vector3.new(0.3, -0.25, 0.55)) * CFrame.Angles(0, math.rad(60), math.rad(35))
			if math.random() < 0.15 then dust(at, theme().chalk, 1, { 0.3, 1 }) end
		elseif tip.Transparency < 1 then
			tip.Transparency = 1
		end
	end
	-- Writes digit `d` in slot `i` of `n`: its lines drawn one after another
	-- over `seconds`, starting `delay` seconds from now (all at once if 0).
	local function writeSlot(i: number, n: number, d: number, seconds: number, delay: number?)
		local look = theme()
		local lefts = ChalkBoard.digitLefts(n)
		local bottom = ChalkBoard.NUMBER_Y - ChalkBoard.NUMBER_HEIGHT / 2
		local segments = ChalkBoard.segments(d, lefts[i], bottom, ChalkBoard.NUMBER_HEIGHT)
		local total = 0
		for _, seg in segments do total += (seg[2] - seg[1]).Magnitude end
		local parts: { Part } = {}
		local done = delay or 0
		for _, seg in segments do
			local share = if seconds > 0 then seconds * (seg[2] - seg[1]).Magnitude / math.max(total, 1e-3) else 0
			table.insert(parts, drawStroke(seg[1], seg[2], ChalkView.STROKE, look.chalk, look.glow, done, if seconds > 0 then done + share else 0))
			done += share
		end
		slots[i] = { digit = d, parts = parts }
		if seconds > 0 then
			revealSerial += 1
			local serial = revealSerial
			task.delay(done, function()
				if serial == revealSerial and #segments > 0 then dust(segments[#segments][2], look.chalk, 3, { 0.5, 2 }) end
			end)
		end
	end
	-- Draws the count: only the digits that changed are written again, unless
	-- the number of digits changed. Each takes `seconds`, one after another.
	local function drawCount(count: number, seconds: number)
		local digits = ChalkBoard.digits(math.min(count, 10 ^ ChalkBoard.MAX_DIGITS - 1))
		local delay = 0
		if #digits ~= #slots then
			clearSlots()
			for i, d in digits do
				writeSlot(i, #digits, d, seconds, delay)
				delay += seconds
			end
		else
			for i, d in digits do
				if slots[i].digit ~= d then
					for _, p in slots[i].parts do p:Destroy() end
					writeSlot(i, #digits, d, seconds, delay)
					delay += seconds
				end
			end
		end
		shownCount = count
	end

	-- The goal, top right, with a drawn target beside it; the progress line;
	-- the countdown, top left, with a drawn clock beside it.
	local cornerParts: { Part } = {}
	local progressPart: Part? = nil
	local countdownParts: { Part } = {}
	local shownGoal, shownCountdown = -1, -1
	local function ring(parts: { Part }, cx: number, cy: number, r: number, colour: Color3, glow: boolean, width: number)
		local steps = 14
		for k = 0, steps - 1 do
			local a0, a1 = k / steps * math.pi * 2, (k + 1) / steps * math.pi * 2
			table.insert(parts, stroke(drawing, ChalkBoard.onBoard(cx + math.cos(a0) * r, cy + math.sin(a0) * r),
				ChalkBoard.onBoard(cx + math.cos(a1) * r, cy + math.sin(a1) * r), width, colour, glow))
		end
	end
	local function smallNumber(parts: { Part }, value: number, right: number, middleY: number, height: number, colour: Color3, glow: boolean)
		local digits = ChalkBoard.digits(value)
		local width = height * ChalkBoard.DIGIT_WIDTH / ChalkBoard.NUMBER_HEIGHT
		local gap = height * ChalkBoard.DIGIT_GAP / ChalkBoard.NUMBER_HEIGHT
		local total = #digits * width + (#digits - 1) * gap
		local lefts = ChalkBoard.digitLefts(#digits, height, right - total / 2)
		for i, d in digits do
			for _, seg in ChalkBoard.segments(d, lefts[i], middleY - height / 2, height) do
				table.insert(parts, stroke(drawing, seg[1], seg[2], ChalkView.SMALL_STROKE, colour, glow))
			end
		end
	end
	local function drawGoal()
		for _, p in cornerParts do p:Destroy() end
		table.clear(cornerParts)
		local look = theme()
		local goal = attr("ChalkGoal", ChalkBoard.GOAL.default)
		local top = ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT - 1.6
		local right = ChalkBoard.BOARD_WIDTH / 2 - 1.2
		smallNumber(cornerParts, goal, right, top, 1.8, look.chalk, look.glow)
		local digits = #ChalkBoard.digits(goal)
		local width = digits * 1.8 * (ChalkBoard.DIGIT_WIDTH + ChalkBoard.DIGIT_GAP) / ChalkBoard.NUMBER_HEIGHT
		local cx = right - width - 1.3
		ring(cornerParts, cx, top, 0.9, look.chalk, look.glow, ChalkView.SMALL_STROKE)
		ring(cornerParts, cx, top, 0.4, look.chalk, look.glow, ChalkView.SMALL_STROKE)
		shownGoal = goal
	end
	local function drawProgress(count: number)
		local goal = math.max(1, attr("ChalkGoal", ChalkBoard.GOAL.default))
		local look = theme()
		local half = ChalkBoard.BOARD_WIDTH / 2 - 1.5
		local y = ChalkBoard.BOARD_BOTTOM + 1.1
		local fraction = math.clamp(count / goal, 0, 1)
		if progressPart then progressPart:Destroy() end
		progressPart = if fraction > 0 then stroke(drawing, ChalkBoard.onBoard(-half, y), ChalkBoard.onBoard(-half + 2 * half * fraction, y), 0.22, look.chalk, look.glow) else nil
	end
	local function drawCountdown(seconds: number)
		if seconds == shownCountdown then return end
		shownCountdown = seconds
		for _, p in countdownParts do p:Destroy() end
		table.clear(countdownParts)
		if seconds < 0 then return end
		local top = ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT - 1.7
		local left = -ChalkBoard.BOARD_WIDTH / 2 + 2.2
		local colour = Color3.fromRGB(255, 110, 110)
		ring(countdownParts, left, top, 1, colour, true, ChalkView.SMALL_STROKE)
		table.insert(countdownParts, stroke(drawing, ChalkBoard.onBoard(left, top), ChalkBoard.onBoard(left, top + 0.7), ChalkView.SMALL_STROKE, colour, true))
		table.insert(countdownParts, stroke(drawing, ChalkBoard.onBoard(left, top), ChalkBoard.onBoard(left + 0.5, top), ChalkView.SMALL_STROKE, colour, true))
		-- The seconds start just right of the clock (smallNumber lines up their right edge).
		local count = #ChalkBoard.digits(seconds)
		local total = 2 * (count * ChalkBoard.DIGIT_WIDTH + (count - 1) * ChalkBoard.DIGIT_GAP) / ChalkBoard.NUMBER_HEIGHT
		smallNumber(countdownParts, seconds, left + 1.6 + total, top, 2, colour, true)
	end
	local function redrawAll()
		clearSlots()
		shownCount = -1
		drawCount(attr("ChalkCount", 0), 0)
		drawGoal()
		drawProgress(attr("ChalkCount", 0))
		shownCountdown = -2
	end

	-- The eraser sweeps across the board (a wipe), or over the number (a gift down).
	local holdDrawUntil = 0
	local function sweep(full: boolean, seconds: number)
		local look = theme()
		local eraser = make("Part", { Name = "SweepEraser", Size = Vector3.new(2.6, 1.2, 0.8), Color = Color3.fromRGB(96, 66, 42), Material = Enum.Material.Wood,
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }, effects)
		-- The board shows the old count until the eraser has passed over it.
		holdDrawUntil = math.max(holdDrawUntil, os.clock() + seconds * 0.6)
		local passes = if full then 4 else 2
		local half = if full then ChalkBoard.BOARD_WIDTH / 2 - 2 else 9
		local lowY = if full then ChalkBoard.BOARD_BOTTOM + 1.5 else ChalkBoard.NUMBER_Y - 2.4
		local highY = if full then ChalkBoard.BOARD_BOTTOM + ChalkBoard.BOARD_HEIGHT - 1.5 else ChalkBoard.NUMBER_Y + 2.4
		local start = os.clock()
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function()
			local t = math.clamp((os.clock() - start) / seconds, 0, 1)
			local pass = math.min(passes - 1, math.floor(t * passes))
			local u = t * passes - pass
			local x = if pass % 2 == 0 then -half + 2 * half * u else half - 2 * half * u
			local y = highY + (lowY - highY) * ((pass + u) / passes)
			local at = ChalkBoard.onBoard(x, y) + Vector3.new(0, 0, 0.4)
			eraser.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.sin(t * 40) * 0.15)
			if math.random() < 0.35 then dust(at, look.chalk, 2, { 1, 3 }) end
			if t >= 1 and connection then
				connection:Disconnect()
				connection = nil
				eraser:Destroy()
			end
		end)
	end

	-- A gift: chalk bursts at the number (more for bigger gifts), or the eraser for gifts down.
	-- The shake is added by the classroom camera each frame (below), so it is never overwritten.
	local shakeDegrees, shakeStart, shakeSeconds = 0, 0, 1
	local function camShake(degrees: number, seconds: number)
		local now = os.clock()
		local left = shakeDegrees * math.max(0, 1 - (now - shakeStart) / shakeSeconds)
		if degrees < left then return end
		shakeDegrees, shakeStart, shakeSeconds = degrees, now, seconds
	end
	local function burst(at: Vector3, colour: Color3, count: number)
		local spot = make("Attachment", { Position = at }, workspace.Terrain)
		Debris:AddItem(spot, 2.5)
		local sparks = make("ParticleEmitter", {
			Texture = SPARK, Color = ColorSequence.new(WHITE, colour), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) }),
			Lifetime = NumberRange.new(0.6, 1.3), Speed = NumberRange.new(10, 24), SpreadAngle = Vector2.new(80, 80), Drag = 2.5,
			Acceleration = Vector3.new(0, -8, 0), Enabled = false,
		}, spot)
		sparks:Emit(count)
	end
	-- A gift: its show (see ChalkEffects) plays on the board, and the number
	-- changes when the show hits it.
	local effectContext: ChalkEffects.Context = {
		chalk = theme().chalk,
		glow = theme().glow,
		digits = function(): { BasePart }
			local list = {}
			for _, slot in slots do
				for _, p in slot.parts do table.insert(list, p) end
			end
			return list
		end,
		drawStroke = drawStroke,
		shake = function(degrees: number, seconds: number) camShake(degrees, seconds) end,
	}
	local function onGift(data: any)
		if not active or type(data) ~= "table" then return end
		local coins = tonumber(data.coins) or 1
		local tier = ChalkBoard.tier(coins, data.tier)
		local amount = tonumber(data.amount) or 0
		local up = data.up == true
		local look = theme()
		effectContext.chalk = look.chalk
		effectContext.glow = look.glow
		local impact = ChalkEffects.play(tier, up, effectContext)
		-- The board keeps the old number until the show hits it.
		holdDrawUntil = math.max(holdDrawUntil, os.clock() + impact)
		local title = (if up then ChalkEffects.UP_TITLES else ChalkEffects.DOWN_TITLES)[tier]
		local sub = string.format("%s sent %s  ·  %s%s", tostring(data.name or "Someone"), tostring(data.gift or "a gift"),
			if amount > 0 then "+" else "", Format.commas(amount))
		showShout(title, if up then GREEN else RED, 2 + tier * 0.4, 1 + tier * 0.2, sub)
		task.delay(impact, function()
			if active then pop(1.1 + tier * 0.05) end
		end)
	end
	local function onReset(data: any)
		if not active or type(data) ~= "table" then return end
		if data.state == "started" then
			Sounds.play("rumble")
			showShout(string.format("%s sent the RESET!", tostring(data.name or "Someone")), RED, 3, 2.2)
			camShake(1.4, 0.8)
			resetScale.Scale = 1.6
			TweenService:Create(resetScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		elseif data.state == "saved" then
			Sounds.play("chime")
			showShout(string.format("SAVED BY %s!", string.upper(tostring(data.name or "someone"))), GREEN, 3, 2.2)
			local middle = ChalkBoard.onBoard(0, ChalkBoard.NUMBER_Y) + Vector3.new(0, 0, 0.5)
			for k = 1, 5 do
				task.delay(k * 0.1, function() burst(middle + Vector3.new((k - 3) * 4, 0, 0), GREEN, 30) end)
			end
		elseif data.state == "wiped" then
			Sounds.play("boom")
			showShout("THE BOARD WAS WIPED!", RED, 3, 2)
			camShake(1.2, 0.6)
		end
	end
	local function onWipe(_data: any)
		if not active then return end
		Sounds.play("erase")
		task.delay(0.6, function() if active then Sounds.play("erase") end end)
		sweep(true, 1.4)
	end
	local function onWin(data: any)
		if not active or type(data) ~= "table" then return end
		Sounds.play("cheer")
		showShout(string.format("YOU REACHED %s!", Format.commas(tonumber(data.goal) or 0)), GOLD, 5, 2.4)
		pop(1.4)
		for k = 1, 8 do
			task.delay(k * 0.25, function()
				local at = ChalkBoard.onBoard((math.random() - 0.5) * 30, ChalkBoard.BOARD_BOTTOM + 2 + math.random() * 10) + Vector3.new(0, 0, 1)
				burst(at, ({ GOLD, GREEN, Color3.fromRGB(255, 120, 200), Color3.fromRGB(110, 200, 255) })[k % 4 + 1], 50)
			end)
		end
	end

	-- Holding to write -----------------------------------------------------------------------
	local held = false
	local function setHeld(on: boolean)
		if on == held then return end
		held = on
		request:FireServer("chalkHold", on)
	end
	local function isWriteInput(input: InputObject): boolean
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Space
	end
	-- The mouse and the screen (clicks on buttons don't write).
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if active and not processed and isWriteInput(input) and input.KeyCode ~= Enum.KeyCode.Space and UserInputService:GetFocusedTextBox() == nil then setHeld(true) end
	end)
	-- Space is the jump key, which Roblox's controls take, so in the classroom
	-- it is taken first (bound while writing); bound keys never fire while
	-- typing in chat.
	local WRITE_ACTION = "ChalkboardWrite"
	local function onWriteKey(_name: string, inputState: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
		if inputState == Enum.UserInputState.Begin then
			setHeld(true)
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			setHeld(false)
		end
		return Enum.ContextActionResult.Sink
	end
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if isWriteInput(input) then setHeld(false) end
	end)
	UserInputService.WindowFocusReleased:Connect(function() setHeld(false) end)

	-- The writer's arm and chalk: the arm reaches up to the board and scribbles.
	local arm: { motor: Motor6D, base: CFrame, r15: boolean }? = nil
	local chalkStick: Part? = nil
	local function releaseArm()
		if arm then
			if arm.motor.Parent then arm.motor.C0 = arm.base end
			arm = nil
		end
		if chalkStick then
			chalkStick:Destroy()
			chalkStick = nil
		end
	end
	local function grabArm(): boolean
		local character = player.Character
		if character == nil then return false end
		local upper = character:FindFirstChild("RightUpperArm")
		local torso = character:FindFirstChild("Torso")
		local motor = if upper then upper:FindFirstChild("RightShoulder") elseif torso then torso:FindFirstChild("Right Shoulder") else nil
		if motor == nil or not motor:IsA("Motor6D") then return false end
		arm = { motor = motor, base = motor.C0, r15 = upper ~= nil }
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		if hand and hand:IsA("BasePart") then
			local stick = make("Part", { Name = "HeldChalk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 0.22, 0.22), Color = theme().chalk,
				Material = Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, CastShadow = false }, character)
			local weld = make("Weld", { Part0 = hand, Part1 = stick, C0 = CFrame.new(0, -hand.Size.Y / 2 - 0.1, -0.2) * CFrame.Angles(0, math.pi / 2, 0.6) }, stick)
			local _ = weld
			chalkStick = stick
		end
		return true
	end
	local wasHolding = false
	local lastDraw = 0
	-- The writer's right hand follows the chalk (an IKControl moves the arm to
	-- an invisible point on the board), and they step along the board to the
	-- digit being written. Only this player's own game does this.
	local handTarget = make("Part", { Name = "ChalkHandTarget", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }, drawing)
	local ik: IKControl? = nil
	local function handIK(): IKControl?
		if ik and ik.Parent then return ik end
		ik = nil
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local upper = character and character:FindFirstChild("RightUpperArm")
		local hand = character and character:FindFirstChild("RightHand")
		if humanoid == nil or upper == nil or hand == nil then return nil end -- R6: the old wiggle instead
		ik = make("IKControl", { Name = "ChalkHand", Type = Enum.IKControlType.Position, ChainRoot = upper, EndEffector = hand,
			Target = handTarget, SmoothTime = 0.04, Weight = 1, Enabled = false }, humanoid)
		return ik
	end
	local function writeWithHand(dt: number): boolean
		local control = handIK()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if control == nil or root == nil or not root:IsA("BasePart") then return false end
		-- The hand on the chalk while it writes; between numbers it hovers by
		-- the last stroke, a little off the board.
		local point = chalkPoint or ChalkBoard.onBoard(ChalkBoard.writerX(0) + 2, ChalkBoard.NUMBER_Y)
		local resting = os.clock() - chalkPointAt > 0.15
		handTarget.Position = point + Vector3.new(0, 0, if resting then 0.9 else 0.35)
		control.Enabled = true
		-- Step along the board so the hand reaches the digit being written.
		local want = ChalkBoard.ORIGIN.X + ChalkBoard.writerX(point.X - ChalkBoard.ORIGIN.X)
		local here = root.Position
		local x = here.X + (want - here.X) * math.min(1, dt * 6)
		local at = Vector3.new(x, here.Y, here.Z)
		root.CFrame = CFrame.lookAt(at, at - Vector3.new(0, 0, 1))
		return true
	end
	local function restHand()
		if ik then ik.Enabled = false end
	end
	RunService.RenderStepped:Connect(function(dt: number)
		if not active then return end
		-- A steady view of the writer and the board (gifts may shake it).
		local camera = workspace.CurrentCamera
		if camera then
			if camera.CameraType ~= Enum.CameraType.Scriptable then camera.CameraType = Enum.CameraType.Scriptable end
			local t = os.clock()
			local frame = ChalkBoard.cameraFrame()
			local shook = t - shakeStart
			if shook < shakeSeconds then
				local a = math.rad(shakeDegrees) * (1 - shook / shakeSeconds)
				frame *= CFrame.Angles(math.noise(shook * 18, 1) * a, math.noise(shook * 18, 5) * a, 0)
			end
			camera.CFrame = frame
			-- Roblox draws the most detail round the camera's focus: the board.
			camera.Focus = CFrame.new(ChalkBoard.centre())
		end
		-- The mouse stays free in the classroom.
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
		growStrokes()
		-- The hold at the goal: a gift that takes the count down ends it.
		local holdStart = attr("ChalkHoldStart", 0)
		hold.update(holdStart, workspace:GetServerTimeNow())
		if wasHolding and holdStart == 0 and attr("ChalkCount", 0) < attr("ChalkGoal", ChalkBoard.GOAL.default) then
			showShout("KNOCKED DOWN! THE HOLD IS LOST", RED, 3, 1.8)
		end
		wasHolding = holdStart > 0
		-- The arm writes while the server is writing.
		local writingNow = state:GetAttribute("ChalkWriting") == true
		if writingNow then
			if arm == nil then grabArm() end
			local a = arm
			if writeWithHand(dt) then
				-- The IKControl moves the arm (R15); the shoulder stays as it is.
				if a and a.motor.Parent then a.motor.C0 = a.base end
			elseif a then
				local t = os.clock() * math.min(30, 6 + speed * 2)
				local wiggle = CFrame.Angles(math.sin(t) * 0.12, math.cos(t * 1.3) * 0.1, 0)
				a.motor.C0 = a.base * (if a.r15 then CFrame.Angles(2.3, 0, 0) else CFrame.Angles(0, 0, 2.3)) * wiggle
			end
		elseif arm then
			releaseArm()
			restHand()
		end
		hint.Visible = not writingNow and attr("ChalkCount", 0) < 3
		-- The count, goal, progress and countdown on the board.
		local count = attr("ChalkCount", 0)
		local fast = writingNow and speed > ChalkView.FAST_SPEED
		if count ~= shownCount and os.clock() >= holdDrawUntil and (not fast or os.clock() - lastDraw >= 1 / ChalkView.FAST_DRAWS) then
			lastDraw = os.clock()
			local stepUp = count == shownCount + 1
			-- Writing draws the next number at the writing speed; very fast
			-- writing scribbles the changed digits a dozen times a second; a
			-- jump (a gift) draws each changed digit quickly.
			drawCount(count, if fast then 0.012 elseif stepUp then ChalkView.writeSeconds(speed) elseif shownCount >= 0 then 0.22 else 0)
			drawProgress(count)
			if not stepUp and shownCount >= 0 then dust(ChalkBoard.onBoard(0, ChalkBoard.NUMBER_Y), theme().chalk, 6, { 1, 4 }) end
		end
		if attr("ChalkGoal", 0) ~= shownGoal then
			drawGoal()
			drawProgress(count)
		end
		local ends = attr("ChalkResetEnds", 0)
		local left = if ends > 0 then ends - workspace:GetServerTimeNow() else -1
		drawCountdown(if left >= 0 then math.ceil(left) else -1)
		resetBox.Visible = left >= 0
		if left >= 0 then
			resetLabel.Text = ChalkView.resetText(left)
			saveLabel.Text = ChalkView.saveText(attr("ChalkSaveCoins", ChalkBoard.SAVE_COINS))
			resetLabel.TextTransparency = if left < 10 and (left % 0.5) < 0.25 then 0.4 else 0
		end
		-- The display.
		local goal = attr("ChalkGoal", ChalkBoard.GOAL.default)
		countLabel.Text = ChalkView.countText(count, goal)
		barFill.Size = UDim2.fromScale(math.clamp(count / math.max(1, goal), 0, 1), 1)
		statsLabel.Text = string.format('BEST <font color="#FFFFFF">%s</font>    WINS <font color="#F6C85C">%s</font>',
			Format.commas(attr("ChalkBest", 0)), Format.commas(attr("ChalkWins", 0)))
	end)
	state:GetAttributeChangedSignal("ChalkTheme"):Connect(function()
		refreshSettings()
		if active then redrawAll() end
		if chalkStick then chalkStick.Color = theme().chalk end
	end)

	local function setActive(on: boolean)
		if on == active then return end
		active = on
		gui.Enabled = on
		if on then
			ContextActionService:BindActionAtPriority(WRITE_ACTION, onWriteKey, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)
			redrawAll()
		else
			ContextActionService:UnbindAction(WRITE_ACTION)
			setHeld(false)
			releaseArm()
			restHand()
			clearSlots()
			for _, p in cornerParts do p:Destroy() end
			table.clear(cornerParts)
			if progressPart then progressPart:Destroy() end
			progressPart = nil
			drawCountdown(-1)
			local camera = workspace.CurrentCamera
			if camera then camera.CameraType = Enum.CameraType.Custom end
		end
	end
	player.CharacterAdded:Connect(function()
		arm = nil
		chalkStick = nil
		ik = nil
		setHeld(false)
	end)

	return { setActive = setActive, onGift = onGift, onReset = onReset, onWipe = onWipe, onWin = onWin }
end

return ChalkView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ClimbEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Diamond Climb's gift animations: a TikTok gift picks the climber up and
-- flies them up the tower (gifts that would break the mountain) or smashes
-- them down it (gifts that add stone), with a show for each gift tier. From
-- 100 coins they take over the camera, and each tier is wilder than the last.
--
-- Sent up:
--   1  BOUNCE PAD          (1+ coins)       a gold pad springs them up in a flip
--   2  SPRING LAUNCH       (10+ coins)      a giant spring coils and boings them up, spinning
--   3  ROCKET BOOST        (100+ coins)     a rocket ignites under them and corkscrews up the
--                                           tower in fire and smoke, then bursts into fireworks
--   4  DIAMOND CANNON      (500+ coins)     a gold cannon charges, fires them round the tower on
--                                           a rainbow trail through portals, and lands in a
--                                           shower of crystal
--   5  STARLIGHT ASCENT    (1,000+ coins)   night falls, a beam of starlight lifts them, stars
--                                           orbit them, every platform lights up as they fly
--                                           past, and they arrive in a supernova
--   6  GALACTIC ASCENSION  (10,000+ coins)  the sky goes black, a galaxy spins under them,
--                                           planets orbit, a big bang hurls them up at warp
--                                           speed through giant portals, fireworks all round
--                                           the tower and a galaxy nova at the top
-- Sent down:
--   1  BANANA SLIP         a banana peel, a backflip and a dizzy landing
--   2  SPIKE BOUNCE        spikes shoot out of the platform and bounce them off
--   3  ANVIL SMASH         an anvil falls on them, CLANG, and drives them down the tower
--   4  METEOR STRIKE       the sky burns, a meteor hits and blasts them off in flames
--   5  THUNDER HAMMER      a storm, lightning strikes, a giant hammer slams them down with
--                          lightning chasing them all the way
--   6  BLACK HOLE PLUNGE   a black hole opens, swallows the light and the climber, and spits
--                          them out far below in a nova
--
-- The climber's character is held (anchored on this computer) and carried
-- along a spiral round the tower to their new platform, then let go there.
-- Built like GiftEffects: Roblox's own particle textures, neon parts, trails
-- and lights, nothing physical, capped per tier, everything gone afterwards.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("DiamondRush")
local GiftTier = require(Shared:WaitForChild("GiftTier"))
local ClimbPath = require(Shared:WaitForChild("ClimbPath"))
local Format = require(Shared:WaitForChild("Format"))
local CameraShake = require(script.Parent:WaitForChild("CameraShake"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local ClimbEffects = {}

local TEXTURES = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	ember = "rbxasset://textures/particles/fire_sparks_main.dds",
	ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
}
ClimbEffects.TEXTURES = TEXTURES
ClimbEffects.UP_TITLES = ClimbPath.UP_TITLES
ClimbEffects.DOWN_TITLES = ClimbPath.DOWN_TITLES
-- Per tier: parts, lights and particles one show may create (checked by the tests).
ClimbEffects.PART_LIMITS = { 40, 60, 130, 170, 210, 260 }
ClimbEffects.LIGHT_LIMITS = { 2, 3, 4, 5, 6, 7 }
ClimbEffects.PARTICLE_BUDGETS = { 300, 450, 1400, 1800, 2200, 2800 }
-- Each show's own sounds: { seconds in, cue } (see Sounds).
ClimbEffects.UP_SOUNDS = {
	{ { 0.22, "boing" } },
	{ { 0.3, "boing" }, { 0.45, "whoosh" } },
	{ { 0, "launch" }, { 0.6, "whoosh" } },
	{ { 0, "rumble" }, { 0.8, "launch" } },
	{ { 0, "chime" }, { 0.5, "deepWhoosh" } },
	{ { 0, "rumble" }, { 0.6, "deepWhoosh" }, { 1.2, "launch" } },
}
ClimbEffects.DOWN_SOUNDS = {
	{ { 0.3, "slip" } },
	{ { 0.15, "zap" }, { 0.35, "falling" } },
	{ { 0.1, "falling" }, { 0.75, "clang" } },
	{ { 0, "deepWhoosh" }, { 0.8, "falling" } },
	{ { 0, "rumble" }, { 0.9, "falling" } },
	{ { 0, "deepWhoosh" }, { 0.7, "deepWhoosh" }, { 1.4, "falling" } },
}
-- From this tier up the show takes over the camera.
ClimbEffects.CINEMATIC_TIER = 3

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local GOLD = Color3.fromRGB(255, 206, 92)
local ORANGE = Color3.fromRGB(255, 132, 48)
local RED = Color3.fromRGB(255, 64, 72)
local CYAN = Color3.fromRGB(110, 235, 255)
local BLUE = Color3.fromRGB(80, 150, 255)
local VIOLET = Color3.fromRGB(168, 96, 255)
local PINK = Color3.fromRGB(255, 110, 200)
local GREEN = Color3.fromRGB(110, 240, 150)
local YELLOW = Color3.fromRGB(255, 232, 80)
local IRON = Color3.fromRGB(58, 60, 68)
local SMOKE = Color3.fromRGB(96, 90, 86)
-- Banner colours: gold and sky for up, red and violet for down.
local UP_COLOURS = { GOLD, Color3.fromRGB(255, 180, 90), ORANGE, CYAN, Color3.fromRGB(200, 220, 255), PINK }
local DOWN_COLOURS = { YELLOW, RED, Color3.fromRGB(200, 205, 220), ORANGE, CYAN, VIOLET }
local RAINBOW = { RED, ORANGE, YELLOW, GREEN, CYAN, BLUE, VIOLET, PINK }

local random = Random.new()
local label: TextLabel? = nil
local subLabel: TextLabel? = nil
local bannerScale: UIScale? = nil
local bannerSerial = 0
local current: { folder: Folder, finish: () -> () }? = nil
-- True while a show is stopped because the climber left the climb: the server
-- is moving them elsewhere, so the ride lets go of them where they are.
local leaving = false
local shownIndex: number? = nil

local function sequence(...: Color3): ColorSequence
	local colours = { ... }
	if #colours == 1 then return ColorSequence.new(colours[1]) end
	local keys = {}
	for i, colour in colours do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#colours - 1), colour))
	end
	return ColorSequence.new(keys)
end

local function curve(...: number): NumberSequence
	local values = { ... }
	if #values == 1 then return NumberSequence.new(values[1]) end
	local keys = {}
	for i, value in values do
		table.insert(keys, NumberSequenceKeypoint.new((i - 1) / (#values - 1), value))
	end
	return NumberSequence.new(keys)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end
local function easeIn(t: number): number
	return t * t * t
end
local function easeOut(t: number): number
	return 1 - (1 - t) ^ 3
end
local function easeOutQuart(t: number): number
	return 1 - (1 - t) ^ 4
end
ClimbEffects.ease = { smooth = smooth, easeIn = easeIn, easeOut = easeOut }

-- Camera shake, added after the show's camera moves.
local shake = 0
local shaking = false
local shakeTime = 0
local function addShake(degrees: number)
	shake = math.max(shake, degrees)
	if shaking then return end
	shaking = true
	RunService:BindToRenderStep("DiamondClimbShake", Enum.RenderPriority.Camera.Value + 4, function(dt: number)
		local camera = workspace.CurrentCamera
		if shake < 0.01 or camera == nil then
			shake = 0
			shaking = false
			RunService:UnbindFromRenderStep("DiamondClimbShake")
			return
		end
		shakeTime += dt
		local t = shakeTime * 19
		local a = math.rad(shake) * 1.5
		CameraShake.apply(camera, CFrame.Angles(math.noise(t, 0.3) * a, math.noise(t, 7.1) * a, math.noise(t, 13.7) * a * 0.5))
		shake *= math.exp(-dt * 3)
	end)
end
ClimbEffects.shaking = function(): boolean return shaking end

-- The banner: the show's name, big, and who sent what, under it.
function ClimbEffects.start(parent: Instance)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ClimbEffects"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 4
	gui.Parent = parent
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.27)
	holder.Size = UDim2.new(0.9, 0, 0, 110)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = holder
	bannerScale = scale
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 70)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextStrokeTransparency = 0.2
	title.TextTransparency = 1
	title.TextStrokeColor3 = BLACK
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 14
	limit.MaxTextSize = 64
	limit.Parent = title
	title.Parent = holder
	label = title
	local sub = Instance.new("TextLabel")
	sub.Position = UDim2.fromOffset(0, 72)
	sub.Size = UDim2.new(1, 0, 0, 30)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextStrokeTransparency = 0.3
	sub.TextTransparency = 1
	sub.TextColor3 = WHITE
	local subLimit = Instance.new("UITextSizeConstraint")
	subLimit.MinTextSize = 12
	subLimit.MaxTextSize = 26
	subLimit.Parent = sub
	sub.Parent = holder
	subLabel = sub
end

local function showBanner(title: string, sub: string, colour: Color3, tier: number, seconds: number)
	local text, small, scale = label, subLabel, bannerScale
	if text == nil or small == nil or scale == nil then return end
	bannerSerial += 1
	local serial = bannerSerial
	text.Text = title
	text.TextColor3 = colour
	text.TextTransparency = 0
	small.Text = sub
	small.TextTransparency = 0
	-- Bigger gifts slam in harder.
	scale.Scale = 1 + tier * 0.35
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(seconds, function()
		if serial ~= bannerSerial then return end
		TweenService:Create(text, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		TweenService:Create(small, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
	end)
end

-- The platform number the climber is passing during a ride, for the HUD; nil
-- when nothing is playing.
function ClimbEffects.shownIndex(): number?
	return shownIndex
end

function ClimbEffects.playing(): boolean
	return current ~= nil
end

-- Ends the show playing now at once (the climber is let go on their new platform).
-- Ends the show now. `inPlace` (the climber left the climb) lets go of them
-- where they are instead of putting them on the ride's platform.
function ClimbEffects.stop(inPlace: boolean?)
	local show = current
	if show then
		leaving = inPlace == true
		show.finish()
		leaving = false
	end
end

export type Particles = {
	texture: string,
	count: number,
	colour: ColorSequence,
	size: NumberSequence,
	transparency: NumberSequence?,
	lifetime: { number },
	speed: { number },
	spread: number?,
	drag: number?,
	acceleration: Vector3?,
	glow: number?,
	spin: number?,
	flat: boolean?,
}

-- Plays a climb gift: data = { up, from, to, coins, name, gift, platforms }.
-- `root` is the climber's HumanoidRootPart when it is this player riding.
-- `pace` above 1 plays it faster (gifts are queuing up). `onDone` runs when
-- the climber is let go. Returns how long it takes, in seconds.
function ClimbEffects.play(data: any, root: BasePart?, pace: number?, onDone: (() -> ())?): number
	ClimbEffects.stop()
	local speed = math.max(1, pace or 1)
	local coins = math.max(1, tonumber(data.coins) or 1)
	local tier = GiftTier.pick(coins, data.tier)
	local up = data.up == true
	local from = math.clamp(math.floor(tonumber(data.from) or 0), 0, ClimbPath.TOP)
	local to = math.clamp(math.floor(tonumber(data.to) or from), 0, ClimbPath.TOP)
	local total = ClimbPath.GIFT_SECONDS[tier]
	local seconds = total / speed
	local colour = (if up then UP_COLOURS else DOWN_COLOURS)[tier]
	local title = (if up then ClimbPath.UP_TITLES else ClimbPath.DOWN_TITLES)[tier]
	local moved = math.abs(to - from)
	showBanner(title, string.format("%s sent %s (%s)  ·  %s %s PLATFORM%s", tostring(data.name or "Someone"), tostring(data.gift or "a gift"),
		Format.commas(coins), if up then "UP" else "DOWN", Format.commas(moved), if moved == 1 then "" else "S"), colour, tier, math.max(1.6, seconds * 0.8))

	local folder = Instance.new("Folder")
	folder.Name = "ClimbGiftShow"
	folder.Parent = workspace
	-- The landing's sparks and rings outlast the ride a little.
	Debris:AddItem(folder, seconds + 3)
	local made, lights, emitted = 0, 0, 0
	local finished = false
	local released = false
	local function alive(): boolean
		return folder.Parent ~= nil and not finished
	end
	-- Script seconds to real seconds.
	local function S(t: number): number
		return t / speed
	end
	local function after(delay: number, callback: () -> ())
		task.delay(S(delay), function()
			if alive() then callback() end
		end)
	end
	-- The climber hears their own ride, wherever the camera is.
	local loudness = 1 + (tier - 1) * 0.15
	local function noise(name: string)
		if alive() then Sounds.play(name, nil, loudness) end
	end
	-- Each show's own sounds, on top of its bangs and sparkles.
	for _, cue in (if up then ClimbEffects.UP_SOUNDS else ClimbEffects.DOWN_SOUNDS)[tier] do
		after(cue[1], function() noise(cue[2]) end)
	end
	local function part(shape: Enum.PartType, size: Vector3, frame: CFrame, tint: Color3, material: Enum.Material?): Part?
		if not alive() or made >= ClimbEffects.PART_LIMITS[tier] then return nil end
		made += 1
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = frame
		p.Color = tint
		p.Material = material or Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = folder
		return p
	end
	local fovTween: Tween? = nil
	local function animate(p: Instance, duration: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
		local tween = TweenService:Create(p, TweenInfo.new(S(duration), style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
		if goal.FieldOfView ~= nil then fovTween = tween end
		tween:Play()
	end
	local function fade(p: Instance, duration: number, goal: { [string]: any })
		animate(p, duration, goal)
		Debris:AddItem(p, S(duration) + 0.05)
	end
	local connections: { [any]: boolean } = {}
	local function motion(duration: number, update: (number) -> (), finish: (() -> ())?)
		local elapsed = 0
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function(dt: number)
			elapsed += dt
			local t = math.clamp(elapsed / S(duration), 0, 1)
			if alive() then update(t) end
			if t >= 1 or not alive() then
				if connection then
					connections[connection] = nil
					connection:Disconnect()
					connection = nil
				end
				if alive() and finish then finish() end
			end
		end)
		connections[connection] = true
	end
	local function light(holder: Instance, tint: Color3, range: number, brightness: number, duration: number)
		if lights >= ClimbEffects.LIGHT_LIMITS[tier] then return end
		lights += 1
		local glow = Instance.new("PointLight")
		glow.Color = tint
		glow.Range = range
		glow.Brightness = brightness
		glow.Shadows = false
		glow.Parent = holder
		animate(glow, duration, { Brightness = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	local anchor = part(Enum.PartType.Block, Vector3.one * 0.2, CFrame.identity, WHITE) :: Part
	anchor.Transparency = 1
	local function point(at: Vector3, duration: number): Attachment
		local spot = Instance.new("Attachment")
		spot.Position = at
		spot.Parent = anchor
		Debris:AddItem(spot, duration)
		return spot
	end
	local function burst(at: Vector3, spec: Particles)
		if not alive() then return end
		local budget = ClimbEffects.PARTICLE_BUDGETS[tier]
		local count = math.min(spec.count, budget - emitted)
		if count <= 0 then return end
		emitted += count
		local particles = Instance.new("ParticleEmitter")
		particles.Texture = spec.texture
		particles.Color = spec.colour
		particles.Size = spec.size
		particles.Transparency = spec.transparency or curve(0, 1)
		particles.Lifetime = NumberRange.new(spec.lifetime[1], spec.lifetime[2])
		particles.Speed = NumberRange.new(spec.speed[1], spec.speed[2])
		local spread = spec.spread or 180
		particles.SpreadAngle = Vector2.new(spread, spread)
		particles.Drag = spec.drag or 0
		particles.Acceleration = spec.acceleration or Vector3.zero
		particles.LightEmission = spec.glow or 1
		particles.LightInfluence = if (spec.glow or 1) > 0 then 0 else 1
		particles.Rotation = NumberRange.new(0, 360)
		local spin = spec.spin or 0
		particles.RotSpeed = NumberRange.new(-spin, spin)
		particles.EmissionDirection = Enum.NormalId.Top
		if spec.flat then particles.Orientation = Enum.ParticleOrientation.VelocityPerpendicular end
		particles.Enabled = false
		particles.Parent = point(at, spec.lifetime[2] + 0.2)
		particles:Emit(count)
	end
	-- The colour grade over the whole screen: up to `peak` and back.
	local function grade(peak: { [string]: any }, rise: number, hold: number, fall: number)
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "ClimbGrade"
		effect.Parent = Lighting
		animate(effect, rise, peak)
		after(rise + hold, function()
			animate(effect, fall, { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		end)
		Debris:AddItem(effect, S(rise + hold + fall) + 0.1)
		-- Cleared with the show if it ends early.
		task.delay(seconds + 0.5, function() if effect.Parent then effect:Destroy() end end)
	end

	-- Effects ---------------------------------------------------------------------------
	local function sparkles(at: Vector3, tint: Color3, count: number, speedRange: { number }, size: number?)
		noise("sparkle")
		burst(at, { texture = TEXTURES.spark, count = count, colour = sequence(WHITE, tint), size = curve(size or 1.2, (size or 1.2) * 0.4, 0),
			lifetime = { 0.5, 1.2 }, speed = speedRange, drag = 3, spin = 200 })
	end
	local function shockwave(at: Vector3, radius: number, tint: Color3, duration: number)
		noise(if radius >= 18 then "bigBoom" elseif radius >= 7 then "boom" else "thud")
		burst(at, { texture = TEXTURES.ring, count = 1, colour = sequence(WHITE, tint),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, radius * 1.5), NumberSequenceKeypoint.new(1, radius * 2) }),
			transparency = curve(0, 0.2, 1), lifetime = { duration, duration }, speed = { 0.01, 0.01 }, spread = 0, flat = true })
	end
	local function fireball(at: Vector3, size: number, count: number)
		noise("boom")
		burst(at, { texture = TEXTURES.fire, count = count, colour = sequence(YELLOW, ORANGE, RED), size = curve(size * 0.6, size, size * 0.3),
			lifetime = { 0.4, 0.9 }, speed = { size * 1.5, size * 4 }, drag = 4, spin = 90 })
		burst(at, { texture = TEXTURES.smoke, count = math.ceil(count / 2), colour = sequence(SMOKE, Color3.fromRGB(60, 56, 54)), size = curve(size * 0.8, size * 1.8),
			transparency = curve(0.3, 1), lifetime = { 1, 2 }, speed = { size, size * 2.5 }, drag = 2, glow = 0, acceleration = Vector3.new(0, 4, 0) })
	end
	local function firework(at: Vector3, tint: Color3, count: number)
		noise("pop")
		burst(at, { texture = TEXTURES.spark, count = count, colour = sequence(WHITE, tint, tint), size = curve(1.6, 1, 0),
			lifetime = { 0.8, 1.6 }, speed = { 18, 34 }, drag = 2.5, acceleration = Vector3.new(0, -10, 0), spin = 300 })
		burst(at, { texture = TEXTURES.glow, count = 2, colour = sequence(tint), size = curve(6, 14, 0), lifetime = { 0.4, 0.5 }, speed = { 0, 0.1 } })
	end
	local function nova(at: Vector3, tint: Color3, radius: number, duration: number)
		noise("bigBoom")
		local ball = part(Enum.PartType.Ball, Vector3.one * 2, CFrame.new(at), WHITE)
		if ball then
			ball.Transparency = 0.05
			animate(ball, duration * 0.3, { Color = tint })
			fade(ball, duration, { Size = Vector3.one * radius * 2, Transparency = 1 })
			light(ball, tint, math.min(60, radius * 3), 8, duration)
		end
	end
	local function flash(at: Vector3, tint: Color3, size: number)
		local glow = part(Enum.PartType.Ball, Vector3.one * size * 0.3, CFrame.new(at), tint)
		if glow then
			glow.Transparency = 0.1
			fade(glow, 0.35, { Size = Vector3.one * size, Transparency = 1 })
		end
	end
	-- A ring of light round platform `index` (the platforms flash as riders pass).
	local function flashPlatform(index: number, tint: Color3)
		local top = ClimbPath.top(index)
		local size = ClimbPath.size(index) + 1.5
		local ring = part(Enum.PartType.Cylinder, Vector3.new(0.4, size, size), CFrame.new(top) * CFrame.Angles(0, 0, math.pi / 2), tint)
		if ring then
			ring.Transparency = 0.15
			fade(ring, 0.7, { Size = Vector3.new(0.1, size * 2.2, size * 2.2), Transparency = 1 })
		end
	end
	-- A jagged bolt of lightning from `a` to `b`.
	local function bolt(a: Vector3, b: Vector3, tint: Color3, width: number)
		noise("zap")
		local steps = 6
		local last = a
		for i = 1, steps do
			local t = i / steps
			local target = a + (b - a) * t
			if i < steps then
				target += Vector3.new(random:NextNumber(-1, 1), random:NextNumber(-0.4, 0.4), random:NextNumber(-1, 1)) * (b - a).Magnitude * 0.07
			end
			local length = (target - last).Magnitude
			if length > 0.05 then
				local segment = part(Enum.PartType.Block, Vector3.new(width, width, length), CFrame.lookAt((last + target) / 2, target), WHITE)
				if segment then
					animate(segment, 0.1, { Color = tint })
					fade(segment, 0.35, { Transparency = 1, Size = Vector3.new(width * 0.2, width * 0.2, length) })
				end
			end
			last = target
		end
		sparkles(b, tint, 16, { 10, 24 })
	end

	-- The ride ------------------------------------------------------------------------------
	local O = ClimbPath.ORIGIN
	local startFrame = ClimbPath.standFrame(from)
	local endFrame = ClimbPath.standFrame(to)
	local A, B = startFrame.Position, endFrame.Position
	local function reach(p: Vector3): number
		return Vector3.new(p.X - O.X, 0, p.Z - O.Z).Magnitude
	end
	local angleA, angleB = ClimbPath.angle(from), ClimbPath.angle(to)
	local reachA, reachB = reach(A), reach(B)
	-- A point on the spiral from the start to the new platform: `u` from 0 to 1,
	-- `bulge` studs further out from the tower mid-way, `lift` studs higher.
	local function spiral(u: number, bulge: number, lift: number): Vector3
		local angle = lerp(angleA, angleB, u)
		local r = lerp(reachA, reachB, u) + bulge * math.sin(math.pi * u)
		return Vector3.new(O.X + math.cos(angle) * r, lerp(A.Y, B.Y, u) + lift, O.Z + math.sin(angle) * r)
	end
	local riderPos = A
	local riderLook = startFrame.LookVector
	local riding = root ~= nil and root.Parent ~= nil
	if riding and root then
		root.Anchored = true
	end
	shownIndex = from
	local function place(at: Vector3, spinX: number, spinY: number, spinZ: number)
		local step = Vector3.new(at.X - riderPos.X, 0, at.Z - riderPos.Z)
		if step.Magnitude > 0.05 then riderLook = step.Unit end
		riderPos = at
		if riding and not released and root and root.Parent then
			root.CFrame = CFrame.lookAt(at, at + riderLook) * CFrame.Angles(spinX, spinY, spinZ)
		end
	end
	-- Rides the spiral over `length` seconds from `start`, eased; `lift(u)` is the
	-- extra height along the way, `flips`/`spins`/`rolls` whole turns.
	local function ride(start: number, length: number, spec: { [string]: any })
		after(start, function()
			local ease = spec.ease or smooth
			local bulge = spec.bulge or 0
			local lift = spec.lift or function(_u: number): number return 0 end
			local flips, spins, rolls = spec.flips or 0, spec.spins or 0, spec.rolls or 0
			motion(length, function(t: number)
				local u = ease(t)
				place(spiral(u, bulge, lift(u)), u * flips * 2 * math.pi, u * spins * 2 * math.pi, u * rolls * 2 * math.pi)
				if not released then shownIndex = lerp(from, to, u) end
			end)
		end)
	end
	-- Holds the rider at the start, offset by `offset(t)` (a hover or a wobble).
	local function hover(start: number, length: number, offset: (number) -> Vector3, spins: number?)
		after(start, function()
			motion(length, function(t: number)
				place(A + offset(t), 0, t * (spins or 0) * 2 * math.pi, 0)
			end)
		end)
	end
	-- An invisible tracer that follows the rider, carrying trails.
	local tracer = part(Enum.PartType.Ball, Vector3.one * 0.3, CFrame.new(A), WHITE)
	if tracer then
		tracer.Transparency = 1
		motion(total, function()
			tracer.CFrame = CFrame.new(riderPos)
		end)
	end
	local function trail(colours: ColorSequence, width: number, life: number)
		if tracer == nil then return end
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, width / 2, 0)
		a0.Parent = tracer
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -width / 2, 0)
		a1.Parent = tracer
		local streak = Instance.new("Trail")
		streak.Attachment0 = a0
		streak.Attachment1 = a1
		streak.Color = colours
		streak.Lifetime = life
		streak.LightEmission = 1
		streak.FaceCamera = true
		streak.Transparency = curve(0, 1)
		streak.WidthScale = curve(1, 0.1)
		streak.Parent = tracer
	end
	-- Something every `every` seconds while the rider moves from `start` for `length`.
	local function along(start: number, length: number, every: number, callback: (number) -> ())
		local steps = math.max(1, math.floor(length / every))
		for i = 0, steps - 1 do
			after(start + i * every, function() callback(i / steps) end)
		end
	end
	-- The platforms between here and there flash as the rider goes by.
	local function flashPassed(start: number, length: number, tint: Color3, flashes: number)
		if moved < 2 then return end
		local count = math.min(flashes, moved)
		for i = 1, count do
			local u = i / (count + 1)
			after(start + length * u, function()
				flashPlatform(math.floor(lerp(from, to, u) + 0.5), tint)
			end)
		end
	end

	-- The camera: from 100 coins the show films the rider from outside the tower.
	local camera = workspace.CurrentCamera
	local filming = tier >= ClimbEffects.CINEMATIC_TIER and riding and camera ~= nil
	local savedType = if camera then camera.CameraType else nil
	local savedFov = if camera then camera.FieldOfView else 70
	if filming and camera then
		local distance = 26 + tier * 5
		local height = 6 + tier * 1.5
		local camPos = camera.CFrame.Position
		camera.CameraType = Enum.CameraType.Scriptable
		RunService:BindToRenderStep("DiamondClimbCamera", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
			local around = Vector3.new(riderPos.X - O.X, 0, riderPos.Z - O.Z)
			local out = if around.Magnitude > 0.1 then around.Unit else Vector3.new(1, 0, 0)
			local want = riderPos + out * distance + Vector3.new(0, height, 0)
			camPos += (want - camPos) * math.min(1, dt * 5)
			camera.CFrame = CFrame.lookAt(camPos, riderPos)
		end)
	end
	local function punch(fov: number, rise: number, hold: number, fall: number)
		if not filming or camera == nil then return end
		animate(camera, rise, { FieldOfView = fov })
		after(rise + hold, function() animate(camera, fall, { FieldOfView = savedFov }) end)
	end

	-- At the end of the ride the climber is let go on their new platform and
	-- gets their camera back, while the landing's effects fade.
	local function release()
		if released then return end
		released = true
		if current and current.folder == folder then current = nil end
		shownIndex = nil
		if filming then RunService:UnbindFromRenderStep("DiamondClimbCamera") end
		if camera and filming then
			-- A zoom still tweening would undo the reset.
			if fovTween then fovTween:Cancel() end
			camera.CameraType = savedType or Enum.CameraType.Custom
			camera.FieldOfView = savedFov
		end
		if riding and root and root.Parent then
			if not leaving then root.CFrame = endFrame end
			root.AssemblyLinearVelocity = Vector3.zero
			root.Anchored = false
		end
		if onDone then onDone() end
	end
	-- Cut short (the next gift is here, or the climber left): everything goes now.
	local function abort()
		release()
		if finished then return end
		finished = true
		for connection in connections do connection:Disconnect() end
		table.clear(connections)
		folder:Destroy()
		for _, child in Lighting:GetChildren() do
			if child.Name == "ClimbGrade" then child:Destroy() end
		end
	end
	current = { folder = folder, finish = abort }
	task.delay(seconds, release)

	-- The shows ------------------------------------------------------------------------------
	local feet = A - Vector3.new(0, 3, 0)
	local landing = B - Vector3.new(0, 3, 0)
	local function arrive(at: number, tint: Color3, size: number)
		after(at, function()
			shockwave(landing + Vector3.new(0, 0.3, 0), size, tint, 0.8)
			sparkles(landing + Vector3.new(0, 1, 0), tint, 14 + size * 2, { 8, 18 + size })
			flashPlatform(to, tint)
		end)
	end

	if up and tier == 1 then
		-- BOUNCE PAD: a gold pad squashes and springs them up in a flip.
		local pad = part(Enum.PartType.Cylinder, Vector3.new(0.5, 4, 4), CFrame.new(feet + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), GOLD)
		if pad then
			animate(pad, 0.2, { Size = Vector3.new(0.2, 5, 5) })
			after(0.22, function() animate(pad, 0.15, { Size = Vector3.new(1, 4, 4) }, Enum.EasingStyle.Back) end)
			after(0.6, function() fade(pad, 0.4, { Transparency = 1 }) end)
			light(pad, GOLD, 12, 3, 1)
		end
		after(0.22, function() sparkles(feet, GOLD, 24, { 6, 14 }) end)
		ride(0.25, 0.95, { ease = smooth, bulge = 2, lift = function(u) return math.sin(math.pi * u) * 6 end, flips = 1 })
		arrive(1.2, GOLD, 4)
	elseif up and tier == 2 then
		-- SPRING LAUNCH: a big spring coils under them, then boings them up spinning.
		local coils: { Part } = {}
		for i = 1, 6 do
			local coil = part(Enum.PartType.Cylinder, Vector3.new(0.35, 4.5, 4.5), CFrame.new(feet + Vector3.new(0, i * 0.7, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				if i % 2 == 0 then WHITE else Color3.fromRGB(255, 170, 90))
			if coil then
				coil.Transparency = 1
				animate(coil, 0.15, { Transparency = 0.1 })
				table.insert(coils, coil)
			end
		end
		hover(0, 0.45, function(t) return Vector3.new(0, -t * 1.2, 0) end)
		for i, coil in coils do
			animate(coil, 0.4, { CFrame = CFrame.new(feet + Vector3.new(0, i * 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2) })
		end
		after(0.45, function()
			for i, coil in coils do
				animate(coil, 0.18, { CFrame = CFrame.new(feet + Vector3.new(0, i * 1.6, 0)) * CFrame.Angles(0, 0, math.pi / 2) }, Enum.EasingStyle.Back)
				after(0.5, function() fade(coil, 0.4, { Transparency = 1 }) end)
			end
			sparkles(feet + Vector3.new(0, 2, 0), Color3.fromRGB(255, 170, 90), 40, { 10, 22 })
			shockwave(feet + Vector3.new(0, 0.3, 0), 7, GOLD, 0.6)
			if tracer then light(tracer, GOLD, 16, 3, 1.4) end
			addShake(0.5)
		end)
		trail(sequence(GOLD, PINK, CYAN), 1.6, 0.5)
		ride(0.45, 1.3, { ease = smooth, bulge = 5, lift = function(u) return math.sin(math.pi * u) * 12 end, spins = 2, flips = 1 })
		along(0.5, 1.2, 0.12, function() sparkles(riderPos, PINK, 6, { 2, 6 }, 0.8) end)
		after(1.75, function() firework(landing + Vector3.new(0, 4, 0), PINK, 30) end)
		arrive(1.75, GOLD, 7)
	elseif up and tier == 3 then
		-- ROCKET BOOST: a rocket ignites under them and corkscrews up the tower.
		-- The rocket's pieces and where each sits under the climber.
		local pieces = {
			{ Enum.PartType.Cylinder, Vector3.new(4.5, 2.2, 2.2), CFrame.new(0, -4.6, 0) * CFrame.Angles(0, 0, math.pi / 2), WHITE },
			{ Enum.PartType.Ball, Vector3.one * 2.2, CFrame.new(0, -2.4, 0), RED },
		}
		for k = 0, 2 do
			local angle = k * math.pi * 2 / 3
			table.insert(pieces, { Enum.PartType.Block, Vector3.new(0.3, 1.6, 1.4), CFrame.new(math.cos(angle) * 1.4, -6.4, math.sin(angle) * 1.4) * CFrame.Angles(0, -angle, 0), RED })
		end
		local rocket: { Part } = {}
		local offsets: { CFrame } = {}
		for _, piece in pieces do
			local p = part(piece[1], piece[2], CFrame.new(A) * piece[3], piece[4], Enum.Material.SmoothPlastic)
			if p then
				table.insert(rocket, p)
				table.insert(offsets, piece[3])
			end
		end
		-- The rocket rides along under the climber.
		motion(2.9, function()
			for i, p in rocket do p.CFrame = CFrame.new(riderPos) * offsets[i] end
		end)
		after(0.2, function()
			fireball(feet - Vector3.new(0, 4, 0), 2.5, 30)
			shockwave(feet + Vector3.new(0, 0.3, 0), 10, ORANGE, 0.8)
			flash(feet, ORANGE, 12)
			addShake(1.2)
			grade({ Brightness = 0.08, Contrast = 0.15, TintColor = Color3.fromRGB(255, 225, 200) }, 0.2, 2.2, 0.8)
			if tracer then light(tracer, ORANGE, 24, 5, 3) end
		end)
		hover(0.2, 0.45, function(t) return Vector3.new(random:NextNumber(-0.15, 0.15), t * 1.5, random:NextNumber(-0.15, 0.15)) end)
		trail(sequence(YELLOW, ORANGE, RED, SMOKE), 2.4, 0.9)
		ride(0.65, 2.15, { ease = function(t) return smooth(easeIn(t) * 0.35 + t * 0.65) end, bulge = 14, lift = function(u) return math.sin(math.pi * u) * 10 end, rolls = 3 })
		punch(92, 0.4, 1.6, 0.8)
		along(0.2, 2.6, 0.06, function()
			burst(riderPos - Vector3.new(0, 6.5, 0), { texture = TEXTURES.fire, count = 6, colour = sequence(YELLOW, ORANGE, RED), size = curve(1.6, 2.4, 0.4),
				lifetime = { 0.25, 0.5 }, speed = { 8, 16 }, spread = 18, drag = 2, acceleration = Vector3.new(0, -30, 0) })
			burst(riderPos - Vector3.new(0, 7, 0), { texture = TEXTURES.smoke, count = 3, colour = sequence(Color3.fromRGB(200, 196, 190), SMOKE), size = curve(2, 5),
				transparency = curve(0.4, 1), lifetime = { 0.8, 1.5 }, speed = { 1, 4 }, glow = 0 })
		end)
		along(0.9, 1.8, 0.45, function() addShake(0.8) end)
		flashPassed(0.65, 2.15, ORANGE, 12)
		after(2.8, function()
			-- The rocket bursts into fireworks.
			for _, p in rocket do
				local fling = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(0.3, 1), random:NextNumber(-1, 1)).Unit * 14
				fade(p, 0.6, { CFrame = p.CFrame + fling, Transparency = 1 })
			end
			fireball(B + Vector3.new(0, 1, 0), 3, 26)
			for k = 1, 3 do
				local angle = k * math.pi * 2 / 3
				firework(B + Vector3.new(math.cos(angle) * 8, 8 + k * 2, math.sin(angle) * 8), RAINBOW[k * 2], 40)
			end
			flash(B, WHITE, 16)
			addShake(1.4)
		end)
		arrive(2.85, ORANGE, 10)
	elseif up and tier == 4 then
		-- DIAMOND CANNON: a gold cannon charges up and fires them round the tower.
		local out = Vector3.new(A.X - O.X, 0, A.Z - O.Z).Unit
		local base = feet + out * 1.5
		local aim = (Vector3.new(0, 1, 0) + riderLook * 0.6).Unit
		local mouth = base + aim * 6.5
		local barrel = part(Enum.PartType.Cylinder, Vector3.new(9, 3.6, 3.6), CFrame.lookAt(base + aim * 2, base + aim * 3) * CFrame.Angles(0, math.pi / 2, 0), GOLD, Enum.Material.Foil)
		local ring1 = part(Enum.PartType.Cylinder, Vector3.new(0.8, 4.4, 4.4), CFrame.lookAt(mouth, mouth + aim) * CFrame.Angles(0, math.pi / 2, 0), CYAN)
		local wheelL = part(Enum.PartType.Cylinder, Vector3.new(0.8, 4, 4), CFrame.lookAt(base, base + riderLook) * CFrame.new(-2.4, 0, 0), IRON, Enum.Material.Metal)
		local wheelR = part(Enum.PartType.Cylinder, Vector3.new(0.8, 4, 4), CFrame.lookAt(base, base + riderLook) * CFrame.new(2.4, 0, 0), IRON, Enum.Material.Metal)
		local gem = part(Enum.PartType.Block, Vector3.one * 2.4, CFrame.new(base - aim * 2.5) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), CYAN, Enum.Material.Glass)
		local cannon: { Part } = {}
		for _, p in { barrel, ring1, wheelL, wheelR, gem } do
			if p then
				local size = p.Size
				p.Size = size * 0.05
				animate(p, 0.35, { Size = size }, Enum.EasingStyle.Back)
				table.insert(cannon, p)
			end
		end
		sparkles(base, CYAN, 30, { 6, 14 })
		-- Pulled into the barrel's mouth.
		hover(0.3, 0.5, function(t) return (mouth - A) * smooth(t) end, 1)
		-- Charging: energy rushes in from all round.
		after(0.8, function()
			if ring1 then light(ring1, CYAN, 22, 1, 0.1) end
			for k = 1, 10 do
				local angle = k * math.pi * 2 / 10
				local start = mouth + Vector3.new(math.cos(angle) * 14, random:NextNumber(-4, 6), math.sin(angle) * 14)
				local orb = part(Enum.PartType.Ball, Vector3.one * 0.9, CFrame.new(start), RAINBOW[(k - 1) % #RAINBOW + 1])
				if orb then
					after(k * 0.05, function() fade(orb, 0.6, { CFrame = CFrame.new(mouth), Size = Vector3.one * 0.2 }) end)
				end
			end
		end)
		along(0.8, 0.8, 0.2, function(t) addShake(0.3 + t); sparkles(mouth, CYAN, 8, { 1, 4 }) end)
		after(1.6, function()
			-- FIRE.
			flash(mouth, WHITE, 26)
			shockwave(mouth, 14, CYAN, 0.9)
			shockwave(feet + Vector3.new(0, 0.3, 0), 18, GOLD, 1.1)
			fireball(mouth, 3, 24)
			for k = 1, 14 do
				local dir = (aim + Vector3.new(random:NextNumber(-0.8, 0.8), random:NextNumber(-0.3, 0.8), random:NextNumber(-0.8, 0.8))).Unit
				local shard = part(Enum.PartType.Block, Vector3.new(0.6, 0.6, 1.6), CFrame.lookAt(mouth, mouth + dir), RAINBOW[(k - 1) % #RAINBOW + 1], Enum.Material.Glass)
				if shard then fade(shard, 0.8, { CFrame = CFrame.lookAt(mouth + dir * 22, mouth + dir * 23), Transparency = 1 }) end
			end
			addShake(2.2)
			grade({ Brightness = 0.25, Contrast = 0.2, Saturation = 0.3 }, 0.08, 0.3, 0.9)
			for _, p in cannon do
				after(0.8, function() fade(p, 0.6, { Transparency = 1, Size = p.Size * 0.3 }) end)
			end
		end)
		trail(sequence(RED, ORANGE, YELLOW, GREEN, CYAN, BLUE, VIOLET), 2.6, 1.1)
		ride(1.6, 2.4, { ease = easeOutQuart, bulge = 24, lift = function(u) return math.sin(math.pi * u) * 20 end, spins = 3, flips = 2 })
		punch(100, 0.12, 1.6, 1)
		-- Portals along the way, and diamond sparkles.
		for k = 1, 4 do
			local u = k / 5
			local at = spiral(easeOutQuart(lerp(0, 1, u)), 24, math.sin(math.pi * easeOutQuart(u)) * 20)
			local portal = part(Enum.PartType.Cylinder, Vector3.new(0.4, 1, 1), CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), RAINBOW[k * 2])
			if portal then
				portal.Transparency = 0.45
				animate(portal, 0.4, { Size = Vector3.new(0.4, 12, 12) }, Enum.EasingStyle.Back)
				after(1.6 + 2.4 * u * 0.55, function()
					shockwave(at, 10, RAINBOW[k * 2], 0.6)
					fade(portal, 0.4, { Size = Vector3.new(0.2, 20, 20), Transparency = 1 })
				end)
			end
		end
		along(1.7, 2.2, 0.08, function() sparkles(riderPos, CYAN, 6, { 3, 8 }, 1) end)
		flashPassed(1.6, 2.4, CYAN, 16)
		after(4.0, function()
			-- A shower of crystal at the top.
			nova(B, CYAN, 10, 0.8)
			shockwave(landing + Vector3.new(0, 0.3, 0), 16, CYAN, 1)
			shockwave(landing + Vector3.new(0, 2, 0), 10, GOLD, 0.8)
			for k = 1, 12 do
				local dir = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(0.2, 1), random:NextNumber(-1, 1)).Unit
				local shard = part(Enum.PartType.Block, Vector3.new(0.7, 0.7, 1.4), CFrame.lookAt(B, B + dir), RAINBOW[(k - 1) % #RAINBOW + 1], Enum.Material.Glass)
				if shard then fade(shard, 1, { CFrame = CFrame.lookAt(B + dir * 18 - Vector3.new(0, 6, 0), B + dir * 19), Transparency = 1 }) end
			end
			sparkles(B, WHITE, 60, { 10, 28 }, 1.6)
			addShake(1.6)
		end)
		arrive(4.0, CYAN, 12)
	elseif up and tier == 5 then
		-- STARLIGHT ASCENT: night falls and a beam of starlight carries them up.
		grade({ Brightness = -0.18, Contrast = 0.25, Saturation = -0.2, TintColor = Color3.fromRGB(170, 190, 255) }, 0.5, 4.4, 1)
		for k = 1, 8 do
			local angle = k * math.pi / 4
			sparkles(A + Vector3.new(math.cos(angle) * 20, random:NextNumber(0, 18), math.sin(angle) * 20), WHITE, 10, { 0.5, 2 }, 1.4)
		end
		local beam = part(Enum.PartType.Cylinder, Vector3.new(160, 1, 1), CFrame.new(A + Vector3.new(0, 76, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(220, 235, 255))
		if beam then
			beam.Transparency = 0.35
			animate(beam, 0.4, { Size = Vector3.new(160, 9, 9) }, Enum.EasingStyle.Back)
			light(beam, Color3.fromRGB(200, 220, 255), 30, 4, 2)
			after(1.6, function() fade(beam, 0.8, { Size = Vector3.new(160, 0.2, 0.2), Transparency = 1 }) end)
		end
		after(0.3, function() shockwave(feet + Vector3.new(0, 0.3, 0), 12, WHITE, 0.9) end)
		hover(0.4, 1.0, function(t) return Vector3.new(0, smooth(t) * 5, 0) end, 1)
		-- Stars orbit the climber the whole way.
		local orbiters: { Part } = {}
		for k = 1, 6 do
			local orb = part(Enum.PartType.Ball, Vector3.one * 0.9, CFrame.new(A), if k % 2 == 0 then CYAN else WHITE)
			if orb then table.insert(orbiters, orb) end
		end
		motion(5.2, function(t)
			for k, orb in orbiters do
				local angle = t * 26 + k * math.pi / 3
				orb.CFrame = CFrame.new(riderPos + Vector3.new(math.cos(angle) * 4.5, math.sin(t * 13 + k) * 1.5, math.sin(angle) * 4.5))
			end
		end, function()
			for _, orb in orbiters do fade(orb, 0.3, { Transparency = 1 }) end
		end)
		after(1.4, function()
			flash(riderPos, WHITE, 22)
			shockwave(riderPos, 16, CYAN, 0.9)
			sparkles(riderPos, CYAN, 70, { 14, 30 }, 1.6)
			addShake(1.8)
			if tracer then light(tracer, CYAN, 26, 4, 4) end
		end)
		trail(sequence(WHITE, CYAN, BLUE, VIOLET), 2.4, 1.2)
		ride(1.4, 3.6, { ease = smooth, bulge = 18, lift = function(u) return 5 * (1 - u) + math.sin(math.pi * u) * 24 end, spins = 4 })
		punch(100, 0.5, 2.6, 1)
		along(1.5, 3.4, 0.07, function() sparkles(riderPos, WHITE, 5, { 2, 6 }, 1.1) end)
		along(1.8, 3, 0.7, function(t)
			local side = Vector3.new(math.cos(t * 9) * 10, 4, math.sin(t * 9) * 10)
			firework(riderPos + side, if t < 0.5 then CYAN else VIOLET, 30)
		end)
		flashPassed(1.4, 3.6, Color3.fromRGB(200, 225, 255), 24)
		after(5.0, function()
			-- SUPERNOVA.
			nova(B, Color3.fromRGB(200, 230, 255), 16, 1)
			shockwave(landing + Vector3.new(0, 0.3, 0), 22, CYAN, 1.2)
			shockwave(B + Vector3.new(0, 3, 0), 14, WHITE, 0.9)
			shockwave(B + Vector3.new(0, 6, 0), 9, VIOLET, 0.7)
			sparkles(B, WHITE, 120, { 14, 40 }, 1.8)
			grade({ Brightness = 0.3, Contrast = 0.1 }, 0.06, 0.15, 0.6)
			addShake(2.2)
		end)
		arrive(5.0, CYAN, 14)
	elseif up and tier == 6 then
		-- GALACTIC ASCENSION: a galaxy spins under them, a big bang hurls them up at warp speed.
		grade({ Brightness = -0.3, Contrast = 0.35, Saturation = 0.25, TintColor = Color3.fromRGB(205, 170, 255) }, 0.6, 6, 1.2)
		local arms: { Part } = {}
		for k = 1, 3 do
			local disc = part(Enum.PartType.Cylinder, Vector3.new(0.2, 4 + k * 7, 4 + k * 7), CFrame.new(feet - Vector3.new(0, k * 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), ({ PINK, VIOLET, BLUE })[k])
			if disc then
				disc.Transparency = 1
				animate(disc, 0.6, { Transparency = 0.45 + k * 0.1 })
				table.insert(arms, disc)
			end
		end
		local stars: { Part } = {}
		for k = 1, 16 do
			local star = part(Enum.PartType.Ball, Vector3.one * 0.7, CFrame.new(feet), RAINBOW[(k - 1) % #RAINBOW + 1])
			if star then table.insert(stars, star) end
		end
		-- The galaxy turns, faster and faster, until the big bang flings it out.
		motion(1.9, function(t)
			for k, star in stars do
				local arm = k % 2
				local r = 2 + (k / #stars) * 12
				local angle = t * t * 30 + arm * math.pi + r * 0.5
				star.CFrame = CFrame.new(feet + Vector3.new(math.cos(angle) * r, 0.5, math.sin(angle) * r))
			end
			for k, disc in arms do
				disc.CFrame = CFrame.new(feet - Vector3.new(0, k * 0.6, 0)) * CFrame.Angles(t * t * 12 * (if k % 2 == 0 then -1 else 1), 0, math.pi / 2)
			end
		end)
		-- Planets orbit the climber.
		local planets: { Part } = {}
		for k = 1, 3 do
			local planet = part(Enum.PartType.Ball, Vector3.one * (1 + k * 0.4), CFrame.new(A), ({ ORANGE, CYAN, PINK })[k], Enum.Material.SmoothPlastic)
			if planet then table.insert(planets, planet) end
		end
		motion(7, function(t)
			for k, planet in planets do
				local angle = t * (14 + k * 4) + k * 2
				planet.CFrame = CFrame.new(riderPos + Vector3.new(math.cos(angle) * (4 + k * 2), math.sin(angle * 0.7) * 2, math.sin(angle) * (4 + k * 2)))
			end
		end, function()
			for _, planet in planets do fade(planet, 0.3, { Transparency = 1 }) end
		end)
		hover(0.4, 1.4, function(t) return Vector3.new(random:NextNumber(-0.1, 0.1) * t, smooth(t) * 6, random:NextNumber(-0.1, 0.1) * t) end, 3)
		along(0.4, 1.4, 0.25, function(t) addShake(0.4 + t * 1.2); sparkles(feet, PINK, 10, { 2, 8 }) end)
		after(1.8, function()
			-- BIG BANG.
			flash(riderPos, WHITE, 40)
			nova(feet, PINK, 18, 0.9)
			shockwave(feet + Vector3.new(0, 0.3, 0), 30, PINK, 1.2)
			shockwave(feet + Vector3.new(0, 2, 0), 20, VIOLET, 1)
			shockwave(riderPos, 14, WHITE, 0.8)
			for _, star in stars do
				local dir = Vector3.new(star.Position.X - feet.X, random:NextNumber(-0.2, 0.6), star.Position.Z - feet.Z)
				if dir.Magnitude < 0.01 then dir = Vector3.new(1, 0, 0) end
				fade(star, 0.9, { CFrame = star.CFrame + dir.Unit * 40, Transparency = 1 })
			end
			for _, disc in arms do fade(disc, 0.6, { Size = disc.Size * 3, Transparency = 1 }) end
			sparkles(feet, WHITE, 120, { 20, 50 }, 2)
			grade({ Brightness = 0.4, Contrast = 0.2 }, 0.05, 0.1, 0.5)
			addShake(2.6)
			if tracer then light(tracer, PINK, 30, 5, 5) end
		end)
		trail(sequence(RED, ORANGE, YELLOW, GREEN, CYAN, BLUE, VIOLET, PINK), 3.2, 1.4)
		ride(1.8, 5, { ease = function(t) return easeOutQuart(t) * 0.7 + smooth(t) * 0.3 end, bulge = 30,
			lift = function(u) return 6 * (1 - u) + math.sin(math.pi * u) * 30 end, spins = 6, flips = 2 })
		punch(110, 0.1, 4, 1.4)
		-- Warp streaks rush past.
		along(1.9, 4.6, 0.06, function()
			local offset = Vector3.new(random:NextNumber(-12, 12), 0, random:NextNumber(-12, 12))
			local streak = part(Enum.PartType.Block, Vector3.new(0.18, 9, 0.18), CFrame.new(riderPos + offset + Vector3.new(0, 18, 0)), RAINBOW[random:NextInteger(1, #RAINBOW)])
			if streak then fade(streak, 0.35, { CFrame = CFrame.new(riderPos + offset - Vector3.new(0, 26, 0)), Transparency = 1 }) end
		end)
		-- Giant portals to fly through.
		for k = 1, 6 do
			local u = k / 7
			local eased = easeOutQuart(u) * 0.7 + smooth(u) * 0.3
			local at = spiral(eased, 30, 6 * (1 - eased) + math.sin(math.pi * eased) * 30)
			local portal = part(Enum.PartType.Cylinder, Vector3.new(0.5, 1, 1), CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), RAINBOW[k + 1])
			if portal then
				portal.Transparency = 1
				after(1.8, function()
					animate(portal, 0.4, { Size = Vector3.new(0.5, 16, 16), Transparency = 0.4 }, Enum.EasingStyle.Back)
				end)
				after(1.8 + 5 * u * 0.92, function()
					shockwave(at, 14, RAINBOW[k + 1], 0.7)
					sparkles(at, RAINBOW[k + 1], 20, { 10, 24 })
					fade(portal, 0.4, { Size = Vector3.new(0.2, 28, 28), Transparency = 1 })
				end)
			end
		end
		along(2.2, 4.4, 0.55, function(t)
			local side = Vector3.new(math.cos(t * 14) * 14, 6, math.sin(t * 14) * 14)
			firework(riderPos + side, RAINBOW[math.floor(t * #RAINBOW) + 1], 34)
		end)
		flashPassed(1.8, 5, WHITE, 30)
		after(6.8, function()
			-- GALAXY NOVA, with fireworks all round the tower.
			nova(B, PINK, 22, 1.1)
			shockwave(landing + Vector3.new(0, 0.3, 0), 30, PINK, 1.3)
			shockwave(B + Vector3.new(0, 3, 0), 20, CYAN, 1.1)
			shockwave(B + Vector3.new(0, 6, 0), 14, GOLD, 0.9)
			shockwave(B + Vector3.new(0, 9, 0), 9, WHITE, 0.7)
			for k = 1, 6 do
				local angle = k * math.pi / 3
				firework(Vector3.new(O.X + math.cos(angle) * 40, B.Y + 10 + (k % 2) * 6, O.Z + math.sin(angle) * 40), RAINBOW[k + 1], 40)
			end
			sparkles(B, WHITE, 140, { 16, 46 }, 2)
			grade({ Brightness = 0.35, Contrast = 0.15, Saturation = 0.4 }, 0.05, 0.2, 0.7)
			addShake(2.4)
		end)
		arrive(6.8, PINK, 18)
	elseif tier == 1 then
		-- BANANA SLIP: a peel, a backflip and a dizzy landing.
		local peel = part(Enum.PartType.Block, Vector3.new(1.4, 0.3, 0.7), CFrame.new(feet + riderLook * 0.6 + Vector3.new(0, 0.2, 0)), YELLOW, Enum.Material.SmoothPlastic)
		if peel then
			light(peel, YELLOW, 10, 2, 0.8)
			after(0.3, function() fade(peel, 0.5, { CFrame = peel.CFrame + riderLook * 4 + Vector3.new(0, 2, 0), Transparency = 1 }) end)
		end
		ride(0.3, 0.9, { ease = smooth, bulge = 3, lift = function(u) return math.sin(math.pi * u) * 4 end, flips = -1.25 })
		after(1.15, function()
			burst(landing, { texture = TEXTURES.smoke, count = 10, colour = sequence(Color3.fromRGB(200, 196, 188)), size = curve(1, 3),
				transparency = curve(0.4, 1), lifetime = { 0.5, 1 }, speed = { 3, 7 }, glow = 0 })
		end)
		-- Dizzy stars.
		local dizzy: { Part } = {}
		for k = 1, 3 do
			local star = part(Enum.PartType.Ball, Vector3.one * 0.5, CFrame.new(B), YELLOW)
			if star then table.insert(dizzy, star) end
		end
		after(1.2, function()
			motion(0.4, function(t)
				for k, star in dizzy do
					local angle = t * 14 + k * math.pi * 2 / 3
					star.CFrame = CFrame.new(B + Vector3.new(math.cos(angle) * 1.4, 2.6, math.sin(angle) * 1.4))
				end
			end)
		end)
		arrive(1.2, YELLOW, 4)
	elseif tier == 2 then
		-- SPIKE BOUNCE: spikes shoot out of the platform and bounce them off.
		local spikes: { Part } = {}
		for k = 1, 8 do
			local angle = k * math.pi / 4
			local at = feet + Vector3.new(math.cos(angle) * 2.4, -1.5, math.sin(angle) * 2.4)
			local spike = part(Enum.PartType.Block, Vector3.new(0.5, 3, 0.5), CFrame.new(at) * CFrame.Angles(0, angle, 0.25), RED, Enum.Material.Metal)
			if spike then
				animate(spike, 0.15, { CFrame = CFrame.new(at + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, angle, 0.25) }, Enum.EasingStyle.Back)
				after(0.9, function() fade(spike, 0.4, { CFrame = CFrame.new(at) * CFrame.Angles(0, angle, 0.25), Transparency = 1 }) end)
				table.insert(spikes, spike)
			end
		end
		after(0.15, function()
			sparkles(feet + Vector3.new(0, 1, 0), RED, 30, { 8, 18 })
			addShake(0.6)
			if spikes[1] then light(spikes[1], RED, 14, 3, 0.8) end
		end)
		trail(sequence(RED, Color3.fromRGB(120, 20, 30)), 1.4, 0.4)
		ride(0.35, 1.4, { ease = smooth, bulge = 6, lift = function(u) return math.sin(math.pi * u) * 9 end, flips = -2 })
		after(1.75, function()
			burst(landing, { texture = TEXTURES.smoke, count = 14, colour = sequence(SMOKE), size = curve(1.5, 4),
				transparency = curve(0.3, 1), lifetime = { 0.6, 1.2 }, speed = { 4, 9 }, glow = 0 })
		end)
		arrive(1.75, RED, 7)
	elseif tier == 3 then
		-- ANVIL SMASH: an anvil falls on them, CLANG, and drives them down the tower.
		local shadow = part(Enum.PartType.Cylinder, Vector3.new(0.1, 1, 1), CFrame.new(feet + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2), BLACK, Enum.Material.SmoothPlastic)
		if shadow then
			shadow.Transparency = 0.6
			animate(shadow, 0.7, { Size = Vector3.new(0.1, 6, 6), Transparency = 0.25 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			after(0.75, function() fade(shadow, 0.2, { Transparency = 1 }) end)
		end
		local high = A + Vector3.new(0, 70, 0)
		local anvil: { Part } = {}
		local pieces = {
			{ Vector3.new(5, 1.6, 3), Vector3.new(0, 0.8, 0) },
			{ Vector3.new(2.4, 1.6, 2), Vector3.new(0, 2.4, 0) },
			{ Vector3.new(6.5, 1.6, 3), Vector3.new(0.6, 4, 0) },
			{ Vector3.new(2, 1.2, 1.6), Vector3.new(4.4, 4.2, 0) },
		}
		local offsets: { Vector3 } = {}
		for _, piece in pieces do
			local p = part(Enum.PartType.Block, piece[1], CFrame.new(high + piece[2]), IRON, Enum.Material.Metal)
			if p then
				table.insert(anvil, p)
				table.insert(offsets, piece[2] + Vector3.new(0, 2.6, 0))
			end
		end
		local anvilAt = high
		local function moveAnvil(at: Vector3)
			anvilAt = at
			for i, p in anvil do p.CFrame = CFrame.lookAt(at + offsets[i], at + offsets[i] + riderLook) end
		end
		motion(0.75, function(t) moveAnvil(high + (A - high) * easeIn(t)) end)
		after(0.75, function()
			-- CLANG.
			flash(A + Vector3.new(0, 3, 0), WHITE, 18)
			burst(A + Vector3.new(0, 3, 0), { texture = TEXTURES.ember, count = 60, colour = sequence(WHITE, YELLOW, ORANGE), size = curve(0.6, 0.2),
				lifetime = { 0.4, 0.9 }, speed = { 18, 40 }, drag = 2, acceleration = Vector3.new(0, -40, 0) })
			shockwave(feet + Vector3.new(0, 0.3, 0), 14, WHITE, 0.8)
			addShake(2)
			grade({ Brightness = 0.2, Contrast = 0.3, Saturation = -0.4 }, 0.04, 0.15, 0.5)
			if anvil[1] then light(anvil[1], YELLOW, 22, 6, 0.6) end
		end)
		-- Squashed, then driven down with the anvil on top.
		hover(0.75, 0.2, function(t) return Vector3.new(0, -t * 0.8, 0) end)
		motion(3, function()
			if anvilAt ~= high and riderPos ~= A then moveAnvil(riderPos) end
		end)
		trail(sequence(YELLOW, ORANGE, IRON), 2, 0.6)
		ride(0.95, 1.95, { ease = easeIn, bulge = 6, lift = function(u) return math.sin(math.pi * u) * 3 end, rolls = 1.5 })
		punch(90, 0.6, 1.2, 0.6)
		along(1, 1.9, 0.07, function()
			burst(riderPos + Vector3.new(0, 4, 0), { texture = TEXTURES.ember, count = 5, colour = sequence(YELLOW, ORANGE), size = curve(0.5, 0.1),
				lifetime = { 0.3, 0.6 }, speed = { 10, 20 }, drag = 2, acceleration = Vector3.new(0, 20, 0) })
		end)
		along(1.2, 1.6, 0.4, function() addShake(0.9) end)
		flashPassed(0.95, 1.95, RED, 12)
		after(2.9, function()
			-- THUD.
			fireball(landing + Vector3.new(0, 1, 0), 2, 16)
			shockwave(landing + Vector3.new(0, 0.3, 0), 16, ORANGE, 1)
			shockwave(landing + Vector3.new(0, 1.5, 0), 10, WHITE, 0.7)
			for k = 1, 8 do
				local dir = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(0.4, 1), random:NextNumber(-1, 1)).Unit
				local chunk = part(Enum.PartType.Block, Vector3.one * random:NextNumber(0.5, 1.1), CFrame.new(landing + Vector3.new(0, 1, 0)), ClimbPath.colour(to), Enum.Material.SmoothPlastic)
				if chunk then fade(chunk, 0.8, { CFrame = CFrame.new(landing + dir * 12 - Vector3.new(0, 4, 0)) * CFrame.Angles(3, 2, 1), Transparency = 1 }) end
			end
			for _, p in anvil do
				fade(p, 0.7, { CFrame = p.CFrame + Vector3.new(0, 8, 0) + riderLook * 10, Transparency = 1 })
			end
			addShake(2.2)
		end)
		arrive(2.9, RED, 10)
	elseif tier == 4 then
		-- METEOR STRIKE: the sky burns, a meteor hits and blasts them off in flames.
		grade({ Brightness = -0.05, Contrast = 0.3, Saturation = 0.3, TintColor = Color3.fromRGB(255, 190, 150) }, 0.4, 3.4, 0.8)
		local out = Vector3.new(A.X - O.X, 0, A.Z - O.Z).Unit
		local sky = A + out * 90 + Vector3.new(0, 110, 0)
		local meteor = part(Enum.PartType.Ball, Vector3.one * 7, CFrame.new(sky), Color3.fromRGB(70, 50, 40), Enum.Material.Basalt)
		local core = part(Enum.PartType.Ball, Vector3.one * 5.2, CFrame.new(sky), ORANGE)
		local meteorAt = sky
		if meteor then
			light(meteor, ORANGE, 40, 6, 1.4)
			motion(1.2, function(t)
				meteorAt = sky + (A - sky) * easeIn(t)
				meteor.CFrame = CFrame.new(meteorAt) * CFrame.Angles(t * 8, t * 5, 0)
				if core then core.CFrame = CFrame.new(meteorAt) end
			end, function()
				fade(meteor, 0.2, { Transparency = 1 })
				if core then fade(core, 0.2, { Transparency = 1, Size = Vector3.one * 14 }) end
			end)
		end
		along(0, 1.2, 0.05, function()
			burst(meteorAt, { texture = TEXTURES.fire, count = 6, colour = sequence(YELLOW, ORANGE, RED), size = curve(4, 6, 1),
				lifetime = { 0.3, 0.6 }, speed = { 1, 4 }, drag = 1 })
			burst(meteorAt, { texture = TEXTURES.smoke, count = 3, colour = sequence(SMOKE, Color3.fromRGB(40, 36, 34)), size = curve(4, 9),
				transparency = curve(0.3, 1), lifetime = { 1, 2 }, speed = { 0.5, 2 }, glow = 0 })
		end)
		along(0.3, 0.9, 0.3, function(t) addShake(0.4 + t) end)
		after(1.2, function()
			-- Impact.
			flash(A, YELLOW, 34)
			fireball(A, 4, 40)
			shockwave(feet + Vector3.new(0, 0.3, 0), 22, ORANGE, 1.1)
			shockwave(feet + Vector3.new(0, 3, 0), 14, RED, 0.9)
			shockwave(feet + Vector3.new(0, 6, 0), 9, YELLOW, 0.7)
			burst(A, { texture = TEXTURES.ember, count = 80, colour = sequence(YELLOW, ORANGE, RED), size = curve(0.8, 0.2),
				lifetime = { 0.6, 1.4 }, speed = { 20, 46 }, drag = 1.5, acceleration = Vector3.new(0, -30, 0) })
			addShake(2.5)
			grade({ Brightness = 0.3, Contrast = 0.2 }, 0.05, 0.12, 0.5)
			if tracer then light(tracer, ORANGE, 24, 4, 3) end
		end)
		trail(sequence(YELLOW, ORANGE, RED, SMOKE), 2.6, 1)
		ride(1.3, 2.7, { ease = smooth, bulge = 22, lift = function(u) return math.sin(math.pi * math.min(1, u * 1.6)) * 9 * (1 - u) end, flips = -3, spins = 2 })
		punch(98, 0.15, 2, 0.8)
		along(1.35, 2.6, 0.06, function()
			burst(riderPos, { texture = TEXTURES.fire, count = 4, colour = sequence(YELLOW, ORANGE, RED), size = curve(1.6, 2.4, 0.3),
				lifetime = { 0.3, 0.6 }, speed = { 1, 4 } })
			burst(riderPos, { texture = TEXTURES.smoke, count = 2, colour = sequence(SMOKE), size = curve(2, 5),
				transparency = curve(0.4, 1), lifetime = { 0.8, 1.6 }, speed = { 0.5, 2 }, glow = 0 })
		end)
		-- Burning rocks fall alongside.
		along(1.5, 2.2, 0.3, function()
			local start = riderPos + Vector3.new(random:NextNumber(-10, 10), 14, random:NextNumber(-10, 10))
			local rock = part(Enum.PartType.Ball, Vector3.one * random:NextNumber(1, 2), CFrame.new(start), ORANGE)
			if rock then fade(rock, 0.8, { CFrame = CFrame.new(start - Vector3.new(0, 40, 0)), Transparency = 1 }) end
		end)
		flashPassed(1.3, 2.7, ORANGE, 16)
		after(4.0, function()
			fireball(landing + Vector3.new(0, 1, 0), 3, 30)
			burst(landing, { texture = TEXTURES.smoke, count = 20, colour = sequence(SMOKE, Color3.fromRGB(50, 46, 44)), size = curve(3, 8),
				transparency = curve(0.2, 1), lifetime = { 1.5, 2.5 }, speed = { 2, 6 }, spread = 25, glow = 0, acceleration = Vector3.new(0, 6, 0) })
			shockwave(landing + Vector3.new(0, 0.3, 0), 18, ORANGE, 1)
			addShake(2)
		end)
		arrive(4.0, ORANGE, 12)
	elseif tier == 5 then
		-- THUNDER HAMMER: a storm, lightning, and a giant hammer slams them down.
		grade({ Brightness = -0.25, Contrast = 0.4, Saturation = -0.5, TintColor = Color3.fromRGB(170, 190, 230) }, 0.4, 4.6, 1)
		local cloud = A + Vector3.new(0, 36, 0)
		along(0, 2, 0.25, function()
			burst(cloud + Vector3.new(random:NextNumber(-14, 14), random:NextNumber(-2, 2), random:NextNumber(-14, 14)), { texture = TEXTURES.smoke, count = 6,
				colour = sequence(Color3.fromRGB(60, 62, 76), Color3.fromRGB(30, 30, 40)), size = curve(8, 14), transparency = curve(0.3, 1),
				lifetime = { 1.5, 2.5 }, speed = { 0.5, 2 }, glow = 0 })
		end)
		for k = 1, 5 do
			after(0.2 + k * 0.22, function()
				local angle = random:NextNumber(0, math.pi * 2)
				local ground = feet + Vector3.new(math.cos(angle) * random:NextNumber(4, 12), 0, math.sin(angle) * random:NextNumber(4, 12))
				bolt(cloud + Vector3.new(random:NextNumber(-6, 6), 0, random:NextNumber(-6, 6)), ground, CYAN, 0.5)
				flash(ground, CYAN, 8)
				addShake(0.7)
			end)
		end
		-- The hammer swings down from overhead.
		local pivot = A + Vector3.new(0, 4, 0) - riderLook * 9
		local handle = part(Enum.PartType.Block, Vector3.new(1, 1, 12), CFrame.new(pivot), Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
		local head = part(Enum.PartType.Block, Vector3.new(6, 4.5, 4.5), CFrame.new(pivot), Color3.fromRGB(150, 160, 180), Enum.Material.Metal)
		local runes = part(Enum.PartType.Block, Vector3.new(6.2, 1, 4.7), CFrame.new(pivot), CYAN)
		local function swing(angle: number)
			local frame = CFrame.lookAt(pivot, pivot + riderLook) * CFrame.fromAxisAngle(Vector3.new(1, 0, 0), angle)
			if handle then handle.CFrame = frame * CFrame.new(0, 0, -6) end
			if head then head.CFrame = frame * CFrame.new(0, 0, -12.5) end
			if runes then runes.CFrame = frame * CFrame.new(0, 0, -12.5) end
		end
		swing(math.rad(80))
		motion(1.4, function(t) swing(math.rad(80 + 40 * smooth(t))) end)
		after(1.4, function()
			motion(0.6, function(t) swing(math.rad(120 - 125 * easeIn(t))) end)
		end)
		after(2.0, function()
			-- SMASH.
			bolt(cloud, A, WHITE, 1.2)
			bolt(cloud + Vector3.new(4, 0, 0), A, CYAN, 0.8)
			flash(A, WHITE, 36)
			nova(A, CYAN, 12, 0.6)
			shockwave(feet + Vector3.new(0, 0.3, 0), 24, CYAN, 1.1)
			shockwave(feet + Vector3.new(0, 2, 0), 16, WHITE, 0.9)
			shockwave(feet + Vector3.new(0, 4, 0), 10, BLUE, 0.7)
			sparkles(A, CYAN, 80, { 16, 40 }, 1.6)
			addShake(2.6)
			grade({ Brightness = 0.5, Contrast = 0.2 }, 0.03, 0.08, 0.4)
			for _, p in { handle, head, runes } do
				if p then after(0.4, function() fade(p, 0.5, { Transparency = 1 }) end) end
			end
			if tracer then light(tracer, CYAN, 26, 5, 3.4) end
		end)
		trail(sequence(WHITE, CYAN, BLUE), 2.4, 0.8)
		ride(2.1, 3.1, { ease = easeIn, bulge = 16, lift = function(u) return math.sin(math.pi * u) * 4 end, flips = -4, spins = 1 })
		punch(100, 0.15, 2.4, 0.8)
		-- Lightning chases them all the way down.
		along(2.3, 2.9, 0.3, function()
			bolt(riderPos + Vector3.new(random:NextNumber(-8, 8), 34, random:NextNumber(-8, 8)), riderPos, if random:NextNumber() < 0.5 then CYAN else WHITE, 0.45)
			addShake(0.6)
		end)
		along(2.2, 2.9, 0.08, function() sparkles(riderPos, CYAN, 4, { 3, 8 }, 0.9) end)
		flashPassed(2.1, 3.1, CYAN, 20)
		after(5.2, function()
			-- Thunder clap.
			bolt(landing + Vector3.new(0, 40, 0), landing, WHITE, 1.2)
			flash(landing, CYAN, 24)
			shockwave(landing + Vector3.new(0, 0.3, 0), 18, CYAN, 1)
			shockwave(landing + Vector3.new(0, 2, 0), 11, WHITE, 0.8)
			sparkles(landing, CYAN, 50, { 12, 30 }, 1.4)
			addShake(2)
		end)
		arrive(5.2, CYAN, 12)
	else
		-- BLACK HOLE PLUNGE: a black hole swallows the light and the climber.
		grade({ Brightness = -0.35, Contrast = 0.4, Saturation = -0.3, TintColor = Color3.fromRGB(190, 160, 255) }, 0.8, 6, 1.2)
		local out = Vector3.new(A.X - O.X, 0, A.Z - O.Z).Unit
		local holeAt = A + out * 14 - Vector3.new(0, 6, 0)
		local hole = part(Enum.PartType.Ball, Vector3.one * 0.5, CFrame.new(holeAt), BLACK, Enum.Material.SmoothPlastic)
		local disks: { Part } = {}
		for k = 1, 3 do
			local disk = part(Enum.PartType.Cylinder, Vector3.new(0.2, 1, 1), CFrame.new(holeAt) * CFrame.Angles(0.3, 0, math.pi / 2), ({ ORANGE, PINK, VIOLET })[k])
			if disk then
				disk.Transparency = 0.35 + k * 0.12
				table.insert(disks, disk)
			end
		end
		if hole then
			animate(hole, 1.2, { Size = Vector3.one * 9 }, Enum.EasingStyle.Back)
			light(hole, VIOLET, 40, 6, 7)
		end
		for k, disk in disks do
			animate(disk, 1.2, { Size = Vector3.new(0.2, 14 + k * 6, 14 + k * 6) }, Enum.EasingStyle.Back)
		end
		-- The hole and its disks turn, and follow the climber down later.
		local spinning = true
		motion(7.4, function(t)
			if not spinning then return end
			for k, disk in disks do
				disk.CFrame = CFrame.new(holeAt) * CFrame.Angles(0.3, t * 40 * (if k % 2 == 0 then -1 else 1), math.pi / 2)
			end
			if hole then hole.CFrame = CFrame.new(holeAt) end
		end)
		-- Everything near is pulled in: sparks and broken gems spiral into it.
		along(0.3, 2, 0.08, function(t)
			local angle = random:NextNumber(0, math.pi * 2)
			local start = holeAt + Vector3.new(math.cos(angle) * 26, random:NextNumber(-8, 12), math.sin(angle) * 26)
			local bit = part(Enum.PartType.Block, Vector3.one * random:NextNumber(0.4, 1), CFrame.new(start), RAINBOW[random:NextInteger(1, #RAINBOW)])
			if bit then
				local spinFrom = angle
				motion(0.9, function(s)
					local r = 26 * (1 - easeIn(s))
					local a = spinFrom + s * 6
					bit.CFrame = CFrame.new(holeAt + Vector3.new(math.cos(a) * r, (start.Y - holeAt.Y) * (1 - s), math.sin(a) * r)) * CFrame.Angles(s * 9, s * 7, 0)
				end, function() bit:Destroy() end)
			end
			if t > 0.5 then addShake(0.3 + t * 0.6) end
		end)
		hover(0.4, 2, function(t)
			local pull = holeAt + Vector3.new(0, 4, 0) - A
			return pull * easeIn(t) * 0.55 + Vector3.new(0, math.sin(t * 20) * 0.3, 0)
		end, 3)
		after(2.4, function()
			-- Swallowed.
			grade({ Brightness = -0.5, Contrast = 0.5 }, 0.15, 0.25, 0.6)
			shockwave(holeAt, 22, VIOLET, 1)
			burst(holeAt, { texture = TEXTURES.glow, count = 3, colour = sequence(VIOLET, BLACK), size = curve(20, 2), lifetime = { 0.5, 0.6 }, speed = { 0, 0.1 } })
			addShake(2.2)
			if tracer then light(tracer, VIOLET, 22, 4, 4) end
			spinning = false
		end)
		-- The hole plunges with them.
		after(2.4, function()
			motion(4.2, function(t)
				local below = riderPos - Vector3.new(0, 7, 0)
				holeAt = holeAt + (below - holeAt) * math.min(1, t * 4)
				if hole then hole.CFrame = CFrame.new(holeAt) end
				for k, disk in disks do
					disk.CFrame = CFrame.new(holeAt) * CFrame.Angles(0.3, t * 60 * (if k % 2 == 0 then -1 else 1), math.pi / 2)
				end
			end)
		end)
		trail(sequence(PINK, VIOLET, BLACK), 2.8, 1.2)
		ride(2.4, 4.2, { ease = function(t) return easeIn(t) * 0.5 + smooth(t) * 0.5 end, bulge = 20, lift = function(u) return (1 - u) * -2 end, spins = -5, rolls = 3 })
		punch(112, 0.3, 3.4, 1)
		-- Warped light streaks upward as they fall.
		along(2.5, 4, 0.06, function()
			local offset = Vector3.new(random:NextNumber(-12, 12), 0, random:NextNumber(-12, 12))
			local streak = part(Enum.PartType.Block, Vector3.new(0.18, 8, 0.18), CFrame.new(riderPos + offset - Vector3.new(0, 18, 0)), if random:NextNumber() < 0.5 then VIOLET else PINK)
			if streak then fade(streak, 0.35, { CFrame = CFrame.new(riderPos + offset + Vector3.new(0, 26, 0)), Transparency = 1 }) end
		end)
		along(2.6, 3.8, 0.5, function() addShake(0.9) end)
		flashPassed(2.4, 4.2, VIOLET, 30)
		after(6.6, function()
			-- Spat out in a nova.
			if hole then fade(hole, 0.3, { Size = Vector3.one * 0.2 }) end
			for _, disk in disks do fade(disk, 0.4, { Size = Vector3.new(0.2, 40, 40), Transparency = 1 }) end
			nova(B, WHITE, 20, 1)
			shockwave(landing + Vector3.new(0, 0.3, 0), 28, VIOLET, 1.2)
			shockwave(B + Vector3.new(0, 3, 0), 18, PINK, 1)
			shockwave(B + Vector3.new(0, 6, 0), 12, WHITE, 0.8)
			shockwave(B + Vector3.new(0, 9, 0), 8, ORANGE, 0.6)
			sparkles(B, VIOLET, 140, { 16, 44 }, 2)
			grade({ Brightness = 0.4, Contrast = 0.2 }, 0.04, 0.15, 0.6)
			addShake(2.6)
		end)
		arrive(6.6, VIOLET, 16)
	end
	return seconds
end

return ClimbEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">ClimbView</string>
            <string name="Source"><![CDATA[--!strict
-- Diamond Climb on this computer: the climb's display (platform, best and
-- climbs), the speed and jump sliders, the landing animation each time the
-- climber lands on a platform (a bigger one every hundred), sending each new
-- platform to the server as the checkpoint, putting the climber back on
-- their checkpoint when they fall, the gift rides (one after another, see
-- ClimbEffects), the hold at the top (stay there through a countdown from 10
-- without being sent down) and the win. Also turns the climb's diamond, and
-- keeps the whole tower out of sight from the other games (it is far off in
-- the sky, but tall enough to see from the mountain).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local ClimbPath = require(Shared:WaitForChild("ClimbPath"))
local Format = require(Shared:WaitForChild("Format"))
local ClimbEffects = require(script.Parent:WaitForChild("ClimbEffects"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local HoldCountdown = require(script.Parent:WaitForChild("HoldCountdown"))

local ClimbView = {}

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(246, 200, 92)
local RED = Color3.fromRGB(255, 84, 84)
local MUTED = Color3.fromRGB(168, 174, 190)
local PANEL = Color3.fromRGB(16, 18, 26)
local SELECTED = Color3.fromRGB(64, 128, 236)
local BUTTON = Color3.fromRGB(46, 50, 68)
local FONT = Enum.Font.GothamBold
local FONT_MEDIUM = Enum.Font.GothamMedium
local FONT_HEAVY = Enum.Font.GothamBlack
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local RING = "rbxasset://textures/particles/explosion01_shockwave_main.dds"
-- A short chime that ships with Roblox; it rises in pitch through each ten platforms.
ClimbView.LAND_SOUND = "rbxasset://sounds/electronicpingshort.wav"
-- Falling this far below the checkpoint puts the climber back on it.
ClimbView.FALL_DISTANCE = 24
-- Landing this many platforms below the checkpoint does too (falling a turn down).
ClimbView.FALL_PLATFORMS = 3

-- The pitch of the landing chime on platform `index`: up a step each
-- platform, starting again every ten.
function ClimbView.pitch(index: number): number
	return 0.8 + (index % 10) * 0.07
end

-- The wall's health colour: green when whole, gold, then red near breaking.
function ClimbView.wallColour(health: number, max: number): string
	local fraction = health / math.max(1, max)
	return if fraction > 0.6 then "#76E6A0" elseif fraction > 0.25 then "#F6C85C" else "#FF5454"
end

-- What the climb's display says.
function ClimbView.platformText(index: number): string
	return string.format("PLATFORM %s / %s", Format.commas(math.floor(index + 0.5)), Format.commas(ClimbPath.TOP))
end

-- Platform numbers float over the platforms near the climber: this many below
-- and above the one they're on (only those, so 1000 signs never draw at once).
ClimbView.NUMBERS_BELOW, ClimbView.NUMBERS_ABOVE = 6, 24
ClimbView.NUMBER_HEIGHT = 1.8 -- studs over the platform's top, at its outer edge

-- Where platform `index`'s number hangs: just above the outer edge of its
-- top (away from the pillar), so it never sits in a platform or on the climber.
function ClimbView.numberPoint(index: number): Vector3
	local top = ClimbPath.top(index)
	local out = Vector3.new(top.X - ClimbPath.ORIGIN.X, 0, top.Z - ClimbPath.ORIGIN.Z)
	local edge = if out.Magnitude > 1e-3 then out.Unit * (ClimbPath.size(index) / 2 - 0.6) else Vector3.zero
	return top + edge + Vector3.new(0, ClimbView.NUMBER_HEIGHT, 0)
end

-- The platforms that show their number while the climber is on `index`.
function ClimbView.numberRange(index: number): (number, number)
	local here = math.clamp(math.floor(index + 0.5), 0, ClimbPath.TOP)
	return math.max(1, here - ClimbView.NUMBERS_BELOW), math.min(ClimbPath.TOP, here + ClimbView.NUMBERS_ABOVE)
end

-- The gift rides play faster while more are waiting.
function ClimbView.pace(waiting: number): number
	return math.min(3, 1 + math.max(0, waiting) * 0.5)
end

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent ~= nil then instance.Parent = parent end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function glass(instance: GuiObject, radius: number)
	instance.BackgroundColor3 = PANEL
	instance.BackgroundTransparency = 0.28
	rounded(instance, radius)
	make("UIStroke", { Thickness = 1, Color = WHITE, Transparency = 0.88, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, instance)
end

-- `request` sends climbLand and setClimbMove; `state` carries the climb's
-- progress (ClimbCheckpoint, ClimbBest, ClimbWins, ClimbSpeed, ClimbJump).
-- Returns setActive(climbing) and the gift and win handlers.
function ClimbView.start(request: RemoteEvent, state: Instance)
	local player = Players.LocalPlayer
	local active = false
	local function attr(name: string, fallback: number): number
		local value = state:GetAttribute(name)
		return if type(value) == "number" then value else fallback
	end

	local gui = make("ScreenGui", {
		Name = "DiamondClimbHud",
		ResetOnSpawn = false,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	ClimbEffects.start(player:WaitForChild("PlayerGui"))

	-- The display, top centre: the platform, a progress bar, best and climbs.
	local card = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 92),
	}, gui)
	glass(card, 14)
	local cardScale = make("UIScale", { Scale = 1 }, card)
	make("TextLabel", {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 12,
		TextColor3 = MUTED,
		Text = "DIAMOND CLIMB",
	}, card)
	local platformLabel = make("TextLabel", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Font = FONT_HEAVY,
		TextSize = 26,
		TextColor3 = WHITE,
		Text = ClimbView.platformText(0),
	}, card)
	local bar = make("Frame", {
		Position = UDim2.new(0, 16, 0, 58),
		Size = UDim2.new(1, -32, 0, 6),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
	}, card)
	rounded(bar, 3)
	local barFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, bar)
	rounded(barFill, 3)
	local barGradient = make("UIGradient", { Color = ColorSequence.new(ClimbPath.GEMS[1], ClimbPath.GEMS[1]) }, barFill)
	local statsLabel = make("TextLabel", {
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = FONT_MEDIUM,
		TextSize = 13,
		TextColor3 = MUTED,
		RichText = true,
		Text = "",
	}, card)
	-- A big line under the display for milestones and the win.
	local shout = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		-- Under the win counter (102 to 146).
		Position = UDim2.new(0.5, 0, 0, 158),
		Size = UDim2.fromOffset(600, 46),
		BackgroundTransparency = 1,
		Font = FONT_HEAVY,
		TextSize = 38,
		TextColor3 = GOLD,
		TextStrokeTransparency = 0.3,
		TextTransparency = 1,
		Text = "",
	}, gui)
	local shoutScale = make("UIScale", { Scale = 1 }, shout)
	local shoutSerial = 0
	local function showShout(text: string, colour: Color3, seconds: number)
		shoutSerial += 1
		local serial = shoutSerial
		shout.Text = text
		shout.TextColor3 = colour
		shout.TextTransparency = 0
		shoutScale.Scale = 1.8
		TweenService:Create(shoutScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		task.delay(seconds, function()
			if serial == shoutSerial then
				TweenService:Create(shout, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
			end
		end)
	end

	-- The hold at the top, under the display.
	local hold = HoldCountdown.new(gui, 214, "HOLD THE TOP")

	-- The speed and jump sliders, bottom right (Settings can hide them).
	local moveCard = make("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		-- Higher on touch screens, clear of Roblox's jump button.
		Position = UDim2.new(1, -14, 1, if UserInputService.TouchEnabled then -190 else -36),
		Size = UDim2.fromOffset(280, 136),
	}, gui)
	glass(moveCard, 14)
	make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 10) }, moveCard)
	make("TextLabel", {
		Size = UDim2.new(1, -70, 0, 14),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = MUTED,
		Text = "MOVEMENT",
	}, moveCard)
	local resetButton = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -2),
		Size = UDim2.fromOffset(60, 20),
		BackgroundColor3 = BUTTON,
		Font = FONT,
		TextSize = 11,
		TextColor3 = WHITE,
		Text = "Reset",
	}, moveCard)
	rounded(resetButton, 6)

	type Slider = { set: (number) -> (), value: () -> number }
	local dragging: { [any]: boolean } = {}
	local function slider(y: number, name: string, range: { min: number, max: number, default: number }, step: number, onChange: (number, boolean) -> ()): Slider
		local current = range.default
		make("TextLabel", {
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(1, -60, 0, 18),
			BackgroundTransparency = 1,
			Font = FONT_MEDIUM,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = WHITE,
			Text = name,
		}, moveCard)
		local valueLabel = make("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, y),
			Size = UDim2.fromOffset(60, 18),
			BackgroundTransparency = 1,
			Font = FONT,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = WHITE,
			Text = "",
		}, moveCard)
		local hit = make("TextButton", {
			Position = UDim2.fromOffset(0, y + 20),
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, moveCard)
		local track = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 6),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
		}, hit)
		rounded(track, 3)
		local fill = make("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = SELECTED, BorderSizePixel = 0 }, track)
		rounded(fill, 3)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
		}, track)
		rounded(knob, 9)
		local function show()
			local fraction = (current - range.min) / (range.max - range.min)
			fill.Size = UDim2.fromScale(fraction, 1)
			knob.Position = UDim2.fromScale(fraction, 0.5)
			valueLabel.Text = if step < 1 then string.format("%.1f", current) else tostring(math.floor(current + 0.5))
		end
		local function set(value: number)
			current = math.clamp(math.floor(value / step + 0.5) * step, range.min, range.max)
			show()
		end
		local function fromScreen(x: number, done: boolean)
			local left, width = track.AbsolutePosition.X, math.max(1, track.AbsoluteSize.X)
			set(range.min + math.clamp((x - left) / width, 0, 1) * (range.max - range.min))
			onChange(current, done)
		end
		local key = {}
		hit.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging[key] = true
				fromScreen(input.Position.X, false)
			end
		end)
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if dragging[key] and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				fromScreen(input.Position.X, false)
			end
		end)
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if dragging[key] and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging[key] = nil
				fromScreen(input.Position.X, true)
			end
		end)
		show()
		return { set = set, value = function() return current end }
	end

	local function humanoid(): Humanoid?
		local character = player.Character
		return if character then character:FindFirstChildOfClass("Humanoid") else nil
	end
	-- The sliders change the character straight away; the server keeps them.
	local lastSent = 0
	local speedSlider: Slider, jumpSlider: Slider
	local function moved(_value: number, done: boolean)
		local walker = humanoid()
		if walker and active then
			walker.UseJumpPower = false
			walker.WalkSpeed = speedSlider.value()
			walker.JumpHeight = jumpSlider.value()
		end
		local now = os.clock()
		if done or now - lastSent > 0.25 then
			lastSent = now
			request:FireServer("setClimbMove", { speed = speedSlider.value(), jump = jumpSlider.value() })
		end
	end
	speedSlider = slider(22, "Speed", ClimbPath.SPEED, 0.5, moved)
	jumpSlider = slider(72, "Jump height", ClimbPath.JUMP, 0.1, moved)
	resetButton.Activated:Connect(function()
		speedSlider.set(ClimbPath.SPEED.default)
		jumpSlider.set(ClimbPath.JUMP.default)
		moved(0, true)
	end)
	local function refreshMove()
		if next(dragging) ~= nil then return end
		speedSlider.set(attr("ClimbSpeed", ClimbPath.SPEED.default))
		jumpSlider.set(attr("ClimbJump", ClimbPath.JUMP.default))
	end
	state:GetAttributeChangedSignal("ClimbSpeed"):Connect(refreshMove)
	state:GetAttributeChangedSignal("ClimbJump"):Connect(refreshMove)
	refreshMove()
	local function refreshCard()
		moveCard.Visible = player:GetAttribute("HideClimbCard") ~= true
	end
	player:GetAttributeChangedSignal("HideClimbCard"):Connect(refreshCard)
	refreshCard()

	-- The display follows the checkpoint, or the ride while a gift carries the climber.
	local shownPlatform = attr("ClimbCheckpoint", 0)
	local function refreshStats()
		local wall, wallMax = attr("ClimbWall", ClimbPath.WALL.default), attr("ClimbWallMax", ClimbPath.WALL.default)
		statsLabel.Text = string.format('BEST <font color="#FFFFFF">%s</font>    CLIMBS <font color="#F6C85C">%s</font>    WALL <font color="%s">%s</font>',
			Format.commas(attr("ClimbBest", 0)), Format.commas(attr("ClimbWins", 0)),
			ClimbView.wallColour(wall, wallMax), Format.commas(wall))
	end
	state:GetAttributeChangedSignal("ClimbBest"):Connect(refreshStats)
	state:GetAttributeChangedSignal("ClimbWins"):Connect(refreshStats)
	state:GetAttributeChangedSignal("ClimbWall"):Connect(refreshStats)
	state:GetAttributeChangedSignal("ClimbWallMax"):Connect(refreshStats)
	refreshStats()
	local lastWhole = -1
	local wasHolding = false
	RunService.RenderStepped:Connect(function(dt: number)
		if not active then return end
		-- The hold at the top: a gift that sends them down ends it.
		local holdStart = attr("ClimbHoldStart", 0)
		hold.update(holdStart, workspace:GetServerTimeNow())
		if wasHolding and holdStart == 0 and attr("ClimbCheckpoint", 0) < ClimbPath.TOP then
			showShout("SENT DOWN! THE HOLD IS LOST", RED, 3)
		end
		wasHolding = holdStart > 0
		local target = ClimbEffects.shownIndex() or attr("ClimbCheckpoint", 0)
		shownPlatform += (target - shownPlatform) * math.min(1, dt * 12)
		if math.abs(target - shownPlatform) < 0.5 then shownPlatform = target end
		local whole = math.floor(shownPlatform + 0.5)
		if whole ~= lastWhole then
			lastWhole = whole
			platformLabel.Text = ClimbView.platformText(whole)
			barFill.Size = UDim2.fromScale(whole / ClimbPath.TOP, 1)
			local gem = ClimbPath.colour(math.max(1, whole))
			barGradient.Color = ColorSequence.new(gem:Lerp(WHITE, 0.4), gem)
			platformLabel.TextColor3 = WHITE:Lerp(gem, 0.35)
		end
	end)
	local function pop(scale: number)
		cardScale.Scale = scale
		TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	-- The tower's platforms by number, for the landing animation.
	local platforms: { [number]: BasePart } = {}
	local tower: Instance? = nil
	-- Out of sight (and not drawn) unless climbing: only this computer's copy
	-- of the tower moves here; the server's stays where it is.
	local hiddenTower = Instance.new("Folder")
	hiddenTower.Name = "HiddenClimb"
	hiddenTower.Parent = ReplicatedStorage
	local function showTower()
		if tower then tower.Parent = if active then workspace else hiddenTower end
	end
	local startDiamond: (Instance) -> ()
	-- The wall behind the start: its health over it, and how it takes hits.
	local wallPart: BasePart? = nil
	local wallColour: Color3? = nil
	local wallBar: Frame? = nil
	local wallText: TextLabel? = nil
	local function refreshWall()
		local health, max = attr("ClimbWall", ClimbPath.WALL.default), attr("ClimbWallMax", ClimbPath.WALL.default)
		local bar, text = wallBar, wallText
		if bar and text then
			bar.Size = UDim2.fromScale(math.clamp(health / math.max(1, max), 0, 1), 1)
			bar.BackgroundColor3 = Color3.fromHex(ClimbView.wallColour(health, max))
			text.Text = string.format("WALL  %s / %s", Format.commas(health), Format.commas(max))
		end
	end
	local function startWall(model: Instance)
		local found = model:WaitForChild("ClimbWall", math.huge)
		if found == nil or not found:IsA("BasePart") then return end
		wallPart = found
		wallColour = found.Color
		local sign = make("BillboardGui", { Name = "WallHealth", Adornee = found, Size = UDim2.fromScale(14, 2.6),
			StudsOffsetWorldSpace = Vector3.new(0, ClimbPath.WALL_SIZE.Y / 2 + 3, 0), LightInfluence = 0, MaxDistance = 300 }, player:WaitForChild("PlayerGui"))
		local back = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromScale(1, 0.38),
			BackgroundColor3 = Color3.fromRGB(20, 22, 30), BackgroundTransparency = 0.15, BorderSizePixel = 0 }, sign)
		rounded(back, 6)
		local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, back)
		rounded(fill, 6)
		local label = make("TextLabel", { Size = UDim2.fromScale(1, 0.58), BackgroundTransparency = 1, Font = FONT_HEAVY, TextScaled = true,
			TextColor3 = WHITE, TextStrokeTransparency = 0.3, Text = "" }, sign)
		wallBar, wallText = fill, label
		refreshWall()
	end
	state:GetAttributeChangedSignal("ClimbWall"):Connect(refreshWall)
	state:GetAttributeChangedSignal("ClimbWallMax"):Connect(refreshWall)
	-- Started at the end (once everything it uses is ready).
	local function findTower()
		local model = workspace:WaitForChild("DiamondClimb", math.huge)
		tower = model
		local function add(item: Instance)
			local index = item:GetAttribute("ClimbIndex")
			if type(index) == "number" and item:IsA("BasePart") then platforms[index] = item end
		end
		for _, item in model:GetDescendants() do add(item) end
		model.DescendantAdded:Connect(add)
		task.spawn(startDiamond, model)
		task.spawn(startWall, model)
		showTower()
	end

	-- The landing animation: the platform bounces and flashes, a ring of light
	-- races out, sparkles fly up and a chime rings, rising through each ten.
	-- Every hundredth platform gets fireworks and a gold shout.
	local effects = make("Folder", { Name = "ClimbLandings" }, workspace)
	local function landed(index: number, fresh: boolean)
		local platform = platforms[index]
		local top = ClimbPath.top(index)
		local colour = if index == 0 then WHITE else ClimbPath.colour(index)
		local size = ClimbPath.size(index)
		-- The rim swells and flashes white, then settles.
		local rim = if platform then platform:FindFirstChild("Rim") else nil
		if rim and rim:IsA("BasePart") then
			local base = ClimbPath.size(index) + (if index % ClimbPath.MILESTONE == 0 then 1.4 else 0.7)
			local thick = rim.Size.X
			-- Its own colour, remembered the first time (a flash may still be fading).
			local tint = rim:GetAttribute("Tint")
			if typeof(tint) ~= "Color3" then
				tint = rim.Color
				rim:SetAttribute("Tint", tint)
			end
			rim.Size = Vector3.new(thick, base * 1.25, base * 1.25)
			rim.Color = WHITE
			TweenService:Create(rim, TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Size = Vector3.new(thick, base, base) }):Play()
			TweenService:Create(rim, TweenInfo.new(0.5), { Color = tint }):Play()
		end
		-- A ring of light.
		local ring = make("Part", {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, size, size),
			CFrame = CFrame.new(top + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = colour,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, effects)
		local reach = if fresh then size * 2.6 else size * 1.7
		TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, reach, reach), Transparency = 1 }):Play()
		Debris:AddItem(ring, 0.6)
		-- Sparkles and a flat shockwave.
		-- Terrain sits at the world's origin, so these positions are world positions.
		local spot = make("Attachment", { Position = top + Vector3.new(0, 0.6, 0) }, workspace.Terrain)
		Debris:AddItem(spot, 1.6)
		local sparkles = make("ParticleEmitter", {
			Texture = SPARK,
			Color = ColorSequence.new(WHITE, colour),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new(0),
			Lifetime = NumberRange.new(0.4, 0.9),
			Speed = NumberRange.new(6, 14),
			SpreadAngle = Vector2.new(70, 70),
			Drag = 3,
			LightEmission = 1,
			Enabled = false,
		}, spot)
		sparkles:Emit(if fresh then 22 else 10)
		if fresh then
			local wave = make("ParticleEmitter", {
				Texture = RING,
				Color = ColorSequence.new(colour),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, size * 1.6) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
				Lifetime = NumberRange.new(0.5, 0.5),
				Speed = NumberRange.new(0.01, 0.01),
				Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
				LightEmission = 1,
				Enabled = false,
			}, spot)
			wave:Emit(1)
			local chime = make("Sound", {
				SoundId = ClimbView.LAND_SOUND,
				Volume = 0.45,
				PlaybackSpeed = ClimbView.pitch(index),
			}, spot)
			chime:Play()
			pop(1.08)
		end
		if fresh and index > 0 and index % ClimbPath.MILESTONE == 0 and index < ClimbPath.TOP then
			-- A hundred more: fireworks round the platform and a gold shout.
			local fireworks = make("ParticleEmitter", {
				Texture = SPARK,
				Color = ColorSequence.new(GOLD, colour),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
				Lifetime = NumberRange.new(0.8, 1.5),
				Speed = NumberRange.new(16, 30),
				SpreadAngle = Vector2.new(180, 180),
				Drag = 2,
				Acceleration = Vector3.new(0, -12, 0),
				LightEmission = 1,
				Enabled = false,
			}, spot)
			fireworks:Emit(90)
			showShout(string.format("PLATFORM %d!", index), GOLD, 2.2)
			pop(1.3)
		end
	end

	-- Landing, checkpoints and falls.
	local riding = false
	local rides: { any } = {} -- gift rides waiting their turn
	local lastLanded = attr("ClimbCheckpoint", 0)
	-- A new platform the server has not taken as the checkpoint yet (it sees
	-- players a moment late), sent again while the climber stands on it.
	local pending: number? = nil
	local pendingSent = 0
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include
	local function backToCheckpoint()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root == nil or not root:IsA("BasePart") then return end
		local checkpoint = attr("ClimbCheckpoint", 0)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = ClimbPath.standFrame(checkpoint)
		lastLanded = checkpoint
		pending = nil
		landed(checkpoint, false)
	end
	RunService.Heartbeat:Connect(function()
		if not active or riding or #rides > 0 or ClimbEffects.playing() then return end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local walker = humanoid()
		if root == nil or not root:IsA("BasePart") or walker == nil or walker.Health <= 0 then return end
		local checkpoint = attr("ClimbCheckpoint", 0)
		-- Fell off: measured from the platform they were last on (a gift may
		-- have moved the checkpoint a long way up already, ahead of its ride).
		if root.Position.Y < ClimbPath.top(math.min(lastLanded, checkpoint)).Y - ClimbView.FALL_DISTANCE then
			backToCheckpoint()
			return
		end
		if walker.FloorMaterial == Enum.Material.Air or tower == nil then return end
		rayParams.FilterDescendantsInstances = { tower :: Instance }
		-- Down to the feet and a little more (an R6 rig's HipHeight is 0, its legs
		-- are under the root); a sphere catches landings on a platform's edge.
		local down = Vector3.new(0, -(walker.HipHeight + root.Size.Y / 2 + (if walker.RigType == Enum.HumanoidRigType.R6 then 2 else 0) + 1.5), 0)
		local hit = workspace:Raycast(root.Position, down, rayParams) or workspace:Spherecast(root.Position, 1, down, rayParams)
		local index = if hit then hit.Instance:GetAttribute("ClimbIndex") else nil
		if type(index) ~= "number" then return end
		if index ~= lastLanded then
			lastLanded = index
			pending = nil
			if index < checkpoint - ClimbView.FALL_PLATFORMS then
				backToCheckpoint()
				return
			end
			local fresh = index > checkpoint
			landed(index, fresh)
			if fresh then
				pending = index
				pendingSent = 0
			end
		end
		if pending ~= nil and pending == index and pending > checkpoint and os.clock() - pendingSent > 0.4 then
			pendingSent = os.clock()
			request:FireServer("climbLand", pending)
		elseif pending ~= nil and pending <= checkpoint then
			pending = nil
		end
	end)

	-- Platform numbers over the nearby platforms, moved along as the climber
	-- goes up or down. Only this computer draws them.
	local numberFolder = make("Folder", { Name = "ClimbNumbers" }, player:WaitForChild("PlayerGui"))
	local numberSigns: { [number]: BillboardGui } = {}
	local numbersFrom, numbersTo = -1, -1
	-- Each number hangs on its own invisible point just above its platform's
	-- outer edge, and is drawn over everything, so no platform ever hides it.
	local anchorFolder = make("Folder", { Name = "ClimbNumberPoints" }, workspace)
	local anchors: { [number]: BasePart } = {}
	local function numberSign(index: number, _platform: BasePart): BillboardGui
		local milestone = index % ClimbPath.MILESTONE == 0
		local point = make("Part", { Name = "Point" .. index, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(ClimbView.numberPoint(index)) }, anchorFolder)
		anchors[index] = point
		local sign = make("BillboardGui", {
			Name = "Platform" .. index,
			Adornee = point,
			Size = UDim2.fromScale(if milestone then 7 else 4.6, if milestone then 2.8 else 2),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = 220,
			ResetOnSpawn = false,
		}, numberFolder)
		make("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = FONT_HEAVY,
			TextScaled = true,
			TextColor3 = if milestone or index == ClimbPath.TOP then GOLD else WHITE,
			TextStrokeColor3 = Color3.new(0, 0, 0),
			TextStrokeTransparency = 0.35,
			Text = Format.commas(index),
		}, sign)
		return sign
	end
	RunService.Heartbeat:Connect(function()
		local home = if active then player:FindFirstChildOfClass("PlayerGui") else nil
		if numberFolder.Parent ~= home then numberFolder.Parent = home end
		if not active then return end
		local first, last = ClimbView.numberRange(if riding or #rides > 0 then shownPlatform else lastLanded)
		if first == numbersFrom and last == numbersTo then return end
		for index, sign in numberSigns do
			if index < first or index > last then
				sign:Destroy()
				numberSigns[index] = nil
				if anchors[index] then anchors[index]:Destroy() end
				anchors[index] = nil
			end
		end
		local missing = false
		for index = first, last do
			local platform = platforms[index]
			if not numberSigns[index] then
				if platform then numberSigns[index] = numberSign(index, platform) else missing = true end
			end
		end
		-- The tower is still arriving: try again next frame.
		if missing then numbersFrom, numbersTo = -1, -1 else numbersFrom, numbersTo = first, last end
	end)

	-- Gift rides, one after another.
	local winWaiting: any = nil
	local function celebrate()
		Sounds.play("cheer")
		showShout("YOU REACHED THE DIAMOND!", GOLD, 6)
		pop(1.4)
		local finish = ClimbPath.top(ClimbPath.TOP)
		for k = 1, 6 do
			task.delay(k * 0.45, function()
				local angle = k * math.pi / 3
				local spot = make("Attachment", { Position = finish + Vector3.new(math.cos(angle) * 14, 10 + (k % 3) * 4, math.sin(angle) * 14) }, workspace.Terrain)
				Debris:AddItem(spot, 2)
				local burst = make("ParticleEmitter", {
					Texture = SPARK,
					Color = ColorSequence.new(WHITE, ClimbPath.GEMS[(k * 3) % #ClimbPath.GEMS + 1]),
					Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0) }),
					Lifetime = NumberRange.new(0.9, 1.6),
					Speed = NumberRange.new(18, 34),
					SpreadAngle = Vector2.new(180, 180),
					Drag = 2,
					Acceleration = Vector3.new(0, -10, 0),
					LightEmission = 1,
					Enabled = false,
				}, spot)
				burst:Emit(80)
			end)
		end
	end
	RunService.Heartbeat:Connect(function()
		if riding then return end
		if not active then
			table.clear(rides)
			winWaiting = nil
			return
		end
		local data = table.remove(rides, 1)
		if data == nil then
			if winWaiting then
				winWaiting = nil
				celebrate()
			end
			return
		end
		riding = true
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		ClimbEffects.play(data, if root and root:IsA("BasePart") then root else nil, ClimbView.pace(#rides), function()
			riding = false
			lastLanded = data.to
			landed(data.to, false)
		end)
	end)

	local function onGift(data: any)
		if active and type(data) == "table" then
			-- The gift decides the checkpoint now, not a landing still on its way.
			pending = nil
			table.insert(rides, data)
		end
	end
	local function onWin(data: any)
		if active then winWaiting = data end
	end
	-- A push back past platform 0 hits the wall; at 0 health it breaks.
	local function onWall(data: any)
		if not active or type(data) ~= "table" then return end
		local wall = wallPart
		local at = if wall then wall.Position else ClimbPath.top(0)
		local damage = tonumber(data.damage) or 0
		if data.broke then
			Sounds.play("bigBoom", at, 1.6)
			Sounds.play("shatter", at, 1.4)
			showShout("THE WALL BROKE! -1 WIN", RED, 4)
		else
			Sounds.play(if damage >= 200 then "boom" else "clang", at)
			showShout("WALL -" .. Format.commas(damage), Color3.fromRGB(255, 160, 80), 1.6)
		end
		-- The wall flashes and shudders.
		if wall and wallColour then
			local base = wallColour
			wall.Color = if data.broke then WHITE else RED
			TweenService:Create(wall, TweenInfo.new(if data.broke then 1 else 0.4), { Color = base }):Play()
			local home = ClimbPath.wallFrame()
			task.spawn(function()
				for i = 1, 8 do
					local amount = (if data.broke then 0.8 else 0.25) * (1 - i / 8)
					wall.CFrame = home * CFrame.new((math.random() - 0.5) * amount, 0, (math.random() - 0.5) * amount)
					task.wait(0.03)
				end
				wall.CFrame = home
			end)
		end
	end
	local function onRestart()
		if not active then return end
		table.clear(rides)
		winWaiting = nil
		ClimbEffects.stop()
		task.delay(0.2, backToCheckpoint)
	end

	local function setActive(on: boolean)
		if on == active then return end
		active = on
		gui.Enabled = on
		showTower()
		if not on then
			-- The server is moving the climber elsewhere: no putting them back on the tower.
			ClimbEffects.stop(true)
			riding = false
		else
			lastLanded = attr("ClimbCheckpoint", 0)
			shownPlatform = lastLanded
			lastWhole = -1
			-- A wider view for platforming.
			player.CameraMaxZoomDistance = 40
		end
	end

	-- The diamond at the top turns slowly and bobs (only when near).
	function startDiamond(model: Instance)
		local gem = model:WaitForChild("ClimbDiamond", math.huge)
		local centre = gem:GetAttribute("Centre")
		if typeof(centre) ~= "Vector3" then return end
		local origin = CFrame.new(centre)
		local parts: { BasePart } = {}
		local offsets: { CFrame } = {}
		for _, item in gem:GetDescendants() do
			if item:IsA("BasePart") then
				table.insert(parts, item)
				table.insert(offsets, origin:ToObjectSpace(item.CFrame))
			end
		end
		local frames: { CFrame } = table.create(#parts, CFrame.identity)
		RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			if camera == nil or (camera.CFrame.Position - centre).Magnitude > 300 then return end
			local t = os.clock()
			local turn = CFrame.new(centre + Vector3.new(0, math.sin(t * 1.3) * 0.6, 0)) * CFrame.Angles(0, t * 0.8, 0)
			for i, offset in offsets do frames[i] = turn * offset end
			if not active then return end
			workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end)
	end

	task.spawn(findTower)

	return {
		setActive = setActive,
		onGift = onGift,
		onWin = onWin,
		onRestart = onRestart,
		onWall = onWall,
	}
end

return ClimbView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">FirstPerson</string>
            <string name="Source"><![CDATA[--!strict
-- First-person view with two hands in front of the camera (like the PC game).
-- The hands follow the camera, bob while walking and take turns digging: each
-- swing draws back, drives forward into the rock with the fingers clawed, and
-- rakes the rubble down and back. The rock breaks when a hand lands (see
-- FirstPerson.onStrike), so what you see and what you dig stay in step.
--
-- The hands are drawn small and close to the camera, so they never sink into
-- the rock when you stand right against it, and they are refitted to the
-- field of view (FirstPerson.setFieldOfView), so they look the same at any FOV.
--
-- Picking up the diamond: the gem flies from where it lay into your right hand,
-- the hand lifts it up and the camera eases upward so the gem is framed
-- against the sky and the mountain. The server freezes the holder in place
-- until a rebuild cancels the hold or the countdown is won.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FirstPerson = {}

local SKIN_FALLBACK = Color3.fromRGB(234, 184, 146)
local SLEEVE = Color3.fromRGB(70, 82, 70)
local GEM_SIZE = 1.05 -- studs across: about a third of the screen in the raised hand
local FLY_SECONDS = 0.45 -- world position to hand
local CAMERA_EASE = 0.7
local HOLD_PITCH = math.rad(28) -- looking up, but still showing the peak below the gem
local SWING_SECONDS = 0.25 -- one hand's swing; the server digs DigPerSecond / 4 rocks per strike
local IMPACT = 0.5 -- how far through a swing the hand lands
local VIEW_SCALE = 0.5 -- the hands are built at half size, half as far away: the same on screen
local BASE_FOV = 70 -- the field of view the hands were framed for
local PIVOT = Vector3.new(0, -0.92, -1.6) -- the hands' resting point in front of the camera

FirstPerson.SWING_SECONDS = SWING_SECONDS
FirstPerson.IMPACT = IMPACT
FirstPerson.FOV_MIN = 50
FirstPerson.FOV_MAX = 100
FirstPerson.FOV_DEFAULT = BASE_FOV

local function part(name: string, size: Vector3, colour: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = colour
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local function smooth(value: number): number
	value = math.clamp(value, 0, 1)
	return value * value * (3 - 2 * value)
end

-- One hand's pose through a swing (0 to 1), as offsets from its resting pose:
-- `inward` towards the middle of the screen, `up`, `back` towards the camera,
-- the hand's pitch (radians, positive tips the fingers up) and how far the
-- fingers curl (0 to 1). The pose starts and ends at rest, so swings chain
-- without a jump. Pure, for tests.
export type Pose = { inward: number, up: number, back: number, pitch: number, curl: number }
local KEYS: { { at: number, pose: Pose } } = {
	{ at = 0, pose = { inward = 0, up = 0, back = 0, pitch = 0, curl = 0.15 } },
	-- Draw back and up, wrist cocked.
	{ at = 0.34, pose = { inward = 0.03, up = 0.15, back = 0.16, pitch = math.rad(26), curl = 0.35 } },
	-- Drive forward and a little down into the rock, fingers clawed.
	{ at = IMPACT, pose = { inward = 0.2, up = -0.03, back = -0.6, pitch = math.rad(-16), curl = 0.92 } },
	-- Rake the rubble down and back.
	{ at = 0.8, pose = { inward = 0.13, up = -0.24, back = -0.18, pitch = math.rad(18), curl = 1 } },
	{ at = 1, pose = { inward = 0, up = 0, back = 0, pitch = 0, curl = 0.15 } },
}
function FirstPerson.pose(t: number): Pose
	t = math.clamp(t, 0, 1)
	for i = 1, #KEYS - 1 do
		local a, b = KEYS[i], KEYS[i + 1]
		if t <= b.at then
			local u = (t - a.at) / (b.at - a.at)
			-- The drive into the rock speeds up to the impact; everything else eases.
			u = if b.at == IMPACT then u * u else smooth(u)
			local p, q = a.pose, b.pose
			return {
				inward = p.inward + (q.inward - p.inward) * u,
				up = p.up + (q.up - p.up) * u,
				back = p.back + (q.back - p.back) * u,
				pitch = p.pitch + (q.pitch - p.pitch) * u,
				curl = p.curl + (q.curl - p.curl) * u,
			}
		end
	end
	return KEYS[#KEYS].pose
end

-- How much bigger the hands must be drawn at `fov` to look the same on screen
-- as at the field of view they were framed for.
function FirstPerson.fovScale(fov: number): number
	return math.tan(math.rad(fov) / 2) / math.tan(math.rad(BASE_FOV) / 2)
end

-- Where a point framed at the base field of view goes, in camera space, at a
-- field of view `scale` times wider (see fovScale): the hands grow about their
-- resting point, which moves out with the edge of the screen. Pure, for tests.
function FirstPerson.fit(frame: CFrame, scale: number): CFrame
	local p = frame.Position
	local fitted = Vector3.new(p.X * scale, p.Y * scale, PIVOT.Z + (p.Z - PIVOT.Z) * scale) * VIEW_SCALE
	return CFrame.new(fitted) * frame.Rotation
end

-- In the lobby the view is a normal third-person camera and the hands hide.
local enabled = true
local fieldOfView = BASE_FOV
local function applyCamera()
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	if enabled then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 24
		player.CameraMinZoomDistance = 8
	end
	if camera then camera.FieldOfView = if enabled then fieldOfView else BASE_FOV end
end

function FirstPerson.setEnabled(on: boolean)
	enabled = on
	applyCamera()
end

-- The player's field of view in the game (the lobby keeps the default).
function FirstPerson.setFieldOfView(fov: number)
	fieldOfView = math.clamp(math.floor(fov + 0.5), FirstPerson.FOV_MIN, FirstPerson.FOV_MAX)
	-- Only the field of view: the zoom limits belong to whichever game is on.
	local camera = workspace.CurrentCamera
	if camera then camera.FieldOfView = if enabled then fieldOfView else BASE_FOV end
end

function FirstPerson.fieldOfView(): number
	return fieldOfView
end

-- `callback` runs each time a digging hand lands on the rock.
local strikeListeners: { () -> () } = {}
function FirstPerson.onStrike(callback: () -> ())
	table.insert(strikeListeners, callback)
end

function FirstPerson.start()
	local player = Players.LocalPlayer
	applyCamera()

	local rig = Instance.new("Model")
	rig.Name = "FirstPersonHands"
	local hands = {}
	local rigParts: { BasePart } = {}
	local skinParts: { BasePart } = {}
	local function add(p: BasePart, skin: boolean)
		p.Parent = rig
		table.insert(rigParts, p)
		if skin then table.insert(skinParts, p) end
	end
	for _, side in { -1, 1 } do
		local sleeve = part("Sleeve", Vector3.new(0.42, 0.42, 1.5), SLEEVE, Enum.Material.Fabric)
		local hand = part("Hand", Vector3.new(0.4, 0.34, 0.45), SKIN_FALLBACK)
		add(sleeve, false)
		add(hand, true)
		local fingers = {}
		for _ = 1, 4 do
			local finger = part("FingerBase", Vector3.new(0.075, 0.11, 0.14), SKIN_FALLBACK)
			local tip = part("FingerTip", Vector3.new(0.072, 0.10, 0.13), SKIN_FALLBACK)
			add(finger, true)
			add(tip, true)
			table.insert(fingers, { base = finger, tip = tip })
		end
		local thumb = part("Thumb", Vector3.new(0.12, 0.16, 0.21), SKIN_FALLBACK)
		add(thumb, true)
		table.insert(hands, { side = side, sleeve = sleeve, hand = hand, fingers = fingers, thumb = thumb })
	end
	local rigFrames: { CFrame } = table.create(#rigParts, CFrame.identity)
	local baseSizes: { Vector3 } = {}
	for i, p in rigParts do baseSizes[i] = p.Size end
	local skinColour = SKIN_FALLBACK
	-- The hands are resized only when the field of view changes.
	local fitScale = -1
	local function refit(scale: number)
		if math.abs(scale - fitScale) < 1e-4 then return end
		fitScale = scale
		for i, p in rigParts do p.Size = baseSizes[i] * (scale * VIEW_SCALE) end
	end

	local State = ReplicatedStorage:WaitForChild("DiamondRushState")
	local DiamondShape = require(ReplicatedStorage:WaitForChild("DiamondRush"):WaitForChild("DiamondShape"))
	local worldDiamond = workspace:WaitForChild("Diamond") :: BasePart

	-- The server rebuilds the world gem's facets whenever it changes size, so
	-- the facet folder is looked up again rather than cached.
	local hiddenFacets: Instance? = nil
	local function hideWorld(hidden: boolean)
		local facets = worldDiamond:FindFirstChild("Facets")
		local target = if hidden then facets else nil
		if target == hiddenFacets then return end
		if hiddenFacets and hiddenFacets.Parent then
			for _, face in hiddenFacets:GetChildren() do
				if face:IsA("BasePart") then face.LocalTransparencyModifier = 0 end
			end
		end
		hiddenFacets = target
		if target then
			for _, face in target:GetChildren() do
				if face:IsA("BasePart") then face.LocalTransparencyModifier = 1 end
			end
		end
	end

	-- The held gem: anchored facets moved in one call each frame (no welds).
	-- In the haystack skin it is a needle (see Skin).
	local gemKind = if State:GetAttribute("Skin") == "hay" then "needle" else "diamond"
	local gemScale = VIEW_SCALE
	local gem = DiamondShape.build(GEM_SIZE * gemScale, "HeldDiamond", gemKind)
	local core = part("Core", Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 1, 1))
	core.Transparency = 1
	core.Parent = gem.model
	local shine = Instance.new("PointLight")
	shine.Color = Color3.fromRGB(160, 235, 255)
	shine.Range = 6
	shine.Brightness = 1.2
	shine.Shadows = false
	shine.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(160, 235, 255))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new(0, 1)
	sparkles.Lifetime = NumberRange.new(0.3, 0.7)
	sparkles.Rate = 10
	sparkles.Speed = NumberRange.new(0.3, 0.9)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LockedToPart = true
	sparkles.Enabled = false
	sparkles.Parent = core
	local outline = Instance.new("Highlight")
	outline.FillTransparency = 1
	outline.OutlineColor = Color3.new(1, 1, 1)
	outline.OutlineTransparency = 0.35
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = gem.model
	-- A reskin, or a new field of view, rebuilds the held gem, carrying its
	-- light, sparkles and outline over.
	local function rebuildGem(kind: string, scale: number)
		if kind == gemKind and math.abs(scale - gemScale) < 1e-4 then return end
		gemKind = kind
		gemScale = scale
		local old = gem
		gem = DiamondShape.build(GEM_SIZE * scale, "HeldDiamond", kind)
		core.Parent = gem.model
		outline.Parent = gem.model
		gem.model.Parent = old.model.Parent
		old.model:Destroy()
	end
	State:GetAttributeChangedSignal("Skin"):Connect(function()
		rebuildGem(if State:GetAttribute("Skin") == "hay" then "needle" else "diamond", gemScale)
	end)

	local hiddenArms: { [BasePart]: number } = {}
	local armNames = { RightHand = true, RightLowerArm = true, RightUpperArm = true, LeftHand = true, LeftLowerArm = true, LeftUpperArm = true, ["Right Arm"] = true, ["Left Arm"] = true }
	local function restoreArms()
		for limb, transparency in hiddenArms do
			if limb.Parent then limb.LocalTransparencyModifier = transparency end
		end
		table.clear(hiddenArms)
	end
	player.CharacterRemoving:Connect(restoreArms)

	local function isHolding(): boolean
		-- Display names are not unique: only the actual holder gets this view.
		return State:GetAttribute("Phase") == "Holding" and State:GetAttribute("HolderUserId") == player.UserId
	end

	-- Hold state, set when the hold begins.
	local holdClock = 0
	local holdYaw = 0
	local startPitch = 0
	local gemFrom: CFrame? = nil
	local lastWorldGem: CFrame? = nil
	local wasHolding = false

	-- While you hold the diamond the camera is locked, easing up towards it.
	RunService:BindToRenderStep("DiamondRushHoldCamera", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local holding = isHolding() and humanoid ~= nil and humanoid.Health > 0
		if not holding and State:GetAttribute("Phase") == "Revealed" then
			lastWorldGem = worldDiamond.CFrame
		end
		if holding and camera and head and head:IsA("BasePart") then
			if not wasHolding then
				wasHolding = true
				holdClock = os.clock()
				local look = camera.CFrame.LookVector
				holdYaw = math.atan2(-look.X, -look.Z)
				startPitch = math.asin(math.clamp(look.Y, -1, 1))
				gemFrom = lastWorldGem
				camera.CameraType = Enum.CameraType.Scriptable
			end
			local t = os.clock() - holdClock
			local pitch = startPitch + (HOLD_PITCH - startPitch) * smooth(t / CAMERA_EASE)
			local breathe = math.sin(t * 1.6) * math.rad(0.6)
			camera.CFrame = CFrame.new(head.Position + Vector3.new(0, 0.6, 0))
				* CFrame.Angles(0, holdYaw + breathe * 0.5, 0) * CFrame.Angles(pitch + breathe, 0, 0)
		elseif wasHolding then
			wasHolding = false
			gemFrom = nil
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
		end
	end)

	local cycle = 1 -- how far through the current swing (1 = at rest)
	local swingSide = 1 -- the hand swinging now; the hands take turns
	local struck = true -- whether this swing has landed yet
	local kick = 0 -- a small jolt through both hands as one lands
	local bob = 0
	local lift = 0 -- 0 = digging pose, 1 = diamond raised high

	-- Position the hands after both Roblox's camera and our hold-camera update.
	RunService:BindToRenderStep("DiamondRushHands", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not enabled or camera == nil or character == nil or humanoid == nil or humanoid.Health <= 0 then
			rig.Parent = nil
			gem.model.Parent = nil
			sparkles.Enabled = false
			restoreArms()
			hideWorld(false)
			cycle, struck = 1, true
			return
		end
		rig.Parent = camera
		if camera.FieldOfView ~= fieldOfView then camera.FieldOfView = fieldOfView end
		local scale = FirstPerson.fovScale(camera.FieldOfView)
		refit(scale)
		-- Scriptable cameras bypass the normal first-person transparency controller.
		-- Hide the real limbs so they cannot float above the custom hands.
		for _, limb in character:GetChildren() do
			if limb:IsA("BasePart") and armNames[limb.Name] and hiddenArms[limb] == nil then
				hiddenArms[limb] = limb.LocalTransparencyModifier
				limb.LocalTransparencyModifier = 1
			end
		end
		-- Skin tone from the avatar, applied only when it changes.
		local colours = character:FindFirstChildOfClass("BodyColors")
		local skin = if colours then colours.RightArmColor3 else SKIN_FALLBACK
		if skin ~= skinColour then
			skinColour = skin
			for _, p in skinParts do p.Color = skin end
		end
		local tool = character:FindFirstChildOfClass("Tool")
		-- Keep any third-person tool from obscuring the local hand and diamond.
		if tool then
			for _, d in tool:GetDescendants() do
				if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 end
			end
		end
		local moving = humanoid.MoveDirection.Magnitude > 0.1 and humanoid.FloorMaterial ~= Enum.Material.Air
		bob += dt * (if moving then 9 else 2)
		-- Walking sways the hands; digging steadies them.
		local sway = if moving then 0.04 else 0.012
		local holding = isHolding()
		local digging = player:GetAttribute("DiggingRock") == true and not holding
		-- A swing always finishes once begun, so letting go never snaps the
		-- hand back; the next one starts, with the other hand, while you dig.
		if holding then
			cycle, struck = 1, true
		else
			if cycle >= 1 and digging then
				cycle, struck = 0, false
				swingSide = -swingSide
			end
			if cycle < 1 then
				cycle = math.min(1, cycle + dt / SWING_SECONDS)
				if not struck and cycle >= IMPACT then
					struck = true
					kick = 1
					if digging then
						for _, callback in strikeListeners do task.spawn(callback) end
					end
				end
			end
		end
		kick = math.max(0, kick - dt * 9)
		lift += ((if holding then 1 else 0) - lift) * (1 - math.exp(-dt * 8))
		hideWorld(holding)
		local worldLight = worldDiamond:FindFirstChildOfClass("PointLight")
		if worldLight then worldLight.Enabled = State:GetAttribute("Phase") == "Holding" and not holding end
		if holding then
			-- The world gem's sparkles are for everyone else watching.
			local worldSparkles = worldDiamond:FindFirstChild("HeldSparkles", true)
			if worldSparkles and worldSparkles:IsA("ParticleEmitter") then worldSparkles.Enabled = false end
		end

		-- Everything below is framed in camera space at the base field of view,
		-- then fitted to the camera (see FirstPerson.fit).
		local index = 0
		local function put(frame: CFrame)
			index += 1
			rigFrames[index] = camera.CFrame * FirstPerson.fit(frame, scale)
		end
		local jolt = kick * kick * 0.035
		local base = CFrame.new(PIVOT + Vector3.new(math.sin(bob * 0.5) * sway * 0.4, math.sin(bob) * sway * 0.45 - jolt, jolt))
		local swing = FirstPerson.pose(cycle)
		-- The resting hand braces a little while the other one drives in.
		local brace = math.sin(math.clamp(cycle / 0.8, 0, 1) * math.pi)
		local palm = CFrame.identity
		for _, h in hands do
			local active = h.side == swingSide
			local p = if active then swing else nil
			local inward = if p then p.inward else 0
			local up = if p then p.up else -0.04 * brace
			local back = if p then p.back else 0.07 * brace
			local pitch = if p then p.pitch else math.rad(-4) * brace
			local normal = base * CFrame.new(h.side * (0.58 - inward * (1 - lift)), up * (1 - lift), back * (1 - lift))
				* CFrame.Angles(math.rad(10) + pitch * (1 - lift), math.rad(-h.side * (8 + inward * 50)), math.rad(-h.side * inward * 30))
			-- The right hand rises to the right of centre, under the countdown;
			-- the left hand drops out of view.
			local raised = if h.side == 1
				then CFrame.new(0.5, -0.62, -1.7) * CFrame.Angles(math.rad(34), math.rad(-12), math.rad(-6))
				else normal * CFrame.new(0, -1.6, 0.3)
			local arm = normal:Lerp(raised, smooth(lift))
			put(arm * CFrame.new(0, 0, 0.46))
			local handFrame = arm * CFrame.new(0, 0, -0.35)
			put(handFrame)
			if h.side == 1 then palm = handFrame end
			local curl = if p then p.curl else 0.15
			local grip = math.max(if h.side == 1 then lift else 0, curl * (1 - lift))
			for fingerIndex, _ in h.fingers do
				local bend = grip * (0.85 + fingerIndex * 0.035)
				local joint = handFrame * CFrame.new((fingerIndex - 2.5) * 0.09, 0, -0.20) * CFrame.Angles(math.rad(-46 * bend), 0, 0)
				put(joint * CFrame.new(0, 0, -0.07))
				put(joint * CFrame.new(0, 0, -0.14) * CFrame.Angles(math.rad(-54 * bend), 0, 0) * CFrame.new(0, 0, -0.065))
			end
			put(handFrame * CFrame.new(-h.side * 0.17, 0.015, -0.08)
				* CFrame.Angles(math.rad(-35 * grip), math.rad(h.side * 20 * grip), math.rad(h.side * (15 + 35 * grip))))
		end
		workspace:BulkMoveTo(rigParts, rigFrames, Enum.BulkMoveMode.FireCFrameChanged)

		if holding then
			rebuildGem(gemKind, scale * VIEW_SCALE)
			local t = os.clock() - holdClock
			-- Upright in the world, crown tipped towards you, slowly turning.
			local spin = t * 0.9
			local seat = camera.CFrame * FirstPerson.fit(palm * CFrame.new(0, 0.17 + GEM_SIZE * 0.6, -0.05), scale)
			local target = CFrame.new(seat.Position) * CFrame.Angles(0, holdYaw, 0) * CFrame.Angles(math.rad(20), 0, 0) * CFrame.Angles(0, spin, 0)
			local frame = target
			local from = gemFrom
			if from and t < FLY_SECONDS then
				-- Arc from where the gem lay into the hand.
				local u = smooth(t / FLY_SECONDS)
				frame = from:Lerp(target, u) + Vector3.new(0, math.sin(u * math.pi) * 0.9, 0)
			end
			gem.model.Parent = camera
			DiamondShape.place(gem, frame)
			core.CFrame = frame
			-- A bright flash as it lands, settling to a steady glow.
			shine.Brightness = 1.2 + 3 * math.max(0, 1 - math.abs(t - FLY_SECONDS) / 0.35)
			sparkles.Enabled = t >= FLY_SECONDS * 0.5
		else
			sparkles.Enabled = false
			gem.model.Parent = nil
		end
	end)
end

return FirstPerson
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">GiftEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Gift effects: a hand-made sequence for each gift tier, played on every
-- client and never physical (nothing collides, is touched or blocks a click).
--
--   1  SPARK BURST       (1+ coins)       a crisp golden pop and a puff of dust
--   2  SHOCKWAVE         (10+ coins)      a ground shockwave, sparks and flying rock
--   3  DIAMOND FRACTURE  (100+ coins)     glowing cracks, then crystals burst out and shatter
--   4  ORBITAL STRIKE    (500+ coins)     a target locks on, a beam fires from the sky, then a
--                                         barrage walks round the crater and a wider beam ends it
--   5  GALAXY COLLAPSE   (1,000+ coins)   a swirling black hole pulls in stars, goes nova, flings
--                                         out spiral arms, then pulses again with a starlight beam
--   6  COSMIC BURST      (10,000+ coins)  the sky darkens, a meteor storm falls, a comet hits,
--                                         fire geysers erupt, more meteors, then a cosmic shock
--
-- Built from Roblox's own particle textures (sparkles, fire, smoke, embers and
-- shockwave rings), neon parts, trails, lights, a gentle camera shake and a
-- brief colour grade. At most two sequences play at once, each with a capped
-- number of parts, lights and particles. The small tiers are over in a second
-- or two; the big ones run for 4 to 8 seconds. Every piece is gone soon after.
--
-- Gifts that add stone have their own six, in greens, aimed at the summit:
--   1  PEBBLE DROP       pebbles fall onto the peak with puffs of dust
--   2  ROCKSLIDE         a ring of rocks rises out of the slopes and tumbles in
--   3  STONE SURGE       green veins converge, stone pillars thrust up and sink in
--   4  BOULDER BARRAGE   a dozen boulders are hurled in from far away and crash home
--   5  STONE CYCLONE     rocks from the valley spiral up into a towering cyclone,
--                        then slam down, and the peak blasts out a second ring
--   6  MOUNTAIN RISING   the ground rumbles, a colossal boulder descends, pulling
--                        rock up from all round, lands with a blast of light, and
--                        a ring of green pillars erupts round the mountain
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("DiamondRush")
local GiftTier = require(Shared:WaitForChild("GiftTier"))
local Format = require(Shared:WaitForChild("Format"))
local CameraShake = require(script.Parent:WaitForChild("CameraShake"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local GiftEffects = {}

-- Particle textures that ship with every Roblox client.
local TEXTURES = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	ember = "rbxasset://textures/particles/fire_sparks_main.dds",
	ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
}
GiftEffects.TEXTURES = TEXTURES
GiftEffects.TITLES = { "SPARK BURST", "SHOCKWAVE", "DIAMOND FRACTURE", "ORBITAL STRIKE", "GALAXY COLLAPSE", "COSMIC BURST" }
-- Per tier: the big gifts get longer, wilder shows with room for more pieces.
GiftEffects.PART_LIMITS = { 70, 70, 70, 110, 130, 160 } -- parts one sequence may create
GiftEffects.LIGHT_LIMITS = { 3, 3, 3, 3, 4, 4 } -- lights one sequence may create
GiftEffects.LIFETIMES = { 9, 9, 9, 10, 11, 12 } -- seconds before a sequence is cleared, whatever happens
GiftEffects.PARTICLE_BUDGETS = { 400, 400, 400, 600, 700, 900 } -- particles one sequence may emit at once (checked by the tests)
-- How long the banner stays up for each tier.
local BANNER_SECONDS = { 1.85, 2.2, 2.55, 4.4, 5.6, 7.4 }

local COLOURS = {
	Color3.fromRGB(255, 208, 112), -- gold
	Color3.fromRGB(255, 140, 60), -- orange
	Color3.fromRGB(110, 235, 255), -- ice blue
	Color3.fromRGB(90, 190, 255), -- sky blue
	Color3.fromRGB(168, 96, 255), -- violet
	Color3.fromRGB(255, 220, 130), -- white gold
}
local GREEN = Color3.fromRGB(90, 235, 170)
-- Gifts that add stone (the griefers' gifts) get their own six sequences, in greens.
GiftEffects.ADD_TITLES = { "PEBBLE DROP", "ROCKSLIDE", "STONE SURGE", "BOULDER BARRAGE", "STONE CYCLONE", "MOUNTAIN RISING" }
local ADD_COLOURS = {
	Color3.fromRGB(150, 255, 200), -- mint
	Color3.fromRGB(90, 235, 170), -- green
	Color3.fromRGB(60, 225, 140), -- emerald
	Color3.fromRGB(120, 230, 90), -- moss
	Color3.fromRGB(70, 235, 200), -- jade
	Color3.fromRGB(140, 255, 120), -- bright green
}
local WHITE = Color3.new(1, 1, 1)
local PINK = Color3.fromRGB(255, 120, 210)
local SMOKE_DARK = Color3.fromRGB(70, 64, 60)
local SMOKE_LIGHT = Color3.fromRGB(150, 142, 134)
-- Flying rock and dust match the mountain's skin.
local ROCK = {
	stone = { colour = Color3.fromRGB(118, 114, 108), dust = Color3.fromRGB(160, 152, 142), material = Enum.Material.Slate },
	hay = { colour = Color3.fromRGB(214, 178, 92), dust = Color3.fromRGB(226, 202, 140), material = Enum.Material.Fabric },
}

local active: { { folder: Folder, tier: number } } = {}
local label: TextLabel? = nil
local state: Instance? = nil
local bannerSerial = 0
local bannerTier = 0
local bannerTween: Tween? = nil
local random = Random.new()

-- Camera shake: a small decaying wobble added after the camera has moved, so
-- it never builds up and the first-person hands follow it.
local shake = 0
local shaking = false
local shakeTime = 0
local function addShake(degrees: number)
	shake = math.max(shake, degrees)
	if shaking then return end
	shaking = true
	RunService:BindToRenderStep("DiamondRushGiftShake", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		local camera = workspace.CurrentCamera
		if shake < 0.01 or camera == nil then
			shake = 0
			shaking = false
			RunService:UnbindFromRenderStep("DiamondRushGiftShake")
			return
		end
		shakeTime += dt
		local t = shakeTime * 17
		local a = math.rad(shake) * 1.5 -- math.noise stays within about ±0.5
		CameraShake.apply(camera, CFrame.Angles(math.noise(t, 0.3) * a, math.noise(t, 7.1) * a, math.noise(t, 13.7) * a * 0.5))
		shake *= math.exp(-dt * 3.5)
	end)
end
GiftEffects.shaking = function(): boolean return shaking end

-- A brief colour grade over the whole screen: up to `peak` and back.
local function grade(peak: { [string]: any }, rise: number, hold: number, fall: number)
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "GiftGrade"
	effect.Parent = Lighting
	TweenService:Create(effect, TweenInfo.new(rise, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), peak):Play()
	task.delay(rise + hold, function()
		TweenService:Create(effect, TweenInfo.new(fall, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE,
		}):Play()
	end)
	Debris:AddItem(effect, rise + hold + fall + 0.1)
end

local function sequence(...: Color3): ColorSequence
	local colours = { ... }
	if #colours == 1 then return ColorSequence.new(colours[1]) end
	local keys = {}
	for i, colour in colours do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#colours - 1), colour))
	end
	return ColorSequence.new(keys)
end

local function curve(...: number): NumberSequence
	local values = { ... }
	if #values == 1 then return NumberSequence.new(values[1]) end
	local keys = {}
	for i, value in values do
		table.insert(keys, NumberSequenceKeypoint.new((i - 1) / (#values - 1), value))
	end
	return NumberSequence.new(keys)
end

function GiftEffects.start(parent: Instance, gameState: Instance?)
	state = gameState
	local gui = Instance.new("ScreenGui")
	gui.Name = "GiftEffects"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 4
	gui.Parent = parent
	local text = Instance.new("TextLabel")
	text.AnchorPoint = Vector2.new(0.5, 0.5)
	text.Position = UDim2.fromScale(0.5, 0.30)
	text.Size = UDim2.new(0.82, 0, 0, 64)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBlack
	text.TextScaled = true
	text.TextStrokeTransparency = 0.35
	text.TextTransparency = 1
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 12
	limit.MaxTextSize = 24
	limit.Parent = text
	text.Parent = gui
	label = text
end

-- A craggy lump of rock: its parts and where each sits in the lump.
type Lump = { parts: { Part }, offsets: { CFrame } }

export type Particles = {
	texture: string,
	count: number,
	colour: ColorSequence,
	size: NumberSequence,
	transparency: NumberSequence?,
	lifetime: { number },
	speed: { number },
	spread: number?,
	drag: number?,
	acceleration: Vector3?,
	glow: number?, -- light emission, 0 to 1
	spin: number?, -- degrees a second
	flat: boolean?, -- lies flat on the ground (shockwave rings)
}

function GiftEffects.play(data: any)
	if typeof(data.position) ~= "Vector3" or type(data.coins) ~= "number" then return end
	local tier = GiftTier.pick(data.coins, data.tier)
	for i = #active, 1, -1 do
		if active[i].folder.Parent == nil then table.remove(active, i) end
	end
	if #active >= 2 then
		local weakest = 1
		for i, entry in active do
			if entry.tier < active[weakest].tier then weakest = i end
		end
		if active[weakest].tier > tier then return end
		table.remove(active, weakest).folder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GiftBurst"
	folder.Parent = workspace
	table.insert(active, { folder = folder, tier = tier })
	Debris:AddItem(folder, GiftEffects.LIFETIMES[tier])
	local colour = if data.adding then ADD_COLOURS[tier] else COLOURS[tier]
	local centre: Vector3 = data.position
	local skin = if state then state:GetAttribute("Skin") else nil
	local rock = ROCK[if type(skin) == "string" and ROCK[skin] then skin else "stone"]

	local made, lights = 0, 0
	local function alive(): boolean
		return folder.Parent ~= nil
	end
	-- Sounds grow deeper and louder with the tier.
	local loudness = 1 + (tier - 1) * 0.15
	local function noise(name: string, at: Vector3?)
		if alive() then Sounds.play(name, at, loudness) end
	end
	local function after(delay: number, callback: () -> ())
		task.delay(delay, function()
			if alive() then callback() end
		end)
	end
	local function part(shape: Enum.PartType, size: Vector3, frame: CFrame, tint: Color3, material: Enum.Material?): Part?
		if not alive() or made >= GiftEffects.PART_LIMITS[tier] then return nil end
		made += 1
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = frame
		p.Color = tint
		p.Material = material or Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = folder
		return p
	end
	local function animate(p: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
		TweenService:Create(p, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal):Play()
	end
	local function fade(p: Instance, seconds: number, goal: { [string]: any })
		animate(p, seconds, goal)
		Debris:AddItem(p, seconds + 0.05)
	end
	-- One connection per moving piece, released when it ends or the sequence is cleared.
	local function motion(duration: number, update: (number) -> (), finish: (() -> ())?)
		local elapsed = 0
		local connection: RBXScriptConnection? = nil
		connection = RunService.RenderStepped:Connect(function(dt: number)
			elapsed += dt
			local t = math.clamp(elapsed / duration, 0, 1)
			if alive() then update(t) end
			if t >= 1 or not alive() then
				if connection then connection:Disconnect(); connection = nil end
				if alive() and finish then finish() end
			end
		end)
	end
	local function light(holder: Instance, tint: Color3, range: number, brightness: number, seconds: number)
		if lights >= GiftEffects.LIGHT_LIMITS[tier] then return end
		lights += 1
		local glow = Instance.new("PointLight")
		glow.Color = tint
		glow.Range = range
		glow.Brightness = brightness
		glow.Shadows = false
		glow.Parent = holder
		animate(glow, seconds, { Brightness = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	-- Particles come from attachments on one invisible anchor at the origin.
	local anchor = part(Enum.PartType.Block, Vector3.one * 0.2, CFrame.identity, WHITE) :: Part
	anchor.Transparency = 1
	local function emitter(spec: Particles, holder: Instance): ParticleEmitter
		local particles = Instance.new("ParticleEmitter")
		particles.Texture = spec.texture
		particles.Color = spec.colour
		particles.Size = spec.size
		particles.Transparency = spec.transparency or curve(0, 1)
		particles.Lifetime = NumberRange.new(spec.lifetime[1], spec.lifetime[2])
		particles.Speed = NumberRange.new(spec.speed[1], spec.speed[2])
		local spread = spec.spread or 180
		particles.SpreadAngle = Vector2.new(spread, spread)
		particles.Drag = spec.drag or 0
		particles.Acceleration = spec.acceleration or Vector3.zero
		particles.LightEmission = spec.glow or 1
		particles.LightInfluence = if (spec.glow or 1) > 0 then 0 else 1
		particles.Rotation = NumberRange.new(0, 360)
		local spin = spec.spin or 0
		particles.RotSpeed = NumberRange.new(-spin, spin)
		particles.EmissionDirection = Enum.NormalId.Top
		if spec.flat then particles.Orientation = Enum.ParticleOrientation.VelocityPerpendicular end
		particles.Enabled = false
		particles.Parent = holder
		return particles
	end
	-- A point in the world to hang particles or a light on.
	local function point(at: Vector3, seconds: number): Attachment
		local spot = Instance.new("Attachment")
		spot.Position = at
		spot.Parent = anchor
		Debris:AddItem(spot, seconds)
		return spot
	end
	local function burst(at: Vector3, spec: Particles)
		if not alive() then return end
		emitter(spec, point(at, spec.lifetime[2] + 0.2)):Emit(spec.count)
	end
	-- A shockwave ring that races out flat across the ground.
	local function shockwave(at: Vector3, radius: number, tint: Color3, seconds: number)
		noise(if radius >= 18 then "bigBoom" elseif radius >= 6 then "boom" else "thud", at)
		burst(at + Vector3.new(0, 0.4, 0), {
			texture = TEXTURES.ring, count = 1, colour = sequence(WHITE, tint),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, radius * 1.5), NumberSequenceKeypoint.new(1, radius * 2) }),
			transparency = curve(0, 0.2, 1), lifetime = { seconds, seconds }, speed = { 0.01, 0.01 }, spread = 0, flat = true,
		})
	end
	local function flash(at: Vector3, size: number, tint: Color3, seconds: number)
		if size < 6 then noise("pop", at) end
		local orb = part(Enum.PartType.Ball, Vector3.one * 0.4, CFrame.new(at), WHITE)
		if orb == nil then return end
		orb.Transparency = 0.05
		fade(orb, seconds, { Size = Vector3.one * size, Transparency = 1, Color = tint })
	end
	local function sparks(at: Vector3, count: number, tint: Color3, power: number)
		noise("sparkle", at)
		burst(at, {
			texture = TEXTURES.spark, count = count, colour = sequence(WHITE, tint), size = curve(0.55, 0.35, 0),
			lifetime = { 0.45, 1 }, speed = { 6 * power, 14 * power }, drag = 3.5, acceleration = Vector3.new(0, -14, 0), spin = 200,
		})
	end
	local function dust(at: Vector3, count: number, size: number)
		burst(at, {
			texture = TEXTURES.smoke, count = count, colour = sequence(rock.dust), size = curve(size, size * 2.6),
			transparency = curve(0.35, 0.6, 1), lifetime = { 0.9, 1.5 }, speed = { 3, 7 }, spread = 80, drag = 2.5,
			acceleration = Vector3.new(0, 1.5, 0), glow = 0, spin = 40,
		})
	end
	local function embers(at: Vector3, count: number, power: number)
		burst(at, {
			texture = TEXTURES.ember, count = count, colour = sequence(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 150, 60), Color3.fromRGB(200, 60, 20)),
			size = curve(0.45, 0.3, 0), lifetime = { 0.8, 1.6 }, speed = { 10 * power, 22 * power }, spread = 55, drag = 1.5,
			acceleration = Vector3.new(0, -22, 0), spin = 120,
		})
	end
	local function fireball(at: Vector3, count: number, size: number, tint: Color3)
		burst(at, {
			texture = TEXTURES.fire, count = count, colour = sequence(WHITE, tint, Color3.fromRGB(255, 110, 40)), size = curve(size, size * 2.2, size * 1.6),
			transparency = curve(0.1, 0.35, 1), lifetime = { 0.45, 0.9 }, speed = { size * 3, size * 6 }, drag = 5, glow = 0.85, spin = 90,
		})
	end
	local function smokeColumn(at: Vector3, count: number, size: number, seconds: number)
		burst(at, {
			texture = TEXTURES.smoke, count = count, colour = sequence(SMOKE_DARK, SMOKE_LIGHT), size = curve(size, size * 2.4),
			transparency = curve(0.25, 0.5, 1), lifetime = { seconds * 0.7, seconds }, speed = { size * 1.4, size * 2.6 }, spread = 32,
			drag = 1.4, acceleration = Vector3.new(0, 2, 0), glow = 0, spin = 25,
		})
	end
	-- Chunks of rock (or hay) thrown out of the crater, tumbling as they fall.
	local function chunks(at: Vector3, count: number, power: number)
		noise("rubble", at)
		for _ = 1, count do
			local size = random:NextNumber(0.35, 0.75) * math.sqrt(power)
			local chunk = part(Enum.PartType.Block, Vector3.new(size, size * random:NextNumber(0.6, 1), size), CFrame.new(at), rock.colour:Lerp(rock.dust, random:NextNumber(0, 0.5)), rock.material)
			if chunk == nil then return end
			local angle = random:NextNumber(0, math.pi * 2)
			local velocity = Vector3.new(math.cos(angle) * random:NextNumber(5, 11) * power, random:NextNumber(10, 18) * math.sqrt(power), math.sin(angle) * random:NextNumber(5, 11) * power)
			local spin = Vector3.new(random:NextNumber(-12, 12), random:NextNumber(-12, 12), random:NextNumber(-12, 12))
			local duration = random:NextNumber(0.9, 1.3)
			motion(duration, function(t)
				local s = t * duration
				local position = at + velocity * s + Vector3.new(0, -30 * s * s, 0)
				chunk.CFrame = CFrame.new(position) * CFrame.Angles(spin.X * s, spin.Y * s, spin.Z * s)
				chunk.Transparency = math.clamp((t - 0.7) / 0.3, 0, 1)
			end, function() chunk:Destroy() end)
		end
	end
	-- A vertical column of light from `top` down to `bottom`.
	local function column(bottom: Vector3, height: number, width: number, tint: Color3, seconds: number, material: Enum.Material?): Part?
		noise("beam", bottom)
		local beam = part(Enum.PartType.Cylinder, Vector3.new(height, width * 0.2, width * 0.2), CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), tint, material)
		if beam == nil then return nil end
		animate(beam, 0.08, { Size = Vector3.new(height, width, width) })
		task.delay(0.08, function()
			if beam.Parent then fade(beam, seconds, { Size = Vector3.new(height, width * 0.1, width * 0.1), Transparency = 1 }) end
		end)
		return beam
	end
	-- A glowing ball streaking along a curve from the sky to `target`, with a
	-- trail and fire behind it. `land` runs when it hits.
	local function streak(from: Vector3, target: Vector3, size: number, seconds: number, tint: Color3, withLight: boolean, land: () -> ())
		noise("whoosh", target)
		local ball = part(Enum.PartType.Ball, Vector3.one * size, CFrame.new(from), tint:Lerp(WHITE, 0.6))
		if ball == nil then return end
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, size * 0.45, 0)
		a.Parent = ball
		local b = Instance.new("Attachment")
		b.Position = Vector3.new(0, -size * 0.45, 0)
		b.Parent = ball
		local trail = Instance.new("Trail")
		trail.Attachment0 = a
		trail.Attachment1 = b
		trail.Color = sequence(WHITE, tint, Color3.fromRGB(255, 90, 40))
		trail.Lifetime = 0.35 + size * 0.06
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.WidthScale = curve(1, 0)
		trail.Transparency = curve(0, 1)
		trail.Parent = ball
		local fire = emitter({
			texture = TEXTURES.fire, count = 0, colour = sequence(WHITE, tint, Color3.fromRGB(255, 100, 40)), size = curve(size * 0.9, 0),
			transparency = curve(0.1, 1), lifetime = { 0.25, 0.45 }, speed = { 0.5, 1.5 }, glow = 0.9, spin = 120,
		}, a)
		fire.Rate = 30 + size * 20
		fire.Enabled = true
		if withLight then light(ball, tint, 10 + size * 4, 3, seconds + 0.3) end
		local bend = (from + target) / 2 + Vector3.new(0, (from - target).Magnitude * 0.12, 0)
		motion(seconds, function(t)
			local u = t * t
			local position = from * ((1 - u) ^ 2) + bend * (2 * (1 - u) * u) + target * (u * u)
			ball.CFrame = CFrame.new(position)
		end, function()
			ball:Destroy()
			land()
		end)
	end
	local function skyPoint(at: Vector3, height: number, reach: number): Vector3
		local angle = random:NextNumber(0, math.pi * 2)
		return at + Vector3.new(math.cos(angle) * reach, height, math.sin(angle) * reach)
	end

	-- Where the rock surface is under a point (glowing veins and cracks lie on it).
	local mountain = workspace:FindFirstChild("Mountain", true)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = if mountain then { mountain } else {}
	local function surface(at: Vector3): Vector3?
		if mountain == nil then return nil end
		local hit = workspace:Raycast(at + Vector3.new(0, 100, 0), Vector3.new(0, -220, 0), params)
		return if hit then hit.Position + hit.Normal * 0.09 else nil
	end
	-- A craggy lump of rock (or hay): one block, or three for big ones, moved together.
	local LUMP_PIECES = {
		{ Vector3.new(1, 0.8, 0.9), CFrame.identity },
		{ Vector3.new(0.7, 0.6, 0.75), CFrame.new(0.25, 0.2, -0.1) * CFrame.Angles(0.5, 0.3, 0.2) },
		{ Vector3.new(0.6, 0.55, 0.6), CFrame.new(-0.25, -0.1, 0.2) * CFrame.Angles(-0.3, 0.8, 0.4) },
	}
	local function lump(size: number, frame: CFrame): Lump?
		local rocks: Lump = { parts = {}, offsets = {} }
		for index, piece in LUMP_PIECES do
			if index > 1 and size < 1.4 then break end
			local offset = CFrame.new(piece[2].Position * size) * piece[2].Rotation
			local chunk = part(Enum.PartType.Block, piece[1] * size, frame * offset, rock.colour:Lerp(rock.dust, random:NextNumber(0, 0.4)), rock.material)
			if chunk == nil then break end
			table.insert(rocks.parts, chunk)
			table.insert(rocks.offsets, offset)
		end
		return if #rocks.parts > 0 then rocks else nil
	end
	local function place(rocks: Lump, frame: CFrame)
		for index, chunk in rocks.parts do chunk.CFrame = frame * rocks.offsets[index] end
	end
	local function vanish(rocks: Lump)
		for _, chunk in rocks.parts do chunk:Destroy() end
	end
	-- Green motes rising where rock has landed.
	local function motes(at: Vector3, count: number, power: number)
		burst(at, {
			texture = TEXTURES.spark, count = count, colour = sequence(WHITE, colour), size = curve(0.5, 0.3, 0),
			lifetime = { 0.8, 1.5 }, speed = { 3 * power, 9 * power }, spread = 45, drag = 1.5, acceleration = Vector3.new(0, 4, 0), spin = 120,
		})
	end
	-- Rock arriving at `at`: a puff of dust, a green glint and a small ring.
	local function settle(at: Vector3, power: number)
		dust(at, math.ceil(2 * power), 0.6 * power)
		motes(at, math.ceil(5 * power), 0.7)
		shockwave(at, 2.5 * power, colour, 0.4)
	end
	-- Glowing veins along the rock from `radius` out, racing in to the centre
	-- (inward) or out from it.
	local function veins(origin: Vector3, branches: number, radius: number, inward: boolean, width: number, seconds: number)
		noise("zap", origin)
		local rotation = random:NextNumber(0, math.pi * 2)
		for branch = 1, branches do
			local angle = rotation + branch * math.pi * 2 / branches
			local previous = origin
			for step = 1, 3 do
				local bend = angle + random:NextNumber(-0.3, 0.3)
				local flatTarget = centre + Vector3.new(math.cos(bend), 0, math.sin(bend)) * radius * step / 3
				local target = surface(flatTarget) or Vector3.new(flatTarget.X, origin.Y, flatTarget.Z)
				local start = previous
				previous = target
				local delta = target - start
				if delta.Magnitude < 0.05 or delta.Magnitude > radius * 0.6 then continue end
				local delay = (if inward then 3 - step else step - 1) * seconds / 3 + branch * 0.015
				after(delay, function()
					local frame = if inward then CFrame.lookAt(target, start) else CFrame.lookAt(start, target)
					local vein = part(Enum.PartType.Block, Vector3.new(width, width, 0.05), frame, colour)
					if vein == nil then return end
					animate(vein, seconds / 3, { Size = Vector3.new(width, width, delta.Magnitude), CFrame = frame * CFrame.new(0, 0, -delta.Magnitude / 2) }, Enum.EasingStyle.Linear)
					task.delay(seconds + 0.25 - delay, function()
						if vein.Parent then fade(vein, 0.3, { Color = WHITE, Transparency = 1 }) end
					end)
				end)
			end
		end
	end
	local function towards(a: Vector3, b: Vector3, t: number): Vector3
		return a + (b - a) * t
	end

	if data.adding then
		-- Rock coming back.
		local summit = surface(centre) or centre
		if tier == 1 then
			-- PEBBLE DROP: pebbles fall onto the peak, each with a puff of dust.
			light(point(summit + Vector3.new(0, 2, 0), 1), colour, 10, 2, 0.8)
			for i = 1, 5 do
				after((i - 1) * 0.08, function()
					local angle = random:NextNumber(0, math.pi * 2)
					local landing = summit + Vector3.new(math.cos(angle), 0, math.sin(angle)) * random:NextNumber(0, 2.5)
					local from = landing + Vector3.new(0, random:NextNumber(9, 12), 0)
					local rocks = lump(random:NextNumber(0.5, 0.8), CFrame.new(from))
					if rocks == nil then return end
					local spin = random:NextNumber(4, 9)
					motion(0.45, function(t)
						place(rocks, CFrame.new(towards(from, landing, t * t)) * CFrame.Angles(spin * t, spin * t * 0.6, 0))
					end, function()
						vanish(rocks)
						settle(landing, 1)
					end)
				end)
			end
			after(0.55, function() shockwave(summit, 5, colour, 0.5) end)
		elseif tier == 2 then
			-- ROCKSLIDE: a ring of rocks rises out of the slopes and tumbles in.
			light(point(summit + Vector3.new(0, 2, 0), 1.4), colour, 16, 3, 1.2)
			local rotation = random:NextNumber(0, math.pi * 2)
			for i = 1, 10 do
				local angle = rotation + i * math.pi / 5
				local flat = summit + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 9
				local rise = (surface(flat) or (flat - Vector3.new(0, 4, 0)))
				local rocks = lump(random:NextNumber(0.7, 1.1), CFrame.new(rise))
				if rocks == nil then break end
				dust(rise, 2, 0.8)
				local lifted = rise + Vector3.new(0, 3, 0)
				local spin = random:NextNumber(5, 10)
				motion(0.35, function(t)
					place(rocks, CFrame.new(towards(rise, lifted, 1 - (1 - t) ^ 3)) * CFrame.Angles(0, t * 2, 0))
				end)
				after(0.35 + i * 0.03, function()
					local apex = towards(lifted, summit, 0.5) + Vector3.new(0, 3, 0)
					motion(0.45, function(t)
						local u = t * t
						local position = lifted * ((1 - u) ^ 2) + apex * (2 * (1 - u) * u) + summit * (u * u)
						place(rocks, CFrame.new(position) * CFrame.Angles(spin * t, 2 + spin * t * 0.5, 0))
					end, function()
						vanish(rocks)
						settle(summit, 0.8)
					end)
				end)
			end
			after(0.95, function()
				shockwave(summit, 11, colour, 0.6)
				motes(summit, 20, 1)
				addShake(0.35)
			end)
		elseif tier == 3 then
			-- STONE SURGE: green veins race in from all round, stone pillars
			-- thrust up in a ring, lean in and sink into the peak.
			veins(summit, 6, 11, true, 0.14, 0.5)
			light(point(summit + Vector3.new(0, 2, 0), 1.6), colour, 14, 2, 1.4)
			after(0.5, function()
				local rotation = random:NextNumber(0, math.pi * 2)
				for i = 1, 6 do
					local angle = rotation + i * math.pi / 3
					local flat = summit + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 4.5
					local base = surface(flat) or (flat - Vector3.new(0, 1, 0))
					local height = random:NextNumber(4, 6)
					local column = part(Enum.PartType.Cylinder, Vector3.new(0.1, 1.5, 1.5), CFrame.new(base) * CFrame.Angles(0, 0, math.pi / 2), rock.colour, rock.material)
					if column == nil then break end
					dust(base, 2, 1)
					animate(column, 0.22, { Size = Vector3.new(height, 1.5, 1.5), CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2) }, Enum.EasingStyle.Back)
					after(0.5, function()
						-- Lean the top in towards the peak while sliding into it.
						local top = base + Vector3.new(0, height / 2, 0)
						local inward = Vector3.new(summit.X - base.X, 0, summit.Z - base.Z).Unit
						local axis = Vector3.new(0, 1, 0):Cross(inward)
						motion(0.3, function(t)
							local position = towards(top, summit + Vector3.new(0, 0.5, 0), t * t)
							column.CFrame = CFrame.new(position) * CFrame.fromAxisAngle(axis, 1.1 * t) * CFrame.Angles(0, 0, math.pi / 2)
							column.Size = Vector3.new(height * (1 - 0.7 * t), 1.5 * (1 - 0.5 * t), 1.5 * (1 - 0.5 * t))
						end, function() column:Destroy() end)
					end)
				end
			end)
			after(1.32, function()
				flash(summit + Vector3.new(0, 1, 0), 8, colour, 0.35)
				shockwave(summit, 14, colour, 0.6)
				dust(summit, 12, 1.5)
				motes(summit, 30, 1.2)
				addShake(0.5)
			end)
		elseif tier == 4 then
			-- BOULDER BARRAGE: a dozen boulders hurled in from far away crash home
			-- one after another, trailing dust, then the peak heaves with a ring
			-- of light.
			local rotation = random:NextNumber(0, math.pi * 2)
			light(point(summit + Vector3.new(0, 4, 0), 3.6), colour, 20, 1.5, 3.4)
			for i = 1, 12 do
				after((i - 1) * 0.22, function()
					local angle = rotation + i * 1.1
					local from = summit + Vector3.new(math.cos(angle) * 75, random:NextNumber(4, 12), math.sin(angle) * 75)
					local landing = summit + Vector3.new(random:NextNumber(-5, 5), 0, random:NextNumber(-5, 5))
					landing = surface(landing) or landing
					local apex = towards(from, landing, 0.5) + Vector3.new(0, random:NextNumber(28, 42), 0)
					local rocks = lump(random:NextNumber(1.6, 2.3), CFrame.new(from))
					if rocks == nil then return end
					noise("whoosh", landing)
					local trail = Instance.new("Attachment")
					trail.Parent = rocks.parts[1]
					local dustTrail = emitter({
						texture = TEXTURES.smoke, count = 0, colour = sequence(rock.dust), size = curve(1.2, 2.6), transparency = curve(0.4, 1),
						lifetime = { 0.5, 0.8 }, speed = { 0.2, 0.8 }, glow = 0, spin = 40,
					}, trail)
					dustTrail.Rate = 30
					dustTrail.Enabled = true
					local spin = random:NextNumber(3, 6)
					motion(0.95, function(t)
						local position = from * ((1 - t) ^ 2) + apex * (2 * (1 - t) * t) + landing * (t * t)
						place(rocks, CFrame.new(position) * CFrame.Angles(spin * t, spin * t * 0.7, spin * t * 0.3))
					end, function()
						vanish(rocks)
						settle(landing, 1.6)
						chunks(landing, 1, 0.8)
						addShake(0.35)
					end)
				end)
			end
			after(3.45, function()
				flash(summit + Vector3.new(0, 1, 0), 12, colour, 0.4)
				grade({ Brightness = 0.15, Contrast = 0.08, TintColor = colour:Lerp(WHITE, 0.7) }, 0.05, 0.1, 0.5)
				addShake(0.8)
				shockwave(summit, 20, colour, 0.75)
				after(0.12, function() shockwave(summit, 13, WHITE, 0.6) end)
				column(summit, 40, 3, colour, 0.8)
				motes(summit, 50, 1.5)
				dust(summit, 12, 2)
				light(point(summit + Vector3.new(0, 3, 0), 1.3), colour, 24, 3, 1.1)
			end)
		elseif tier == 5 then
			-- STONE CYCLONE: rocks from the valley spiral up into a towering,
			-- whirling cyclone over the peak with a pulsing green core, then
			-- slam down into it, and the peak blasts out a second ring.
			light(point(summit + Vector3.new(0, 10, 0), 4.4), colour, 28, 3, 4.2)
			local count = 32
			local spinUp = 3.2
			local stones: { Lump } = {}
			local seeds: { { number } } = {}
			for i = 1, count do
				local angle = i / count * math.pi * 2
				local reach = random:NextNumber(22, 34)
				local rocks = lump(random:NextNumber(0.6, 1.2), CFrame.new(summit))
				if rocks == nil then break end
				table.insert(stones, rocks)
				-- angle, reach, start height, end height, end reach, spin speed
				table.insert(seeds, { angle, reach, summit.Y - random:NextNumber(8, 14), summit.Y + 7 + (i % 8) * 2.4, 2.5 + (i % 5) * 1.3, 4 + (i % 3) })
			end
			local whirl: { Attachment } = {}
			for i = 1, 4 do
				local spot = point(summit, spinUp + 0.8)
				local cloud = emitter({
					texture = TEXTURES.smoke, count = 0, colour = sequence(rock.dust, colour:Lerp(rock.dust, 0.6)), size = curve(1.5, 3.8),
					transparency = curve(0.45, 1), lifetime = { 0.6, 1 }, speed = { 0.5, 1.5 }, glow = 0, spin = 60,
				}, spot)
				cloud.Rate = 24
				cloud.Enabled = true
				table.insert(whirl, spot)
			end
			-- The eye of the storm pulses brighter as it spins up.
			local eye = part(Enum.PartType.Cylinder, Vector3.new(26, 0.8, 0.8), CFrame.new(summit + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.pi / 2), colour, Enum.Material.ForceField)
			local positions: { Vector3 } = {}
			motion(spinUp, function(t)
				local ease = 1 - (1 - t) ^ 2
				for i, rocks in stones do
					local seed = seeds[i]
					local angle = seed[1] + t * seed[6] * 4
					local reach = seed[2] + (seed[5] - seed[2]) * ease
					local position = Vector3.new(summit.X + math.cos(angle) * reach, seed[3] + (seed[4] - seed[3]) * ease, summit.Z + math.sin(angle) * reach)
					positions[i] = position
					place(rocks, CFrame.new(position) * CFrame.Angles(angle * 2, angle, 0))
				end
				for i, spot in whirl do
					local angle = t * 16 + i * math.pi / 2
					spot.Position = summit + Vector3.new(math.cos(angle) * 4.5, 4 + i * 3 + t * 6, math.sin(angle) * 4.5)
				end
				if eye then
					local pulse = 0.8 + t * 2.4 + math.sin(t * 40) * 0.3
					eye.Size = Vector3.new(26, pulse, pulse)
				end
			end, function()
				if eye then fade(eye, 0.2, { Size = Vector3.new(26, 0.1, 0.1), Transparency = 1 }) end
				for i, rocks in stones do
					local from = positions[i] or summit
					local delay = (i % 6) * 0.03
					after(delay, function()
						motion(0.3, function(t)
							place(rocks, CFrame.new(towards(from, summit, t * t)) * CFrame.Angles(t * 6, t * 3, 0))
						end, function() vanish(rocks) end)
					end)
				end
			end)
			after(spinUp + 0.38, function()
				flash(summit + Vector3.new(0, 1, 0), 16, colour, 0.45)
				grade({ Brightness = 0.22, Contrast = 0.12, TintColor = colour:Lerp(WHITE, 0.65) }, 0.05, 0.12, 0.6)
				addShake(1.1)
				shockwave(summit, 24, colour, 0.8)
				after(0.1, function() shockwave(summit, 16, WHITE, 0.6) end)
				dust(summit, 18, 2.4)
				motes(summit, 50, 1.6)
			end)
			after(spinUp + 1.1, function()
				shockwave(summit, 32, colour:Lerp(rock.dust, 0.3), 1)
				column(summit, 50, 3.5, colour, 0.9)
				motes(summit, 40, 2)
				addShake(0.6)
			end)
		else
			-- MOUNTAIN RISING: the sky turns, the ground rumbles and green light
			-- cracks outward, a colossal boulder descends slowly, pulling rock
			-- up from all round, lands on the peak with a blast of light, and a
			-- ring of green pillars erupts round the mountain.
			local descent = 2.8
			noise("rumble", summit)
			after(1.2, function() noise("rumble", summit) end)
			after(descent - 0.5, function() noise("deepWhoosh", summit) end)
			grade({ Brightness = -0.12, Contrast = 0.2, Saturation = -0.05, TintColor = Color3.fromRGB(205, 255, 220) }, 0.6, 3.4, 1.4)
			for i = 0, 9 do
				after(i * 0.3, function() addShake(0.45) end)
			end
			veins(summit, 8, 20, false, 0.2, 1.2)
			local sky = summit + Vector3.new(0, 85, 0)
			local land = summit + Vector3.new(0, 5, 0)
			local colossus = lump(9, CFrame.new(sky))
			local carried = Vector3.zero
			if colossus then
				local core = colossus.parts[1]
				light(core, colour, 40, 4, descent + 0.8)
				local halo = Instance.new("Attachment")
				halo.Parent = core
				local rings = emitter({
					texture = TEXTURES.ring, count = 0, colour = sequence(WHITE, colour), size = curve(9, 18),
					transparency = curve(0.3, 1), lifetime = { 0.6, 0.6 }, speed = { 0.01, 0.01 }, spread = 0, flat = true,
				}, halo)
				rings.Rate = 5
				rings.Enabled = true
				motion(descent, function(t)
					local u = t * t * (3 - 2 * t)
					carried = towards(sky, land, u)
					place(colossus, CFrame.new(carried) * CFrame.Angles(0.15, t * 2.4, 0.1))
				end)
				after(0.4, function()
					-- Rock is pulled up off the slopes into it.
					for i = 1, 26 do
						local angle = i / 26 * math.pi * 2 + random:NextNumber(-0.2, 0.2)
						local flat = summit + Vector3.new(math.cos(angle), 0, math.sin(angle)) * random:NextNumber(18, 32)
						local from = surface(flat) or (flat - Vector3.new(0, 8, 0))
						local rocks = lump(random:NextNumber(0.7, 1.3), CFrame.new(from))
						if rocks == nil then break end
						if i % 3 == 0 then dust(from, 2, 1) end
						local spin = random:NextNumber(4, 8)
						after(i * 0.06, function()
							motion(1.4, function(t)
								local target = if carried.Magnitude > 0 then carried else land
								place(rocks, CFrame.new(towards(from, target, t * t) + Vector3.new(0, math.sin(t * math.pi) * 8, 0)) * CFrame.Angles(spin * t, spin * t, 0))
							end, function()
								vanish(rocks)
								motes(carried, 3, 0.6)
							end)
						end)
					end
				end)
			end
			after(descent + 0.02, function()
				if colossus then
					for _, chunk in colossus.parts do fade(chunk, 0.12, { Size = chunk.Size * 0.6, Transparency = 1 }) end
				end
				grade({ Brightness = 0.45, Contrast = 0.12, TintColor = Color3.fromRGB(230, 255, 236) }, 0.04, 0.1, 0.7)
				addShake(1.5)
				flash(summit + Vector3.new(0, 2, 0), 28, colour, 0.55)
				shockwave(summit, 32, colour, 0.9)
				after(0.12, function() shockwave(summit, 22, WHITE, 0.7) end)
				after(0.3, function() shockwave(summit, 44, colour:Lerp(rock.dust, 0.4), 1.1) end)
				dust(summit, 24, 3.5)
				motes(summit, 60, 2)
				column(summit, 90, 6, colour, 1.6)
				chunks(summit, 10, 1.6)
				light(point(summit + Vector3.new(0, 4, 0), 1.8), colour, 36, 4, 1.6)
			end)
			-- Aftershock: green pillars burst up in a ring round the mountain,
			-- one after another, then the whole peak pulses once more.
			local ringTurn = random:NextNumber(0, math.pi * 2)
			for i = 1, 8 do
				after(descent + 0.5 + i * 0.16, function()
					local angle = ringTurn + i * math.pi / 4
					local flat = summit + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 16
					local foot = surface(flat) or (flat - Vector3.new(0, 6, 0))
					column(foot, 34, 2.2, colour, 0.9)
					settle(foot, 1.5)
					addShake(0.4)
				end)
			end
			after(descent + 2.2, function()
				flash(summit + Vector3.new(0, 2, 0), 18, colour, 0.5)
				shockwave(summit, 50, colour, 1.2)
				after(0.15, function() shockwave(summit, 36, WHITE, 0.9) end)
				motes(summit, 70, 2.4)
				grade({ Brightness = 0.25, Contrast = 0.08, TintColor = Color3.fromRGB(225, 255, 235) }, 0.05, 0.1, 0.8)
				addShake(0.9)
			end)
		end
	elseif tier == 1 then
		-- SPARK BURST: a crisp golden pop, sparks and a puff of dust.
		flash(centre, 3, colour, 0.25)
		light(point(centre + Vector3.new(0, 2, 0), 0.6), colour, 10, 2, 0.4)
		sparks(centre, 22, colour, 0.9)
		dust(centre, 5, 1)
		shockwave(centre, 5, colour, 0.45)
		chunks(centre, 3, 0.8)
	elseif tier == 2 then
		-- SHOCKWAVE: a double ring tears across the ground, rock and sparks fly.
		flash(centre, 5, colour, 0.3)
		light(point(centre + Vector3.new(0, 2, 0), 0.8), colour, 16, 3, 0.6)
		shockwave(centre, 12, colour, 0.6)
		after(0.09, function() shockwave(centre, 8, WHITE, 0.5) end)
		sparks(centre, 30, colour, 1.2)
		embers(centre, 10, 0.8)
		dust(centre, 12, 1.4)
		chunks(centre, 7, 1)
		addShake(0.35)
	elseif tier == 3 then
		-- DIAMOND FRACTURE: glowing cracks race over the rock, crystals burst up
		-- out of them, then shatter into glittering shards.
		local origin = surface(centre) or centre
		local radius = 7 + math.clamp((data.coins - 100) / 399, 0, 1) * 5
		local rotation = random:NextNumber(0, math.pi * 2)
		local tips: { Vector3 } = {}
		for branch = 1, 6 do
			local angle = rotation + branch * math.pi / 3
			local previous = origin
			for step = 1, 3 do
				local bend = angle + random:NextNumber(-0.3, 0.3)
				local flatTarget = centre + Vector3.new(math.cos(bend), 0, math.sin(bend)) * radius * step / 3
				local target = surface(flatTarget) or Vector3.new(flatTarget.X, origin.Y, flatTarget.Z)
				local start = previous
				previous = target
				local delta = target - start
				-- No glowing bridges across a dug-out gap.
				if delta.Magnitude < 0.05 or delta.Magnitude > 6 then continue end
				if step == 3 then table.insert(tips, target) end
				after((step - 1) * 0.12 + branch * 0.02, function()
					local frame = CFrame.lookAt(start, target)
					local crack = part(Enum.PartType.Block, Vector3.new(0.12, 0.12, 0.05), frame, colour)
					if crack == nil then return end
					animate(crack, 0.14, { Size = Vector3.new(0.14, 0.14, delta.Magnitude), CFrame = frame * CFrame.new(0, 0, -delta.Magnitude / 2) }, Enum.EasingStyle.Linear)
					task.delay(0.62 - (step - 1) * 0.12, function()
						if crack.Parent then fade(crack, 0.25, { Color = WHITE, Transparency = 1, Size = Vector3.new(0.3, 0.3, delta.Magnitude) }) end
					end)
				end)
			end
		end
		light(point(origin + Vector3.new(0, 2, 0), 1.2), colour, 12, 1.5, 0.9)
		burst(origin, {
			texture = TEXTURES.glow, count = 2, colour = sequence(colour), size = curve(1, radius * 0.9), transparency = curve(0.5, 1),
			lifetime = { 0.7, 0.7 }, speed = { 0.01, 0.01 }, spread = 0,
		})
		-- Crystals grow out of the crack tips and the centre.
		after(0.62, function()
			table.insert(tips, origin)
			local crystals: { Part } = {}
			for index, tip in tips do
				local height = if index == #tips then 4.2 else random:NextNumber(2, 3.2)
				local tilt = CFrame.Angles(random:NextNumber(-0.35, 0.35), random:NextNumber(0, math.pi), random:NextNumber(-0.35, 0.35))
				local base = CFrame.new(tip) * tilt * CFrame.Angles(0, math.pi / 4, 0)
				local crystal = part(Enum.PartType.Block, Vector3.new(0.7, 0.1, 0.7), base, colour:Lerp(WHITE, 0.35), Enum.Material.Glass)
				if crystal == nil then break end
				crystal.Transparency = 0.25
				crystal.Reflectance = 0.25
				table.insert(crystals, crystal)
				animate(crystal, 0.16, { Size = Vector3.new(0.7, height, 0.7), CFrame = base * CFrame.new(0, height / 2, 0) }, Enum.EasingStyle.Back)
			end
			-- Then they shatter.
			after(0.42, function()
				noise("shatter", origin)
				flash(origin + Vector3.new(0, 1.5, 0), radius * 0.9, colour, 0.35)
				shockwave(origin, radius * 1.4, colour, 0.6)
				sparks(origin + Vector3.new(0, 1.5, 0), 45, colour, 1.3)
				addShake(0.5)
				for _, crystal in crystals do
					local from = crystal.CFrame
					local fromSize = crystal.Size
					local away = Vector3.new(from.Position.X - origin.X, 0, from.Position.Z - origin.Z)
					if away.Magnitude < 0.1 then away = Vector3.new(random:NextNumber(-1, 1), 0, random:NextNumber(-1, 1)) end
					local velocity = away.Unit * random:NextNumber(6, 12) + Vector3.new(0, random:NextNumber(8, 14), 0)
					local spin = random:NextNumber(6, 14)
					motion(0.9, function(t)
						local s = t * 0.9
						crystal.CFrame = CFrame.new(from.Position + velocity * s + Vector3.new(0, -26 * s * s, 0)) * from.Rotation * CFrame.Angles(spin * s, spin * s * 0.6, 0)
						crystal.Size = fromSize:Lerp(Vector3.new(0.3, 0.6, 0.3), t)
						crystal.Transparency = 0.25 + 0.75 * t * t
					end, function() crystal:Destroy() end)
				end
			end)
		end)
	elseif tier == 4 then
		-- ORBITAL STRIKE: a target ring locks on while a charge gathers high in
		-- the sky, a beam slams down and the ground erupts, then a barrage of
		-- strikes walks round the crater and a last, wider beam finishes it.
		burst(centre + Vector3.new(0, 0.3, 0), {
			texture = TEXTURES.ring, count = 1, colour = sequence(colour), size = curve(16, 3), transparency = curve(0.6, 0.1),
			lifetime = { 0.65, 0.65 }, speed = { 0.01, 0.01 }, spread = 0, flat = true,
		})
		local marks: { Part } = {}
		for _ = 1, 4 do
			local mark = part(Enum.PartType.Block, Vector3.new(0.25, 0.12, 1.6), CFrame.new(centre), colour)
			if mark then table.insert(marks, mark) end
		end
		motion(0.65, function(t)
			local reach = 8 - 5.5 * t * t
			for i, mark in marks do
				local angle = i * math.pi / 2 + t * 2.2
				local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
				mark.CFrame = CFrame.lookAt(centre + direction * reach + Vector3.new(0, 0.3, 0), centre + Vector3.new(0, 0.3, 0))
			end
		end, function()
			for _, mark in marks do fade(mark, 0.15, { Transparency = 1 }) end
		end)
		local sky = centre + Vector3.new(0, 70, 0)
		local charge = part(Enum.PartType.Ball, Vector3.one * 0.3, CFrame.new(sky), colour:Lerp(WHITE, 0.5))
		if charge then
			animate(charge, 0.6, { Size = Vector3.one * 4 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			light(charge, colour, 30, 4, 1.2)
			burst(sky, {
				texture = TEXTURES.glow, count = 3, colour = sequence(colour, WHITE), size = curve(12, 2), transparency = curve(0.7, 0.2),
				lifetime = { 0.6, 0.6 }, speed = { 0.01, 0.01 }, spread = 0,
			})
		end
		after(0.65, function()
			if charge then fade(charge, 0.2, { Size = Vector3.one * 0.5, Transparency = 1 }) end
			column(centre, 70, 3.2, WHITE, 0.55)
			column(centre, 70, 7, colour, 0.7, Enum.Material.ForceField)
			flash(centre, 9, colour, 0.35)
			grade({ Brightness = 0.25, Contrast = 0.1, TintColor = colour:Lerp(WHITE, 0.7) }, 0.04, 0.05, 0.45)
			addShake(0.8)
			fireball(centre, 22, 2, colour)
			smokeColumn(centre, 10, 2.5, 3)
			embers(centre, 30, 1.1)
			shockwave(centre, 20, colour, 0.7)
			after(0.12, function() shockwave(centre, 13, WHITE, 0.55) end)
			chunks(centre, 8, 1.4)
			light(point(centre + Vector3.new(0, 3, 0), 1.2), colour, 26, 4, 1)
		end)
		-- The barrage: four more strikes walk round the crater.
		local turn = random:NextNumber(0, math.pi * 2)
		for i = 1, 4 do
			local angle = turn + i * math.pi / 2 + random:NextNumber(-0.3, 0.3)
			local spot = centre + Vector3.new(math.cos(angle), 0, math.sin(angle)) * random:NextNumber(6, 10)
			spot = surface(spot) or spot
			after(1.0 + i * 0.5, function()
				burst(spot + Vector3.new(0, 0.3, 0), {
					texture = TEXTURES.ring, count = 1, colour = sequence(colour), size = curve(7, 1.5), transparency = curve(0.6, 0.1),
					lifetime = { 0.3, 0.3 }, speed = { 0.01, 0.01 }, spread = 0, flat = true,
				})
			end)
			after(1.3 + i * 0.5, function()
				column(spot, 70, 1.8, WHITE, 0.4)
				column(spot, 70, 4, colour, 0.5, Enum.Material.ForceField)
				flash(spot, 5, colour, 0.3)
				fireball(spot, 10, 1.4, colour)
				sparks(spot, 16, colour, 1.1)
				shockwave(spot, 10, colour, 0.55)
				chunks(spot, 3, 1)
				addShake(0.5)
			end)
		end
		-- The last word: a wider beam and three rings.
		after(3.6, function()
			column(centre, 80, 5, WHITE, 0.7)
			column(centre, 80, 11, colour, 0.9, Enum.Material.ForceField)
			flash(centre, 14, colour, 0.45)
			grade({ Brightness = 0.32, Contrast = 0.12, TintColor = colour:Lerp(WHITE, 0.65) }, 0.04, 0.1, 0.6)
			addShake(1.1)
			fireball(centre, 26, 2.6, colour)
			smokeColumn(centre, 14, 3, 3.4)
			embers(centre, 40, 1.3)
			shockwave(centre, 26, colour, 0.8)
			after(0.12, function() shockwave(centre, 18, WHITE, 0.6) end)
			after(0.3, function() shockwave(centre, 34, Color3.fromRGB(255, 150, 70), 1) end)
			chunks(centre, 8, 1.6)
			light(point(centre + Vector3.new(0, 3, 0), 1.5), colour, 32, 4, 1.3)
		end)
	elseif tier == 5 then
		-- GALAXY COLLAPSE: a black hole opens over the rock with a spinning
		-- ring of stars, pulls in light from all round, then goes nova. The
		-- stars fling out in spiral arms, the hole flickers back for a second
		-- pulse, and a beam of starlight drives into the mountain.
		local core = centre + Vector3.new(0, 11, 0)
		local gather = 1.8
		noise("deepWhoosh", core)
		after(0.9, function() noise("deepWhoosh", core) end)
		local hole = part(Enum.PartType.Ball, Vector3.one * 0.2, CFrame.new(core), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
		local halo = part(Enum.PartType.Ball, Vector3.one * 0.3, CFrame.new(core), colour)
		if hole then animate(hole, 0.8, { Size = Vector3.one * 3.8 }, Enum.EasingStyle.Back) end
		if halo then
			halo.Transparency = 0.55
			animate(halo, 0.8, { Size = Vector3.one * 6 }, Enum.EasingStyle.Back)
			light(halo, colour, 26, 3, gather + 0.3)
		end
		grade({ Brightness = -0.08, Contrast = 0.15, Saturation = 0.15, TintColor = Color3.fromRGB(225, 210, 255) }, 0.5, gather - 0.5, 0.4)
		-- The accretion ring: stars with short trails orbiting on a tilted plane.
		local function star(size: number, at: CFrame, tint: Color3): Part?
			local ball = part(Enum.PartType.Ball, Vector3.one * size, at, tint)
			if ball == nil then return nil end
			local a = Instance.new("Attachment")
			a.Position = Vector3.new(0, 0.2, 0)
			a.Parent = ball
			local b = Instance.new("Attachment")
			b.Position = Vector3.new(0, -0.2, 0)
			b.Parent = ball
			local trail = Instance.new("Trail")
			trail.Attachment0 = a
			trail.Attachment1 = b
			trail.Color = sequence(WHITE, tint)
			trail.Lifetime = 0.3
			trail.LightEmission = 1
			trail.FaceCamera = true
			trail.WidthScale = curve(1, 0)
			trail.Transparency = curve(0.1, 1)
			trail.Parent = ball
			return ball
		end
		local function starColour(i: number): Color3
			return (if i % 3 == 0 then PINK elseif i % 3 == 1 then colour else Color3.fromRGB(120, 170, 255)):Lerp(WHITE, 0.3)
		end
		local stars: { Part } = {}
		local tilt = CFrame.new(core) * CFrame.Angles(math.rad(18), random:NextNumber(0, math.pi), math.rad(-10))
		for i = 1, 24 do
			local ball = star(random:NextNumber(0.3, 0.6), tilt, starColour(i))
			if ball == nil then break end
			table.insert(stars, ball)
		end
		local phases: { number } = {}
		local orbits: { number } = {}
		for i = 1, #stars do
			phases[i] = i / #stars * math.pi * 2
			orbits[i] = random:NextNumber(4.5, 9)
		end
		motion(gather, function(t)
			for i, ball in stars do
				local spin = phases[i] + t * (9 + 4 / orbits[i] * 9)
				local reach = orbits[i] * (1 - 0.5 * t * t)
				ball.CFrame = tilt * CFrame.new(math.cos(spin) * reach, math.sin(spin * 3 + i) * 0.25, math.sin(spin) * reach)
			end
		end)
		-- Light pulled in from a sphere round the hole.
		local well = part(Enum.PartType.Ball, Vector3.one * 30, CFrame.new(core), WHITE)
		if well then
			well.Transparency = 1
			local inward = emitter({
				texture = TEXTURES.spark, count = 0, colour = sequence(WHITE, colour, PINK), size = curve(0.2, 0.6, 0.1),
				transparency = curve(0.6, 0, 0.4), lifetime = { 0.45, 0.45 }, speed = { 30, 32 }, spread = 0, spin = 180,
			}, well)
			inward.Shape = Enum.ParticleEmitterShape.Sphere
			inward.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
			inward.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			inward.Rate = 120
			inward.Enabled = true
			after(gather - 0.1, function() inward.Enabled = false end)
		end
		for i = 1, 3 do
			after(i * 0.45, function() addShake(0.25 + i * 0.1) end)
		end
		-- Collapse, then nova.
		after(gather, function()
			if hole then fade(hole, 0.12, { Size = Vector3.one * 0.1 }) end
			if halo then fade(halo, 0.12, { Size = Vector3.one * 0.1, Transparency = 1 }) end
			for _, ball in stars do fade(ball, 0.12, { Size = Vector3.one * 0.05 }) end
		end)
		after(gather + 0.13, function()
			flash(core, 18, colour, 0.5)
			grade({ Brightness = 0.32, Contrast = 0.15, Saturation = 0.2, TintColor = colour:Lerp(WHITE, 0.6) }, 0.05, 0.1, 0.6)
			addShake(1)
			shockwave(core, 26, colour, 0.8)
			after(0.1, function() shockwave(core, 18, PINK, 0.7) end)
			burst(core, {
				texture = TEXTURES.spark, count = 70, colour = sequence(WHITE, colour, PINK), size = curve(0.7, 0.45, 0),
				lifetime = { 0.7, 1.4 }, speed = { 14, 30 }, drag = 3, spin = 200,
			})
			column(centre, 11, 2.6, colour, 0.45)
			shockwave(centre, 22, colour, 0.7)
			dust(centre, 14, 2)
			fireball(centre, 14, 1.6, colour)
			chunks(centre, 8, 1.4)
			light(point(core, 1.6), colour, 30, 4, 1.4)
			-- Spiral arms: new stars fling out from the core and fade.
			for i = 1, 18 do
				local arm = (i % 2) * math.pi
				local ball = star(random:NextNumber(0.35, 0.7), CFrame.new(core), starColour(i))
				if ball == nil then break end
				local reachOut = 8 + (i // 2) * 2.2
				local twist = random:NextNumber(2.2, 3)
				motion(1.6, function(t)
					local ease = 1 - (1 - t) ^ 3
					local angle = arm + ease * twist + (i // 2) * 0.12
					ball.CFrame = tilt * CFrame.new(math.cos(angle) * reachOut * ease, math.sin(i + t * 4) * 0.6, math.sin(angle) * reachOut * ease)
					ball.Transparency = math.clamp((t - 0.6) / 0.4, 0, 1)
				end, function() ball:Destroy() end)
			end
		end)
		-- The second pulse: the hole flickers back, then starlight pours down.
		local pulseAt = gather + 1.6
		after(pulseAt, function()
			flash(core, 9, PINK, 0.4)
			shockwave(core, 20, PINK, 0.7)
			after(0.1, function() shockwave(core, 14, colour, 0.6) end)
			addShake(0.6)
		end)
		after(pulseAt + 0.4, function()
			column(centre, 60, 3.4, WHITE, 0.6)
			column(centre, 60, 7.5, colour, 0.8, Enum.Material.ForceField)
			burst(core + Vector3.new(0, 6, 0), {
				texture = TEXTURES.spark, count = 60, colour = sequence(WHITE, PINK, colour), size = curve(0.6, 0.4, 0),
				lifetime = { 1, 1.8 }, speed = { 4, 12 }, spread = 70, drag = 1, acceleration = Vector3.new(0, -18, 0), spin = 160,
			})
			flash(centre, 14, colour, 0.45)
			grade({ Brightness = 0.28, Contrast = 0.12, Saturation = 0.2, TintColor = colour:Lerp(WHITE, 0.6) }, 0.04, 0.1, 0.7)
			addShake(1.1)
			shockwave(centre, 30, colour, 0.9)
			after(0.12, function() shockwave(centre, 20, WHITE, 0.7) end)
			after(0.3, function() shockwave(centre, 38, PINK, 1.1) end)
			fireball(centre, 20, 2, colour)
			dust(centre, 18, 2.4)
			chunks(centre, 8, 1.6)
			light(point(centre + Vector3.new(0, 4, 0), 1.6), colour, 34, 4, 1.4)
		end)
	else
		-- COSMIC BURST: the sky darkens, a meteor storm rains down round the
		-- target, a blazing comet strikes with a mushroom of fire and smoke,
		-- fire geysers erupt in a ring, more meteors fall, and a final cosmic
		-- shock rolls out across the whole valley.
		grade({ Brightness = -0.15, Contrast = 0.22, Saturation = 0.1, TintColor = Color3.fromRGB(255, 205, 190) }, 0.5, 5.6, 1.5)
		noise("rumble", centre)
		local function meteor(delay: number, spread: number, size: number)
			after(delay, function()
				local target = centre + Vector3.new(random:NextNumber(-spread, spread), 0, random:NextNumber(-spread, spread))
				target = surface(target) or target
				streak(skyPoint(target, 60, 30), target, size, 0.6, colour, false, function()
					flash(target, 3.5 * size, colour, 0.3)
					shockwave(target, 6 * size, colour, 0.5)
					sparks(target, 12, colour, 1)
					chunks(target, 1, 0.9)
					addShake(0.3)
				end)
			end)
		end
		for i = 1, 12 do
			meteor(0.15 + (i - 1) * 0.2, 16, random:NextNumber(0.9, 1.4))
		end
		local impact = 2.9
		after(impact - 0.75, function()
			streak(skyPoint(centre, 100, 60), centre, 5, 0.75, colour, true, function()
				grade({ Brightness = 0.5, Contrast = 0.1, TintColor = Color3.fromRGB(255, 244, 220) }, 0.04, 0.1, 0.7)
				addShake(1.5)
				flash(centre, 30, colour, 0.55)
				shockwave(centre, 36, colour, 0.9)
				after(0.12, function() shockwave(centre, 26, WHITE, 0.7) end)
				after(0.3, function() shockwave(centre, 46, Color3.fromRGB(255, 150, 70), 1.1) end)
				fireball(centre, 36, 3.8, colour)
				smokeColumn(centre, 22, 4.8, 4.5)
				embers(centre, 60, 1.5)
				burst(centre + Vector3.new(0, 3, 0), {
					texture = TEXTURES.spark, count = 45, colour = sequence(WHITE, colour), size = curve(0.8, 0.5, 0),
					lifetime = { 0.8, 1.6 }, speed = { 16, 34 }, drag = 2.5, spin = 200,
				})
				column(centre, 110, 7, colour, 1.6)
				chunks(centre, 12, 1.8)
				light(point(centre + Vector3.new(0, 4, 0), 2), colour, 42, 5, 1.8)
			end)
		end)
		-- Fire geysers burst up in a ring, one after another, while the ground rumbles.
		local turn = random:NextNumber(0, math.pi * 2)
		for i = 1, 6 do
			after(impact + 0.6 + i * 0.22, function()
				local angle = turn + i * math.pi / 3
				local flat = centre + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 13
				local foot = surface(flat) or flat
				column(foot, 26, 2.4, Color3.fromRGB(255, 150, 70), 0.8)
				fireball(foot, 9, 1.8, colour)
				smokeColumn(foot, 4, 2, 2.4)
				shockwave(foot, 7, colour, 0.5)
				addShake(0.45)
			end)
		end
		-- A second, smaller wave of meteors.
		for i = 1, 6 do
			meteor(impact + 1.7 + i * 0.18, 20, random:NextNumber(0.8, 1.2))
		end
		-- The cosmic shock: the sky flashes white and rings roll out across the valley.
		after(impact + 3.6, function()
			grade({ Brightness = 0.4, Contrast = 0.12, Saturation = 0.15, TintColor = Color3.fromRGB(255, 236, 225) }, 0.05, 0.12, 0.8)
			addShake(1.2)
			flash(centre + Vector3.new(0, 4, 0), 22, WHITE, 0.5)
			shockwave(centre, 50, colour, 1.2)
			after(0.15, function() shockwave(centre, 38, WHITE, 1) end)
			after(0.35, function() shockwave(centre, 62, Color3.fromRGB(255, 150, 70), 1.4) end)
			embers(centre, 40, 1.6)
			burst(centre + Vector3.new(0, 6, 0), {
				texture = TEXTURES.spark, count = 50, colour = sequence(WHITE, colour, PINK), size = curve(0.8, 0.5, 0),
				lifetime = { 1, 1.8 }, speed = { 18, 36 }, drag = 2.5, spin = 200,
			})
			light(point(centre + Vector3.new(0, 6, 0), 1.6), colour, 40, 4, 1.4)
		end)
	end

	local text = label
	if text and tier >= bannerTier then
		bannerTier = tier
		bannerSerial += 1
		local serial = bannerSerial
		local title = if data.adding then (if data.blocks == 0 then "MOUNTAIN FULL" elseif data.blocks == nil then "REBUILDING" else GiftEffects.ADD_TITLES[tier]) else GiftEffects.TITLES[tier]
		text.Text = title .. "  ·  " .. Format.commas(data.coins) .. " COINS\n" .. tostring(data.name or "Someone") .. " sent " .. tostring(data.gift or "a gift")
		text.TextColor3 = colour
		if bannerTween then bannerTween:Cancel() end
		text.TextTransparency = 0
		text.TextStrokeTransparency = 0.35
		text.Position = UDim2.fromScale(0.5, 0.33)
		local grow = text:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		grow.Scale = 0.8
		grow.Parent = text
		TweenService:Create(text, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Position = UDim2.fromScale(0.5, 0.30) }):Play()
		TweenService:Create(grow, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		task.delay(BANNER_SECONDS[tier], function()
			if serial ~= bannerSerial then return end
			bannerTween = TweenService:Create(text, TweenInfo.new(0.45), { TextTransparency = 1, TextStrokeTransparency = 1 })
			bannerTween:Play()
			bannerTier = 0
		end)
	end
end

return GiftEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">GiftMenu</string>
            <string name="Source"><![CDATA[--!strict
-- The full-screen gift settings (streamer only): every TikTok gift with a
-- search bar; pick one to set what it does in each game and the key that
-- sends it. TikFinity can press that key whenever the gift arrives on the
-- LIVE, so the game reacts to real gifts.
-- GiftMenu.start(send, state, notice) builds it; open it with GiftMenu.setOpen.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local GiftCatalogue = require(Shared:WaitForChild("GiftCatalogue"))
local Keybinds = require(Shared:WaitForChild("Keybinds"))

local GiftMenu = {}

type Gift = { name: string, coins: number, icon: string? }

local WHITE = Color3.fromRGB(255, 255, 255)
local GOLD = Color3.fromRGB(246, 200, 92)
local MUTED = Color3.fromRGB(168, 174, 190)
local BACK = Color3.fromRGB(12, 14, 20)
local CARD = Color3.fromRGB(24, 27, 38)
local ROW = Color3.fromRGB(32, 36, 50)
local BUTTON = Color3.fromRGB(46, 50, 68)
local SELECTED = Color3.fromRGB(64, 128, 236)
local DANGER = Color3.fromRGB(176, 64, 72)
local FONT = Enum.Font.GothamBold
local FONT_MEDIUM = Enum.Font.GothamMedium
local FONT_HEAVY = Enum.Font.GothamBlack

-- Each show (1 smallest to 6 biggest) by name in each game: breaking or
-- adding stone, climbing up or down, counting up or down. The same lists as
-- GiftEffects, ClimbPath and ChalkEffects (the tests check they match).
GiftMenu.ANIMATIONS = {
	{ rough = "SPARK BURST", add = "PEBBLE DROP", up = "BOUNCE PAD", down = "BANANA SLIP", chalkUp = "CHALK STAR", chalkDown = "SPITBALL" },
	{ rough = "SHOCKWAVE", add = "ROCKSLIDE", up = "SPRING LAUNCH", down = "SPIKE BOUNCE", chalkUp = "GOLD STARS", chalkDown = "ERASER TOSS" },
	{ rough = "DIAMOND FRACTURE", add = "STONE SURGE", up = "ROCKET BOOST", down = "ANVIL SMASH", chalkUp = "PAPER PLANES", chalkDown = "SPONGE SPLASH" },
	{ rough = "ORBITAL STRIKE", add = "BOULDER BARRAGE", up = "DIAMOND CANNON", down = "METEOR STRIKE", chalkUp = "CHALK STORM", chalkDown = "BOARD QUAKE" },
	{ rough = "GALAXY COLLAPSE", add = "STONE CYCLONE", up = "STARLIGHT ASCENT", down = "THUNDER HAMMER", chalkUp = "FIREWORKS", chalkDown = "DUSTER TORNADO" },
	{ rough = "COSMIC BURST", add = "MOUNTAIN RISING", up = "GALACTIC ASCENSION", down = "BLACK HOLE PLUNGE", chalkUp = "SUPERNOVA", chalkDown = "BLACK HOLE" },
}

-- What the animation button and its line under it say for a choice (nil: auto).
function GiftMenu.animationText(tier: number?): (string, string)
	if tier == nil then
		return "Animation: Auto (picked by the coins)", "Bigger gifts play bigger shows. Press to choose one."
	end
	local a = GiftMenu.ANIMATIONS[tier]
	return string.format("Animation: %d of 6", tier),
		string.format("Rough: %s / %s · Climb: %s / %s · Chalk: %s / %s", a.rough, a.add, a.up, a.down, a.chalkUp, a.chalkDown)
end

local open = false
local onOpenChanged: { (boolean) -> () } = {}

function GiftMenu.isOpen(): boolean
	return open
end

-- What a rule shows in the list: "+5", "-20", or "auto" (from the coins).
function GiftMenu.ruleText(value: number?): string
	if value == nil then return "auto" end
	return if value > 0 then "+" .. tostring(value) else tostring(value)
end

-- A typed amount: a whole number (negative allowed), or nil for "auto".
function GiftMenu.parseAmount(text: string): number?
	local clean = string.gsub(text, "[%s,]", "")
	if clean == "" then return nil end
	local number = tonumber(clean)
	if number == nil or number ~= number then return nil end
	return math.floor(number)
end

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent then instance.Parent = parent end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function label(parent: Instance, text: string, size: number, colour: Color3, font: Enum.Font?, height: number?): TextLabel
	return make("TextLabel", {
		Size = UDim2.new(1, 0, 0, height or size + 6),
		BackgroundTransparency = 1,
		Font = font or FONT_MEDIUM,
		TextSize = size,
		TextColor3 = colour,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = text,
	}, parent)
end

local function box(parent: Instance, placeholder: string): TextBox
	local input = make("TextBox", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = ROW,
		Font = FONT_MEDIUM,
		TextSize = 17,
		TextColor3 = WHITE,
		PlaceholderColor3 = Color3.fromRGB(120, 126, 142),
		PlaceholderText = placeholder,
		ClearTextOnFocus = false,
		Text = "",
	}, parent)
	rounded(input, 8)
	make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, input)
	return input
end

local function button(parent: Instance, text: string, colour: Color3?): TextButton
	local b = make("TextButton", {
		Size = UDim2.new(0, 150, 0, 38),
		BackgroundColor3 = colour or BUTTON,
		Font = FONT,
		TextSize = 15,
		TextColor3 = WHITE,
		Text = text,
		AutoButtonColor = true,
	}, parent)
	rounded(b, 8)
	return b
end

function GiftMenu.setOpen(value: boolean)
	if value == open then return end
	open = value
	for _, listener in onOpenChanged do task.spawn(listener, value) end
end

-- `send(action, value)` asks the server; `state` holds the published settings.
function GiftMenu.start(send: (string, any) -> (), state: Instance)
	local player = Players.LocalPlayer
	local function decode(name: string): { [string]: any }
		local ok, data = pcall(HttpService.JSONDecode, HttpService, (state:GetAttribute(name) :: any) or "{}")
		return if ok and type(data) == "table" then data else {}
	end

	local gui = make("ScreenGui", {
		Name = "GiftSettings",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40, -- above every other card and menu
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
	}, player:WaitForChild("PlayerGui"))
	-- A full-screen button underneath, so clicks never fall through to the game.
	local screen = make("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = BACK,
		BackgroundTransparency = 0.04,
		AutoButtonColor = false,
		Text = "",
		Modal = true,
	}, gui)
	local page = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -48, 1, -48),
		BackgroundTransparency = 1,
	}, screen)
	make("UISizeConstraint", { MaxSize = Vector2.new(1400, 900) }, page)

	-- Header: title, how to use it with TikFinity, close.
	local header = make("Frame", { Size = UDim2.new(1, 0, 0, 86), BackgroundTransparency = 1 }, page)
	local title = label(header, "GIFT SETTINGS", 30, GOLD, FONT_HEAVY, 36)
	title.Size = UDim2.new(1, -170, 0, 36)
	local help = label(header, "Pick a gift to set what it does in each game. Give it a key, and in TikFinity add an action that presses that key when the gift arrives: keep the Roblox window focused while you stream.", 14, MUTED, FONT_MEDIUM, 44)
	help.Position = UDim2.fromOffset(0, 40)
	help.Size = UDim2.new(1, -170, 0, 44)
	local close = button(header, "Close", DANGER)
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, 0, 0, 0)
	close.Activated:Connect(function() GiftMenu.setOpen(false) end)

	-- Left: search and the gift list.
	local left = make("Frame", {
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(0.56, -10, 1, -96),
		BackgroundColor3 = CARD,
	}, page)
	rounded(left, 12)
	make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }, left)
	local search = box(left, "Search gifts, e.g. Rose, Galaxy, Lion…")
	search.Size = UDim2.new(1, 0, 0, 44)
	search.TextSize = 18
	local count = label(left, "", 13, MUTED, FONT_MEDIUM, 18)
	count.Position = UDim2.fromOffset(2, 50)
	local list = make("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -72),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = MUTED,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
	}, left)
	local listLayout = make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, list)
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		list.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 6)
	end)

	-- Right: the chosen gift's settings.
	local right = make("ScrollingFrame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 96),
		Size = UDim2.new(0.44, -10, 1, -96),
		BackgroundColor3 = CARD,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = MUTED,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
	}, page)
	rounded(right, 12)
	make("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16) }, right)
	local rightLayout = make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, right)
	rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		right.CanvasSize = UDim2.fromOffset(0, rightLayout.AbsoluteContentSize.Y + 30)
	end)
	local order = 0
	local function add<T>(instance: T): T
		order += 1;
		(instance :: any).LayoutOrder = order
		return instance
	end
	local giftName = add(label(right, "Pick a gift", 26, WHITE, FONT_HEAVY, 32))
	local giftCoins = add(label(right, "", 15, MUTED, FONT_MEDIUM, 20))
	add(label(right, "COINS PER GIFT (change it if TikTok's price is different where you are)", 13, MUTED, FONT, 18))
	local coinsBox = add(box(right, "Coins per gift"))
	local function section(heading: string, hint: string, placeholder: string): TextBox
		add(label(right, heading, 15, GOLD, FONT, 20))
		add(label(right, hint, 13, MUTED, FONT_MEDIUM, 34))
		return add(box(right, placeholder))
	end
	local roughBox = section("DIAMOND IN THE ROUGH: rocks per gift", "Positive breaks that many rocks off the mountain; negative adds stone. Empty: worked out from the coins.", "auto (from the coins)")
	local climbBox = section("DIAMOND CLIMB: platforms per gift", "Positive sends the climber up; negative sends them down. Empty: worked out from the coins.", "auto (from the coins)")
	local chalkBox = section("CHALKBOARD COUNT: numbers per gift", "Positive counts up; negative counts down. Empty: worked out from the coins.", "auto (from the coins)")
	-- Chalkboard Count's own reset gift (Y panel) starts its countdown instead.
	local chalkNote = add(label(right, "", 13, GOLD, FONT_MEDIUM, 34))
	chalkNote.Visible = false
	local winsBox = section("WINS per gift", "Adds wins (e.g. 1) or takes them away (e.g. -1) on the win counter of whichever game you're playing. Empty: no change.", "no change")
	add(label(right, "ANIMATION", 15, GOLD, FONT, 20))
	local animButton = add(button(right, "Animation: Auto"))
	animButton.Size = UDim2.new(1, 0, 0, 38)
	local animNames = add(label(right, "", 13, MUTED, FONT_MEDIUM, 34))
	add(label(right, "RESET", 15, GOLD, FONT, 20))
	add(label(right, "On: this gift sends the game you're playing back to the start (a full mountain, platform 0, or a count of 0), and does nothing else.", 13, MUTED, FONT_MEDIUM, 34))
	local resetToggle = add(button(right, "Reset: off"))
	resetToggle.Size = UDim2.new(1, 0, 0, 38)
	add(label(right, "KEYBIND (for TikFinity)", 15, GOLD, FONT, 20))
	add(label(right, "Press the button, then the key. Shift or Ctrl with a key works too. Pressing it in the game sends this gift.", 13, MUTED, FONT_MEDIUM, 34))
	local keyRow = add(make("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, right))
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, keyRow)
	local keyButton = button(keyRow, "Set key")
	keyButton.Size = UDim2.new(0.6, -4, 1, 0)
	local clearKey = button(keyRow, "No key")
	clearKey.Size = UDim2.new(0.4, -4, 1, 0)
	local actions = add(make("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, right))
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, actions)
	local save = button(actions, "Save", SELECTED)
	save.Size = UDim2.new(0.4, -6, 1, 0)
	save.TextSize = 17
	local test = button(actions, "Test gift")
	test.Size = UDim2.new(0.3, -6, 1, 0)
	local reset = button(actions, "Reset")
	reset.Size = UDim2.new(0.3, -6, 1, 0)
	local removeCustom = add(button(right, "Remove this gift", DANGER))
	removeCustom.Size = UDim2.new(1, 0, 0, 34)
	local status = add(label(right, "", 14, GOLD, FONT_MEDIUM, 22))

	-- The chosen gift and its key (while editing).
	local chosen: Gift? = nil
	local chosenKey = ""
	local chosenReset = false
	local chosenAnim: number? = nil
	local function showAnim()
		local text, names = GiftMenu.animationText(chosenAnim)
		animButton.Text = text
		animButton.BackgroundColor3 = if chosenAnim then SELECTED else BUTTON
		animNames.Text = names
	end
	local function showReset()
		resetToggle.Text = if chosenReset then "Reset: ON (back to the start)" else "Reset: off"
		resetToggle.BackgroundColor3 = if chosenReset then DANGER else BUTTON
	end
	local capturing = false

	local function rules()
		return decode("GiftRules"), decode("ClimbRules"), decode("ChalkRules"), decode("GiftBindings"), decode("CustomGifts"), decode("WinRules"), decode("ResetGifts"), decode("AnimRules")
	end
	local function keyFor(bindings: { [string]: any }, name: string): string
		local lower = string.lower(name)
		for key, binding in bindings do
			if type(binding) == "table" and type(binding.gift) == "string" and string.lower(binding.gift) == lower then return key end
		end
		return ""
	end
	local function showKey()
		keyButton.Text = if capturing then "Press a key…" elseif chosenKey ~= "" then "Key: " .. Keybinds.label(chosenKey) else "Set key"
		keyButton.BackgroundColor3 = if capturing then SELECTED else BUTTON
	end

	local function choose(gift: Gift?, custom: boolean)
		chosen = gift
		capturing = false
		status.Text = ""
		local rough, climb, chalk, bindings, _, wins, resets, anims = rules()
		if gift == nil then
			chosenReset = false
			showReset()
			chosenAnim = nil
			showAnim()
			giftName.Text = "Pick a gift"
			giftCoins.Text = "Choose one from the list, or search for a gift that's missing to add it."
			coinsBox.Visible = false
			removeCustom.Visible = false
			chalkNote.Visible = false
			for _, input in { roughBox, climbBox, chalkBox, winsBox } do input.Text = "" end
			chosenKey = ""
			showKey()
			return
		end
		local lower = string.lower(gift.name)
		giftName.Text = (gift.icon or GiftCatalogue.ICON) .. "  " .. gift.name
		giftCoins.Text = string.format("%s coin%s", tostring(gift.coins), if gift.coins == 1 then "" else "s")
		coinsBox.Visible = true
		coinsBox.Text = tostring(gift.coins)
		removeCustom.Visible = custom and GiftCatalogue.find(gift.name) == nil
		roughBox.Text = if type(rough[lower]) == "number" then tostring(rough[lower]) else ""
		climbBox.Text = if type(climb[lower]) == "number" then tostring(climb[lower]) else ""
		chalkBox.Text = if type(chalk[lower]) == "number" then tostring(chalk[lower]) else ""
		winsBox.Text = if type(wins[lower]) == "number" then tostring(wins[lower]) else ""
		chosenReset = resets[lower] == true
		showReset()
		chosenAnim = if type(anims[lower]) == "number" then anims[lower] else nil
		showAnim()
		chosenKey = keyFor(bindings, gift.name)
		showKey()
		local countdownGift = state:GetAttribute("ChalkResetGift")
		chalkNote.Visible = type(countdownGift) == "string" and string.lower(countdownGift) == lower
		chalkNote.Text = "In Chalkboard Count this is the countdown reset gift (set in the Y panel), so there it starts the countdown and the number above isn't used."
	end

	-- The list, drawn again whenever the search or the settings change.
	local function draw()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then child:Destroy() end
		end
		local rough, climb, chalk, bindings, custom, wins, resets, anims = rules()
		local all = GiftCatalogue.all(custom :: any)
		local shown = GiftCatalogue.search(all, search.Text)
		local query = (string.gsub(search.Text, "^%s*(.-)%s*$", "%1"))
		local exact = false
		for _, gift in shown do
			if string.lower(gift.name) == string.lower(query) then exact = true end
		end
		local rowOrder = 0
		if query ~= "" and not exact then
			-- A gift that isn't in the list yet: add it.
			rowOrder += 1
			local addRow = make("TextButton", {
				LayoutOrder = rowOrder,
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundColor3 = SELECTED,
				Font = FONT,
				TextSize = 16,
				TextColor3 = WHITE,
				Text = string.format("+  Add \"%s\" as a gift", string.sub(query, 1, 40)),
			}, list)
			rounded(addRow, 8)
			addRow.Activated:Connect(function()
				choose({ name = string.sub(query, 1, 40), coins = 1 }, true)
				status.Text = "Type its coins, set what it does, then Save."
			end)
		end
		count.Text = string.format("%d gift%s", #shown, if #shown == 1 then "" else "s")
		for _, gift in shown do
			rowOrder += 1
			local lower = string.lower(gift.name)
			local key = keyFor(bindings, gift.name)
			local isChosen = chosen ~= nil and string.lower((chosen :: Gift).name) == lower
			local row = make("TextButton", {
				LayoutOrder = rowOrder,
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundColor3 = if isChosen then SELECTED else ROW,
				AutoButtonColor = true,
				Text = "",
			}, list)
			rounded(row, 8)
			make("TextLabel", {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(0, 34, 1, 0),
				BackgroundTransparency = 1,
				Font = FONT,
				TextSize = 24,
				TextColor3 = WHITE,
				Text = gift.icon or GiftCatalogue.ICON,
			}, row)
			make("TextLabel", {
				Position = UDim2.fromOffset(48, 0),
				Size = UDim2.new(0.42, -48, 1, 0),
				BackgroundTransparency = 1,
				Font = FONT,
				TextSize = 16,
				TextColor3 = WHITE,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = gift.name,
			}, row)
			make("TextLabel", {
				Position = UDim2.new(0.42, 0, 0, 0),
				Size = UDim2.new(0.14, 0, 1, 0),
				BackgroundTransparency = 1,
				Font = FONT_MEDIUM,
				TextSize = 14,
				TextColor3 = GOLD,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = tostring(gift.coins) .. " c",
			}, row)
			make("TextLabel", {
				Position = UDim2.new(0.56, 0, 0, 0),
				Size = UDim2.new(0.44, -12, 1, 0),
				BackgroundTransparency = 1,
				Font = FONT_MEDIUM,
				TextSize = 13,
				TextColor3 = MUTED,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = string.format("Rough %s · Climb %s · Chalk %s%s%s",
					GiftMenu.ruleText(rough[lower]), GiftMenu.ruleText(climb[lower]), GiftMenu.ruleText(chalk[lower]),
					(if type(wins[lower]) == "number" and wins[lower] ~= 0 then " · Wins " .. GiftMenu.ruleText(wins[lower]) else "")
						.. (if resets[lower] == true then " · RESET" else "")
						.. (if type(anims[lower]) == "number" then " · Anim " .. tostring(anims[lower]) else ""),
					if key ~= "" then " · [" .. Keybinds.label(key) .. "]" else ""),
			}, row)
			row.Activated:Connect(function()
				choose(gift, (custom :: any)[gift.name] ~= nil)
				draw()
			end)
		end
	end

	search:GetPropertyChangedSignal("Text"):Connect(draw)
	for _, name in { "GiftRules", "ClimbRules", "ChalkRules", "GiftBindings", "CustomGifts", "WinRules", "ResetGifts", "AnimRules" } do
		state:GetAttributeChangedSignal(name):Connect(function()
			if open then draw() end
		end)
	end

	keyButton.Activated:Connect(function()
		if chosen == nil then return end
		capturing = true
		showKey()
	end)
	animButton.Activated:Connect(function()
		if chosen == nil then return end
		-- Auto, then 1 to 6, then auto again.
		chosenAnim = if chosenAnim == nil then 1 elseif chosenAnim >= 6 then nil else chosenAnim + 1
		showAnim()
	end)
	resetToggle.Activated:Connect(function()
		if chosen == nil then return end
		chosenReset = not chosenReset
		showReset()
	end)
	clearKey.Activated:Connect(function()
		capturing = false
		chosenKey = ""
		showKey()
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject)
		if not open or not capturing or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local key = input.KeyCode.Name
		-- Wait for the real key while Shift or Ctrl is being held down.
		if string.find(key, "Shift", 1, true) or string.find(key, "Control", 1, true) then return end
		capturing = false
		local combo = Keybinds.combo(key,
			UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
			UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
		if Keybinds.allowed(combo) then
			chosenKey = combo
			status.Text = ""
		else
			status.Text = Keybinds.label(combo) .. " is used by the game or Roblox. Try a letter like K, a number, F1–F8 on their own or the number pad."
		end
		showKey()
	end)

	local function current(): { [string]: any }?
		local gift = chosen
		if gift == nil then return nil end
		local coins = tonumber((string.gsub(coinsBox.Text, "[^%d]", ""))) or 0
		if coins < 1 then
			status.Text = "Type how many coins the gift costs."
			return nil
		end
		return {
			gift = gift.name,
			coins = coins,
			rough = GiftMenu.parseAmount(roughBox.Text),
			climb = GiftMenu.parseAmount(climbBox.Text),
			chalk = GiftMenu.parseAmount(chalkBox.Text),
			wins = GiftMenu.parseAmount(winsBox.Text),
			reset = chosenReset,
			anim = chosenAnim,
			key = chosenKey,
		}
	end
	save.Activated:Connect(function()
		local value = current()
		if value == nil then return end
		send("setGiftSettings", value)
		status.Text = "Saved."
		if chosen then (chosen :: Gift).coins = value.coins end
	end)
	test.Activated:Connect(function()
		local value = current()
		if value == nil then return end
		-- Saved first, so the test plays what the boxes say now (the server
		-- handles the two in order).
		send("setGiftSettings", value)
		if chosen then (chosen :: Gift).coins = value.coins end
		send("testGift", { coins = value.coins, count = 1, name = value.gift })
		status.Text = "Saved, and sent a test " .. value.gift .. " (test gifts never count on the leaderboards)."
	end)
	reset.Activated:Connect(function()
		if chosen == nil then return end
		roughBox.Text, climbBox.Text, chalkBox.Text, winsBox.Text = "", "", "", ""
		chosenReset = false
		showReset()
		chosenAnim = nil
		showAnim()
		chosenKey = ""
		capturing = false
		showKey()
		status.Text = "Back to auto with no key: press Save to keep it."
	end)
	removeCustom.Activated:Connect(function()
		local gift = chosen
		if gift == nil then return end
		send("removeCustomGift", gift.name)
		choose(nil, false)
	end)

	table.insert(onOpenChanged, function(value: boolean)
		gui.Enabled = value
		capturing = false
		if value then
			draw()
			if chosen == nil then choose(nil, false) end
		end
	end)
	choose(nil, false)
end

return GiftMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">HoldCountdown</string>
            <string name="Source"><![CDATA[--!strict
-- The hold countdown for Diamond Climb (standing at the top) and Chalkboard
-- Count (the count at the goal): like the diamond's, the hold lasts
-- Config.HoldSeconds of real time (15) but the screen counts down from
-- Config.HoldCountFrom (10), quickly at first and slower near the end. Each
-- new number pops in with a tick. A gift that sends the player down ends it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Config = require(Shared:WaitForChild("Config"))
local HoldTimer = require(Shared:WaitForChild("HoldTimer"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local HoldCountdown = {}

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(246, 200, 92)

-- The number on screen `elapsed` real seconds into the hold.
function HoldCountdown.shown(elapsed: number): number
	return HoldTimer.display(elapsed, Config.HoldSeconds, Config.HoldCountFrom, Config.HoldSlowdown)
end

export type Countdown = { update: (holdStart: number, now: number) -> (), frame: Frame }

-- A countdown under the top of `parent`, `y` pixels down, with `title`
-- (such as "HOLD THE TOP") over the number.
function HoldCountdown.new(parent: Instance, y: number, title: string): Countdown
	local frame = Instance.new("Frame")
	frame.Name = "HoldCountdown"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.new(0.5, 0, 0, y)
	frame.Size = UDim2.fromOffset(320, 140)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 30)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 20
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0.35
	label.Text = title
	label.Parent = frame
	local number = Instance.new("TextLabel")
	number.Position = UDim2.fromOffset(0, 30)
	number.Size = UDim2.new(1, 0, 0, 100)
	number.BackgroundTransparency = 1
	number.Font = Enum.Font.GothamBlack
	number.TextSize = 88
	number.TextColor3 = WHITE
	number.TextStrokeTransparency = 0.2
	number.Text = tostring(Config.HoldCountFrom)
	number.Parent = frame
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = number

	local last = -1
	local function update(holdStart: number, now: number)
		if holdStart <= 0 then
			frame.Visible = false
			last = -1
			return
		end
		frame.Visible = true
		local shown = HoldCountdown.shown(now - holdStart)
		if shown ~= last then
			last = shown
			number.Text = tostring(shown)
			number.TextColor3 = WHITE:Lerp(GOLD, 1 - shown / Config.HoldCountFrom)
			scale.Scale = 1.35
			TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			Sounds.play("tick")
		end
	end
	return { update = update, frame = frame }
end

return HoldCountdown
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">HowToPlay</string>
            <string name="Source"><![CDATA[--!strict
-- The How to Play guide: a card in the lobby's white and gold with six
-- pages (connecting TikTok, testing without TikTok, the controls, how to
-- win, Diamond Climb and Chalkboard Count). It opens from the board beside the lobby spawn, the games menu's
-- How to play button, or H anywhere, and frees the mouse while it is open.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local HowToPlay = {}

local IVORY = Color3.fromRGB(250, 248, 243)
local GOLD = Color3.fromRGB(224, 178, 72)
local ROYAL = Color3.fromRGB(34, 52, 140)
local INK = Color3.fromRGB(46, 44, 56)
local MUTED = Color3.fromRGB(140, 132, 118)
local TITLE_FONT = Enum.Font.Merriweather
HowToPlay.KEY = Enum.KeyCode.H
-- The lobby board's prompt and click detector carry this name.
HowToPlay.BOARD = "HowToPlay"

-- Each page: its tab name and its text (Roblox rich text, so no < > or &).
HowToPlay.PAGES = {
	{
		title = "Connect TikTok",
		text = table.concat({
			"Gifts on your TikTok LIVE reach the game through <b>TikFinity</b>: it presses a key when a gift arrives, and the game plays that gift.",
			"",
			"<b>1.</b>  Here, press <b>Y</b>, then <b>Open gift settings</b>. Pick a gift, choose what it does, press <b>Set key</b> and press a key (like <b>K</b>, or <b>Shift+K</b>). Press <b>Save</b>.",
			"<b>2.</b>  In TikFinity, add an action that presses that same key, and an event that runs it when that gift is received. Do the same for each gift you want.",
			"<b>3.</b>  Go LIVE, and keep the Roblox window clicked on (focused) while you stream: the keys only reach the window in front.",
			"",
			"Likes, follows and shares can do something too: have TikFinity press a gift's key for them.",
			"Gifts sent by a key show as <b>A viewer sent</b> in the feed, and don't count on the leaderboards (the key doesn't say who sent them).",
			"To try a gift without going LIVE, press its key yourself, or use <b>Test gift</b>: see <b>Testing</b>.",
		}, "\n"),
	},
	{
		title = "Testing",
		text = table.concat({
			"<b>Y</b> opens the streamer panel in the game and frees the mouse. Press Y again to close it.",
			"",
			"<b>TEST GIFTS</b> send pretend gifts with no TikTok needed, from Rose (1 coin) up to Universe. Bigger gifts make bigger blasts.",
			"<b>REBUILD TEST GIFTS</b> add stone back, from +100 up to Grow to limit.",
			"<b>Send a diamond bird now</b> calls the diamond bird straight away.",
			"",
			"<b>Open gift settings</b> (at the top of the panel): search any TikTok gift, choose what it does in each game, its wins, its animation and whether it resets the game, and press <b>Set key</b> to give it a key. Pressing that key in the game sends that gift; TikFinity presses it for you. <b>Test gift</b> tries it out.",
		}, "\n"),
	},
	{
		title = "Controls",
		text = table.concat({
			"<b>W A S D</b> to walk, <b>Space</b> to jump, move the mouse to look.",
			"Hold <b>Shift</b> to sprint (1.5 times as fast). On a phone, hold the <b>Run</b> button.",
			"<b>Hold left mouse</b> on the mountain to dig. Stand close to the rock you aim at.",
			"<b>Click</b> the diamond to pick it up, and the diamond bird to catch it.",
			"",
			"<b>G</b>  games menu: join, or go back to the lobby",
			"In the lobby, each game also has a room off the hallway: walk into its glowing portal (or press <b>E</b> at it) to join.",
			"<b>P</b>  settings: field of view, and hiding the sidebar, the climb and writing cards and the win counter",
			"The sidebar on the left has <b>Gifts</b>, <b>Themes</b>, <b>Settings</b> and <b>Games</b>; its arrow slides it away.",
			"<b>H</b>  this guide",
			"<b>Y</b>  streamer panel: gift settings, test gifts, map and settings",
			"",
			"On a phone or tablet, tap to dig and use the on-screen buttons.",
		}, "\n"),
	},
	{
		title = "How to win",
		text = table.concat({
			"Dig into the mountain to find the <b>diamond</b> hidden inside. TikTok gifts blast big holes in it, and likes, follows and shares break rocks too. Some gifts add stone back instead: the streamer chooses which.",
			"",
			"When the diamond shows, aim at it and click it from close by to pick it up.",
			"",
			"Hold it until the countdown ends (it takes 15 seconds) to win the round. You can't move while you hold it, and a gift that rebuilds rock makes you drop it.",
			"",
			"<b>Diamond bird</b>: every 5 to 7 and a half minutes a diamond bird circles the mountain. Aim at it until the dot turns gold and click: every gift counts double for 30 seconds.",
			"",
			"The leaderboards behind the mountain show the top helpers (gifts that break the mountain) and the top griefers (gifts that add stone).",
		}, "\n"),
	},
	{
		title = "Diamond Climb",
		text = table.concat({
			"Press <b>G</b> and <b>JOIN</b> Diamond Climb. Jump up <b>1,000 platforms</b> round the crystal tower to the diamond at the top.",
			"",
			"Every platform you land on is a <b>checkpoint</b>. Fall off and you are put straight back on it. Each platform is a little higher than the last, but every jump is a short hop.",
			"",
			"<b>MOVEMENT</b> (bottom right): drag <b>Speed</b> and <b>Jump height</b> to suit you. Reset puts them back. Settings (<b>P</b>) can hide this card.",
			"",
			"<b>Gifts</b> send you up the tower, more platforms for bigger gifts: a Rose is 2, 100 coins is 20, a Galaxy is 63. Some send you <b>down</b>: to start with an Ice Cream Cone, Finger Heart, Perfume, Confetti, Money Gun and TikTok Universe. The gift settings (<b>Y</b>, then <b>Open gift settings</b>) set how far each gift sends you, up or down. From 100 coins the rides take over the camera, and every tier is crazier than the last. Follows and shares lift you one platform.",
			"",
			"Reach the top, then <b>hold it</b>: stay there while the countdown runs from 10 (it slows down near the end). A gift that sends you down ends the hold. Make it to 0 to win the climb. The next one starts from the bottom.",
			"",
			"In the streamer panel (<b>Y</b>), <b>DIAMOND CLIMB</b> restarts the climb and sets the gift strength. TEST GIFTS send you up and REBUILD TEST GIFTS send you down.",
		}, "\n"),
	},
	{
		title = "Chalkboard",
		text = table.concat({
			"Press <b>G</b> and <b>JOIN</b> Chalkboard Count. You stand at a big green chalkboard in a classroom.",
			"",
			"<b>Hold to write</b>: hold the left mouse button, Space or the screen and you chalk up the next number, one after another. Reach the <b>goal</b> (1,000 to start) and <b>hold it</b> while the countdown runs from 10 (it slows down near the end). A gift that takes the count down ends the hold. Make it to 0 to win, then the board is wiped for the next one.",
			"",
			"<b>WRITING</b> (bottom right): drag <b>Speed</b> to write faster or slower, and pick a <b>theme</b> for the classroom: Classic green, Blackboard, Neon night, Sakura or Royal diamond. Settings (<b>P</b>) can hide this card.",
			"",
			"<b>Gifts</b> write numbers for you, more for bigger gifts: a Rose is 2, 100 coins is 20, a Galaxy is 63. Some take numbers <b>off</b>: to start with an Ice Cream Cone, Finger Heart, Perfume, Confetti, Money Gun and TikTok Universe. The gift settings (<b>Y</b>, then <b>Open gift settings</b>) set how far each gift moves the count, up or down. Every gift has its own animation, bigger for bigger gifts. Follows and shares add one.",
			"",
			"<b>The reset</b>: a <b>Galaxy</b> starts a 60 second countdown. When it runs out the board is wiped back to 0. Anyone who sends a different gift worth <b>1,000 coins or more</b> saves the board and stops the countdown.",
			"",
			"In the streamer panel (<b>Y</b>), <b>CHALKBOARD COUNT</b> sets the goal, which gift starts the reset, how long it lasts, how many coins save it and the gift strength. Test reset and Test save try it out without TikTok.",
		}, "\n"),
	},
}

local open = false
local setOpenHandler: ((boolean, number?) -> ())? = nil

function HowToPlay.isOpen(): boolean
	return open
end

-- Opens the guide (on `page`, or where it was left) or closes it.
function HowToPlay.setOpen(show: boolean, page: number?)
	if setOpenHandler then setOpenHandler(show, page) end
end

function HowToPlay.toggle()
	HowToPlay.setOpen(not open)
end

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent ~= nil then
		instance.Parent = parent
	end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent: Instance, colour: Color3, thickness: number)
	make("UIStroke", { Color = colour, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end

function HowToPlay.start()
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "HowToPlay",
		ResetOnSpawn = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
	}, player:WaitForChild("PlayerGui"))
	local card = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.92, 0, 0.86, 0),
		BackgroundColor3 = IVORY,
	}, gui)
	make("UISizeConstraint", { MaxSize = Vector2.new(620, 520) }, card)
	rounded(card, 18)
	stroke(card, GOLD, 3)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 16),
	}, card)
	make("TextLabel", {
		Size = UDim2.new(1, -110, 0, 38),
		BackgroundTransparency = 1,
		Font = TITLE_FONT,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = ROYAL,
		Text = "How to play",
	}, card)
	local close = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.fromOffset(96, 30),
		BackgroundColor3 = ROYAL,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Close  H",
	}, card)
	rounded(close, 15)

	-- The page tabs.
	local tabs = make("Frame", {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
	}, card)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabs)
	make("Frame", {
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
	}, card)
	local body = make("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 100),
		Size = UDim2.new(1, 0, 1, -122),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = GOLD,
	}, card)
	local text = make("TextLabel", {
		Size = UDim2.new(1, -10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		LineHeight = 1.15,
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = INK,
		Text = "",
	}, body)

	local buttons: { TextButton } = {}
	local current = 1
	local function show(page: number)
		current = math.clamp(page, 1, #HowToPlay.PAGES)
		for index, button in buttons do
			local on = index == current
			button.BackgroundColor3 = if on then ROYAL else Color3.new(1, 1, 1)
			button.TextColor3 = if on then Color3.new(1, 1, 1) else ROYAL
		end
		text.Text = HowToPlay.PAGES[current].text
		body.CanvasPosition = Vector2.zero
	end
	for index, page in HowToPlay.PAGES do
		local button = make("TextButton", {
			Size = UDim2.new(1 / #HowToPlay.PAGES, -6, 1, 0),
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextScaled = false,
			TextWrapped = true,
			Text = page.title,
		}, tabs)
		rounded(button, 10)
		stroke(button, ROYAL, 1.5)
		button.Activated:Connect(function() show(index) end)
		table.insert(buttons, button)
	end
	make("TextLabel", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = MUTED,
		Text = "Open this again from the board by the lobby spawn, the games menu, or H.",
	}, card)
	show(1)

	setOpenHandler = function(visible: boolean, page: number?)
		if page then show(page) end
		open = visible
		gui.Enabled = visible
	end
	close.Activated:Connect(function() HowToPlay.setOpen(false) end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or input.KeyCode ~= HowToPlay.KEY or UserInputService:GetFocusedTextBox() then return end
		HowToPlay.toggle()
	end)
	-- The lobby board: walk up and press E, or click it.
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
		if prompt.Name == HowToPlay.BOARD and who == player then HowToPlay.setOpen(true, 1) end
	end)
	task.spawn(function()
		local lobby = workspace:WaitForChild("Lobby", math.huge)
		local board = lobby:WaitForChild("HowToPlayBoard", math.huge)
		local click = board:WaitForChild(HowToPlay.BOARD .. "Click", math.huge)
		if click:IsA("ClickDetector") then
			click.MouseClick:Connect(function() HowToPlay.setOpen(true, 1) end)
		end
	end)
	-- First person locks the mouse; free it while the guide is open.
	RunService.RenderStepped:Connect(function()
		if open then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end)
end

return HowToPlay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">LobbyView</string>
            <string name="Source"><![CDATA[--!strict
-- The games menu on the left of the screen, in the lobby's royal white and
-- gold: Diamond in the Rough with its live status and a Join button, Diamond
-- Climb with the climber's platform and a Join button, Chalkboard Count with
-- the count on the board and a Join button, a slot marked Coming soon, How to play, and Back to lobby while playing. It
-- opens from GAMES on the sidebar (or G), beside the sidebar; Hide (or G)
-- closes it. Also turns the lobby's giant diamond on this computer.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Format = require(Shared:WaitForChild("Format"))
local Skin = require(Shared:WaitForChild("Skin"))

local LobbyView = {}

local IVORY = Color3.fromRGB(250, 248, 243)
local GOLD = Color3.fromRGB(224, 178, 72)
local ROYAL = Color3.fromRGB(34, 52, 140)
local ROYAL_DEEP = Color3.fromRGB(18, 28, 92)
local MUTED = Color3.fromRGB(140, 132, 118)
local TITLE_FONT = Enum.Font.Merriweather
local WIDTH = 360
local TOGGLE_KEY = Enum.KeyCode.G

local open = false
-- How far from the left edge the menu opens: just right of the sidebar.
LobbyView.LEFT = 106

function LobbyView.isOpen(): boolean
	return open
end

-- Opens or closes the menu (GAMES on the sidebar; other cards close it).
-- `opened` runs whenever it opens, so the other cards beside the sidebar close.
LobbyView.opened = nil :: (() -> ())?
local openHandler: (boolean) -> () = function() end
function LobbyView.setOpen(show: boolean)
	openHandler(show)
end
function LobbyView.close()
	openHandler(false)
end

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent ~= nil then
		instance.Parent = parent
	end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent: Instance, colour: Color3, thickness: number, transparency: number?)
	make("UIStroke", { Color = colour, Thickness = thickness, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end

local function text(parent: Instance, properties: { [string]: any }): TextLabel
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	}, parent)
	for key, value in properties do
		(label :: any)[key] = value
	end
	return label
end

-- A small cut-gem mark (a square turned on its corner) at the left of a game
-- card: filled for a game you can play, an outline for one still to come.
local function gemMark(card: Instance, colour: Color3, hollow: number)
	local mark = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(37, 40),
		Size = UDim2.fromOffset(28, 28),
		Rotation = 45,
		BackgroundColor3 = colour,
		BackgroundTransparency = hollow,
		ZIndex = 2,
	}, card)
	rounded(mark, 5)
	stroke(mark, if hollow > 0 then colour else Color3.new(1, 1, 1), 2, if hollow > 0 then 0.35 else 0.2)
	if hollow == 0 then
		make("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), colour), Rotation = -45 }, mark)
	end
end

-- What the Diamond in the Rough card says about the round going on now, in
-- the mountain's skin ("stone" by default, or "hay": see Skin).
function LobbyView.status(phase: string, stone: number, skin: string?): string
	local words = Skin.words(skin)
	local gem = words.gem
	if phase == "Won" then return string.upper(string.sub(gem, 1, 1)) .. string.sub(gem, 2) .. " found! A new round starts soon" end
	if phase == "Rebuilding" then return "The " .. words.heap .. " is being rebuilt" end
	if phase == "Holding" then return "Someone is holding the " .. gem .. "!" end
	return "LIVE · " .. Format.commas(stone) .. " " .. words.material .. " left"
end

-- What the Diamond Climb card says about the climb.
function LobbyView.climbStatus(checkpoint: number, wins: number): string
	local text = "Platform " .. Format.commas(checkpoint) .. " of 1,000"
	if wins ~= 0 then text ..= " · " .. Format.commas(wins) .. (if wins == 1 then " climb" else " climbs") end
	return text
end

-- What the Chalkboard Count card says about the board.
function LobbyView.chalkStatus(count: number, goal: number, wins: number): string
	local text = "Count " .. Format.commas(count) .. " of " .. Format.commas(goal)
	if wins ~= 0 then text ..= " · " .. Format.commas(wins) .. (if wins == 1 then " win" else " wins") end
	return text
end

-- Where the player is: "chalk" (Chalkboard Count), "climb" (Diamond Climb),
-- "rough" (Diamond in the Rough) or "lobby", from their InChalk, InClimb and
-- InGame attributes.
function LobbyView.place(player: Player): string
	if player:GetAttribute("InChalk") == true then return "chalk" end
	if player:GetAttribute("InClimb") == true then return "climb" end
	return if player:GetAttribute("InGame") == true then "rough" else "lobby"
end

-- `request` sends joinGame (with the game's name) / leaveGame;
-- `onChange(place)` runs whenever the player moves between the lobby and the
-- games ("lobby", "rough", "climb" or "chalk"; once at the start too); `onHelp`
-- opens the How to Play guide.
function LobbyView.start(request: RemoteEvent, state: Instance, onChange: (string) -> (), onHelp: (() -> ())?)
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "GamesMenu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	local panel = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -WIDTH - 40, 0.5, 0),
		Size = UDim2.fromOffset(WIDTH, 620),
		BackgroundColor3 = IVORY,
		Visible = false,
	}, gui)
	rounded(panel, 18)
	stroke(panel, GOLD, 3)
	-- Shrinks to fit short screens (Studio's play area, phones).
	local fit = make("UIScale", { Scale = 1 }, panel)
	local function refit()
		local camera = workspace.CurrentCamera
		local height = if camera then camera.ViewportSize.Y else 768
		fit.Scale = math.clamp((height - 60) / 620, 0.5, 1)
	end
	refit()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit) end
	make("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(240, 235, 222)),
		Rotation = 90,
	}, panel)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 14),
	}, panel)

	text(panel, {
		Size = UDim2.new(1, -72, 0, 40),
		Font = TITLE_FONT,
		TextSize = 30,
		TextColor3 = ROYAL,
		Text = "Games",
	})
	text(panel, {
		Position = UDim2.fromOffset(2, 40),
		Size = UDim2.new(1, -72, 0, 20),
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = MUTED,
		Text = "Pick a game to play · G hides this",
	})
	local hide = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 2),
		Size = UDim2.fromOffset(64, 30),
		BackgroundColor3 = ROYAL,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Hide",
	}, panel)
	rounded(hide, 15)
	make("Frame", {
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
	}, panel)

	local list = make("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 1, -80),
		BackgroundTransparency = 1,
	}, panel)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, list)

	-- Diamond in the Rough.
	local card = make("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundTransparency = 1,
	}, list)
	rounded(card, 14)
	stroke(card, GOLD, 2)
	-- The royal blue fill is its own layer, so its gradient leaves the gold border alone.
	local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 1 }, card)
	rounded(fill, 14)
	make("UIGradient", { Color = ColorSequence.new(ROYAL, ROYAL_DEEP), Rotation = 35 }, fill)
	gemMark(card, Color3.fromRGB(176, 230, 255), 0)
	text(card, {
		Position = UDim2.fromOffset(72, 10),
		Size = UDim2.new(1, -80, 0, 26),
		Font = TITLE_FONT,
		TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Diamond in the Rough",
	})
	local live = text(card, {
		Position = UDim2.fromOffset(72, 38),
		Size = UDim2.new(1, -80, 0, 18),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(205, 218, 255),
		Text = "",
	})
	local join = make("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(120, 30),
		BackgroundColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextColor3 = ROYAL_DEEP,
		Text = "JOIN",
		ZIndex = 2,
	}, card)
	rounded(join, 10)

	-- Diamond Climb.
	local climbCard = make("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundTransparency = 1,
	}, list)
	rounded(climbCard, 14)
	stroke(climbCard, GOLD, 2)
	local climbFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 1 }, climbCard)
	rounded(climbFill, 14)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(92, 52, 160), Color3.fromRGB(40, 22, 96)), Rotation = 35 }, climbFill)
	gemMark(climbCard, Color3.fromRGB(255, 150, 220), 0)
	text(climbCard, {
		Position = UDim2.fromOffset(72, 10),
		Size = UDim2.new(1, -80, 0, 26),
		Font = TITLE_FONT,
		TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Diamond Climb",
	})
	local climbLive = text(climbCard, {
		Position = UDim2.fromOffset(72, 38),
		Size = UDim2.new(1, -80, 0, 18),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(230, 210, 255),
		Text = "",
	})
	local climbJoin = make("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(120, 30),
		BackgroundColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextColor3 = ROYAL_DEEP,
		Text = "JOIN",
		ZIndex = 2,
	}, climbCard)
	rounded(climbJoin, 10)

	-- Chalkboard Count.
	local chalkCard = make("Frame", {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundTransparency = 1,
	}, list)
	rounded(chalkCard, 14)
	stroke(chalkCard, GOLD, 2)
	local chalkFill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 1 }, chalkCard)
	rounded(chalkFill, 14)
	make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(46, 112, 74), Color3.fromRGB(20, 58, 38)), Rotation = 35 }, chalkFill)
	gemMark(chalkCard, Color3.fromRGB(240, 244, 230), 0)
	text(chalkCard, {
		Position = UDim2.fromOffset(72, 10),
		Size = UDim2.new(1, -80, 0, 26),
		Font = TITLE_FONT,
		TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "Chalkboard Count",
	})
	local chalkLive = text(chalkCard, {
		Position = UDim2.fromOffset(72, 38),
		Size = UDim2.new(1, -80, 0, 18),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(214, 240, 220),
		Text = "",
	})
	local chalkJoin = make("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(120, 30),
		BackgroundColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextColor3 = ROYAL_DEEP,
		Text = "JOIN",
		ZIndex = 2,
	}, chalkCard)
	rounded(chalkJoin, 10)

	-- More games to come.
	for index = 4, 4 do
		local soon = make("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 84),
			BackgroundColor3 = Color3.fromRGB(238, 235, 228),
		}, list)
		rounded(soon, 14)
		stroke(soon, GOLD, 1.5, 0.45)
		gemMark(soon, GOLD, 1)
		text(soon, {
			Position = UDim2.fromOffset(72, 18),
			Size = UDim2.new(1, -150, 0, 24),
			Font = TITLE_FONT,
			TextSize = 19,
			TextColor3 = MUTED,
			Text = "Coming soon",
		})
		text(soon, {
			Position = UDim2.fromOffset(72, 44),
			Size = UDim2.new(1, -150, 0, 18),
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = Color3.fromRGB(165, 156, 140),
			Text = "A new game is on its way",
		})
		local badge = text(soon, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(64, 24),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = IVORY,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = GOLD,
			Text = "SOON",
		})
		rounded(badge, 12)
		stroke(badge, GOLD, 1.5)
	end

	local help = make("TextButton", {
		LayoutOrder = 9,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = ROYAL,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "How to play  H",
	}, list)
	rounded(help, 12)
	stroke(help, GOLD, 2)
	help.Activated:Connect(function()
		if onHelp then onHelp() end
	end)

	local back = make("TextButton", {
		LayoutOrder = 10,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = ROYAL,
		Text = "Back to lobby",
		Visible = false,
	}, list)
	rounded(back, 12)
	stroke(back, ROYAL, 2)

	-- Showing and hiding: the panel slides in from the left edge.
	local slide: Tween? = nil
	local function setOpen(show: boolean)
		if show == open then return end
		open = show
		if show and LobbyView.opened then (LobbyView.opened :: () -> ())() end
		if slide then slide:Cancel() end
		panel.Visible = true
		local target = if show then UDim2.new(0, LobbyView.LEFT, 0.5, 0) else UDim2.new(0, -WIDTH - 40, 0.5, 0)
		local tween = TweenService:Create(panel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = target })
		slide = tween
		tween.Completed:Connect(function(playback)
			if playback == Enum.PlaybackState.Completed and not open then panel.Visible = false end
		end)
		tween:Play()
	end
	openHandler = setOpen
	hide.Activated:Connect(function() setOpen(false) end)

	-- G toggles the menu (no gift can be given G, see Keybinds).
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or input.KeyCode ~= TOGGLE_KEY then return end
		setOpen(not open)
	end)
	-- First person locks the mouse; free it while the menu is open.
	RunService.RenderStepped:Connect(function()
		if open then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end)

	local function refreshLive()
		live.Text = LobbyView.status(tostring(state:GetAttribute("Phase") or "Digging"), tonumber(state:GetAttribute("Stone")) or 0, state:GetAttribute("Skin"))
	end
	state:GetAttributeChangedSignal("Phase"):Connect(refreshLive)
	state:GetAttributeChangedSignal("Stone"):Connect(refreshLive)
	state:GetAttributeChangedSignal("Skin"):Connect(refreshLive)
	refreshLive()
	local function refreshClimb()
		climbLive.Text = LobbyView.climbStatus(tonumber(state:GetAttribute("ClimbCheckpoint")) or 0, tonumber(state:GetAttribute("ClimbWins")) or 0)
	end
	state:GetAttributeChangedSignal("ClimbCheckpoint"):Connect(refreshClimb)
	state:GetAttributeChangedSignal("ClimbWins"):Connect(refreshClimb)
	refreshClimb()
	local function refreshChalk()
		chalkLive.Text = LobbyView.chalkStatus(tonumber(state:GetAttribute("ChalkCount")) or 0,
			tonumber(state:GetAttribute("ChalkGoal")) or 1000, tonumber(state:GetAttribute("ChalkWins")) or 0)
	end
	state:GetAttributeChangedSignal("ChalkCount"):Connect(refreshChalk)
	state:GetAttributeChangedSignal("ChalkGoal"):Connect(refreshChalk)
	state:GetAttributeChangedSignal("ChalkWins"):Connect(refreshChalk)
	refreshChalk()

	local place: string? = nil
	local function playing(button: TextButton, on: boolean)
		button.Text = if on then "PLAYING" else "JOIN"
		button.BackgroundColor3 = if on then Color3.new(1, 1, 1) else GOLD
		button.AutoButtonColor = not on
	end
	local refreshQueued = false
	local function refreshPlace()
		refreshQueued = false
		local now = LobbyView.place(player)
		if now == place then return end
		place = now
		playing(join, now == "rough")
		playing(climbJoin, now == "climb")
		playing(chalkJoin, now == "chalk")
		back.Visible = now ~= "lobby"
		-- Arriving in the lobby opens the menu; joining a game tucks it away.
		setOpen(now == "lobby")
		onChange(now)
	end
	-- Moving between games changes two attributes; look once both have arrived.
	local function queueRefresh()
		if refreshQueued then return end
		refreshQueued = true
		task.defer(refreshPlace)
	end
	player:GetAttributeChangedSignal("InGame"):Connect(queueRefresh)
	player:GetAttributeChangedSignal("InClimb"):Connect(queueRefresh)
	player:GetAttributeChangedSignal("InChalk"):Connect(queueRefresh)
	refreshPlace()

	join.Activated:Connect(function()
		if place == "rough" then
			setOpen(false)
		else
			request:FireServer("joinGame", "DiamondInTheRough")
		end
	end)
	climbJoin.Activated:Connect(function()
		if place == "climb" then
			setOpen(false)
		else
			request:FireServer("joinGame", "DiamondClimb")
		end
	end)
	chalkJoin.Activated:Connect(function()
		if place == "chalk" then
			setOpen(false)
		else
			request:FireServer("joinGame", "Chalkboard")
		end
	end)
	back.Activated:Connect(function()
		request:FireServer("leaveGame")
	end)

	-- The lobby's giant diamond turns slowly and bobs (only when near).
	task.spawn(function()
		local lobby = workspace:WaitForChild("Lobby", math.huge)
		local gem = lobby:WaitForChild("LobbyDiamond", math.huge)
		local centre = gem:GetAttribute("Centre")
		if typeof(centre) ~= "Vector3" then return end
		local origin = CFrame.new(centre)
		local parts: { BasePart } = {}
		local offsets: { CFrame } = {}
		for _, item in gem:GetDescendants() do
			if item:IsA("BasePart") then
				table.insert(parts, item)
				table.insert(offsets, origin:ToObjectSpace(item.CFrame))
			end
		end
		local frames: { CFrame } = table.create(#parts, CFrame.identity)
		RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			if camera == nil or (camera.CFrame.Position - centre).Magnitude > 400 then return end
			local t = os.clock()
			local turn = CFrame.new(centre + Vector3.new(0, math.sin(t * 1.3) * 0.5, 0)) * CFrame.Angles(0, t * 0.6, 0)
			for i, offset in offsets do
				frames[i] = turn * offset
			end
			workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end)
	end)
end

return LobbyView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">MountainView</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- Draws the mountain on this client. The server only keeps the rock grid and
-- sends a snapshot plus compact change lists (MountainCodec). Every exposed cell
-- gets exactly one local part; shapes slope towards open air (RockStyle).
--
-- Local parts cost no replication, collide with the local character and block
-- clicks, exactly like server parts did. All work runs in one worker with a
-- per-frame time budget, so a 100,000-rock gift opens over a few frames
-- instead of freezing the game.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Grid = require(Shared:WaitForChild("Grid"))
local RockStyle = require(Shared:WaitForChild("RockStyle"))
local Codec = require(Shared:WaitForChild("MountainCodec"))
local PartShapes = require(Shared:WaitForChild("PartShapes"))

local MountainView = {}
MountainView.__index = MountainView

local SPAN, LAYER = Grid.SPAN, Grid.LAYER
local STEPS = Grid.STEPS
local SIDES = { 1, -1, SPAN, -SPAN }
local hasBit = Grid.hasBit
local POOL_LIMIT = 3000
local DEBRIS_PER_CHANGE = 4
local DEBRIS_LIMIT = 24
local REBUILD_LAYERS = 16
local REBUILD_STEP = 0.15 -- seconds between rebuild layers, matching the server

-- Materials per layer for each skin (stone, or hay: see Skin).
local MATERIALS: { [string]: { Enum.Material } } = {}
for skin, palette in RockStyle.SKINS do
	MATERIALS[skin] = {}
	for index, layer in palette.layers do
		MATERIALS[skin][index] = (Enum.Material :: any)[layer.material]
	end
end

-- Rotation for every shape code, so a wedge slopes down towards open air and a
-- corner wedge turns its tall corner away from both open sides.
local function shapeRotations(): { [number]: CFrame }
	local rotations: { [number]: CFrame } = { [RockStyle.BLOCK] = CFrame.identity }
	for code, direction in RockStyle.DIRECTIONS do
		rotations[code] = if code <= 5
			then PartShapes.wedgeToward(Vector3.new(direction[1], 0, direction[2]))
			else PartShapes.cornerToward(-direction[1], -direction[2])
	end
	return rotations
end

export type View = typeof(setmetatable({} :: {
	folder: Folder?,
	grid: Grid.Grid?,
	parts: { [number]: BasePart },
	codes: { [number]: number },
	keys: { [BasePart]: number },
	tops: { [number]: number },
	pool: { { BasePart } },
	templates: { BasePart },
	rotations: { [number]: CFrame },
	queue: { any },
	head: number,
	tail: number,
	round: number,
	height: number,
	blockSize: number,
	skin: string,
	ready: boolean,
	meta: any,
	sliceStart: number,
	debris: { any },
	debrisConnection: RBXScriptConnection?,
	onRebuild: ((any) -> ())?,
	onRestore: ((any) -> ())?,
}, MountainView))

function MountainView.new(): View
	local self = setmetatable({
		folder = nil,
		grid = nil,
		parts = {},
		codes = {},
		keys = {},
		tops = {},
		pool = { {}, {}, {} },
		templates = {},
		rotations = shapeRotations(),
		queue = {},
		head = 1,
		tail = 0,
		round = 0,
		height = 1,
		blockSize = 0.4,
		skin = "stone",
		ready = false,
		meta = nil,
		sliceStart = os.clock(),
		debris = {},
		debrisConnection = nil,
		onRebuild = nil,
		onRestore = nil,
	}, MountainView)
	return self
end

function MountainView._makeTemplates(self: View)
	local size = self.blockSize * 1.02 -- a hair of overlap hides seams between cells
	for kind, className in { "Part", "WedgePart", "CornerWedgePart" } do
		local part = Instance.new(className) :: BasePart
		part.Name = "Stone"
		part.Size = Vector3.new(size, size, size)
		part.Anchored = true
		part.CanCollide = true
		part.CanQuery = true
		part.CanTouch = false
		-- Thousands of small rocks casting shadows cost more than any other
		-- part of the scene; the mountain still takes shadows and shading.
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		self.templates[kind] = part
		self.pool[kind] = {}
	end
end

-- Messages from the server, processed strictly in order.
function MountainView.push(self: View, kind: string, payload: any)
	self.tail += 1
	self.queue[self.tail] = { kind = kind, payload = payload }
end

function MountainView.pending(self: View): number
	return self.tail - self.head + 1
end

-- Yields once this frame's share of work is used up. A backlog earns a
-- slightly larger share so the mountain catches up quickly.
function MountainView._pace(self: View)
	local budget = if self:pending() > 2 or not self.ready then 0.006 else 0.004
	if os.clock() - self.sliceStart >= budget then
		task.wait()
		self.sliceStart = os.clock()
	end
end

function MountainView.start(self: View)
	task.spawn(function()
		while true do
			local message = self.queue[self.head]
			if message == nil then
				self.head, self.tail = 1, 0
				task.wait()
				self.sliceStart = os.clock()
			else
				self.queue[self.head] = nil
				self.head += 1
				local ok, problem = pcall(self._handle, self, message.kind, message.payload)
				if not ok then warn("[DiamondRush] mountain update failed: " .. tostring(problem)) end
			end
		end
	end)
end

function MountainView.keyForPart(self: View, part: Instance): number?
	return if part:IsA("BasePart") then self.keys[part] else nil
end

function MountainView.keyPosition(self: View, key: number): Vector3
	local column = key % LAYER
	local size = self.blockSize
	return Vector3.new((column % SPAN - 128) * size, (key // LAYER) * size + size / 2, (column // SPAN - 128) * size)
end

function MountainView._handle(self: View, kind: string, payload: any)
	if kind == "begin" then
		self:_begin(payload)
	elseif kind == "cells" and self.grid then
		local grid = self.grid :: Grid.Grid
		local count = 0
		Codec.decode(payload, function(key)
			grid.solid[key] = true
			count += 1
			if count % 2048 == 0 then self:_pace() end
		end)
	elseif kind == "tops" then
		Codec.decodePairs(payload, function(column, top) self.tops[column] = top end)
	elseif kind == "end" and self.grid then
		self:_finishSnapshot()
	elseif kind == "diff" and self.grid and self.ready and payload.round == self.round then
		self:_applyDiff(payload)
	elseif kind == "skin" then
		self:_repaint(payload)
	end
end

-- Reskins the mountain (stone or hay, see Skin), in order with the changes
-- from the server.
function MountainView.setSkin(self: View, skin: string)
	if RockStyle.SKINS[skin] == nil then return end
	self:push("skin", skin)
end

-- Every drawn cell keeps its shape and layer and takes the new skin's look.
function MountainView._repaint(self: View, skin: string)
	if skin == self.skin then return end
	self.skin = skin
	local materials = MATERIALS[skin]
	local count = 0
	for key, part in self.parts do
		local layer, r, g, b = RockStyle.look(key, self.tops[key % LAYER], self.height, skin)
		part.Material = materials[layer]
		part.Color = Color3.fromRGB(r, g, b)
		count += 1
		if count % 512 == 0 then self:_pace() end
	end
end

function MountainView._begin(self: View, meta: any)
	-- Drop the previous mountain in one step; it is out of view immediately.
	local old = self.folder
	if old then
		old.Parent = nil
		task.defer(function() old:Destroy() end)
	end
	for _, entry in self.debris do entry.part:Destroy() end
	table.clear(self.debris)
	self.meta = meta
	self.round = meta.round
	self.height = math.max(1, meta.height)
	if meta.blockSize ~= self.blockSize or #self.templates == 0 then
		self.blockSize = meta.blockSize
		self:_makeTemplates()
	end
	self.ready = false
	self.parts, self.codes, self.keys, self.tops = {}, {}, {}, {}
	for kind in self.pool do self.pool[kind] = {} end
	local grid = Grid.blank()
	grid.sealed[meta.diamondKey] = true
	self.grid = grid
	local folder = Instance.new("Folder")
	folder.Name = "Mountain"
	folder.Parent = workspace
	self.folder = folder
end

function MountainView._finishSnapshot(self: View)
	local grid = self.grid :: Grid.Grid
	local exposed: { number } = {}
	local visited = 0
	grid:eachSolid(function(key)
		if grid:isExposed(key) then table.insert(exposed, key) end
		visited += 1
		if visited % 4096 == 0 then self:_pace() end
	end)
	local meta = self.meta
	if meta.animated then
		-- Rise from the base to the summit in waves, with flying stones.
		local layers: { { number } } = {}
		for wave = 1, REBUILD_LAYERS do layers[wave] = {} end
		for _, key in exposed do
			local wave = math.clamp(math.floor((key // LAYER) / self.height * REBUILD_LAYERS) + 1, 1, REBUILD_LAYERS)
			table.insert(layers[wave], key)
		end
		local samples = {}
		for wave, keys in layers do
			for i = 1, math.min(5, #keys) do
				local key = keys[math.max(1, math.floor(i * #keys / 5))]
				local shape = RockStyle.shape(grid, key)
				local _, r, g, b = RockStyle.look(key, self.tops[key % LAYER], self.height, self.skin)
				table.insert(samples, {
					frame = CFrame.new(self:keyPosition(key)) * (self.rotations[shape] or CFrame.identity),
					size = self.templates[1].Size,
					colour = Color3.fromRGB(r, g, b),
					layer = wave,
				})
			end
		end
		if self.onRebuild then self.onRebuild({ stones = samples, start = meta.start }) end
		for wave, keys in layers do
			while workspace:GetServerTimeNow() < meta.start + wave * REBUILD_STEP do task.wait() end
			self.sliceStart = os.clock()
			for index, key in keys do
				self:_refresh(key)
				if index % 64 == 0 then self:_pace() end
			end
		end
	else
		for index, key in exposed do
			self:_refresh(key)
			if index % 64 == 0 then self:_pace() end
		end
	end
	self.ready = true
end

function MountainView._acquire(self: View, kind: number): BasePart
	local pool = self.pool[kind]
	local part = pool[#pool]
	if part then
		pool[#pool] = nil
		return part
	end
	return self.templates[kind]:Clone()
end

function MountainView._release(self: View, part: BasePart, kind: number)
	self.keys[part] = nil
	local pool = self.pool[kind]
	if #pool < POOL_LIMIT then
		part.Parent = nil
		table.insert(pool, part)
	else
		part:Destroy()
	end
end

-- Brings one cell's part in line with the grid: created, reshaped or removed.
function MountainView._refresh(self: View, key: number): BasePart?
	local grid = self.grid :: Grid.Grid
	local old = self.codes[key]
	if not (hasBit(grid.solidPages, key) and grid:isExposed(key)) then
		if old ~= nil then
			self.codes[key] = nil
			local part = self.parts[key]
			if part then
				self.parts[key] = nil
				self:_release(part, RockStyle.kind(old % 16))
			end
		end
		return nil
	end
	local shape = RockStyle.shape(grid, key)
	local layer, r, g, b = RockStyle.look(key, self.tops[key % LAYER], self.height, self.skin)
	local code = shape + layer * 16
	if code == old then return nil end
	local kind = RockStyle.kind(shape)
	local part: BasePart? = self.parts[key]
	if part and (old == nil or RockStyle.kind(old % 16) ~= kind) then
		self:_release(part, RockStyle.kind((old or 0) % 16))
		part = nil
	end
	local fresh = part == nil
	if part == nil then
		local acquired = self:_acquire(kind)
		self.parts[key] = acquired
		self.keys[acquired] = key
		part = acquired
	end
	local stone = part :: BasePart
	stone.CFrame = CFrame.new(self:keyPosition(key)) * self.rotations[shape]
	-- A rock that only changes shape keeps its look: skip the property writes.
	if fresh or old == nil or old // 16 ~= layer then
		stone.Material = MATERIALS[self.skin][layer]
		stone.Color = Color3.fromRGB(r, g, b)
	end
	if fresh then stone.Parent = self.folder end
	self.codes[key] = code
	return if fresh then stone else nil
end

function MountainView._applyDiff(self: View, diff: any)
	local grid = self.grid :: Grid.Grid
	local changed: { number } = {}
	local added: { number } = {}
	local flying: { BasePart } = {}
	local count = 0
	for _, chunk in diff.removed or {} do
		Codec.decode(chunk, function(key)
			if hasBit(grid.solidPages, key) then
				grid.solid[key] = nil
				table.insert(changed, key)
				local part = self.parts[key]
				if part and #flying < DEBRIS_PER_CHANGE and #self.debris + #flying < DEBRIS_LIMIT and diff.effect ~= nil then
					-- This rock flies off as rubble instead of vanishing.
					self.parts[key] = nil
					self.keys[part] = nil
					self.codes[key] = nil
					table.insert(flying, part)
				end
			end
			count += 1
			if count % 1024 == 0 then self:_pace() end
		end)
	end
	for _, chunk in diff.added or {} do
		Codec.decode(chunk, function(key)
			if not hasBit(grid.solidPages, key) then
				grid.solid[key] = true
				table.insert(changed, key)
				table.insert(added, key)
				local column = key % LAYER
				local y = key // LAYER
				if (self.tops[column] or -1) < y then self.tops[column] = y end
			end
			count += 1
			if count % 1024 == 0 then self:_pace() end
		end)
	end
	if #flying > 0 then self:_throwDebris(flying, diff.at) end
	self:_reconcile(changed)
	if diff.effect == "restore" and self.onRestore and #added > 0 then
		local stones = {}
		for _, key in added do
			local part = self.parts[key]
			if part and part.Parent then
				table.insert(stones, { frame = part.CFrame, size = part.Size, colour = part.Color, part = part })
				if #stones >= 24 then break end
			end
		end
		self.onRestore({ stones = stones })
	end
end

-- Re-checks every cell whose shape can depend on the changed cells: the cells
-- themselves, their neighbours (air or exposure changed) and the side
-- neighbours of those (whose shapes test neighbour exposure).
function MountainView._reconcile(self: View, changed: { number })
	local grid = self.grid :: Grid.Grid
	local pages = grid.solidPages
	local marks, markPages = Grid.cellMap()
	local list: { number } = {}
	local function touch(key: number)
		if not hasBit(markPages, key) then
			marks[key] = true
			table.insert(list, key)
		end
	end
	for index, key in changed do
		touch(key)
		for _, step in STEPS do
			local neighbour = key + step
			if neighbour >= 0 and hasBit(pages, neighbour) then
				touch(neighbour)
				for _, side in SIDES do
					local beside = neighbour + side
					if hasBit(pages, beside) then touch(beside) end
				end
			end
		end
		if index % 256 == 0 then self:_pace() end
	end
	for index, key in list do
		self:_refresh(key)
		if index % 64 == 0 then self:_pace() end
	end
end

-- A few removed rocks tumble away from the blast or dig, then return to the pool.
function MountainView._throwDebris(self: View, parts: { BasePart }, at: Vector3?)
	local random = Random.new()
	for _, part in parts do
		part.CanCollide = false
		part.CanQuery = false
		local away = if at then part.Position - at else Vector3.new(random:NextNumber(-1, 1), 0, random:NextNumber(-1, 1))
		if away.Magnitude < 0.05 then away = Vector3.new(random:NextNumber(-1, 1), 0.5, random:NextNumber(-1, 1)) end
		table.insert(self.debris, {
			part = part,
			kind = if part:IsA("CornerWedgePart") then 3 elseif part:IsA("WedgePart") then 2 else 1,
			velocity = away.Unit * random:NextNumber(8, 16) + Vector3.new(0, random:NextNumber(9, 16), 0),
			spin = Vector3.new(random:NextNumber(-9, 9), random:NextNumber(-9, 9), random:NextNumber(-9, 9)),
			age = 0,
		})
	end
	if self.debrisConnection then return end
	self.debrisConnection = RunService.RenderStepped:Connect(function(dt)
		for index = #self.debris, 1, -1 do
			local entry = self.debris[index]
			entry.age += dt
			entry.velocity += Vector3.new(0, -50 * dt, 0)
			local part = entry.part
			part.CFrame = (part.CFrame + entry.velocity * dt) * CFrame.Angles(entry.spin.X * dt, entry.spin.Y * dt, entry.spin.Z * dt)
			part.Transparency = math.clamp((entry.age - 0.55) / 0.35, 0, 1)
			if entry.age >= 0.9 then
				table.remove(self.debris, index)
				part.Transparency = 0
				part.CanCollide = true
				part.CanQuery = true
				if part.Parent == self.folder then
					self:_release(part, entry.kind)
				else
					part:Destroy()
				end
			end
		end
		if #self.debris == 0 and self.debrisConnection then
			self.debrisConnection:Disconnect()
			self.debrisConnection = nil
		end
	end)
end

return MountainView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PetalView</string>
            <string name="Source"><![CDATA[--!strict
-- Cherry petals drift down around the camera while the map shows the sakura
-- theme and this player is in the game (not the lobby). The petals are local
-- parts in a box that follows the camera: each falls, sways and tumbles on its
-- own path, wrapping round the box, so the air stays full wherever you look
-- for the cost of one BulkMoveTo a frame.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PetalView = {}

local COUNT = 90
local BOX = Vector3.new(80, 40, 80) -- studs round the camera
local PINKS = {
	Color3.fromRGB(255, 228, 236),
	Color3.fromRGB(255, 206, 220),
	Color3.fromRGB(255, 186, 204),
	Color3.fromRGB(249, 163, 187),
}

type Petal = { seed: Vector3, fall: number, sway: number, phase: number, spin: Vector3 }

-- Wraps `value` into [0, size).
local function wrap(value: number, size: number): number
	return value - math.floor(value / size) * size
end

-- Where a petal is at time `t`, inside the box round `centre`. Pure, for tests.
function PetalView.frame(petal: Petal, t: number, centre: Vector3): CFrame
	local drift = petal.seed + Vector3.new(
		math.sin(t * petal.sway + petal.phase) * 2.2 + t * 1.1,
		-t * petal.fall,
		math.cos(t * petal.sway * 0.8 + petal.phase) * 1.6 + t * 0.4
	)
	local corner = centre - BOX / 2
	local at = corner + Vector3.new(wrap(drift.X - corner.X, BOX.X), wrap(drift.Y - corner.Y, BOX.Y), wrap(drift.Z - corner.Z, BOX.Z))
	return CFrame.new(at) * CFrame.Angles(t * petal.spin.X, t * petal.spin.Y, t * petal.spin.Z)
end

function PetalView.start(state: Instance)
	local player = Players.LocalPlayer
	local random = Random.new()
	local folder = Instance.new("Folder")
	folder.Name = "SakuraPetals"
	local parts: { BasePart } = {}
	local petals: { Petal } = {}
	local frames: { CFrame } = {}
	for i = 1, COUNT do
		local part = Instance.new("Part")
		part.Name = "Petal"
		part.Size = Vector3.new(0.34, 0.04, 0.26)
		part.Color = PINKS[random:NextInteger(1, #PINKS)]
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = folder
		parts[i] = part
		petals[i] = {
			seed = Vector3.new(random:NextNumber(0, BOX.X), random:NextNumber(0, BOX.Y), random:NextNumber(0, BOX.Z)),
			fall = random:NextNumber(1.6, 3.2),
			sway = random:NextNumber(0.6, 1.4),
			phase = random:NextNumber(0, math.pi * 2),
			spin = Vector3.new(random:NextNumber(-2.5, 2.5), random:NextNumber(-1.5, 1.5), random:NextNumber(-2.5, 2.5)),
		}
		frames[i] = CFrame.identity
	end
	local connection: RBXScriptConnection? = nil
	local function refresh()
		local on = state:GetAttribute("Theme") == "sakura" and player:GetAttribute("InGame") == true
		if on and connection == nil then
			folder.Parent = workspace
			connection = RunService.RenderStepped:Connect(function()
				local camera = workspace.CurrentCamera
				if camera == nil then return end
				local t = os.clock()
				local centre = camera.CFrame.Position
				for i, petal in petals do
					frames[i] = PetalView.frame(petal, t, centre)
				end
				workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
			end)
		elseif not on and connection ~= nil then
			(connection :: RBXScriptConnection):Disconnect()
			connection = nil
			folder.Parent = nil
		end
	end
	state:GetAttributeChangedSignal("Theme"):Connect(refresh)
	player:GetAttributeChangedSignal("InGame"):Connect(refresh)
	refresh()
end

return PetalView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">RebuildEffects</string>
            <string name="Source"><![CDATA[--!strict
-- A bounded stream of flying stones accompanies the server's layer reveal.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RebuildEffects = {}
local current: Folder? = nil
local connection: RBXScriptConnection? = nil
function RebuildEffects.play(data: any)
	if connection then connection:Disconnect(); connection = nil end
	if current then current:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "RebuildingStones"
	folder.Parent = workspace
	current = folder
	local tracks = {}
	for index, stone in data.stones do
		if index > 80 then break end
		local angle = index * 2.39996
		local destination = stone.frame.Position
		local start = destination + Vector3.new(math.cos(angle) * 10, -6, math.sin(angle) * 10)
		table.insert(tracks, { stone = stone, start = CFrame.new(start) * CFrame.Angles(angle, angle, 0), arrive = data.start + stone.layer * 0.15, part = nil, done = false })
	end
	connection = RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		local done = 0
		for _, track in tracks do
			local t = (now - (track.arrive - 0.55)) / 0.55
			if t >= 1 then
				if track.part then track.part:Destroy(); track.part = nil end
				track.done = true
				done += 1
			elseif t >= 0 and not track.done then
				if track.part == nil then
					local p = Instance.new("WedgePart")
					p.Size = track.stone.size * 1.8
					p.Color = track.stone.colour
					p.Material = Enum.Material.Slate
					p.Anchored = true
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.CastShadow = false
					p.Parent = folder
					track.part = p
				end
				local eased = 1 - (1 - t) ^ 3
				track.part.CFrame = track.start:Lerp(track.stone.frame, eased) + Vector3.new(0, math.sin(t * math.pi) * 2, 0)
				track.part.Size = track.stone.size * (1 + 0.8 * (1 - eased))
				track.part.Transparency = math.max(0, 1 - t * 8)
			end
		end
		if done == #tracks then
			if connection then connection:Disconnect(); connection = nil end
			-- A short finishing glint travels upward from the completed peak.
			local peak = Vector3.zero
			for _, track in tracks do
				if track.stone.frame.Position.Y > peak.Y then peak = track.stone.frame.Position end
			end
			for i = 1, 12 do
				local p = Instance.new("Part")
				p.Size = Vector3.new(0.08, 0.08, 0.45)
				p.Anchored = true
				p.CanQuery = false
				p.CanCollide = false
				p.CanTouch = false
				p.Material = Enum.Material.Neon
				p.Color = Color3.fromRGB(170, 240, 255)
				p.Position = peak
				p.Parent = folder
				local angle = i * math.pi / 6
				TweenService:Create(p, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = peak + Vector3.new(math.cos(angle) * 5, 3, math.sin(angle) * 5), Transparency = 1 }):Play()
			end
			Debris:AddItem(folder, 0.7)
		end
	end)
end
local restorations: { () -> () } = {}
function RebuildEffects.restore(data: any)
	if #data.stones == 0 then return end
	if #restorations >= 2 then table.remove(restorations, 1)() end
	local folder = Instance.new("Folder")
	folder.Name = "RestoringRocks"
	folder.Parent = workspace
	local hidden = {}
	local function cleanup()
		-- Also for rocks a gift has blasted meanwhile: they wait in the mountain's
		-- reuse pool and must not come back as invisible (but solid) rock.
		for _, part in hidden do part.LocalTransparencyModifier = 0 end
		table.clear(hidden)
		folder:Destroy()
	end
	table.insert(restorations, cleanup)
	for i, stone in data.stones do
		if i > 24 then break end
		local p = Instance.new("WedgePart")
		p.Size = stone.size * 1.6
		p.Color = stone.colour
		-- Stone or hay, like the rock it becomes.
		p.Material = if typeof(stone.part) == "Instance" and stone.part:IsA("BasePart") then stone.part.Material else Enum.Material.Slate
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		local angle = i * 2.39996
		p.CFrame = stone.frame + Vector3.new(math.cos(angle) * 5, 6 + i % 3, math.sin(angle) * 5)
		p.Parent = folder
		if typeof(stone.part) == "Instance" and stone.part:IsA("BasePart") then
			stone.part.LocalTransparencyModifier = 1
			table.insert(hidden, stone.part)
		end
		TweenService:Create(p, TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, i * 0.012), { CFrame = stone.frame, Size = stone.size }):Play()
	end
	task.delay(1.05, function()
		local index = table.find(restorations, cleanup)
		if index then table.remove(restorations, index) end
		cleanup()
	end)
end

return RebuildEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">SceneryView</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the Blender scenery pack on this computer when the server lays it out
-- in game (see the server's ScenePack): each mesh is unpacked from
-- ScenePackData once, built as an EditableMesh and shared by all of its copies.
-- The work is spread over frames, smallest meshes first, so the game keeps
-- running smoothly while the valley fills in over a few seconds. Trees and
-- plants a map theme hides (see SceneryThemes) are taken out of view while
-- that theme shows.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local MeshPack = require(Shared:WaitForChild("MeshPack"))
local SceneryThemes = require(Shared:WaitForChild("SceneryThemes"))

local SceneryView = {}

local PLACEMENTS = "DiamondRushSceneryPlacements" -- published by the server's ScenePack
local BUDGET = 0.004 -- seconds of building per frame

-- Built meshes and their templates stay referenced while their copies show.
local kept: { any } = {}
-- Copies some theme may hide, and the theme showing now.
local themed: { MeshPart } = {}
local theme: string? = nil
local folder: Folder? = nil

-- Takes the copies the theme hides out of view and puts the rest back.
local function applyTheme()
	for _, copy in themed do
		copy.Parent = if SceneryThemes.hides(theme, copy.Name) then nil else folder
	end
end

local function build(data: { [string]: MeshPack.Entry }, placements: { MeshPack.Placement })
	local byName: { [string]: { MeshPack.Placement } } = {}
	local names: { string } = {}
	for _, placement in placements do
		if data[placement.name] then
			local list = byName[placement.name]
			if list == nil then
				list = {}
				byName[placement.name] = list
				table.insert(names, placement.name)
			end
			table.insert(list, placement)
		end
	end
	-- Smallest first: if this computer ran short of mesh memory, the trees and
	-- rocks would still show.
	table.sort(names, function(a, b)
		return data[a].triangles < data[b].triangles
	end)
	local meshes = Instance.new("Folder")
	meshes.Name = "SceneryMeshes"
	meshes.Parent = workspace
	folder = meshes
	local started = os.clock()
	local function pause()
		if os.clock() - started > BUDGET then
			task.wait()
			started = os.clock()
		end
	end
	local built, copies = 0, 0
	for _, name in names do
		local list = byName[name]
		local ok, problem = pcall(function()
			local mesh = MeshPack.unpack(data[name], pause)
			pause()
			local editable = MeshPack.build(mesh, AssetService, pause)
			table.insert(kept, editable)
			local collide = false
			for _, placement in list do
				collide = collide or placement.collide
			end
			local content = Content.fromObject(editable)
			local options = {
				CollisionFidelity = if collide then Enum.CollisionFidelity.Hull else Enum.CollisionFidelity.Box,
				-- The far mountains keep their full detail.
				RenderFidelity = if mesh.size.X > 200 then Enum.RenderFidelity.Precise else Enum.RenderFidelity.Automatic,
			}
			local template = AssetService:CreateMeshPartAsync(content, options)
			table.insert(kept, template)
			for _, placement in list do
				local copy = template:Clone()
				local source = copy.MeshContent
				if source.SourceType ~= Enum.ContentSourceType.Object or source.Object == nil then
					-- A copy that lost the mesh gets its own part for it.
					copy:Destroy()
					copy = AssetService:CreateMeshPartAsync(content, options)
				end
				copy.Name = name
				local size = mesh.size * placement.scale
				copy.Size = size
				copy.CFrame = MeshPack.frame(placement.ground, size.Y, placement.yaw, placement.tilt, placement.sink)
				MeshPack.dress(copy, placement.collide, placement.shadow)
				if SceneryThemes.themed(name) then
					table.insert(themed, copy)
					copy.Parent = if SceneryThemes.hides(theme, name) then nil else meshes
				else
					copy.Parent = meshes
				end
				copies += 1
				pause()
			end
		end)
		if not ok then
			warn("[DiamondRush] Could not build the scenery mesh " .. name .. " on this computer: " .. tostring(problem)
				.. (if built == 0 then " To show the Blender scenery anyway, import art/DiamondRushScenery.fbx (see the README)." else ""))
			-- Larger meshes would not fit either.
			break
		end
		built += 1
	end
	print(string.format("[DiamondRush] Scenery: built %d of %d Blender meshes, %d copies.", built, #names, copies))
end

function SceneryView.start()
	task.spawn(function()
		-- Only published when the server builds the pack in game.
		local value = ReplicatedStorage:WaitForChild(PLACEMENTS, math.huge) :: StringValue
		local data: { [string]: MeshPack.Entry } = require(Shared:WaitForChild("ScenePackData")) :: any
		-- Follow the map theme (the server's State "Theme").
		local state = ReplicatedStorage:FindFirstChild("DiamondRushState") or ReplicatedStorage:WaitForChild("DiamondRushState", 10)
		if state then
			local function refresh()
				local value = state:GetAttribute("Theme")
				theme = if type(value) == "string" then value else nil
				applyTheme()
			end
			state:GetAttributeChangedSignal("Theme"):Connect(refresh)
			refresh()
		end
		build(data, MeshPack.decodePlacements(value.Value))
	end)
end

return SceneryView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Sidebar</string>
            <string name="Source"><![CDATA[--!strict
-- The sidebar on the left of the screen, everywhere (the lobby and every
-- game): GIFTS (the streamer's gift settings), THEMES (the map's theme, the
-- paid ones bought with Robux), SETTINGS and GAMES, each with a drawn icon.
-- The arrow on its edge slides it away and back. Settings can hide it
-- altogether (on a keyboard: G, P and Y still work).
--
-- The Themes card lives here too: each theme with a little picture of it and
-- a button that says IN USE, USE (free or bought) or its price in Robux.
-- Buying prompts Roblox's own purchase; the server checks what each player
-- owns and puts a bought theme on the map (see ThemeShop).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Config = require(Shared:WaitForChild("Config"))
local ThemeShop = require(Shared:WaitForChild("ThemeShop"))

local Sidebar = {}

local WHITE = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(168, 174, 190)
local GLASS = Color3.fromRGB(16, 18, 26)
local BUTTON = Color3.fromRGB(46, 50, 68)
local SELECTED = Color3.fromRGB(64, 128, 236)
local GOLD = Color3.fromRGB(246, 200, 92)
local GREEN = Color3.fromRGB(46, 164, 96)
local FONT = Enum.Font.GothamBold
local FONT_MEDIUM = Enum.Font.GothamMedium

Sidebar.BAR_WIDTH = 84
Sidebar.MARGIN = 10
-- Where the cards that open from the sidebar sit: just to its right.
Sidebar.PANEL_LEFT = Sidebar.MARGIN + Sidebar.BAR_WIDTH + 12
Sidebar.CENTRE = 0.42 -- of the screen's height: clear of the gift feed below
Sidebar.ITEMS = { "gifts", "themes", "settings", "games" }
Sidebar.LABELS = { gifts = "GIFTS", themes = "THEMES", settings = "SETTINGS", games = "GAMES" }

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if parent ~= nil then instance.Parent = parent end
	return instance
end

local function rounded(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function round(parent: Instance)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, parent)
end

local function glass(frame: GuiObject, radius: number)
	frame.BackgroundColor3 = GLASS
	frame.BackgroundTransparency = 0.12
	frame.BorderSizePixel = 0
	rounded(frame, radius)
	make("UIStroke", { Color = WHITE, Transparency = 0.86, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, frame)
end

-- A piece of an icon: a frame at (x, y) (its centre, in scale of the icon),
-- w by h (scale), turned `rotation` degrees.
local function bit(icon: Frame, x: number, y: number, w: number, h: number, colour: Color3, rotation: number?, corner: number?): Frame
	local frame = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		Rotation = rotation or 0,
		BackgroundColor3 = colour,
		BorderSizePixel = 0,
		ZIndex = icon.ZIndex + 1,
	}, icon)
	if corner == -1 then round(frame) elseif corner then make("UICorner", { CornerRadius = UDim.new(corner, 0) }, frame) end
	return frame
end

-- The drawn icons: a wrapped gift, a painter's palette, a gear and a game
-- controller. Drawn from frames, so they need no uploaded images.
function Sidebar.icon(kind: string, parent: Instance, size: number): Frame
	local icon = make("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, ZIndex = 3 }, parent)
	if kind == "gifts" then
		local red = Color3.fromRGB(232, 64, 84)
		bit(icon, 0.5, 0.66, 0.72, 0.5, GOLD, 0, 0.12) -- the box
		bit(icon, 0.5, 0.38, 0.84, 0.16, Color3.fromRGB(255, 220, 128), 0, 0.2) -- its lid
		bit(icon, 0.5, 0.6, 0.14, 0.62, red) -- the ribbon down
		bit(icon, 0.36, 0.2, 0.26, 0.18, red, 30, -1) -- the bow
		bit(icon, 0.64, 0.2, 0.26, 0.18, red, -30, -1)
		bit(icon, 0.5, 0.26, 0.12, 0.12, Color3.fromRGB(190, 40, 60), 0, -1)
	elseif kind == "themes" then
		bit(icon, 0.5, 0.52, 0.86, 0.74, Color3.fromRGB(240, 226, 196), -10, -1) -- the palette
		bit(icon, 0.66, 0.68, 0.18, 0.16, Color3.fromRGB(40, 44, 60), 0, -1) -- its thumb hole
		bit(icon, 0.3, 0.42, 0.16, 0.16, Color3.fromRGB(232, 64, 84), 0, -1) -- paint
		bit(icon, 0.47, 0.3, 0.16, 0.16, Color3.fromRGB(246, 200, 92), 0, -1)
		bit(icon, 0.66, 0.36, 0.16, 0.16, Color3.fromRGB(86, 170, 255), 0, -1)
		bit(icon, 0.32, 0.64, 0.16, 0.16, Color3.fromRGB(96, 200, 120), 0, -1)
	elseif kind == "settings" then
		local steel = Color3.fromRGB(200, 208, 224)
		for k = 0, 3 do
			bit(icon, 0.5, 0.5, 0.2, 0.9, steel, k * 45, 0.2) -- four bars crossing: eight teeth
		end
		bit(icon, 0.5, 0.5, 0.68, 0.68, steel, 0, -1)
		bit(icon, 0.5, 0.5, 0.28, 0.28, Color3.fromRGB(40, 44, 60), 0, -1)
	else -- games: a controller
		local body = Color3.fromRGB(150, 120, 255)
		bit(icon, 0.5, 0.55, 0.92, 0.5, body, 0, 0.45)
		bit(icon, 0.24, 0.72, 0.26, 0.32, body, 0, -1) -- grips
		bit(icon, 0.76, 0.72, 0.26, 0.32, body, 0, -1)
		local dark = Color3.fromRGB(40, 44, 60)
		bit(icon, 0.3, 0.54, 0.24, 0.08, dark) -- the cross
		bit(icon, 0.3, 0.54, 0.08, 0.24, dark)
		bit(icon, 0.68, 0.48, 0.1, 0.1, Color3.fromRGB(255, 220, 128), 0, -1) -- buttons
		bit(icon, 0.78, 0.6, 0.1, 0.1, Color3.fromRGB(232, 64, 84), 0, -1)
	end
	return icon
end

export type Options = {
	request: RemoteEvent,
	state: Instance,
	-- A sidebar button was pressed ("gifts", "themes", "settings", "games").
	onPick: (name: string) -> (),
	-- Which card is open now (nil: none), so its button lights up.
	active: () -> string?,
}

local themesOpen = false
local setThemesOpenHandler: (boolean) -> () = function() end
local adminHandler: (boolean) -> () = function() end
local hiddenHandler: (boolean) -> () = function() end

function Sidebar.themesOpen(): boolean
	return themesOpen
end

function Sidebar.setThemesOpen(show: boolean)
	setThemesOpenHandler(show)
end

-- GIFTS shows for the streamer only.
function Sidebar.setAdmin(isAdmin: boolean)
	adminHandler(isAdmin)
end

-- Hidden from the settings (the arrow too).
function Sidebar.setHidden(hidden: boolean)
	hiddenHandler(hidden)
end

function Sidebar.start(options: Options)
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "Sidebar",
		ResetOnSpawn = false,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- The bar --------------------------------------------------------------------
	local ITEM = 70
	local bar = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, Sidebar.MARGIN, Sidebar.CENTRE, 0),
		Size = UDim2.fromOffset(Sidebar.BAR_WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, gui)
	glass(bar, 16)
	make("UIPadding", { PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7), PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, bar)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }, bar)
	local buttons: { [string]: TextButton } = {}
	local hovered: { [string]: boolean } = {}
	-- The open card's button is lit; one under the mouse is shaded.
	local function light()
		local active = options.active()
		for name, button in buttons do
			button.BackgroundColor3 = if active == name then SELECTED else BUTTON
			button.BackgroundTransparency = if active == name then 0.1 elseif hovered[name] then 0.5 else 1
		end
	end
	for index, name in Sidebar.ITEMS do
		local button = make("TextButton", {
			LayoutOrder = index,
			Size = UDim2.fromOffset(Sidebar.BAR_WIDTH - 14, ITEM),
			BackgroundColor3 = BUTTON,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 2,
		}, bar)
		rounded(button, 12)
		local icon = Sidebar.icon(name, button, 38)
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.Position = UDim2.new(0.5, 0, 0, 8)
		make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			Font = FONT,
			TextSize = 11,
			TextColor3 = WHITE,
			Text = Sidebar.LABELS[name],
			ZIndex = 3,
		}, button)
		button.MouseEnter:Connect(function() hovered[name] = true; light() end)
		button.MouseLeave:Connect(function() hovered[name] = nil; light() end)
		button.Activated:Connect(function()
			options.onPick(name)
			light()
		end)
		buttons[name] = button
	end
	-- Cards also open and close by key (G, P, Y): look again now and then.
	task.spawn(function()
		while gui.Parent do
			light()
			task.wait(0.2)
		end
	end)

	-- The arrow on the bar's edge slides it away, and back. It sits beside the
	-- bar, not in it: the bar's list layout would place it among the buttons
	-- (and take it off screen with them). Tucked away, the arrow stays at the
	-- screen's edge to bring the bar back.
	local ARROW_OPEN = Sidebar.MARGIN + Sidebar.BAR_WIDTH + 4
	local ARROW_TUCKED = 4
	local arrow = make("TextButton", {
		Name = "SidebarArrow",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, ARROW_OPEN, Sidebar.CENTRE, 0),
		Size = UDim2.fromOffset(24, 64),
		Font = FONT,
		TextSize = 24,
		TextColor3 = WHITE,
		Text = "‹",
		AutoButtonColor = true,
		ZIndex = 4,
	}, gui)
	glass(arrow, 10)
	local collapsed = false
	local slides: { Tween } = {}
	local function setCollapsed(value: boolean)
		collapsed = value
		arrow.Text = if value then "›" else "‹"
		for _, tween in slides do tween:Cancel() end
		local info = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		local barX = if value then -(Sidebar.BAR_WIDTH + 2) else Sidebar.MARGIN
		local arrowX = if value then ARROW_TUCKED else ARROW_OPEN
		slides = {
			TweenService:Create(bar, info, { Position = UDim2.new(0, barX, Sidebar.CENTRE, 0) }),
			TweenService:Create(arrow, info, { Position = UDim2.new(0, arrowX, Sidebar.CENTRE, 0) }),
		}
		for _, tween in slides do tween:Play() end
	end
	arrow.Activated:Connect(function() setCollapsed(not collapsed) end)

	adminHandler = function(isAdmin: boolean)
		buttons.gifts.Visible = isAdmin
	end
	hiddenHandler = function(hidden: boolean)
		gui.Enabled = not hidden
	end

	-- The Themes card -------------------------------------------------------------
	local card = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, Sidebar.PANEL_LEFT, Sidebar.CENTRE, 0),
		Size = UDim2.fromOffset(360, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 5,
	}, gui)
	glass(card, 14)
	make("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, card)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, card)
	local header = make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = 6 }, card)
	make("TextLabel", { Size = UDim2.new(1, -40, 0, 22), BackgroundTransparency = 1, Font = FONT, TextSize = 18, TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left, Text = "THEMES", ZIndex = 6 }, header)
	make("TextLabel", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -40, 0, 18), BackgroundTransparency = 1, Font = FONT_MEDIUM, TextSize = 12,
		TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, Text = "The map's look and the mountain's. Buy one once, keep it.", ZIndex = 6 }, header)
	local closeCard = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = BUTTON, Font = FONT, TextSize = 16, TextColor3 = WHITE, Text = "X", ZIndex = 6 }, header)
	rounded(closeCard, 8)
	local message = make("TextLabel", { LayoutOrder = 99, Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT_MEDIUM, TextSize = 12,
		TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, AutomaticSize = Enum.AutomaticSize.Y, Text = "", ZIndex = 6 }, card)

	-- The rows scroll when the screen is too short for them all (phones).
	local ROW_HEIGHT = 56
	local SECTION_HEIGHT = 18
	local list = make("ScrollingFrame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 4, ScrollBarImageColor3 = MUTED, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 6 }, card)
	list.Name = "ThemeList"
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, list)
	local listHeight = #ThemeShop.ITEMS * (ROW_HEIGHT + 8) + 2 * (SECTION_HEIGHT + 8)
	local function fitList()
		local camera = workspace.CurrentCamera
		local screenHeight = if camera then camera.ViewportSize.Y else 720
		list.Size = UDim2.new(1, 0, 0, math.clamp(screenHeight - 200, 120, listHeight))
	end
	fitList()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitList) end

	local prices: { [string]: number } = {}
	local rows: { [string]: { button: TextButton, kind: string, item: ThemeShop.Theme } } = {}
	local function refreshRows()
		-- What's in use now: the map's theme, and the mountain's skin.
		local current = {
			theme = tostring(options.state:GetAttribute("Theme") or "default"),
			skin = tostring(options.state:GetAttribute("Skin") or "stone"),
		}
		local owned = ThemeShop.decode(player:GetAttribute("OwnedThemes"))
		for key, row in rows do
			local label, kind = ThemeShop.status(key, current[row.item.kind] or "", owned, Config.ThemePasses, prices[key])
			row.kind = kind
			row.button.Text = label
			row.button.BackgroundColor3 = if kind == "using" then BUTTON elseif kind == "use" then SELECTED else GREEN
			row.button.AutoButtonColor = kind ~= "using"
		end
	end
	local function section(order: number, text: string)
		make("TextLabel", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, SECTION_HEIGHT), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
			TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Text = text, ZIndex = 6 }, list)
	end
	-- A little picture of a theme: its sky, its ground, a peak and a highlight.
	local function themePicture(picture: Frame, theme: ThemeShop.Theme)
		make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.4), BackgroundColor3 = theme.ground, BorderSizePixel = 0, ZIndex = 8 }, picture)
		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.42, 0.62), Size = UDim2.fromOffset(26, 26), Rotation = 45,
			BackgroundColor3 = theme.ground:Lerp(Color3.new(0, 0, 0), 0.25), BorderSizePixel = 0, ZIndex = 8 }, picture)
		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.78, 0.3), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = theme.accent, BorderSizePixel = 0, ZIndex = 9 }, picture).Name = "Highlight"
	end
	-- A little picture of a skin: the mountain against its backdrop, with what's
	-- hidden in it showing: a diamond in the stone, or a needle in the hay.
	local function skinPicture(picture: Frame, skin: ThemeShop.Theme)
		if skin.key == "hay" then
			local stack = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(52, 48), BackgroundColor3 = skin.ground, BorderSizePixel = 0, ZIndex = 8 }, picture)
			rounded(stack, 24)
			for k = 1, 3 do
				make("Frame", { Position = UDim2.fromOffset(8 + k * 8, 8 + k * 4), Size = UDim2.fromOffset(12, 2), Rotation = -20 + k * 15,
					BackgroundColor3 = skin.ground:Lerp(Color3.new(0, 0, 0), 0.2), BorderSizePixel = 0, ZIndex = 9 }, stack)
			end
			make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.62, 0.36), Size = UDim2.fromOffset(2, 20), Rotation = 35,
				BackgroundColor3 = skin.accent, BorderSizePixel = 0, ZIndex = 10 }, stack).Name = "Highlight"
		else
			make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.95), Size = UDim2.fromOffset(46, 46), Rotation = 45,
				BackgroundColor3 = skin.ground, BorderSizePixel = 0, ZIndex = 8 }, picture)
			make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromOffset(9, 9), Rotation = 45,
				BackgroundColor3 = skin.accent, BorderSizePixel = 0, ZIndex = 9 }, picture).Name = "Highlight"
		end
	end
	local function addRow(order: number, item: ThemeShop.Theme)
		local row = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, -6, 0, ROW_HEIGHT), BackgroundColor3 = BUTTON, BackgroundTransparency = 0.5, ZIndex = 6 }, list)
		rounded(row, 10)
		local picture = make("Frame", { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(64, 44), BackgroundColor3 = item.sky, ClipsDescendants = true, ZIndex = 7 }, row)
		rounded(picture, 8)
		if item.kind == "skin" then skinPicture(picture, item) else themePicture(picture, item) end
		make("TextLabel", { Position = UDim2.fromOffset(80, 8), Size = UDim2.new(1, -180, 0, 20), BackgroundTransparency = 1, Font = FONT, TextSize = 16, TextColor3 = WHITE,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = item.name, ZIndex = 7 }, row)
		make("TextLabel", { Position = UDim2.fromOffset(80, 28), Size = UDim2.new(1, -180, 0, 18), BackgroundTransparency = 1, Font = FONT_MEDIUM, TextSize = 11, TextColor3 = MUTED,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = item.blurb, ZIndex = 7 }, row)
		local button = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(88, 32),
			BackgroundColor3 = SELECTED, Font = FONT, TextSize = 14, TextColor3 = WHITE, Text = "", ZIndex = 7 }, row)
		rounded(button, 8)
		rows[item.key] = { button = button, kind = "use", item = item }
		button.Activated:Connect(function()
			local kind = rows[item.key].kind
			if kind == "use" then
				if item.kind == "skin" then
					options.request:FireServer("setSkin", item.key)
					message.Text = "The mountain is turning into " .. item.name .. "."
				else
					options.request:FireServer("setTheme", item.key)
					message.Text = item.name .. " is going on the map."
				end
			elseif kind == "buy" then
				local pass = ThemeShop.pass(item.key, Config.ThemePasses)
				if pass then
					message.Text = ""
					local ok = pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, pass)
					if not ok then message.Text = "Roblox couldn't open the purchase. Try again in a moment." end
				end
			end
		end)
		-- Its price, asked of Roblox once.
		local pass = ThemeShop.pass(item.key, Config.ThemePasses)
		if pass then
			task.spawn(function()
				local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, pass, Enum.InfoType.GamePass)
				if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
					prices[item.key] = info.PriceInRobux
					refreshRows()
				end
			end)
		end
	end
	-- The map's themes, then the mountain's skins in a section of their own.
	section(0, "MAP THEMES")
	for index, theme in ThemeShop.THEMES do addRow(index, theme) end
	section(100, "MOUNTAIN SKINS  ·  same game, reskinned")
	for index, skin in ThemeShop.SKINS do addRow(100 + index, skin) end
	for _, name in { "Theme", "Skin" } do
		options.state:GetAttributeChangedSignal(name):Connect(function()
			refreshRows()
			message.Text = ""
		end)
	end
	player:GetAttributeChangedSignal("OwnedThemes"):Connect(refreshRows)
	refreshRows()

	setThemesOpenHandler = function(show: boolean)
		themesOpen = show
		card.Visible = show
		if show then message.Text = "" end
	end
	closeCard.Activated:Connect(function() setThemesOpenHandler(false) end)
end

return Sidebar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Sound effects for every game: digging, the gift shows (Diamond in the
-- Rough's blasts and rebuilds, Diamond Climb's rides, Chalkboard Count's
-- gifts) and the chalk being written. Every sound is one that ships with the
-- Roblox client (rbxasset://sounds), so nothing has to be uploaded or made
-- public; each cue layers a few of them at different pitches to make the
-- sound. To use your own uploads instead, change the ids in FILES.
--
-- Sounds.play(cue, at?, scale?, pitch?) plays a cue: at a point in the world
-- (it fades with distance) or, without one, straight to the player. `scale`
-- (default 1) makes it louder and deeper for bigger gifts; `pitch` (default 1)
-- raises or lowers every layer (digging climbs a little with each hit). The same cue is
-- not started again within a few hundredths of a second, and only so many
-- sounds play at once, so a hundred sparks never make a hundred sounds.
local SoundService = game:GetService("SoundService")

local Sounds = {}

Sounds.FILES = {
	crunch = "rbxasset://sounds/collide.wav",
	hit = "rbxasset://sounds/hit.wav",
	snap = "rbxasset://sounds/snap.wav",
	click = "rbxasset://sounds/clickfast.wav",
	button = "rbxasset://sounds/button.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	glass = "rbxasset://sounds/glassbreak.wav",
	splash = "rbxasset://sounds/impact_water.mp3",
	splat = "rbxasset://sounds/splat.wav",
	land = "rbxasset://sounds/action_jump_land.mp3",
	jump = "rbxasset://sounds/action_jump.mp3",
	fall = "rbxasset://sounds/action_falling.mp3",
	victory = "rbxasset://sounds/victory.wav",
	plunk = "rbxasset://sounds/Kerplunk.wav",
	rocket = "rbxasset://sounds/Rocket shot.wav",
	page = "rbxasset://sounds/pageturn.wav",
}

-- A layer: which file, how loud, its pitch (a range picks one at random),
-- and how long after the cue starts it plays.
export type Layer = { file: string, volume: number, pitch: { number }, delay: number? }

Sounds.CUES = {
	-- Digging: a short, crisp chip, like a chisel flicking a flake off the
	-- rock, and a few grains trickling away. Only small clicks and cracks,
	-- with no thump, crunch or blast, so holding dig stays light. (A sound of
	-- your own: Config.DigSoundId.)
	dig = {
		{ file = "snap", volume = 0.14, pitch = { 1.7, 2.0 } },
		{ file = "click", volume = 0.1, pitch = { 1.9, 2.3 } },
		{ file = "click", volume = 0.05, pitch = { 1.4, 1.7 }, delay = 0.05 },
		{ file = "click", volume = 0.035, pitch = { 1.6, 2.0 }, delay = 0.1 },
	},
	-- Every fourth hit a flake breaks off: a lower crack and grains trickling.
	crumble = {
		{ file = "snap", volume = 0.12, pitch = { 1.25, 1.4 } },
		{ file = "click", volume = 0.05, pitch = { 1.3, 1.5 }, delay = 0.07 },
		{ file = "click", volume = 0.04, pitch = { 1.5, 1.7 }, delay = 0.13 },
		{ file = "click", volume = 0.03, pitch = { 1.7, 2.0 }, delay = 0.2 },
	},
	-- Gift shows.
	pop = {
		{ file = "snap", volume = 0.5, pitch = { 1.1, 1.3 } },
		{ file = "ping", volume = 0.25, pitch = { 1.6, 1.9 }, delay = 0.02 },
	},
	sparkle = { { file = "ping", volume = 0.3, pitch = { 2, 2.6 } } },
	rubble = {
		{ file = "crunch", volume = 0.45, pitch = { 0.5, 0.65 } },
		{ file = "click", volume = 0.18, pitch = { 0.5, 0.7 }, delay = 0.06 },
		{ file = "click", volume = 0.14, pitch = { 0.7, 0.9 }, delay = 0.14 },
	},
	-- The impacts at the end of the gift shows: a deep whump, a crack and a
	-- sparkly tinkle (no explosion).
	boom = {
		{ file = "whoosh", volume = 0.45, pitch = { 0.5, 0.6 } },
		{ file = "snap", volume = 0.3, pitch = { 0.7, 0.85 } },
		{ file = "glass", volume = 0.12, pitch = { 1.4, 1.6 }, delay = 0.04 },
	},
	bigBoom = {
		{ file = "whoosh", volume = 0.55, pitch = { 0.38, 0.45 } },
		{ file = "snap", volume = 0.35, pitch = { 0.55, 0.65 } },
		{ file = "glass", volume = 0.2, pitch = { 1.1, 1.25 }, delay = 0.05 },
		{ file = "ping", volume = 0.18, pitch = { 1.8, 2.1 }, delay = 0.12 },
	},
	thud = {
		{ file = "land", volume = 0.6, pitch = { 0.6, 0.8 } },
		{ file = "crunch", volume = 0.35, pitch = { 0.55, 0.7 } },
	},
	rumble = {
		{ file = "whoosh", volume = 0.4, pitch = { 0.32, 0.38 } },
		{ file = "whoosh", volume = 0.3, pitch = { 0.4, 0.45 }, delay = 0.35 },
	},
	whoosh = { { file = "whoosh", volume = 0.5, pitch = { 0.8, 1.1 } } },
	deepWhoosh = { { file = "whoosh", volume = 0.7, pitch = { 0.4, 0.55 } } },
	shatter = {
		{ file = "glass", volume = 0.55, pitch = { 0.9, 1.15 } },
		{ file = "ping", volume = 0.2, pitch = { 2.4, 2.8 }, delay = 0.05 },
	},
	beam = {
		{ file = "rocket", volume = 0.4, pitch = { 0.6, 0.75 } },
		{ file = "ping", volume = 0.25, pitch = { 0.5, 0.6 } },
	},
	zap = {
		{ file = "snap", volume = 0.5, pitch = { 0.6, 0.7 } },
		{ file = "ping", volume = 0.25, pitch = { 0.8, 0.9 } },
	},
	clang = {
		{ file = "hit", volume = 0.8, pitch = { 0.45, 0.55 } },
		{ file = "hit", volume = 0.5, pitch = { 0.9, 1 }, delay = 0.03 },
	},
	boing = {
		{ file = "jump", volume = 0.7, pitch = { 0.7, 0.8 } },
		{ file = "whoosh", volume = 0.35, pitch = { 1.3, 1.5 }, delay = 0.05 },
	},
	launch = {
		{ file = "rocket", volume = 0.7, pitch = { 0.9, 1.05 } },
		{ file = "whoosh", volume = 0.45, pitch = { 0.7, 0.8 }, delay = 0.1 },
	},
	slip = {
		{ file = "whoosh", volume = 0.5, pitch = { 1.4, 1.6 } },
		{ file = "plunk", volume = 0.45, pitch = { 1, 1.1 }, delay = 0.25 },
	},
	falling = { { file = "fall", volume = 0.55, pitch = { 0.9, 1.1 } } },
	splash = {
		{ file = "splash", volume = 0.6, pitch = { 0.9, 1.1 } },
		{ file = "splat", volume = 0.4, pitch = { 0.8, 1 } },
	},
	splat = { { file = "splat", volume = 0.6, pitch = { 0.9, 1.15 } } },
	cheer = {
		{ file = "victory", volume = 0.6, pitch = { 1, 1 } },
	},
	-- Chalk on the board: a short scratch per stroke, a tap per number.
	chalk = {
		{ file = "whoosh", volume = 0.12, pitch = { 2.6, 3.2 } },
		{ file = "click", volume = 0.05, pitch = { 1.6, 2 } },
	},
	erase = {
		{ file = "whoosh", volume = 0.35, pitch = { 0.6, 0.75 } },
		{ file = "page", volume = 0.2, pitch = { 0.7, 0.9 } },
	},
	-- The hold countdowns: a tick each number, and a rising chime at the end.
	tick = { { file = "click", volume = 0.35, pitch = { 1.2, 1.2 } } },
	chime = {
		{ file = "ping", volume = 0.4, pitch = { 1, 1 } },
		{ file = "ping", volume = 0.4, pitch = { 1.26, 1.26 }, delay = 0.12 },
		{ file = "ping", volume = 0.4, pitch = { 1.5, 1.5 }, delay = 0.24 },
	},
} :: { [string]: { Layer } }

Sounds.MAX_PLAYING = 24 -- sounds at once
Sounds.REPEAT_SECONDS = 0.045 -- the same cue is not restarted sooner than this
Sounds.HEARD_FROM = 260 -- studs: a cue in the world fades out by this far away
Sounds.LONGEST_SECONDS = 4 -- the longest file, at normal speed
-- Gift shows and other effects play at this share of their volume; digging,
-- the chalk and the countdown's ticks (already quiet) play in full.
Sounds.EFFECTS_VOLUME = 0.5
Sounds.FULL_VOLUME = { dig = true, crumble = true, chalk = true, tick = true }

local playing = 0
local lastPlayed: { [string]: number } = {}
local muted = false

-- Uses a sound of your own for digging (an audio id from the Creator Store or
-- your uploads, as a number or "rbxassetid://..."), in place of the built-in
-- chip. An empty id keeps the built-in one.
function Sounds.useDigSound(id: string, volume: number?)
	local digits = string.match(id or "", "(%d+)")
	if digits == nil then return end
	Sounds.FILES.customDig = "rbxassetid://" .. digits
	Sounds.CUES.dig = { { file = "customDig", volume = math.clamp(volume or 0.5, 0, 2), pitch = { 0.95, 1.05 } } }
	Sounds.CUES.crumble = {}
end

-- The pitch of the `streak`th hit in a row: up a small step each hit, eight
-- steps, then round again.
function Sounds.digPitch(streak: number): number
	return 1 + ((math.max(1, math.floor(streak)) - 1) % 8) * 0.025
end

-- How many sounds are playing now.
function Sounds.playingCount(): number
	return playing
end

-- Turns every sound off (or back on).
function Sounds.setMuted(value: boolean)
	muted = value
end

local function startLayer(layer: Layer, at: Vector3?, scale: number, shift: number, level: number)
	if playing >= Sounds.MAX_PLAYING then return end
	local file = Sounds.FILES[layer.file]
	if file == nil then return end
	local low, high = layer.pitch[1], layer.pitch[2] or layer.pitch[1]
	local pitch = (low + (high - low) * math.random()) / math.sqrt(math.max(scale, 0.25)) * shift
	local sound = Instance.new("Sound")
	sound.SoundId = file
	sound.Volume = math.min(2, layer.volume * math.sqrt(scale) * level)
	sound.PlaybackSpeed = math.clamp(pitch, 0.2, 4)
	local holder: Instance
	if at then
		local spot = Instance.new("Attachment")
		spot.Position = at
		spot.Parent = workspace.Terrain
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 30 * scale
		sound.RollOffMaxDistance = Sounds.HEARD_FROM * math.max(1, scale)
		holder = spot
	else
		holder = SoundService
	end
	sound.Parent = holder
	playing += 1
	-- Its place is free again the moment it finishes, so holding dig (a dozen
	-- short sounds a second) never fills every place and cuts sounds out. A
	-- sound that never finishes (it failed to load) goes after the longest a
	-- file could take.
	local done = false
	local function finish()
		if done then return end
		done = true
		playing -= 1
		if holder ~= SoundService then holder:Destroy() else sound:Destroy() end
	end
	sound.Ended:Connect(finish)
	sound:Play()
	task.delay(Sounds.LONGEST_SECONDS / sound.PlaybackSpeed + 0.5, finish)
end

-- Plays cue `name`: at `at` in the world, or to the player when `at` is nil.
function Sounds.play(name: string, at: Vector3?, scale: number?, pitch: number?)
	if muted then return end
	local cue = Sounds.CUES[name]
	if cue == nil then return end
	local now = os.clock()
	if now - (lastPlayed[name] or -math.huge) < Sounds.REPEAT_SECONDS then return end
	lastPlayed[name] = now
	local size = scale or 1
	local shift = math.clamp(pitch or 1, 0.25, 4)
	local level = if Sounds.FULL_VOLUME[name] then 1 else Sounds.EFFECTS_VOLUME
	for _, layer in cue do
		if layer.delay and layer.delay > 0 then
			task.delay(layer.delay, function()
				pcall(startLayer, layer, at, size, shift, level)
			end)
		else
			pcall(startLayer, layer, at, size, shift, level)
		end
	end
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[--!strict
-- Sprinting: hold Shift (or press the left stick on a controller, or hold the
-- Run button on a phone) to move Config.SprintMultiplier times faster.
--
-- The server sets each character's walking speed (the usual 16, Diamond
-- Climb's speed slider, 0 while holding the diamond or writing on the
-- chalkboard), so sprinting multiplies whatever that speed is rather than
-- replacing it: any change this module didn't make itself becomes the new
-- walking speed. Changes are recognised by their value, not by a "this was
-- me" flag, because Roblox may deliver the change signal after the change
-- (deferred signals), when such a flag would already be cleared.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("DiamondRush")
local Config = require(Shared:WaitForChild("Config"))

local Sprint = {}

Sprint.MULTIPLIER = Config.SprintMultiplier
Sprint.ACTION = "DiamondRushSprint"

-- The speed to move at: the walking speed, or faster while sprinting.
function Sprint.speed(walking: number, sprinting: boolean): number
	return if sprinting then walking * Sprint.MULTIPLIER else walking
end

export type Walker = { WalkSpeed: number }
export type Controller = {
	attach: (walker: Walker?) -> (),
	setHeld: (held: boolean) -> (),
	changed: () -> (),
	walking: () -> number,
	held: () -> boolean,
}

-- Keeps one character's speed: `attach` a new humanoid, `setHeld` as the
-- sprint key goes down and up, and `changed` whenever its WalkSpeed changes.
function Sprint.controller(): Controller
	local walker: Walker? = nil
	local walking = 16
	local held = false
	local self = {} :: Controller

	local function apply()
		local current = walker
		if current == nil then return end
		local want = Sprint.speed(walking, held)
		if math.abs(current.WalkSpeed - want) > 1e-3 then current.WalkSpeed = want end
	end

	function self.attach(next: Walker?)
		walker = next
		if next then walking = next.WalkSpeed end
		apply()
	end

	function self.setHeld(value: boolean)
		if value == held then return end
		held = value
		apply()
	end

	function self.changed()
		local current = walker
		if current == nil then return end
		-- The speed this module set itself: nothing to do.
		if math.abs(current.WalkSpeed - Sprint.speed(walking, held)) <= 1e-3 then return end
		-- Someone else set it (the server, or Diamond Climb's slider): that's
		-- the walking speed now, and sprinting goes on from there.
		walking = current.WalkSpeed
		apply()
	end

	function self.walking(): number return walking end
	function self.held(): boolean return held end
	return self
end

function Sprint.start()
	local player = Players.LocalPlayer
	local control = Sprint.controller()
	local watching: RBXScriptConnection? = nil

	local function onCharacter(character: Model)
		if watching then watching:Disconnect() end
		watching = nil
		control.attach(nil)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid == nil or not humanoid:IsA("Humanoid") or character.Parent == nil then return end
		control.attach(humanoid :: any) -- a Humanoid has the WalkSpeed a Walker needs
		watching = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(control.changed)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then task.spawn(onCharacter, player.Character) end

	-- Shift (either one), the left stick's click, or the on-screen Run button.
	-- The keys still reach everything else (Pass), so Shift Lock and Shift
	-- gift keys keep working.
	ContextActionService:BindAction(Sprint.ACTION, function(_name: string, state: Enum.UserInputState, _input: InputObject)
		if state == Enum.UserInputState.Begin then
			control.setHeld(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			control.setHeld(false)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle(Sprint.ACTION, "Run")
	ContextActionService:SetPosition(Sprint.ACTION, UDim2.new(1, -170, 1, -90))
	-- Letting go while the window wasn't focused never reaches the action.
	UserInputService.WindowFocusReleased:Connect(function() control.setHeld(false) end)
end

return Sprint
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="69">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Terrain" referent="70">
      <Properties>
        <string name="Name">Terrain</string>
        <bool name="Decoration">true</bool>
        <float name="GrassLength">0.75</float>
      </Properties>
    </Item>
  </Item>
</roblox>