          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Everything a streamer may want to tune. Values marked (live) can also be
-- changed in-game from the settings panel; the panel's values are saved.
local Config = {
	-- Stone -----------------------------------------------------------------
	StartingStone = 250000, -- (live) rocks in the mountain at the start of a round (one rock = one stone, max 1,500,000)
	StonePerCoin = 100, -- (live) rocks removed per TikTok coin, for gifts without their own rule
	-- (live) Gift rules: gift name -> rocks removed per gift. Change them in the
	-- settings panel (press Y) while playing.
	GiftRules = {} :: { [string]: number },
	StonePerLike = 2, -- (live)
	StonePerFollow = 500, -- (live)
	StonePerShare = 300, -- (live)

	-- The diamond -----------------------------------------------------------
	HoldSeconds = 15, -- real seconds the diamond must be held to win
	HoldCountFrom = 10, -- the number the on-screen countdown starts at
	HoldSlowdown = 0.6, -- 0 = steady countdown, 1 = slows down a lot near the end
	WinScreenSeconds = 4,

	-- Win counter defaults (all live) ----------------------------------------
	WinTitle = "WINS",
	WinGoal = 0, -- 0 hides the goal ("WINS: 3" instead of "WINS: 3/10")
	WinTextColor = "#FFFFFF",
	WinBackgroundColor = "#2B2140",

	-- Rocks -----------------------------------------------------------------------
	BlockSize = 0.4, -- diggable cell size in studs; irregular rock chips overlap its edges
	DigPerSecond = 100, -- rocks dug per second while the dig button is held

	-- TikTok ------------------------------------------------------------------
	BridgeUrls = { "http://localhost:8787", "http://127.0.0.1:8787" }, -- the bridge app (Roblox Studio)
	MessagingTopic = "DiamondRushTikTok", -- Open Cloud topic (published games)

	-- Extra Roblox user ids allowed to change settings (the owner always can).
	Admins = {} :: { number },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
local Format = {}

-- 250000 -> "250,000"
function Format.commas(n: number): string
	local whole = math.floor(math.abs(n) + 0.5)
	local digits = tostring(whole)
	local out = ""
	while #digits > 3 do
		out = "," .. string.sub(digits, -3) .. out
		digits = string.sub(digits, 1, -4)
	end
	return (if n < 0 and whole > 0 then "-" else "") .. digits .. out
end

-- 83.46 -> "1:23.5"; an hour or more -> "1:02:03.0"
function Format.duration(seconds: number): string
	local tenths = math.floor(math.max(0, seconds) * 10 + 0.5)
	local hours = tenths // 36000
	local minutes = (tenths // 600) % 60
	local secs = (tenths % 600) / 10
	if hours > 0 then
		return string.format("%d:%02d:%04.1f", hours, minutes, secs)
	end
	return string.format("%d:%04.1f", minutes, secs)
end

-- "#FF8800" or "FF8800" -> 255, 136, 0 (nil if it is not a colour)
function Format.parseHex(text: string): (number?, number?, number?)
	local hex = string.match(string.upper(text), "^%s*#?(%x%x%x%x%x%x)%s*$")
	if hex == nil then
		return nil, nil, nil
	end
	return tonumber(string.sub(hex, 1, 2), 16), tonumber(string.sub(hex, 3, 4), 16), tonumber(string.sub(hex, 5, 6), 16)
end

-- The win counter text: "WINS: 3" or "WINS: 3/10" when a goal is set.
function Format.wins(title: string, wins: number, goal: number): string
	local label = if title == "" then "" else title .. ": "
	if goal > 0 then
		return label .. tostring(wins) .. "/" .. tostring(goal)
	end
	return label .. tostring(wins)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">HoldTimer</string>
          <string name="Source"><![CDATA[--!strict
-- The diamond must be held for HoldSeconds of real time, but the screen counts
-- down from HoldCountFrom (10). The count runs quickly at first and slows near
-- the end, so the last numbers hang on screen for longer.
local HoldTimer = {}

-- How much of the on-screen countdown has passed after a fraction p of the real
-- hold time. slowdown 0 is linear; 1 is a full ease-out (4x slower at the end).
function HoldTimer.progress(p: number, slowdown: number): number
	p = math.clamp(p, 0, 1)
	slowdown = math.clamp(slowdown, 0, 1)
	return (1 - slowdown) * p + slowdown * (1 - (1 - p) * (1 - p))
end

-- The whole number to show after `elapsed` real seconds: countFrom at the start,
-- never below 1 until the hold is complete, then 0.
function HoldTimer.display(elapsed: number, holdSeconds: number, countFrom: number, slowdown: number): number
	if elapsed >= holdSeconds then
		return 0
	end
	local shown = countFrom * (1 - HoldTimer.progress(elapsed / holdSeconds, slowdown))
	return math.max(1, math.ceil(shown - 1e-9))
end

return HoldTimer
]]></string>
        </Properties>
      </Item>
    </Item>
