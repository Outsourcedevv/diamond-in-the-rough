}, gui)
outline(status, 1)

-- Gift feed (bottom left) -------------------------------------------------------------
local feed = make("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 12, 1, -12),
	Size = UDim2.fromOffset(440, 300),
	BackgroundTransparency = 1,
}, gui)
make("UIListLayout", {
	VerticalAlignment = Enum.VerticalAlignment.Bottom,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Padding = UDim.new(0, 6),
}, feed)
local feedOrder = 0

local function addFeed(text: string, stone: number, kind: string)
	feedOrder += 1
	local colour = if kind == "gift" then GOLD elseif kind == "follow" then Color3.fromRGB(255, 120, 170) else Color3.fromRGB(170, 220, 255)
	local row = make("TextLabel", {
		LayoutOrder = feedOrder,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.25,
		Font = FONT,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = WHITE,
		RichText = true,
		Text = if stone > 0
			then string.format('%s  <font color="#%s">-%s</font>', (text:gsub("[<>&]", "")), colour:ToHex(), Format.commas(stone))
			else (text:gsub("[<>&]", "")),
	}, feed)
	rounded(row, 10)
	make("UIPadding", { PaddingLeft = UDim.new(0, 12) }, row)
	local rows = {}
	for _, child in feed:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(rows, child)
		end
	end
	table.sort(rows, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #rows - 6 do
		rows[index]:Destroy()
	end
	task.delay(7, function()
		if row.Parent then
			local fade = TweenService:Create(row, TweenInfo.new(0.6), { BackgroundTransparency = 1, TextTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			row:Destroy()
		end
	end)
end

-- Win screen --------------------------------------------------------------------------
local winScreen = make("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(10, 8, 20),
	BackgroundTransparency = 0.25,
	Visible = false,
	ZIndex = 20,
}, gui)
local winCard = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(620, 360),
	BackgroundColor3 = PANEL,
	ZIndex = 21,
}, winScreen)
rounded(winCard, 24)
make("UIStroke", { Thickness = 4, Color = Color3.fromRGB(150, 240, 255) }, winCard)
local winScale = make("UIScale", { Scale = 1 }, winCard)
local function winLine(y: number, height: number, size: number, colour: Color3): TextLabel
	return make("TextLabel", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = size,
		TextColor3 = colour,
		Text = "",
		ZIndex = 22,
	}, winCard)
end
local winTitle = winLine(24, 64, 56, Color3.fromRGB(150, 240, 255))
local winWho = winLine(92, 40, 30, WHITE)
local winTime = winLine(160, 50, 40, WHITE)
local winBest = winLine(216, 50, 40, GOLD)
local winNewBest = winLine(282, 44, 34, Color3.fromRGB(120, 255, 150))

local function showWin(data: { [string]: any })
	winTitle.Text = "💎 DIAMOND SECURED!"
	winWho.Text = tostring(data.winner or "") .. " wins!"
	winTime.Text = "This round's time: " .. Format.duration(tonumber(data.time) or 0)
	winBest.Text = "Best round's time: " .. Format.duration(tonumber(data.best) or 0)
	winNewBest.Text = if data.newBest then "⭐ NEW BEST! ⭐" else ""
	winScreen.Visible = true
	winScale.Scale = 0.6
	TweenService:Create(winScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(Config.WinScreenSeconds, function()
		winScreen.Visible = false
	end)
end

-- Settings panel (owner / admins only) ------------------------------------------------------
local panel = make("ScrollingFrame", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 92),
	Size = UDim2.fromOffset(340, 520),
	CanvasSize = UDim2.fromOffset(0, 0),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 6,
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.05,
	Visible = false,
	ZIndex = 10,
}, gui)
rounded(panel, 14)
make("UIPadding", {
	PaddingLeft = UDim.new(0, 12),
	PaddingRight = UDim.new(0, 14),
	PaddingTop = UDim.new(0, 10),
	PaddingBottom = UDim.new(0, 12),
}, panel)
make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, panel)
local panelOrder = 0

local function panelLabel(text: string)
	panelOrder += 1
	make("TextLabel", {
		LayoutOrder = panelOrder,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(200, 195, 215),
		Text = text,
		ZIndex = 11,
	}, panel)
end

local function panelBox(text: string, onSubmit: (string) -> ()): TextBox
	panelOrder += 1
	local box = make("TextBox", {
		LayoutOrder = panelOrder,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(50, 44, 68),
		Font = Enum.Font.GothamMedium,
		TextSize = 17,
		TextColor3 = WHITE,
		ClearTextOnFocus = false,
		Text = text,
		ZIndex = 11,
	}, panel)
	rounded(box, 8)
	box.FocusLost:Connect(function()
		onSubmit(box.Text)
	end)
	return box
end

local function panelButtons(buttons: { { any } })
	panelOrder += 1
	local row = make("Frame", {
		LayoutOrder = panelOrder,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 11,
	}, panel)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, row)
	for _, spec in buttons do
		local button = make("TextButton", {
			Size = UDim2.new(1 / #buttons, -6, 1, 0),
			BackgroundColor3 = Color3.fromRGB(90, 70, 150),
			Font = FONT,
			TextSize = 16,
			TextColor3 = WHITE,
			Text = spec[1],
			ZIndex = 12,
		}, row)
		rounded(button, 8)
		button.Activated:Connect(spec[2])
	end
end

local function send(action: string, value: any)
	Request:FireServer(action, value)
end

panelLabel("WIN COUNTER TITLE")
local titleBox = panelBox("", function(text)
	send("setTitle", text)
end)
panelLabel("WINS")
local winsInput = panelBox("", function(text)
	local number = tonumber(text)
	if number then
		send("setWins", number)
	end
end)
panelButtons({
	{ "-1", function() send("addWins", -1) end },
	{ "+1", function() send("addWins", 1) end },
	{ "Reset to 0", function() send("setWins", 0) end },
})
panelLabel("GOAL (0 = no goal)")
local goalBox = panelBox("", function(text)
	local number = tonumber(text)
	if number then
		send("setGoal", number)
	end
end)
panelLabel("TEXT COLOUR (#RRGGBB)")
local textColourBox = panelBox("", function(text)
	send("setTextColor", text)
end)
panelLabel("BACKGROUND COLOUR (#RRGGBB)")
local backgroundBox = panelBox("", function(text)
	send("setBackgroundColor", text)
end)
panelButtons({
	{ "Show / hide counter", function() send("setShowWins", not attr("ShowWins", true)) end },
})
panelLabel("STARTING STONE (next round)")
local stoneBoxInput = panelBox("", function(text)
	local number = tonumber((string.gsub(text, "[,%s]", "")))
	if number then
		send("setStartingStone", number)
	end
end)
panelButtons({
	{ "New round", function() send("newRound") end },
	{ "Reset best time", function() send("resetBest") end },
})
panelLabel("ROCKS PER COIN (gifts without a rule)")
local perCoinBox = panelBox("", function(text)
	local number = tonumber((string.gsub(text, "[,%s]", "")))
	if number then
		send("setPerCoin", number)
	end
end)
panelLabel("ROCKS PER LIKE / FOLLOW / SHARE")
local function amountBox(action: string): TextBox
	return panelBox("", function(text)
		local number = tonumber((string.gsub(text, "[^%d]", "")))
		if number then
			send(action, number)
		end
	end)
end
local perLikeBox = amountBox("setPerLike")
local perFollowBox = amountBox("setPerFollow")
local perShareBox = amountBox("setPerShare")

panelLabel("GIFT RULES (rocks removed per gift)")
panelOrder += 1
local rulesList = make("Frame", {
	LayoutOrder = panelOrder,
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 11,
}, panel)
make("UIListLayout", { SortOrder = Enum.SortOrder.Name, Padding = UDim.new(0, 4) }, rulesList)
local newGiftName = panelBox("", function() end)
newGiftName.PlaceholderText = "Gift name, e.g. Rose"
local newGiftRocks = panelBox("", function() end)
newGiftRocks.PlaceholderText = "Rocks removed per gift, e.g. 500"
panelButtons({
	{ "Add / change gift rule", function()
		local rocks = tonumber((string.gsub(newGiftRocks.Text, "[,%s]", "")))
		if newGiftName.Text ~= "" and rocks then
			send("setGiftRule", { gift = newGiftName.Text, rocks = rocks })
			newGiftName.Text = ""
			newGiftRocks.Text = ""
		end
	end },
})

local function refreshRules()
	for _, child in rulesList:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local ok, rules = pcall(function()
		return game:GetService("HttpService"):JSONDecode(attr("GiftRules", "{}"))
	end)
	if not ok or type(rules) ~= "table" then
		return
	end
	for name, rocks in rules do
		local row = make("Frame", { Name = tostring(name), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, ZIndex = 11 }, rulesList)
		make("TextLabel", {
			Size = UDim2.new(1, -40, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = WHITE,
			Text = string.format("%s → %s rocks", tostring(name), Format.commas(tonumber(rocks) or 0)),
			ZIndex = 12,
		}, row)
		local remove = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(34, 30),
			BackgroundColor3 = Color3.fromRGB(150, 60, 70),
			Font = FONT,
			TextSize = 16,
			TextColor3 = WHITE,
			Text = "✕",
			ZIndex = 12,
		}, row)
		rounded(remove, 8)
		remove.Activated:Connect(function()
			send("setGiftRule", { gift = tostring(name) })
		end)
	end
end
State:GetAttributeChangedSignal("GiftRules"):Connect(refreshRules)
refreshRules()

panelLabel("TEST GIFTS (no TikTok needed)")
panelButtons({
	{ "Rose 1", function() send("testGift", { coins = 1, count = 1, name = "Rose" }) end },
	{ "Donut 30", function() send("testGift", { coins = 30, count = 1, name = "Doughnut" }) end },
})
panelButtons({
	{ "Galaxy 1000", function() send("testGift", { coins = 1000, count = 1, name = "Galaxy" }) end },
	{ "Universe", function() send("testGift", { coins = 34999, count = 1, name = "TikTok Universe" }) end },
})

local function refreshPanelFields()
	titleBox.Text = attr("WinTitle", "WINS")
	winsInput.Text = tostring(attr("Wins", 0))
	goalBox.Text = tostring(attr("WinGoal", 0))
	textColourBox.Text = attr("WinTextColor", "#FFFFFF")
	backgroundBox.Text = attr("WinBackgroundColor", "#2B2140")
	stoneBoxInput.Text = Format.commas(attr("NextStartingStone", Config.StartingStone))
	perCoinBox.Text = tostring(attr("PerCoin", Config.StonePerCoin))
	perLikeBox.Text = "Like: " .. tostring(attr("PerLike", Config.StonePerLike))
	perFollowBox.Text = "Follow: " .. tostring(attr("PerFollow", Config.StonePerFollow))
	perShareBox.Text = "Share: " .. tostring(attr("PerShare", Config.StonePerShare))
end

-- The settings panel is hidden: the owner presses Y to open or close it.
local isAdmin = false
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= Enum.KeyCode.Y or not isAdmin then
		return
	end
	panel.Visible = not panel.Visible
	if panel.Visible then
		refreshPanelFields()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)
RunService.RenderStepped:Connect(function()
	-- First person locks the mouse; free it while the panel is open.
	if panel.Visible then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end)

local function refreshAdmin()
	isAdmin = player:GetAttribute("DiamondRushAdmin") == true
	if not isAdmin then
		panel.Visible = false
	end
end
player:GetAttributeChangedSignal("DiamondRushAdmin"):Connect(refreshAdmin)
refreshAdmin()

-- Live updates ---------------------------------------------------------------------------
local function refreshWins()
	winsBox.Visible = attr("ShowWins", true)
	winsBox.Text = Format.wins(attr("WinTitle", "WINS"), attr("Wins", 0), attr("WinGoal", 0))
	winsBox.TextColor3 = hexColor(attr("WinTextColor", "#FFFFFF"), WHITE)
	winsBox.BackgroundColor3 = hexColor(attr("WinBackgroundColor", "#2B2140"), PANEL)
	winsStroke.Color = winsBox.TextColor3:Lerp(GOLD, 0.6)
	if panel.Visible then
		refreshPanelFields()
	end
end
for _, name in { "Wins", "WinTitle", "WinGoal", "WinTextColor", "WinBackgroundColor", "ShowWins", "NextStartingStone" } do
	State:GetAttributeChangedSignal(name):Connect(refreshWins)
end
refreshWins()

local shownStone = attr("Stone", Config.StartingStone)
local lastCount = -1

RunService.RenderStepped:Connect(function(dt: number)
	-- The stone number rolls towards its new value instead of jumping.
	local stone = attr("Stone", 0)
	local starting = math.max(1, attr("StartingStone", Config.StartingStone))
	shownStone += (stone - shownStone) * math.min(1, dt * 10)
	if math.abs(stone - shownStone) < 1 then
		shownStone = stone
	end
	stoneValue.Text = Format.commas(shownStone)
	barFill.Size = UDim2.fromScale(math.clamp(shownStone / starting, 0, 1), 1)

	local phase = attr("Phase", "Digging")
	-- The hold counter takes the top-centre slot; the hand and gem stay unobscured.
	stoneBox.Visible = phase ~= "Holding"
	timerLabel.Visible = phase ~= "Holding"
	local now = workspace:GetServerTimeNow()
	local roundStart = attr("RoundStart", now)
	timerLabel.Text = "⏱ " .. Format.duration(if phase == "Won" then attr("LastTime", 0) else now - roundStart)
	status.Text = "TikTok: " .. tostring(attr("TikTok", ""))

	if phase == "Holding" then
		local elapsed = now - attr("HoldStart", now)
		local shown = HoldTimer.display(elapsed, Config.HoldSeconds, Config.HoldCountFrom, Config.HoldSlowdown)
		countdown.Visible = true
		countHolder.Text = "💎 " .. tostring(attr("Holder", "")) .. " — HOLD IT!"
		countNumber.Text = tostring(shown)
		if shown ~= lastCount then
			lastCount = shown
			countNumber.TextColor3 = WHITE:Lerp(GOLD, 1 - shown / Config.HoldCountFrom)
			countScale.Scale = 1.35
			TweenService:Create(countScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
		banner.Visible = false
	else
		countdown.Visible = false
		lastCount = -1
		banner.Visible = phase == "Revealed"
		if phase == "Revealed" then
			banner.Text = "DIAMOND UNCOVERED — FIND IT AND CLICK IT"
			banner.TextTransparency = 0.25 + 0.25 * math.sin(now * 6)
		end
	end
end)

Notify.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "feed" and type(data) == "table" then
		addFeed(tostring(data.text), tonumber(data.stone) or 0, tostring(data.kind))
	elseif kind == "win" and type(data) == "table" then
		showWin(data)
	elseif kind == "dropped" and type(data) == "table" and data.name ~= "" then
		addFeed(tostring(data.name) .. " dropped the diamond!", 0, "drop")
	end
end)

-- Digging: hold the dig button (left mouse / touch) and your hands tear
-- through the rock you aim at, about DigPerSecond rocks a second.
local mouse = player:GetMouse()
local digging = false
local digClock = 0
local function isDigInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if not processed and isDigInput(input) then
		-- A fresh click on the diamond goes to its ClickDetector, never to digging.
		if mouse.Target == workspace:FindFirstChild("Diamond") then
			digging = false
			return
		end
		digging = true
		digClock = 1
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if isDigInput(input) then
		digging = false
	end
end)
UserInputService.WindowFocusReleased:Connect(function()
	digging = false
end)
RunService.Heartbeat:Connect(function(dt: number)
	local phase = attr("Phase", "Digging")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local target = mouse.Target
	local allowed = digging and not panel.Visible and phase ~= "Won"
		and not (phase == "Holding" and attr("HolderUserId", 0) == player.UserId)
	local onRock = allowed and root ~= nil and root:IsA("BasePart")
		and target ~= nil and target.Name == "Stone"
		and (root.Position - target.Position).Magnitude <= 16
	player:SetAttribute("DiggingRock", onRock == true)
	if not allowed then
		return
	end
	digClock += dt
	if digClock < 0.1 then
		return
	end
	digClock = 0
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool == nil and mouse.Target ~= nil and mouse.Target.Name == "Stone" then
		Request:FireServer("mine", mouse.Target)
	end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">FirstPerson</string>
            <string name="Source"><![CDATA[--!strict
-- First-person view with two hands in front of the camera (like the PC game).
-- The hands follow the camera, bob while walking and swing when you click.
-- Alternating hands reach, curl around stone and rake rubble back.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")


local FirstPerson = {}

local SKIN_FALLBACK = Color3.fromRGB(234, 184, 146)
local SLEEVE = Color3.fromRGB(70, 82, 70)

local function part(name: string, size: Vector3, colour: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = colour
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

function FirstPerson.start()
	local player = Players.LocalPlayer
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5

	local rig = Instance.new("Model")
	rig.Name = "FirstPersonHands"
	local hands = {}
	for _, side in { -1, 1 } do
		local sleeve = part("Sleeve", Vector3.new(0.42, 0.42, 1.5), SLEEVE, Enum.Material.Fabric)
		local hand = part("Hand", Vector3.new(0.4, 0.34, 0.45), SKIN_FALLBACK)
		sleeve.Parent = rig
		hand.Parent = rig
		local fingers = {}
		for index = 1, 4 do
			local finger = part("Finger", Vector3.new(0.075, 0.11, 0.19), SKIN_FALLBACK)
			finger.Parent = rig
			table.insert(fingers, finger)
		end
		local thumb = part("Thumb", Vector3.new(0.12, 0.16, 0.21), SKIN_FALLBACK)
		thumb.Parent = rig
		table.insert(hands, { side = side, sleeve = sleeve, hand = hand, fingers = fingers, thumb = thumb })
	end

	local State = game:GetService("ReplicatedStorage"):WaitForChild("DiamondRushState")
	local worldDiamond = workspace:WaitForChild("Diamond") :: BasePart
	local gem = part("HeldDiamond", worldDiamond.Size, worldDiamond.Color, Enum.Material.Glass)
	gem.Reflectance = 0.35
	gem.Transparency = 1
	local shine = Instance.new("PointLight")
	shine.Color = Color3.fromRGB(150, 235, 255)
	shine.Range = 4
	shine.Brightness = 0.7
	shine.Enabled = false
	shine.Parent = gem
	gem.Parent = rig
	local lift = 0 -- 0 = digging pose, 1 = diamond raised to the sky
	local function isHolding(): boolean
		-- Display names are not unique: only the actual holder gets this view.
		return State:GetAttribute("Phase") == "Holding" and State:GetAttribute("HolderUserId") == player.UserId
	end

	-- While you hold the diamond the camera is locked, tilted up towards it.
	local lockedYaw: number? = nil
	RunService:BindToRenderStep("DiamondRushHoldCamera", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local holding = isHolding() and humanoid ~= nil and humanoid.Health > 0
		if holding and camera and head and head:IsA("BasePart") then
			if lockedYaw == nil then
				local look = camera.CFrame.LookVector
				lockedYaw = math.atan2(-look.X, -look.Z)
				camera.CameraType = Enum.CameraType.Scriptable
			end
			camera.CFrame = CFrame.new(head.Position + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, lockedYaw :: number, 0) * CFrame.Angles(math.rad(62), 0, 0)
		elseif lockedYaw ~= nil then
			lockedYaw = nil
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
		end
	end)
	local cycle = 1
	local punchSide = 1
	local bob = 0
	local digBlend = 0
	local function smooth(value: number): number
		value = math.clamp(value, 0, 1)
		return value * value * (3 - 2 * value)
	end

	-- Position the hands after both Roblox's camera and our hold-camera update.
	RunService:BindToRenderStep("DiamondRushHands", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if camera == nil or character == nil or humanoid == nil or humanoid.Health <= 0 then
			rig.Parent = nil
			worldDiamond.LocalTransparencyModifier = 0
			return
		end
		rig.Parent = camera
		-- Skin tone from the avatar.
		local colours = character:FindFirstChildOfClass("BodyColors")
		local skin = if colours then colours.RightArmColor3 else SKIN_FALLBACK
		local tool = character:FindFirstChildOfClass("Tool")
		-- Keep any third-person tool from obscuring the local hand and diamond.
		if tool then
			for _, d in tool:GetDescendants() do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = 1
				end
			end
		end
		local moving = humanoid.MoveDirection.Magnitude > 0.1 and humanoid.FloorMaterial ~= Enum.Material.Air
		bob += dt * (if moving then 9 else 2)
		local sway = if moving then 0.05 else 0.015
		local holding = isHolding()
		local digging = player:GetAttribute("DiggingRock") == true and not holding
		digBlend += ((if digging then 1 else 0) - digBlend) * (1 - math.exp(-dt * 14))
		if holding then
			cycle = 1
		elseif cycle < 1 then
			cycle = math.min(1, cycle + dt / 0.38)
		elseif digging then
			cycle = 0
			punchSide = -punchSide
		end
		-- Wind up, reach quickly into the stone, rake down, then pull the rubble back.
		local wind = smooth(cycle / 0.18) * (1 - smooth((cycle - 0.18) / 0.16))
		local reach = smooth((cycle - 0.18) / 0.20)
		local pull = smooth((cycle - 0.48) / 0.52)
		local extension = reach * (1 - pull) * digBlend
		local scoop = math.sin(math.clamp((cycle - 0.38) / 0.62, 0, 1) * math.pi) * digBlend
		-- While you hold the diamond your right hand lifts it to the sky.
		lift += ((if holding then 1 else 0) - lift) * math.min(1, dt * 8)
		worldDiamond.LocalTransparencyModifier = if holding then 1 else 0
		local worldLight = worldDiamond:FindFirstChildOfClass("PointLight")
		if worldLight then worldLight.Enabled = State:GetAttribute("Phase") == "Holding" and not holding end
		local base = camera.CFrame * CFrame.new(0, -0.95 + math.abs(math.sin(bob)) * sway, -1.6)
		for _, h in hands do
			local active = if h.side == punchSide then 1 - lift else 0
			local hit = extension * active
			local rake = scoop * active
			local prep = wind * digBlend * active
			local normal = base * CFrame.new(h.side * (0.58 - hit * 0.24), hit * 0.27 - rake * 0.19, -hit * 0.62 + prep * 0.12 + rake * 0.16)
				* CFrame.Angles(math.rad(10 - hit * 22 + rake * 34 + prep * 12), math.rad(-h.side * (8 + hit * 12)), math.rad(h.side * (rake * 16 - hit * 8)))
			-- Camera-relative grip stays below the countdown, well inside the lens.
			-- 62-degree camera tilt + 28-degree arm tilt still points up at the sky.
			local raised = if h.side == 1
				then camera.CFrame * CFrame.new(0.30, -0.56, -1.65) * CFrame.Angles(math.rad(28), math.rad(-8), math.rad(-10))
				else normal * CFrame.new(0, -1.6, 0.3)
			local arm = normal:Lerp(raised, lift)
			h.sleeve.CFrame = arm * CFrame.new(0, 0, 0.55)
			h.hand.CFrame = arm * CFrame.new(0, 0, -0.35)
			h.hand.Color = skin
			h.hand.LocalTransparencyModifier = 0
			local grip = math.max(if h.side == 1 then lift else 0, rake * 0.85)
			for index, finger in h.fingers do
				finger.Color = skin
				finger.CFrame = h.hand.CFrame * CFrame.new((index - 2.5) * 0.09, grip * 0.16, -0.27 + grip * 0.16)
					* CFrame.Angles(math.rad(-45 * grip), 0, 0)
			end
			h.thumb.Color = skin
			h.thumb.CFrame = h.hand.CFrame * CFrame.new(-h.side * 0.21, grip * 0.16, -0.08)
				* CFrame.Angles(math.rad(-25 * grip), 0, math.rad(h.side * 22))
		end
		gem.Transparency = if holding and lift > 0.3 then 0.1 else 1
		shine.Enabled = holding and lift > 0.3
		local palm = hands[2].hand.CFrame
		gem.CFrame = palm * CFrame.new(0, 0.34, -0.08) * CFrame.Angles(math.rad(45), 0, math.rad(35))
	end)
end

return FirstPerson
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="19">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>